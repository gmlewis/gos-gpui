// 04 - Interaction and state
//
// A first interactive program: buttons that raise events, a slider that writes
// straight into app state, and the keyboard routed to the window.
//
//   gos run --main-thread examples/04_interaction.gos
//
// The shape of a GPUI program in Gossamer is always the same three steps:
//
//   1. the frame's events go through a handler,
//   2. the state it left behind is read back,
//   3. the window is described as one chain.
//
// A widget that changes state calls back into GPUI, which schedules the next
// frame for you; nothing needs redrawing by hand.

use gpui
use std::process
use ui

fn stat(label: String, value: String, colour: String) -> ui::El {
    ui::column("items=center gap=2")
        .text(value, f"font=2xl bold {colour}")
        .text(label, "font=xs color=#6c7086")
}

/// One keystroke's worth of meaning.
fn on_key(name: String) {
    let count = gpui::state_int("count", 0)
    let step = gpui::state_float("step", 1.0) as i64
    if name == "up" || name == "k" {
        gpui::set_int("count", count + step)
    } else if name == "down" || name == "j" {
        gpui::set_int("count", count - step)
    } else if name == "r" {
        gpui::set_int("count", 0)
    } else if name == "space" {
        gpui::set_float("step", gpui::state_float("step", 1.0) + 1.0)
    }
}

/// Everything the last frame raised, folded into state.
fn handle(events: Vec<String>) {
    for event in events {
        let id, data = gpui::event_parts(event)
        let count = gpui::state_int("count", 0)
        let step = gpui::state_float("step", 1.0) as i64

        if id == "inc" {
            gpui::set_int("count", count + step)
        } else if id == "dec" {
            gpui::set_int("count", count - step)
        } else if id == "reset" {
            gpui::set_int("count", 0)
        } else if id == "key" {
            data |> on_key
        }

        if id != "" {
            gpui::set_text("last", f"{id} {data}")
        }
    }
}

fn main() {
    let outcome = gpui::run("Interaction", 560.0, 520.0, || {
        // Route keystrokes to the program as `"key|<name>"` events.
        gpui::on_keys(true)
        gpui::take_events() |> handle

        let count = gpui::state_int("count", 0)
        let step = gpui::state_float("step", 1.0) as i64
        let show_help = gpui::state_bool("help", true)
        let parity = if count % 2 == 0 { "even" } else { "odd" }

        let shortcuts = #[
            "↑ / k   add the step",
            "↓ / j   subtract the step",
            "r       reset to zero",
            "space   grow the step by one",
        ]

        ui::column("size=full bg=#1e1e2e p=24 gap=18")
            .child(ui::row("w=full justify=between items=baseline")
                .text("Interaction", "font=2xl bold color=#cdd6f4")
                .text(f"frames {gpui::frame()}", "font=xs color=#585b70"))
            .child(ui::row("w=full gap=10 bg=#181825 rounded=14 p=18 justify=around")
                .child(stat("count", f"{count}", "color=#89b4fa"))
                .child(stat("step", f"{step}", "color=#a6e3a1"))
                .child(stat("parity", parity, "color=#f9e2af")))
            .child(ui::row("w=full gap=10")
                .button("dec", f"-{step}", "flex=1 py=12 rounded=10 bg=#313244 color=#f38ba8 font=lg bold hover=bg:#45475a active=bg:#585b70")
                .button("inc", f"+{step}", "flex=1 py=12 rounded=10 bg=#89b4fa color=#11111b font=lg bold hover=bg:#a6e3fa active=bg:#74c7ec")
                .button("reset", "reset", "px=18 py=12 rounded=10 bg=#313244 color=#cdd6f4 hover=bg:#45475a active=bg:#585b70"))
            .child(ui::column("w=full gap=8 bg=#181825 rounded=14 p=18")
                .child(ui::row("w=full justify=between")
                    .text("step size", "font=sm color=#9399b2")
                    .text(f"{step}", "font=sm color=#89b4fa"))
                .slider("step", 1.0, 25.0, "w=full bg=#313244 rounded=full"))
            .child(ui::row("w=full gap=10 items=center")
                .checkbox("help", "show the keyboard shortcuts", show_help, "color=#cdd6f4 font=sm"))
            // ---- keyboard help, hidden by the checkbox -------------------
            .child(if show_help {
                ui::column("w=full gap=4 bg=#181825 rounded=14 p=18")
                    .text("keyboard", "font=sm semibold color=#9399b2")
                    .children(shortcuts.map(|line| ui::text(line, "font=sm color=#6c7086")))
            } else {
                ui::rect("w=0 h=0")
            })
            .child(ui::row("w=full justify=between bg=#181825 rounded=10 px=14 py=8")
                .text("last event", "font=xs color=#585b70")
                .text(gpui::state_text("last", "—"), "font=xs color=#a6adc8"))
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
