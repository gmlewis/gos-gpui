// 15 - pattern        upstream: tools/upstream/examples/pattern.rs
//
// GPUI's repeating diagonal-slash backgrounds, at two tile sizes, next to a
// flat fill and a 45-degree gradient so the three fills can be compared.
//
// `pattern_slash(colour, width, interval)` is the `slash=` style token:
// `slash=#ff0000,4.5,4.5`.
//
// Two details the tiles turn on:
//
//   * **The border belongs to the container, not to the tile.** Upstream puts
//     `border_1().border_color(blue)` on the `flex_col` that holds the slash
//     tiles — and on the two standalone bars — and gives the tiles themselves no
//     border at all. A border on every tile would make each 54x18
//     square wear its own blue outline, so the column would read as four separate
//     boxes with white between them, and the 256px column as a blue rule between
//     the red, green, blue and yellow bands — 11,137 pixels, every one of them 64
//     levels or more away from upstream's, the whole of both columns.
//   * Upstream's tile size is `56.0 / 6.0`, which is `9.333333` to the last
//     digit an `f32` keeps; `9.333` is a different `f32` by about 350 ulps.
//     With `9.333` a stripe is 9.333px wide instead of upstream's 9.333333px,
//     so the two patterns drift apart by a hundredth of a pixel across the 256px
//     tile. The port writes upstream's own `9.333333`, so a stripe and the tile
//     agree with upstream to the last digit the `f32` keeps.
//
// The green column's fill is `hsla(0.3333333333,1,0.25,0.16)`, which is
// `green().opacity(0.16)` exactly — not the `#00800029` (alpha 41/255) the hex
// spelling would give, since a hex alpha is a byte; see `gpui::hsla`.

use gpui
use std::process
use ui

/// One slash tile. Upstream's `div().w(px(..)).h(px(..)).bg(pattern_slash(..))`,
/// with no border: the container has it.
fn slash(colour: String, width: String, interval: String, extra: String) -> ui::El {
    ui::rect(f"{extra} slash={colour},{width},{interval}")
}

fn main() {
    let outcome = gpui::run("", 600.0, 600.0, || {
        ui::panel("flex col gap=12 bg=white size=600 justify=center items=center shadow=lg font=xl color=black")
            .text("Pattern Example", "")
            .child(ui::column("flex col border=1 bordercolor=blue")
                .child(slash("red", "4.5", "4.5", "w=54 h=18"))
                .child(slash("red", "4.5", "4.5", "w=54 h=18"))
                .child(slash("red", "4.5", "4.5", "w=54 h=18"))
                .child(slash("red", "4.5", "9", "w=54 h=18")))
            .child(ui::column("flex col border=1 bordercolor=blue bg=hsla(0.3333333333,1,0.25,0.16)")
                .text("Elements the same height should align", "")
                .child(slash("red", "9.333333", "9.333333", "w=256 h=56"))
                .child(slash("green", "9.333333", "9.333333", "w=256 h=56"))
                .child(slash("blue", "9.333333", "9.333333", "w=256 h=56"))
                .child(slash("yellow", "9.333333", "9.333333", "w=256 h=26")))
            .child(ui::rect("border=1 bordercolor=blue w=240 h=40 bg=red"))
            .child(ui::rect("border=1 bordercolor=blue w=240 h=40 grad=45,red,blue"))
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
