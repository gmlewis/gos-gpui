// 21 - text_wrapper        upstream: tools/upstream/examples/text_wrapper.rs (123 lines)
//
// NOT PORTED YET. Line wrapping: the same text at several widths, with the wrap points shown.
//
// Run it to see exactly what the binding is missing. The upstream example is
// the control: build and run
//
//   ./tools/upstream-examples.sh run text_wrapper
//
// and compare the two windows side by side.

use gpui
use std::process
use status
use ui

fn main() {
    let outcome = gpui::run("21 - text_wrapper", 760.0, 520.0, || {
        status::missing(
            "21 - text_wrapper",
            "upstream: examples/text_wrapper.rs (123 lines)",
            #[
            "window.text_system().layout_line(..) at a chosen width",
            "LineLayout wrapping iteration",
            "paint_text per wrapped line",
            ],
        )
        |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
