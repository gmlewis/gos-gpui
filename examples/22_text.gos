// 22 - text        upstream: tools/upstream/examples/text.rs (333 lines)
//
// NOT PORTED YET. The text primitives: runs, highlights, decorations, underlines and colours.
//
// Run it to see exactly what the binding is missing. The upstream example is
// the control: build and run
//
//   ./tools/upstream-examples.sh run text
//
// and compare the two windows side by side.

use gpui
use std::process
use status
use ui

fn main() {
    let outcome = gpui::run("22 - text", 780.0, 620.0, || {
        status::missing(
            "22 - text",
            "upstream: examples/text.rs (333 lines)",
            #[
            "cx.text_context + cx.init_colors() / cx.default_colors()",
            "window.rem_size()",
            "text runs, highlight styles and decorations as values",
            ],
        )
        |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
