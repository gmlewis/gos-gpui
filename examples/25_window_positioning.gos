// 25 - window_positioning        upstream: tools/upstream/examples/window_positioning.rs
//
// Nine small windows around every connected display — four corners, four edge
// centres and the centre — each one reporting the bounds it asked for and the
// bounds it actually got. Two are red, two blue and five black, in upstream's
// order; the count grows with the number of displays.
//
// Upstream loops over `cx.displays()` inside `Application::run`'s closure and
// opens all nine windows there, once. Here that loop runs from `gpui::run_with`'s
// view callback, guarded by a state flag: a Gossamer view callback is
// re-invoked every frame, so an unguarded open would spawn a fresh nine windows
// per frame. `gpui::open_window` is deferred to after the frame that asked for
// it — opening a window draws it immediately, and a nested draw would disturb
// the frame being built — which is what lets a running view open another
// window at all.
//
// Each window's content is upstream's, including the two nested `size_full`
// boxes: the label, then the requested origin/size, then the live
// `window.bounds()` origin/size. Both are printed as `…px`, which is what
// GPUI's `Display for Pixels` writes. `window.bounds()` is
// `gpui::window_field(..)`, read afresh on every frame, so the second line tracks
// the window while it is dragged or resized.
//
// Deviations, all on the binding's side:
//
//   * The arithmetic keeps upstream's own quirks, which a multi-display Mac
//     cannot see anyway because GPUI's macOS `Display::bounds()` reports the
//     origin as (0, 0) for every display and only the size is real. Top Left is
//     the absolute point (150, 150); Top Center is at y = 150 and Left Center at
//     x = 150, both absolute; Right Center takes its x from the display's
//     *width* and Bottom Center its y from the display's *height*, so neither
//     follows a display whose origin is not (0, 0). The port reproduces all of
//     it window for window rather than "fixing" it.
//   * `gpui::run` opens one window of its own and upstream's app opens none — it
//     only opens the positioned ones. That host window is the one whose callback
//     does the opening, and it lists the connected displays. It is opened with
//     `show=false`, which on macOS builds the `NSWindow` and never orders it
//     (`platform/mac/window.rs:849-853` calls neither `makeKeyAndOrderFront_` nor
//     `orderFront_`), so there is no tenth window on the screen. Measured: the
//     window server lists nine windows for this process and no tenth, and the
//     host's own view still ran — it is what opened the nine. The one asymmetry is
//     the container: gpui's Linux backend never reads `show` at all, so there the
//     host is an ordinary window like any other. No tier of this project
//     photographs a GPUI window on Linux, so that is not measured here.
//   * Upstream never asks for its app to be activated, so none of its nine is a
//     key window. `gpui::run` activates by default and the port asks for
//     upstream's state instead, as `activate=false` — the call `23_tree` and
//     `24_uniform_list` make for the same reason. All nine are `titlebar=none`, so
//     there are no lights to give it away; measured, with the flag and without it
//     the window interior is the same 0 pixels. What is left is which app is in
//     front — outside "the window, its decorations and the client area". **Invisible.**
//   * A positioned window is not given a view of its own. `gpui::run_with`'s view
//     draws every window, and this port tells them apart with `gpui::window_id`
//     — the host window is 1 and the positioned ones are 2, 3, … in the order
//     they were opened. Each one reads the description written for it just
//     before it was opened, under the id it was about to get, so the label and
//     colour are waiting on its first frame. `open_window` does not take the
//     window's own view callback: a callback handed to a binding function is
//     valid only for the call that received it, and `open_window` returns before
//     the window is drawn, so a view callback would answer an error on the
//     compiled tiers.
//   * Upstream's labels interpolate `DisplayId`'s `Debug`, which is
//     `DisplayId(1)`. `gpui::display_field(i, "id")` is that number, so the labels are
//     reproduced with the `DisplayId(…)` wrapper spelled out by hand.
//   * Upstream passes `titlebar: None`; the binding always attaches a titlebar,
//     invisible here because the port asks for `titlebar=none`, and the title is
//     left empty. Upstream's labels are the text drawn *inside* each window, not
//     titles, and they are reproduced there.
//   * Upstream's window is 350x75 with a 150px margin, which the port keeps. The
//     host's own size is still explicit — `run_with` takes one, and a window with
//     no size is not a thing here — but the host is never ordered, so that number
//     is not a pixel of the pair.

use gpui
use std::process
use ui

/// Upstream's `size`.
const WINDOW_W: f64 = 350.0
const WINDOW_H: f64 = 75.0

/// Upstream's `margin_offset`.
const MARGIN: f64 = 150.0

/// Upstream's `build_window_options`: same kind, focus, movability, titlebar and
/// background. `display=` is not here because it differs per window — `positioned`
/// appends `display=<index>`, which is upstream's `display_id: Some(screen.id())`
/// for the screen that window's bounds were computed against.
const OPTIONS: &str = "kind=popup focus=false movable=false titlebar=none background=transparent"

/// A positioned window's view.
///
/// It is the one view `gpui::run_with` was given, and it is running for a window that
/// is not the host — the host is window 1 and this is one of the nine. What it
/// draws comes from the description `positioned` wrote for it, under this
/// window's own id, before the window existed.
fn positioned_view() {
    let label = gpui::state_text("positioned.label", "")
    let colour = gpui::state_text("positioned.colour", "")
    let x = gpui::state_float("positioned.x", 0.0)
    let y = gpui::state_float("positioned.y", 0.0)
    let here_x = gpui::window_field("x")
    let here_y = gpui::window_field("y")
    let here_w = gpui::window_field("w")
    let here_h = gpui::window_field("h")
    ui::panel(f"flex col size=full items=center bg={colour} color=#ffffff")
        .text(label, "")
        .child(ui::panel("flex col font=sm items=center size=full")
            .text(f"origin: {x}px, {y}px size: {WINDOW_W}px, {WINDOW_H}px", "")
            .text(f"cx.bounds() origin: {here_x}px, {here_y}px size {here_w}px, {here_h}px", ""))
        |> ui::root
}

/// One positioned window: `label` names it, `colour` is upstream's background,
/// `index` is the display it belongs on — upstream's `screen.id()` — and `x`/`y`
/// are the requested screen coordinates in pixels.
///
/// Its description is written into the window's *own* state before it is opened,
/// under the id it is about to be given, so the description is there for its
/// first frame to read. `window::allocate` hands out ids in the order windows are
/// opened and the host took 1, so the n-th window opened here is id `n + 1`.
fn positioned(index: i64, label: String, colour: String, x: f64, y: f64) {
    let n = gpui::state_int("positioned.count", 0) + 1
    gpui::set_int("positioned.count", n)
    let child = n + 1
    gpui::set_text_in(child, "positioned.label", label)
    gpui::set_text_in(child, "positioned.colour", colour)
    gpui::set_float_in(child, "positioned.x", x)
    gpui::set_float_in(child, "positioned.y", y)
    // Upstream attaches no titlebar and so no title; `titlebar=none` is its
    // stand-in, and the title is left empty to match. `display=index` is
    // upstream's `display_id`, so each of the nine is created on the display its
    // bounds were computed for rather than on whichever one is primary.
    gpui::open_window("", x, y, WINDOW_W, WINDOW_H, f"{OPTIONS} display={index}")
}

/// Upstream's nine windows for one display, in the order it opens them.
fn display_windows(index: i64) {
    let id = gpui::display_field(index, "id")
    let dx = gpui::display_field(index, "x")
    let dy = gpui::display_field(index, "y")
    let dw = gpui::display_field(index, "w")
    let dh = gpui::display_field(index, "h")
    let left = dx + MARGIN
    let right = dx + dw - WINDOW_W - MARGIN
    let top = dy + MARGIN
    let bottom = dy + dh - WINDOW_H - MARGIN
    let middle_x = dx + dw / 2.0 - WINDOW_W / 2.0
    let middle_y = dy + dh / 2.0 - WINDOW_H / 2.0

    positioned(index, f"Top Left DisplayId({id})", "red", MARGIN, MARGIN)
    positioned(index, f"Top Right DisplayId({id})", "red", right, top)
    positioned(index, f"Bottom Left DisplayId({id})", "blue", left, bottom)
    positioned(index, f"Bottom Right DisplayId({id})", "blue", right, bottom)
    positioned(index, f"Top Center DisplayId({id})", "black", middle_x, MARGIN)
    positioned(index, f"Left Center DisplayId({id})", "black", MARGIN, middle_y)
    positioned(index, f"Center DisplayId({id})", "black", middle_x, middle_y)
    positioned(index, f"Right Center DisplayId({id})", "black", dw - WINDOW_W - MARGIN, middle_y)
    positioned(index, f"Bottom Center DisplayId({id})", "black", middle_x, dh - WINDOW_H - MARGIN)
}

/// One line of the host window's display list.
fn display_line(index: i64) -> ui::El {
    let id = gpui::display_field(index, "id") as i64
    let x = gpui::display_field(index, "x")
    let y = gpui::display_field(index, "y")
    let w = gpui::display_field(index, "w")
    let h = gpui::display_field(index, "h")
    ui::text(f"display {id}: origin {x}px, {y}px size {w}px, {h}px", "font=sm color=#cdd6f4")
}

fn main() {
    // `show=false` leaves the host window un-ordered, which is the one thing that
    // makes this pair ten windows on one side and nine on the other; `activate=false`
    // is upstream's own state, since it never activates its app. See the deviations
    // above. The host's view still runs and is still what opens the nine.
    let outcome = gpui::run_with("", 560.0, 420.0, "show=false activate=false", || {
        // Every window runs this view; the host is 1 and the positioned ones are
        // the rest, told apart by what `positioned` wrote for them.
        if gpui::window_id() != 1 {
            return positioned_view()
        }

        // Upstream opens every window from `Application::run`'s closure, once.
        // A Gossamer view callback runs once per frame, so this is guarded.
        if !gpui::state_bool("opened", false) {
            gpui::set_bool("opened", true)
            for index in 0..gpui::display_count() {
                display_windows(index)
            }
        }

        let displays = gpui::display_count()

        ui::panel("flex col gap=10 p=20 bg=#181825 color=#cdd6f4 size=full items=center justify=center")
            .text("25 - window_positioning", "font=2xl bold color=#ffffff")
            .text(f"displays: {displays}; nine 350x75 windows each, margin 150", "font=sm")
            .child(ui::column("gap=2").children((0..displays).map(display_line).collect()))
            .text("upstream opens them from Application::run; here the host window does.", "font=xs color=#6c7086")
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
