// 25 - window_positioning        upstream: tools/upstream/examples/window_positioning.rs (219 lines)
//
// NOT PORTED YET. Moving a window between displays and reporting its bounds.
//
// Run it to see exactly what the binding is missing. The upstream example is
// the control: build and run
//
//   ./tools/upstream-examples.sh run window_positioning
//
// and compare the two windows side by side.

use gpui
use std::process
use status
use ui

fn main() {
    let outcome = gpui::run("25 - window_positioning", 640.0, 460.0, || {
        status::missing(
            "25 - window_positioning",
            "upstream: examples/window_positioning.rs (219 lines)",
            #[
            "cx.displays() — the connected displays",
            "window.bounds() and setting bounds on a live window",
            "moving a window to another display",
            ],
        )
        |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
