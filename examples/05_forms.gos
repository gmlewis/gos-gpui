// 05 - Forms
//
// Text fields, focus, keyboard submit, and a small list you can add to and
// delete from. A single-line input keeps its text in app state under the key
// it was given, so the program reads it back with `gpui::state_text` and never
// has to wire up a change handler.
//
//   gos run --main-thread examples/05_forms.gos

use gpui
use std::process
use ui

fn heading(content: String) -> ui::El {
    ui::text(content, "font=sm semibold color=#9399b2")
}

fn field(label: String, key: String, placeholder: String) -> ui::El {
    ui::column("w=full gap=6")
        .text(label, "font=sm color=#9399b2")
        .input(key, placeholder, "w=full px=12 py=8 bg=#313244 rounded=9 border=1 bordercolor=#45475a color=#cdd6f4")
}

fn task_row(index: i64, label: String) -> ui::El {
    ui::row("w=full gap=8 items=center bg=#313244 rounded=8 px=12 py=8")
        .text(f"{index + 1}.", "font=sm color=#585b70 w=24")
        .text(label, "flex=1 font=sm color=#cdd6f4")
        .button(f"del-{index}", "delete", "px=8 py=2 rounded=6 bg=#45475a color=#f38ba8 font=xs hover=bg:#585b70")
}

fn handle(events: Vec<String>) {
    for event in events {
        let id, data = gpui::event_parts(event)
        if id == "draft" && data == "submit" {
            let draft = gpui::state_text("draft", "")
            if draft != "" {
                gpui::list_push("tasks", draft)
                gpui::set_text("draft", "")
            }
        } else if id == "del" {
            if let Some(index) = data.to_i64() {
                gpui::list_remove("tasks", index)
            }
        } else if id == "clear" {
            gpui::list_clear("tasks")
        } else if id == "name" && data == "submit" {
            gpui::set_text("greeted", gpui::state_text("name", ""))
        }
    }
}

fn main() {
    let outcome = gpui::run("Forms", 620.0, 660.0, || {
        gpui::take_events() |> handle

        let name = gpui::state_text("name", "")
        let greeted = gpui::state_text("greeted", "")
        let tasks = gpui::list_len("tasks")
        let greeting = if greeted == "" {
            "type a name and press return"
        } else {
            f"hello, {greeted}!"
        }

        let task_rows = ui::column("w=full gap=6")
            .children((0..tasks).map(|index| task_row(index, gpui::list_get("tasks", index))).collect())

        ui::scroll("size=full bg=#1e1e2e p=24 gap=18")
            .text("Forms", "font=2xl bold color=#cdd6f4")
            // ---- two fields, one live-read ---------------------------------
            .child(ui::column("w=full gap=14 bg=#181825 rounded=14 p=18")
                .child(heading("text input"))
                .child(field("your name", "name", "Ada Lovelace"))
                .child(ui::row("w=full justify=between items=center")
                    .text(greeting, "font=base color=#a6e3a1")
                    .text(f"{name.len()} characters", "font=xs color=#585b70")))
            // ---- a list you can edit ---------------------------------------
            .child(ui::column("w=full gap=12 bg=#181825 rounded=14 p=18")
                .child(ui::row("w=full justify=between items=center")
                    .child(heading("a list"))
                    .text(f"{tasks} items", "font=xs color=#585b70"))
                .child(ui::row("w=full gap=8 items=center")
                    .input("draft", "new task, then return", "flex=1 px=12 py=8 bg=#313244 rounded=9 border=1 bordercolor=#45475a color=#cdd6f4")
                    .button("clear", "clear", "px=14 py=8 rounded=9 bg=#313244 color=#f38ba8 hover=bg:#45475a"))
                .child(if tasks == 0 {
                    ui::text("nothing yet — press return in the field above", "font=sm color=#585b70")
                } else {
                    task_rows
                }))
            // ---- notes on behaviour ----------------------------------------
            .child(ui::column("w=full gap=4 bg=#181825 rounded=14 p=18")
                .child(heading("what is happening"))
                .text("clicking a field focuses it and shows a caret", "font=sm color=#6c7086")
                .text("return submits — the field raises `draft|submit`", "font=sm color=#6c7086")
                .text("escape raises `draft|cancel`", "font=sm color=#6c7086")
                .text("the value lives in state under the field's key", "font=sm color=#6c7086"))
            .spacer(4.0)
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
