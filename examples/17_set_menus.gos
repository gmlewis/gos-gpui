// 17 - set_menus        upstream: tools/upstream/examples/set_menus.rs (49 lines)
//
// The macOS application menu bar, with a Quit item wired to an action, over a
// green window holding one line of text. `gpui::set_menus(name, items)` takes a
// list of entry strings — `"separator"`, `"quits:<label>"`, `"events:<label>"`,
// `"os:<label>:<selector>"` or `"services:<label>"` — so upstream's one `Menu`
// named `set_menus` with a Services submenu, a separator and
// `MenuItem::action("Quit", Quit)` is a three-entry list. (`MenuItem::Submenu`
// is expressible too, as `"submenu:<label>"` with the entries inside it indented
// by one `>` each; upstream's menu has none.)
//
// Upstream also registers the action itself (`actions!(set_menus, [Quit])`,
// `cx.on_action(quit)`) and quits from its own handler. Menu items carry a
// boxed action that no ABI can pass, so the binding owns the action and its
// slot: `"quits:Quit"` is a binding-side action whose handler calls `cx.quit()`.
// Nothing has to be registered from Gossamer, and the Quit item appears with
// exactly the label upstream gives it.
//
// The menu is installed once, from the view callback, guarded by a state flag;
// `set_menus` is a request the binding runs after the frame, so it cannot be
// called before `gpui::run`, and a Gossamer view callback would otherwise
// rebuild the menu bar on every frame.
//
// Deviations, all on the binding's side:
//   * upstream's quit handler prints "Gracefully quitting the application . . ."
//     before `cx.quit()`. `"quits:Quit"` runs the binding's own handler, which
//     only quits, so that line is not printed.
//   * upstream calls `cx.activate(true)` to bring the menu bar forward; the
//     binding activates the app itself when it opens the window, and no example
//     can call it.
//   * upstream leaves the window size to GPUI — `WindowOptions::default()` gives
//     the centred default, 1536x864 clipped to the display. `gpui::run` takes
//     explicit dimensions, so this asks for 800x600. The element is `size_full`
//     either way, so only the window's size differs.
//   * `WindowOptions::default()` passes no titlebar options, which on macOS
//     means no explicit title; the binding always attaches one, and `gpui::run`
//     requires a title, so the window is titled `17 - set_menus`.
//   * the application menu bar is a macOS feature; on Linux `set_menus` stores
//     the menu but shows no bar, which is upstream's behaviour there too.

use gpui
use std::process
use ui

fn main() {
    let outcome = gpui::run("17 - set_menus", 800.0, 600.0, || {
        // Upstream installs the menu once from `Application::run`'s closure,
        // before opening its window. `gpui::set_menus` is applied after the
        // frame that asked for it, so the first frame is where it belongs.
        if !gpui::state_bool("menus", false) {
            gpui::set_bool("menus", true)
            gpui::set_menus("set_menus", #["services:Services", "separator", "quits:Quit"])
        }

        ui::panel("flex size=full justify=center items=center bg=#2e7d32 font=xl color=#ffffff")
            .text("Set Menus Example", "")
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
