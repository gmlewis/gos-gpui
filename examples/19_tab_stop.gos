// 19 - tab_stop        upstream: tools/upstream/examples/tab_stop.rs (155 lines)
//
// Focus order. Five 40px boxes — three with an explicit `tab_index` 1..3, one
// that is focusable but not a tab stop, and one that repeats index 2 — plus
// two buttons at indices 4 and 5. Tab and Shift-Tab move focus between the
// stops, and the focused box draws upstream's 3px blue ring.
//
// The focus *order* is real, and measured rather than asserted (round 91). The
// boxes carry `focusable tabstop=1 tabindex=N`, Tab calls `gpui::focus_next()`,
// and GPUI's own tab machinery is what moves — `tests/gui/fo1_tab_order.gos`
// presses six times over a tree of this shape and reads the walk back in
// `tab_index` order, the repeat of 2 immediately after the first 2 and the box
// that is focusable but not a tab stop never. Until round 91 this did not work,
// and the file said so: the binding handed GPUI a focus handle of its own, and
// GPUI copies `tab_stop`/`tab_index` onto a handle only when it builds one
// itself (gpui-0.2.2/src/elements/div.rs:1584), so every focusable element
// entered the tab map as a non-stop and `Window::focus_next` found nothing to
// move to. `tests/evidence/FO1.before.txt` is that measurement, and
// `FO1.after.txt` its fix.
//
// The 3px blue ring is real for the same reason, and is what those two files
// bought. Each box names itself with `id=` and asks `gpui::is_focused(id)` while
// the frame is being built, so the border follows focus the moment
// `gpui::focus_next` moves it. Upstream asks `item_handle.is_focused(window)` —
// the same question, asked of a handle rather than of a name, which is the whole
// of the difference and leaves the same pixels.
//
// The keys are real too, in the one shape the binding offers: upstream's
// `KeyBinding::new("tab", Tab, None)` and
// `KeyBinding::new("shift-tab", TabPrev, None)` cannot be registered from here,
// so they are read as `key|<stroke>` events instead — and both arrive
// distinctly, `key|tab` and `key|shift-tab`, because `gpui::on_keys` reports
// gpui's unparsed stroke rather than just the key's name.
//
// One deviation, on the binding's side rather than a choice:
//
//   * The two buttons are a focusable box around a `ui::button`, not one
//     element. `ui::button` is a kind of its own; the box carries the focus
//     order and the ring and the black ground, and the button inside carries the
//     click, which together are upstream's
//     `div().id(..).tab_index(..).focus(..).on_click(..)`. Two levels where
//     upstream has one, and the same pixels — `tests/evidence/pairs/census.tsv`
//     holds the row.
//
// One token-order note: in GPUI `tab_index(..)` also sets `tab_stop` to true,
// so the box that must *not* be a tab stop emits no `tabindex` at all, which
// is upstream's state for it as well (the default handle has tab_index 0 and
// tab_stop false).

use gpui
use std::process
use ui

/// Upstream's opening line, verbatim.
const MESSAGE: &str = "Press `Tab`, `Shift-Tab` to switch focus."

/// Upstream's `tab_stop_style`, in the style language: 3px of gpui's `blue()` where the box is
/// focused, and the plain 1px black border it wears otherwise. Built afresh every frame, which is
/// what lets it follow focus.
fn ring(id: String) -> String {
    if gpui::is_focused(id) {
        "border=3 bordercolor=blue"
    } else {
        "border=1 bordercolor=black"
    }
}

/// One of the boxes that is a tab stop: `tab_index` 1, 2, 3 and a repeat of 2,
/// upstream's `hover(bg(black.opacity(0.1)))`, and the 3px blue ring.
///
/// `id` is upstream's `("item", ix)` under a name a program can ask about — the
/// ring is drawn from the answer to `gpui::is_focused`, so the box has to be
/// nameable. It changes no pixel; it is what makes the question askable at all.
fn stop_item(id: String, tab_index: i64) -> ui::El {
    let border = ring(id)
    ui::panel(f"h=40 w=full flex justify=center items=center {border} hover=bg:#0000001a id={id} focusable tabindex={tab_index} tabstop=1")
        .text(f"tab_index: {tab_index}", "")
}

/// The fourth handle: `cx.focus_handle()` with neither `tab_index` nor
/// `tab_stop`, drawn at `opacity(0.4)` with the label `tab_stop: false`.
///
/// It carries no ring, and that is upstream's own doing rather than a limit
/// here: its condition is `item_handle.tab_stop && item_handle.is_focused(window)`,
/// and this handle's `tab_stop` is false, so it is never ringed even while it
/// holds focus.
fn loose_item() -> ui::El {
    ui::panel("h=40 w=full flex justify=center items=center border=1 bordercolor=black opacity=0.4 id=item3 focusable tabstop=0")
        .text("tab_stop: false", "")
}

/// Upstream's `button(id)`: a black `h_10 flex_1` box with `shadow_sm`, a
/// `tab_index`, and a click. The tab stop and the ring are the box; the click is
/// the button inside it — see the header.
fn tab_button(id: String, label: String, tab_index: i64) -> ui::El {
    let border = ring(id)
    ui::panel(f"flex col flex=1 h=40 bg=black color=white {border} shadow=sm id={id} focusable tabindex={tab_index} tabstop=1")
        .button(id, label, "flex=1 w=full")
}

/// Upstream's `on_tab` / `on_tab_prev` / the two `on_click`s, over the state
/// store. Upstream's two key bindings are the two `key|` arms below.
fn handle_events() {
    for event in gpui::take_events() {
        let id, kind = gpui::event_parts(event)
        if id == "key" && kind == "tab" {
            gpui::focus_next()
            gpui::set_text("message", "You have pressed `Tab`.")
        } else if id == "key" && kind == "shift-tab" {
            gpui::focus_prev()
            gpui::set_text("message", "You have pressed `Shift-Tab`.")
        } else if id == "el1" {
            gpui::set_text("message", "You have clicked Button 1.")
        } else if id == "el2" {
            gpui::set_text("message", "You have clicked Button 2.")
        }
    }
}

fn main() {
    let outcome = gpui::run("", 800.0, 600.0, || {
        // Upstream binds Tab and Shift-Tab to actions; the binding owns its key
        // bindings, so the keys are read here as `key|<stroke>` events instead.
        gpui::on_keys(true)

        handle_events()

        let message = gpui::state_text("message", MESSAGE)

        ui::column("size=full p=16 gap=12 bg=white color=black")
            .text(message, "")
            .child(stop_item("item0", 1))
            .child(stop_item("item1", 2))
            .child(stop_item("item2", 3))
            .child(loose_item())
            .child(stop_item("item4", 2))
            .child(ui::row("gap=12 items=center")
                .child(tab_button("el1", "Button 1", 4))
                .child(tab_button("el2", "Button 2", 5)))
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
