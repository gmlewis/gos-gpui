/// Walk `LOGO` and describe it. The run is flat and its commands are not all the same
/// length, so the cursor advances by however many numbers the command just read used.
fn logo() -> i64 {
    let handle = gpui::path_fill()
    let mut i = 0
    let mut commands = 0
    while i < LOGO.len() {
        let op = LOGO[i] as i64
        commands = commands + 1
        if op == 0 {
            gpui::path_move_to(handle, LOGO[i + 1], LOGO[i + 2])
            i = i + 3
        } else if op == 1 {
            gpui::path_line_to(handle, LOGO[i + 1], LOGO[i + 2])
            i = i + 3
        } else if op == 2 {
            gpui::path_curve_to(handle, LOGO[i + 1], LOGO[i + 2], LOGO[i + 3], LOGO[i + 4])
            i = i + 5
        } else if op == 3 {
            gpui::path_cubic_to(
                handle,
                LOGO[i + 1], LOGO[i + 2],
                LOGO[i + 3], LOGO[i + 4],
                LOGO[i + 5], LOGO[i + 6],
            )
            i = i + 7
        } else if op == 4 {
            gpui::path_close(handle)
            i = i + 1
        } else {
            // Not a command: `LOGO` is opaque data, so say so rather than read the next number
            // as though the run were still lined up. The walk then ends off the end and the
            // check below reports a second time.
            println(f"FAIL LOGO unknown command {op} at {i}")
            i = i + 1
        }
    }
    // The walk reads the run by stride, and a stride one number out would drift and describe
    // a different shape without complaining. So it says whether it landed exactly on the end
    // having read exactly 255 commands — lyon's own count for this path — and every one of
    // them a command it knows. A mis-transcribed number in `LOGO` cannot fail this, but a
    // mistyped *stride* cannot pass it.
    if i != LOGO.len() || commands != 255 {
        println(f"FAIL LOGO the walk ended at {i} of {LOGO.len()} after {commands} commands, not at the end after 255")
    }
    finish(handle)
}

// ---- the default painting ---------------------------------------------

/// Upstream's `default_lines`, in paint order. The Rust logo sits between the second circle
/// and the bolt, as upstream's does.
fn default_paths() -> Vec<i64> {
    #[
        fill_rect(50.0, 50.0, 130.0, 130.0),
        fill_rect(150.0, 50.0, 230.0, 130.0),
        fill_rect(250.0, 50.0, 330.0, 130.0),
        fill_rect(350.0, 50.0, 430.0, 130.0),
        circle(530.0, 85.0, 30.0),
        circle(570.0, 85.0, 30.0),
        logo(),
        bolt(),
        star(),
        arch(),
        wedge(871.0, 255.0, 747.0, 163.0),
        wedge(747.0, 163.0, 679.0, 263.0),
        wedge(679.0, 263.0, 754.0, 349.0),
        wedge(754.0, 349.0, 854.0, 310.0),
        wedge(854.0, 310.0, 871.0, 255.0),
        wave(),
    ]
}

/// One background per path above, in the same order. `#ff000080` is upstream's
/// `rgb(0xFF0000)` with `a = 0.5`, and so on; the star's is upstream's
/// `linear_gradient(180., #FACC15 @ 0.7, #D56D0C @ 1.).color_space(Oklab)`;
/// the arch's is `linear_gradient(180., blue @ 0.4, red @ 1.)` in sRGB.
fn default_backgrounds() -> Vec<String> {
    #[
        "#ff000080",
        "#0000ff80",
        "#00ff0080",
        "#00000080",
        "#ff000080",
        "#ff000080",
        "black",
        "#1d4ed8",
        "grad=180,#facc15,0.7,#d56d0c,1,oklab",
        "grad=180,blue,0.4,red,1",
        "#1374e9",
        "#e13527",
        "#0751ce",
        "#209742",
        "#fbc10a",
        "green",
    ]
}

/// A drawn stroke, as a 1px path through every point recorded under `key`, or
/// `-1` for the single-point strokes upstream skips. `points` is a flat
/// x, y, x, y run — two floats per point, four for the smallest drawable
/// stroke — which is what an open polygon wants.
fn stroke_path(key: String, dashed: bool) -> i64 {
    let points = gpui::list_all_float(key)
    if points.len() < 4 {
        return -1
    }
    let handle = gpui::path_stroke(1.0)
    if dashed {
        gpui::path_dash(handle, #[4.0, 2.0])
    }
    gpui::path_polygon(handle, points, false)
    finish(handle)
}

// ---- the frame --------------------------------------------------------

fn main() {
    let outcome = gpui::run("", 1536.0, 864.0, || {
        // Upstream's listeners, through `on_mouse`: a down starts a stroke, a
        // move extends it, an up ends it. The binding reports a move only
        // while the button is down.
        //
        // The point comes off the event, one per event. `gpui::pointer_xy` is
        // the position in the **window**, which is the space upstream's
        // `MouseDownEvent::position` is in and the space the paths below are
        // painted in — so it does not matter where the listening surface sits.
        // The store's `canvas.x` would be the wrong number twice over: one slot
        // per element, so a frame that coalesces four moves answers the fourth
        // point to all four of them.
        for event in gpui::take_events() {
            let id, kind = gpui::event_parts(event.clone())
            if id == "dashed" {
                gpui::set_bool("dashed", !gpui::state_bool("dashed", false))
            } else if id == "clear" {
                gpui::set_int("strokes", 0)
                gpui::set_int("current", -1)
                gpui::set_bool("painting", false)
            } else if id == "canvas" {
                let x, y = gpui::pointer_xy(event.clone())
                if kind == "down" {
                    let index = gpui::state_int("strokes", 0)
                    gpui::forget(f"stroke{index}")
                    gpui::list_push_float(f"stroke{index}", x)
                    gpui::list_push_float(f"stroke{index}", y)
                    gpui::set_float("start.x", x)
                    gpui::set_float("start.y", y)
                    gpui::set_int("strokes", index + 1)
                    gpui::set_int("current", index)
                    gpui::set_bool("painting", true)
                } else if kind == "move" {
                    let index = gpui::state_int("current", -1)
                    if gpui::state_bool("painting", false) && index >= 0 {
                        // Upstream, verbatim: while shift is held, the point
                        // is pulled onto the axis through the stroke's start
                        // that it is furthest from. The modifiers are *this*
                        // event's, so shift pressed halfway through a drag
                        // starts snapping on the next move and letting it go
                        // stops — which a latch of the program's own could not
                        // do, `on_keys` raising key-down only.
                        let mut px = x
                        let mut py = y
                        if strings::contains(gpui::pointer_mods(event.clone()), "shift") {
                            let sx = gpui::state_float("start.x", 0.0)
                            let sy = gpui::state_float("start.y", 0.0)
                            if math::abs(px - sx) > math::abs(py - sy) {
                                py = sy
                            } else {
                                px = sx
                            }
                        }
                        gpui::list_push_float(f"stroke{index}", px)
                        gpui::list_push_float(f"stroke{index}", py)
                    }
                } else if kind == "up" {
                    gpui::set_bool("painting", false)
                }
            }
        }

        let dashed = gpui::state_bool("dashed", false)
        let strokes = gpui::state_int("strokes", 0)

        // Upstream keeps its paths for the life of the entity. Here the drawn
        // strokes are state, so the whole pool is rebuilt every frame; reset
        // first, and nothing accumulates across frames.
        gpui::path_reset()

        let stroke_handles: Vec<i64> = (0..strokes).map(|i| stroke_path(f"stroke{i}", dashed)).collect()
        let stroke_backgrounds: Vec<String> = (0..strokes).map(|_| "black").collect()

        let label = if dashed { "Solid" } else { "Dashed" }

        ui::stack("size=full bg=white")
            .child(quad(70.0, 70.0, 40.0, 40.0))
            .child(quad(170.0, 70.0, 40.0, 40.0))
            .child(quad(270.0, 70.0, 40.0, 40.0))
            .child(quad(370.0, 70.0, 40.0, 40.0))
            .child(quad(450.0, 50.0, 80.0, 80.0))
            .child(ui::paths(default_paths(), default_backgrounds(), "absolute left=0 top=0 size=full"))
            .child(ui::paths(stroke_handles, stroke_backgrounds, "absolute left=0 top=0 size=full"))
            // Upstream's listener is the `size_full` div that holds the
            // canvas; this port keeps it at 900x520 so it does not lie over
            // the toolbar above it — not because the binding needs a pixel
            // size, which it no longer does: the element handed to `on_mouse`
            // *is* the box that listens. At the window origin the coordinates
            // it reports are window coordinates either way, being relative to
            // an element that sits at 0,0.
            // The header in flow at the padded root's corner, then the drawing
            // surface in flow *after* it — so the surface is the area below the
            // header, as upstream's `size_full` canvas div is below the header
            // row in its `flex_col`. It used to be a fixed 900x520 at the window
            // origin, which put the listening box under the header: a drag
            // started in the empty part of the header row drew a line here and
            // draws nothing upstream. What that cost was the *point*, which came
            // out of the store relative to the surface's corner; the strokes are
            // in window coordinates now, off the event, so the surface can sit
            // where upstream's does without moving a single painted pixel.
            .child(ui::row("ml=16 mr=16 mt=16 gap=8 justify=between items=center")
                .text("Mouse down any point and drag to draw lines (Hold on shift key to draw straight lines)", "")
                .child(ui::row("gapx=8")
                    .button("dashed", label, "flex px=12 py=4 bg=black color=white active=opacity:0.8")
                    .button("clear", "Clear", "flex px=12 py=4 bg=black color=white active=opacity:0.8")))
            .child(ui::on_mouse(ui::rect("ml=16 mr=16 mb=16 h=full"), "down up move", "canvas"))
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
