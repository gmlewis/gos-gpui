// 03 - drag_drop        upstream: tools/upstream/examples/drag_drop.rs (137 lines)
//
// Three 128x128 squares you can drag onto a 512x128 target: while a square is
// held, a translucent 120x50 "Item n" ghost rides with the pointer, and
// releasing over the target paints it in the square's colour.
//
// THE DRAG PROTOCOL IS EMULATED, NOT GPUI'S OWN. Upstream uses
// `on_drag(value, ..)` / `on_drop(..)`, which hand GPUI a `'static` payload and
// an `Entity<W>` drag preview; neither fits the binding's ABI, and neither
// method is exposed. Everything below is `on_mouse` plus the state store:
//
//   * `on_drag(DragInfo::new(ix, colour), ..)`  ->  `down` on a square writes
//     the same payload (index and colour) into `drag.*`.
//   * the `Entity<DragInfo>` preview            ->  a plain `ui::panel` placed
//     `absolute` from `gpui::mouse_position()`, centred on the pointer at
//     -60/-25. Upstream's preview lands in exactly that place: GPUI lays the
//     preview root out at `mouse - cursor_offset` and the view then adds
//     `position.x - size.width.half()`, where the two `cursor_offset`s cancel.
//   * `on_drop(..)`                             ->  `up` on the target copies
//     `drag.*` into `drop.*`, which the target paints from.
//
// The one rule upstream has that the binding does not is the drag *threshold*,
// so the port computes it. GPUI starts a drag on the first mouse-move whose
// offset from the pending press is more than `DRAG_THRESHOLD` — `const
// DRAG_THRESHOLD: f64 = 2.;` (`gpui-0.2.2/src/elements/div.rs:47`), compared
// with a strict `>` against the offset's magnitude (`:2149-2174`) — so the
// full-window overlay below listens for `move` as well as `up`, and `move_event`
// applies the same test. `tests/gui/mp3_drag_threshold.gos` checks the binding
// and the arithmetic on a real pointer, on every tier.
//
// Deviations:
//
//   * The ghost is an ordinary element of the window's own tree, not GPUI's
//     drag-preview layer. It carries no id and no listeners, so it never takes
//     a hit. GPUI paints its preview as a root element after the frame, and the
//     ghost is the root stack's last child, so the two are painted in the same
//     order: nothing covers either. The difference is the mechanism, not the
//     pixels — `on_drag` wants a `'static` payload and an `Entity<W>` preview,
//     and neither fits the binding's ABI.
//   * GPUI ends a drag on the next mouse-up wherever it lands; the binding
//     only reports `up` on an element that has a listener. A transparent
//     800x600 `on_mouse` overlay sits at the bottom of the window to hear a
//     release over empty space, and 800x600 is the region it covers rather
//     than a size the binding forces on it: the element `on_mouse` is handed
//     *is* the box that listens (`Kind::Mouse` folds the element into the
//     wrapper that carries the handler), so any size a style can name would
//     do, `size=full` included. The content column is positioned `absolute`
//     so that overlay is the stack's only in-flow child, and a release outside
//     the overlay after a window resize is the one release still not seen.
//   * The ghost follows the pointer because a drag in flight asks for another
//     frame each time round (`gpui::animate()`), where GPUI's own drag
//     machinery redraws for its own reasons. The same pixels, one extra
//     frame-loop iteration.
//   * `cx.listener(..)` — a handler bound to the entity — has no equivalent
//     here. Handlers are plain functions over the shared state store, which is
//     how every port in this repo reaches across a frame.

use gpui
use std::math
use std::process
use ui

/// Upstream's `[gpui::blue(), gpui::red(), gpui::green()]`.
fn name_of(ix: i64) -> String {
    let names = ["blue", "red", "green"]
    let name = names[ix]
    f"{name}"
}

/// The same three colours at 50% — `self.color.opacity(0.5)` on the target's
/// fill and the ghost. The style language takes the alpha in the hex, and
/// `gpui::green()` is `#008000` rather than the CSS `#00ff00`.
fn fill_of(ix: i64) -> String {
    let fills = ["#0000ff80", "#ff000080", "#00800080"]
    let fill = fills[ix]
    f"{fill}"
}

/// … and at 20%, which is the hover on an item.
fn hover_of(ix: i64) -> String {
    let hovers = ["#0000ff33", "#ff000033", "#00800033"]
    let hover = hovers[ix]
    f"{hover}"
}

/// GPUI's own number, from the crate: `const DRAG_THRESHOLD: f64 = 2.;`
/// (`gpui-0.2.2/src/elements/div.rs:47`). Upstream never names it; the port has
/// to, because nothing in the binding applies it.
const DRAG_THRESHOLD: f64 = 2.0

/// A press on a square, held pending. Upstream's `pending_mouse_down`: the
/// press that may or may not become a drag, and the point it landed on, in
/// **window** coordinates — the frame gpui's own listeners measure in.
fn arm_press(ix: i64, x: f64, y: f64) {
    gpui::set_int("press.ix", ix)
    gpui::set_float("press.x", x)
    gpui::set_float("press.y", y)
}

/// Upstream's `DragInfo`: which square is being dragged, and its colour. The
/// position is not carried — the ghost reads the pointer each frame instead.
fn begin_drag(ix: i64) {
    gpui::set_int("drag.ix", ix)
    gpui::set_text("drag.name", name_of(ix))
    gpui::set_text("drag.fill", fill_of(ix))
}

/// A release anywhere other than the target drops the payload, as GPUI does.
fn cancel_drag() {
    gpui::set_int("drag.ix", -1)
}

/// `on_drop`: the payload lands on the target, which paints from `drop.*`.
fn commit_drop() {
    let ix = gpui::state_int("drag.ix", -1)
    if ix >= 0 {
        gpui::set_int("drop.ix", ix)
        gpui::set_text("drop.name", name_of(ix))
        gpui::set_text("drop.fill", fill_of(ix))
        // Which frame the drop landed in. The overlay behind the target hears
        // this same release — GPUI's `hitbox.is_hovered` counts every hitbox
        // under the pointer, not just the front one — and it would clear the
        // payload the drop has just read. The stamp lets it tell a release it
        // has already seen from a live one, whatever order the two handlers
        // are dispatched in.
        gpui::set_int("drop.frame", gpui::frame())
    }
    cancel_drag()
}

/// `up` on the full-window overlay: a release over empty space ends the drag.
fn end_drag_over_background() {
    if gpui::state_int("drop.frame", -1) == gpui::frame() {
        return
    }
    cancel_drag()
}

/// `move` on the full-window overlay: the first move that takes the pointer
/// more than `DRAG_THRESHOLD` from the press starts the drag, which is where
/// GPUI starts it.
///
/// The overlay is the window, and the default `HitboxBehavior` is `Normal`, so
/// it is hovered wherever the pointer is and hears every move of a drag — of
/// this drag or any other. What bounds the span is the binding's own gate,
/// `event.dragging()`, which is "the left button is held" (`interactive.rs:356`);
/// a move with no button down never reaches here at all.
fn move_event(x: f64, y: f64) {
    let ix = gpui::state_int("press.ix", -1)
    if ix < 0 || dragging() {
        return
    }
    let dx = x - gpui::state_float("press.x", 0.0)
    let dy = y - gpui::state_float("press.y", 0.0)
    if math::sqrt(dx * dx + dy * dy) > DRAG_THRESHOLD {
        gpui::set_int("press.ix", -1)
        begin_drag(ix)
    }
}

/// One draggable square: upstream's `div().id(("item", ix)).size_32()`, with
/// `on_drag(..)` replaced by `on_mouse`.
fn item(ix: i64) -> ui::El {
    let name = name_of(ix)
    let hover = hover_of(ix)
    ui::panel(f"w=128 h=128 flex justify=center items=center border=2 bordercolor={name} color={name} cursor=move hover=bg:{hover}")
        .text(f"Item ({ix})", "")
        .on_mouse("down up", f"item{ix}")
}

/// Upstream's `#drop-target`: a 3px black border until something is dropped on
/// it, then the dropped item's colour and a 50%-opaque fill. `drop.name` is
/// unset until then, so its `"black"` default is upstream's `gpui::black()`.
fn drop_target() -> ui::El {
    let name = gpui::state_text("drop.name", "black")
    let fill = gpui::state_text("drop.fill", "")
    let style = if gpui::state_int("drop.ix", -1) >= 0 {
        f"w=512 h=128 flex justify=center items=center border=3 bordercolor={name} bg={fill}"
    } else {
        f"w=512 h=128 flex justify=center items=center border=3 bordercolor={name}"
    }
    ui::panel(style).text("Drop items here", "").on_mouse("up", "drop")
}

/// Is a square being dragged? The ghost and the frame loop both key off this.
fn dragging() -> bool {
    gpui::state_int("drag.ix", -1) >= 0
}

/// Upstream's drag preview: 120x50, the item's colour at 50%, white `text_xs`
/// and `shadow_md`, centred on the pointer. It stays in the tree while nothing
/// is dragged — `hidden` keeps it out of the paint, and being `absolute` it
/// takes no layout either way.
fn ghost() -> ui::El {
    let ix = gpui::state_int("drag.ix", -1)
    let fill = gpui::state_text("drag.fill", "#00000080")
    let mx, my = gpui::mouse_position()
    let visibility = if dragging() { "" } else { "hidden" }
    ui::panel(f"absolute top={my - 25.0} left={mx - 60.0} w=120 h=50 flex justify=center items=center bg={fill} color=white font=xs shadow=md {visibility}")
        .text(f"Item {ix}", "")
}

/// Upstream's listeners, over the shared state store. `x` and `y` are the point
/// the event carried, in **window** coordinates, taken off it by the frame's own
/// closure — see the note at the drain in `main`.
fn handle_event(id: String, kind: String, x: f64, y: f64) {
    if id == "drop" {
        commit_drop()
    } else if id == "drag-end" {
        if kind == "move" {
            move_event(x, y)
        } else {
            end_drag_over_background()
        }
    } else if id == "item0" {
        item_event(0, kind, x, y)
    } else if id == "item1" {
        item_event(1, kind, x, y)
    } else if id == "item2" {
        item_event(2, kind, x, y)
    }
}

/// `down` on a square **arms** the drag and does not start it; `up` back on a
/// square ends one without a drop, which is what GPUI does when the release is
/// not over a drop target. Start is `move_event`'s, once the pointer has moved
/// past the threshold — upstream's `on_drag` is not called on the press either.
fn item_event(ix: i64, kind: String, x: f64, y: f64) {
    if kind == "down" {
        arm_press(ix, x, y)
    } else if kind == "up" {
        gpui::set_int("press.ix", -1)
        cancel_drag()
    }
}

fn main() {
    let outcome = gpui::run("", 800.0, 600.0, || {
        for event in gpui::take_events() {
            let id, kind = gpui::event_parts(event.clone())
            let x, y = gpui::pointer_xy(event.clone())
            handle_event(id, kind, x, y)
        }

        // Upstream gets a frame for every pointer move from GPUI's drag
        // machinery. Here the ghost has to be put where the pointer is, and a
        // drag that leaves the square stops raising `move` events, so a drag in
        // flight asks for a frame each time round — and stops when it ends.
        if dragging() {
            gpui::animate()
        }

        ui::stack("size=full bg=white")
            // The release listener for empty space, and the move listener the
            // drag threshold is computed from. It is the stack's first child, so
            // it paints under everything and every real target has its hitbox in
            // front of it — a hitbox that is *not* in the way, since only an
            // occluding one would block it.
            .child(ui::rect("w=800 h=600").on_mouse("up move", "drag-end"))
            // Upstream's root column, `absolute` so the overlay is the stack's
            // only in-flow child. The four insets rather than `size=full`: an
            // absolute box that fills its containing block needs no percentage
            // against the stack to resolve.
            .child(ui::column("absolute top=0 left=0 right=0 bottom=0 gap=20 justify=center items=center color=#333333")
                .text("Drop & Drop", "font=xl align=center")
                .child(ui::row("w=full mb=40 gap=16 justify=center items=center")
                    .children(#[0, 1, 2].map(item)))
                .child(drop_target()))
            .child(ghost())
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
