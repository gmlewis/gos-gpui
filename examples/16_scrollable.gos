// 16 - scrollable        upstream: tools/upstream/examples/scrollable.rs
//
// Two-way scrolling in a nested layout: a 5000px-tall box that scrolls
// vertically inside a scroll container, holding a 2000px-wide box that scrolls
// horizontally, with a hover effect on the inner one.
//
// `overflow=scroll` is GPUI's `overflow_scroll()` (either axis) and
// `overflow=x` is `overflow_x_scroll()`. This is the example to run if
// scrolling in the binding looks wrong — the two axes are independent here.

use gpui
use std::process
use ui

fn main() {
    let outcome = gpui::run("", 500.0, 500.0, || {
        ui::panel("size=full p=16 overflow=scroll bg=white")
            .text("Example for test 2 way scroll in nested layout", "")
            .child(ui::panel("h=5000 border=1 bordercolor=blue bg=#0000ff0d p=16")
                .child(ui::panel("mb=20 w_full overflow=x")
                    .child(ui::panel("w=2000 h=150 bg=#0080001a hover=bg:#00800033 border=1 bordercolor=green p=16")
                        .text("Scroll Horizontal", "")))
                .text("Scroll Vertical", ""))
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
