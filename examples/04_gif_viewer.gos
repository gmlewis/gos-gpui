// 04 - gif_viewer        upstream: tools/upstream/examples/gif_viewer.rs
//
// An animated GIF filling the window: a `size_full` box around an `img(..)`
// that is itself `size_full` with `object_fit(Contain)` — which is GPUI's
// default object fit, so the binding's plain `ui::image` is the same element.
//
// The id is worth a line before the list, because it is the whole of this
// example's behaviour. GPUI keeps an image's animation cursor (`ImgState`) in a
// map keyed by its element id, so an untagged image never advances a frame —
// which is why upstream tags this one `.id("gif")`. `ui::image` takes a style
// string and `id=<name>` is a style token (`style::named`), so the port writes
// `id=gif`: the same element id upstream asks for, spelled in the port's own
// grammar.
//
// Deviations, all on the binding's side:
//   * the asset is named by filesystem path (`examples/assets/…`) instead of
//     going through upstream's `AssetSource`; `ui::image` reads the file
//     directly, and GPUI's own loader does the decoding. Invisible: the same
//     bytes are decoded by the same loader.
//   * the two captures are of a running animation, so they are of different
//     frames of it. Both sides animate; a still photograph cannot tell which
//     frame it caught. Measured, and the numbers are worth having here: **this
//     GIF's frames differ from one another in nearly every pixel** — frame 0
//     against anything else is ~249,000 of its 250,000 — so two stills of it
//     differ over the whole window, which is why this pair reports ~1.32M. But
//     **upstream against itself reports 1,311,890** and upstream against the
//     port reports 1,317,480: the pair is at the animation's own noise floor,
//     and the port is as close to upstream as upstream is to itself. There is no
//     pair of stills that could agree, on either side, so this is not a
//     difference the port could remove. Invisible, and the same class as
//     `08_image_loading`'s pulse.

use gpui
use std::process
use ui

const GIF: &str = "examples/assets/black-cat-typing.gif"

fn main() {
    let outcome = gpui::run("", 1536.0, 864.0, || {
        ui::panel("size=full")
            .image(*GIF, "id=gif size=full")
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
