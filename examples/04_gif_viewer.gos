// 04 - gif_viewer        upstream: tools/upstream/examples/gif_viewer.rs
//
// An animated GIF filling the window: a `size_full` box around an `img(..)`
// that is itself `size_full` with `object_fit(Contain)` — which is GPUI's
// default object fit, so the binding's plain `ui::image` is the same element.
//
// Deviations, all on the binding's side:
//   * the asset is named by filesystem path (`examples/assets/…`) instead of
//     going through upstream's `AssetSource`; `ui::image` reads the file
//     directly, and GPUI's own loader does the decoding.
//   * upstream tags the image `.id("gif")`. `ui::image(path, style)` takes no
//     id, and the one the binding invents for it is not stable: `Arena::reset`
//     trims the element list each frame but leaves its `next_id` counter
//     running, so this image is `gpui-auto-2` on one frame and `gpui-auto-4` on
//     the next. GPUI keeps an image's animation cursor (`ImgState`) in a map
//     keyed by that element id, so the cursor is thrown away and rebuilt every
//     frame and the picture holds frame 0. It repaints continuously — the
//     element *having* an id is what makes GPUI request animation frames — but
//     it does not advance the way upstream's does. An id parameter on
//     `ui::image`, or rewinding `next_id` together with `els` in
//     `Arena::reset`, is what this needs; nothing in Gossamer can supply the id.

use gpui
use std::process
use ui

const GIF: &str = "examples/assets/black-cat-typing.gif"

fn main() {
    let outcome = gpui::run("", 1536.0, 864.0, || {
        ui::panel("size=full")
            .image(GIF, "size=full")
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
