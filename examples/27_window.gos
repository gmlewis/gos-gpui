// 27 - window        upstream: tools/upstream/examples/window.rs (269 lines)
//
// The window-option sampler. Upstream's `WindowDemo` is a wrapping, centred
// panel of eleven buttons; each one opens a 300x300 window with a different
// `WindowOptions`, and every sub-window carries upstream's `SubWindow` view —
// a "Close" button that removes the window — with the Custom Titlebar one
// drawing its own blue 32px bar over a client-side titlebar.
//
// Faithful buttons — same window option, same sub-window view as upstream:
//
//   Normal           default window options
//   Popup            kind=popup     (upstream's `WindowKind::PopUp`)
//   Custom Titlebar  titlebar=none, and the view draws the blue 32px bar
//   Invisible        show=false
//   Unmovable        movable=false titlebar=none
//   Unresizable      resizable=false
//   Unminimizable    minimizable=false
//   Resize           swaps this window's width and height, from the live
//                    bounds, exactly as upstream's `window.resize(..)` does
//
// Upstream's sub-window "Close" button is `window.remove_window()`, which is
// `gpui::close_window()` here.
//
// Emulated — `window.prompt(..)` is not exposed:
//
//   Prompt, Prompt (non-English)
//   An ordinary in-window dialog stands in for the native modal: a dimmed
//   overlay with an "Are you sure?" panel and Ok / Cancel (确定 / 取消 — the
//   labels are upstream's `&["Ok", "Cancel"]` and
//   `PromptButton::ok("确定") / cancel("取消")`). It prints upstream's exact
//   lines to stdout. It is NOT a modal: the window behind it stays
//   interactive and no platform dialog appears. The dialog says so on screen.
//
// The Hide button is upstream's, and it is a real button:
//
//   Hide Application
//   `gpui::hide()` is upstream's `cx.hide()` — the platform's own Hide, every
//   window of the application put away until the dock brings them back. What is
//   NOT ported is the second half of upstream's handler: a `window.spawn` task
//   sleeps three seconds and then calls `cx.activate(false)` to bring the
//   application forward again, and `cx.activate` is exposed nowhere in the
//   binding. So this port hides and stays hidden. `gpui::delay` could time a
//   restore; there is no restore to time it to.
//
//   This was a dashed, greyed placeholder reading "Hide Application
//   (unavailable)" until the pair's captures were compared: it was the ONLY
//   region of this example's window that differed from upstream's, 11,467
//   pixels of it, and the button it stood in for had been reachable from the
//   binding all along.
//
// Also absent, and therefore not ported:
//
//   * `cx.observe_window_bounds(..)`. Upstream's `main` prints
//     "Window bounds changed: .." on every move and resize. Nothing is
//     printed here; `gpui::window_field(..)` reads the rectangle only at the
//     start of a frame.
//   * `cx.bind_keys` / `cx.on_action` / `actions!(window, [Quit])`. The
//     binding owns its key bindings and already binds the desktop quit
//     shortcut (⌘Q on macOS, Ctrl+Q elsewhere), so upstream's own ⌘Q wiring
//     has no counterpart — and none is needed.
//
// Deviations that are this port's rather than the binding's:
//
//   * `open_window` requires a title; upstream's sub-windows set none, so "" is
//     passed — the same empty bar: GPUI titles only a `Some` (mac/window.rs:740).
//   * `titlebar=none` is the binding's spelling of gpui's own `titlebar: None`,
//     which is what upstream passes: a full-size content view with no bar at
//     all and **no traffic lights**, so the blue 32px bar this view draws is
//     the only one the window has, exactly as in upstream's window. It used to
//     mean a transparent titlebar with the lights moved to (12,12), which is
//     the window `25_window_positioning` was measured against. Measured, the two
//     Custom Titlebar windows — upstream's example and this port's — are **0
//     differing pixels** over the whole 298x298 frame. On Linux the same request
//     sets client decorations, which no tier of this project photographs.
//   * `Rect` and `DisplayInfo` are declared below. The binding returns
//     geometry as five scalars rather than a struct: it matches the reader's
//     fields by a matching struct *name* declared in the program, so a port
//     that reads `.x` / `.w` has to declare the shape (and its field order)
//     itself.
//   * Events are process-wide and drained by whichever window repaints. A
//     click is notified only to the window it happened in, so this port gives
//     each sub-window its own close event id and each window handles only its
//     own; the API does not itself scope an event to a window.
//   * An Invisible sub-window is still an open window, so closing every
//     visible window leaves the program running. Measured on both binaries:
//     with it open, closing the main window leaves upstream's example and this
//     port both running, so the pair agrees there; without it, this port ends
//     the app when the last window closes and upstream's runs on with nothing
//     on screen at all. That last is real and is not a pixel in any window.
//     ⌘Q / Ctrl+Q ends it either way.
//   * `ui::button` supplies its own `flex items=center justify=center
//     cursor=pointer`; upstream's hand-built button sets none of the three, and
//     what it leaves behind is a div, whose `justify_content` is `flex-start`.
//     `button` above hands `justify=start` back, so the label sits where
//     upstream's does — see its doc. It is not a hypothetical: before that, the
//     sub-window's Close label was 584 differing pixels from upstream's, and the
//     main panel's buttons were 0 either way, because their boxes hug the text.
//     The rest of the button chrome is upstream's.

use gpui
use std::process
use ui

/// Upstream's `button(text, on_click)`. A frame's clicks arrive as events here,
/// so the id is how a click reaches the program; the style is upstream's
/// `flex_none px_2 bg(rgb(0xf7f7f7)) active(opacity 0.85) border_1
/// border_color(rgb(0xe0e0e0)) rounded_sm cursor_pointer` — `px_2` is 8px.
///
/// `justify=start` is not upstream's — upstream writes no justification at all,
/// and a div's own `justify_content` is `flex-start`. `ui::button` supplies
/// `justify=center` for the buttons this port draws elsewhere, and it is passed
/// back to `start` here so that this button is upstream's rather than `ui::button`'s.
/// It shows wherever the button is wider than its label: in the main panel the box
/// hugs the text and the two are the same pixels, and in a sub-window, where
/// upstream's `p_8` panel stretches the button across the window, it is the
/// difference between the label at the left edge and the label in the middle.
fn button(id: String, label: String) -> ui::El {
    ui::button(id, label, "flex=none justify=start px=8 bg=#f7f7f7 active=opacity:0.85 border=1 bordercolor=#e0e0e0 rounded=sm cursor=pointer")
}

/// Upstream's custom titlebar: `flex h(px(32.)) px_4 bg(blue) text_color(white)
/// w_full`, with "Custom Titlebar" centred inside it.
fn custom_title_bar() -> ui::El {
    ui::panel("flex h=32 px=16 bg=blue color=white w=full")
        .child(ui::panel("flex items=center justify=center size=full")
            .text("Custom Titlebar", ""))
}

/// Upstream's `SubWindow` view. `custom_titlebar` is upstream's
/// `SubWindow { custom_titlebar }`, and `close_id` is the id of this
/// sub-window's own Close event — one per window, since events are global.
fn sub_view(close_id: String, custom_titlebar: bool) -> ui::El {
    // Upstream's `button("Close", |window, _| window.remove_window())`, and
    // the only event a sub-window has.
    for event in gpui::take_events() {
        let id, _data = gpui::event_parts(event)
        if id == close_id {
            gpui::close_window()
        }
    }

    let mut window = ui::column("gap=8 bg=#ffffff size=full")
    if custom_titlebar {
        window = window.child(custom_title_bar())
    }

    // Upstream's `div().p_8().gap_2()` — 32px of padding, 8px between the
    // label and the button.
    window.child(ui::panel("p=32 gap=8")
        .text("SubWindow", "")
        .child(button(close_id, "Close")))
}

/// A sub-window's view.
///
/// It is the one view `gpui::run` was given, running for a window that is not the
/// host — the host is 1 and each sub-window opened here is another id. What it
/// draws comes from the description `open_sub` wrote under this window's own id,
/// before the window existed, so it is already there on the first frame.
fn sub_window_view() {
    let close_id = gpui::state_text("sub.close_id", "")
    let custom_titlebar = gpui::state_bool("sub.custom_titlebar", false)
    sub_view(close_id, custom_titlebar) |> ui::root
}

/// Open one sub-window. `options` is the binding's vocabulary for the
/// `WindowOptions` upstream builds, and `custom_titlebar` is upstream's
/// `SubWindow` flag.
///
/// What the window will draw is not a callback. `open_window` used to take the
/// window's own view; a callback handed to a binding function is valid only for
/// the call that received it, and `open_window` returns before the window is ever
/// drawn, so on the compiled tiers every sub-window's view answered an error and
/// drew nothing. Instead the description goes into the window's own state, under
/// the id it is about to be given — `window::allocate` hands out ids in the order
/// windows are opened, and the host took 1, so the n-th sub-window is id `n + 1`.
fn open_sub(title: String, options: String, custom_titlebar: bool) {
    let sequence = gpui::state_int("sub_window", 0) + 1
    gpui::set_int("sub_window", sequence)
    let close_id = f"sub{sequence}.close"

    let child = sequence + 1
    gpui::set_text_in(child, "sub.close_id", close_id)
    gpui::set_bool_in(child, "sub.custom_titlebar", custom_titlebar)

    // Upstream's `Bounds::centered(None, size(px(300.), px(300.)), cx)` is what
    // `place=center` asks the binding for, and `None` is the primary display,
    // which is what leaving `display=` out means. x and y are ignored while it
    // is set, so they are passed as 0.
    gpui::open_window(title, 0.0, 0.0, 300.0, 300.0, f"{options} place=center")
}

/// Upstream's `WindowDemo`: `p_4 flex flex_wrap bg(white) size_full
/// justify_center content_center gap_2`, with its buttons in upstream's order.
fn demo_panel() -> ui::El {
    ui::panel("p=16 flex wrap bg=#ffffff size=full justify=center content=center gap=8")
        .child(button("normal", "Normal"))
        .child(button("popup", "Popup"))
        .child(button("custom_titlebar", "Custom Titlebar"))
        .child(button("invisible", "Invisible"))
        .child(button("unmovable", "Unmovable"))
        .child(button("unresizable", "Unresizable"))
        .child(button("unminimizable", "Unminimizable"))
        .child(button("hide", "Hide Application"))
        .child(button("resize", "Resize"))
        .child(button("prompt", "Prompt"))
        .child(button("prompt_zh", "Prompt (non-English)"))
}

/// The two-button dialog that stands in for `window.prompt(..)`. See the
/// header: the labels are upstream's, the modality is not.
fn prompt_dialog(ok: String, cancel: String) -> ui::El {
    ui::panel("absolute inset=0 flex justify=center items=center bg=#00000040")
        .child(ui::column("gap=12 p=20 bg=#ffffff border=1 bordercolor=#e0e0e0 rounded=md shadow=lg items=center")
            .text("Are you sure?", "")
            .child(ui::row("gap=8")
                .child(button("prompt_ok", ok))
                .child(button("prompt_cancel", cancel)))
            .text("emulated: the binding exposes no window.prompt", "font=xs color=#909090"))
}

/// What a frame does before it builds the tree: drain every button event.
fn handle_events() {
    for event in gpui::take_events() {
        let id, _data = gpui::event_parts(event)
        if id == "normal" {
            open_sub("", "", false)
        } else if id == "popup" {
            open_sub("", "kind=popup", false)
        } else if id == "custom_titlebar" {
            open_sub("", "titlebar=none", true)
        } else if id == "invisible" {
            open_sub("", "show=false", false)
        } else if id == "unmovable" {
            open_sub("", "movable=false titlebar=none", false)
        } else if id == "unresizable" {
            open_sub("", "resizable=false", false)
        } else if id == "unminimizable" {
            open_sub("", "minimizable=false", false)
        } else if id == "hide" {
            // Upstream's `cx.hide()`. Its `window.spawn` task then re-activates
            // the application three seconds later; see the header.
            gpui::hide()
        } else if id == "resize" {
            // Upstream: `let content_size = window.bounds().size;
            // window.resize(size(content_size.height, content_size.width));`
            let live_w = gpui::window_field("w")
            let live_h = gpui::window_field("h")
            gpui::resize_window(live_h, live_w)
        } else if id == "prompt" {
            gpui::set_text("prompt", "en")
        } else if id == "prompt_zh" {
            gpui::set_text("prompt", "zh")
        } else if id == "prompt_ok" {
            println("You have clicked Ok")
            gpui::set_text("prompt", "")
        } else if id == "prompt_cancel" {
            println("You have clicked Cancel")
            gpui::set_text("prompt", "")
        }
    }
}

/// The main window: upstream's panel, with the emulated prompt over it while
/// one is open.
fn window_view() -> ui::El {
    handle_events()

    let mut root = demo_panel()
    if gpui::state_text("prompt", "") == "zh" {
        root = ui::stack("size=full").child(root).child(prompt_dialog("确定", "取消"))
    } else if gpui::state_text("prompt", "") == "en" {
        root = ui::stack("size=full").child(root).child(prompt_dialog("Ok", "Cancel"))
    }
    root
}

fn main() {
    let outcome = gpui::run("", 800.0, 600.0, || {
        // Every window runs this view; the host is 1 and the sub-windows are the
        // rest, told apart by what `open_sub` wrote for them.
        if gpui::window_id() != 1 {
            return sub_window_view()
        }
        window_view() |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
