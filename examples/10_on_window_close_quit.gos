// 10 - on_window_close_quit        upstream: tools/upstream/examples/on_window_close_quit.rs
//
// Upstream opens TWO windows and quits when the last one closes. This binding
// is single-window, so the port exercises the behaviour it can: closing this
// window — by the traffic lights or by `cmd-w` — ends the process. Upstream's
// `cx.on_window_closed` quits when the window list empties, which for one
// window is the window that just went away, so `gpui::quit` on the stroke is
// the same act.
//
// Deviations:
//   * upstream binds `cmd-w` to a program action that removes the focused
//     window, and quits only because that was the last window. The binding
//     raises an event for a bound stroke (`gpui::bind_keys`) and a program
//     action is not a value that can cross this ABI (R3), so the port binds
//     `cmd-w` to an event id and quits on it. Same key, same effect, one step
//     instead of two.
//   * upstream opens two windows of the same example side by side. The binding
//     is single-window, so the port opens one, and it is upstream's **first** —
//     the one built inside `cx.activate(false)` (`:55`) — at the same 500x500 and
//     the same centred origin, with the same content. The second window is the
//     whole of the difference, and on macOS it shows in the title bar: the window
//     that is not the app's main window gets a bar six grey levels dimmer
//     (measured `rgb(31,32,32)` against `rgb(37,36,36)`). That is macOS's to draw
//     and not the example's. Forced.
//
// The title is not in the list: `gpui::run` takes it as its first argument and
// this example has nothing to put in it, so it is empty — as upstream's is, it
// leaving `WindowOptions::default()`.

// `activate=false` was tried here and taken back out. gpui's `cx.activate(false)`
// reaches macOS as `NSApp.activateIgnoringOtherApps_(NO)`
// (`platform/mac/platform.rs:564`), which is deprecated and a no-op on this
// system: upstream's window activates anyway and its traffic lights come up in
// colour when the example is run on its own. The binding's `activate=false`
// suppresses the call altogether and leaves the window genuinely not key, with
// grey lights — a difference the flag *creates* rather than removes. Upstream
// matching means `activate=true`, which is what plain `gpui::run` asks for.

use gpui
use std::process
use ui

/// Upstream's `CloseWindow` action, which calls `window.remove_window()`. The
/// last window going away is what quits upstream; with one window the stroke
/// is the whole of it.
fn handle(events: Vec<String>) {
    for event in events {
        let id, _data = gpui::event_parts(event)
        if id == "closewin" {
            gpui::quit()
        }
    }
}

fn main() {
    // `gpui::run`, not `run_with(.., "activate=false", ..)`: see the note above
    // the `use` lines. Upstream's `cx.activate(false)` does not stop the window
    // becoming key on this system, and neither should this port's.
    let outcome = gpui::run("", 500.0, 500.0, || {
        // The window has to be able to hear the stroke: `bind_keys` puts it in
        // the keymap, and `on_keys` is what gives the window the focus a key
        // event is delivered to. Without it the binding is in the keymap and
        // the window never sees the key.
        gpui::on_keys(true)
        gpui::bind_keys("cmd-w=closewin")
        gpui::take_events() |> handle

        ui::panel("flex col gap=12 bg=#505050 size=500 justify=center items=center shadow=lg border=1 bordercolor=#0000ff font=xl color=#ffffff")
            .text("Closing this window with cmd-w or the traffic lights should quit the application!", "")
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
