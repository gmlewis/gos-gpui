// 18 - shadow        upstream: tools/upstream/examples/shadow.rs (585 lines)
//
// NOT PORTED YET. A large showcase of box shadows: offsets, blur, spread and colour.
//
// Run it to see exactly what the binding is missing. The upstream example is
// the control: build and run
//
//   ./tools/upstream-examples.sh run shadow
//
// and compare the two windows side by side.

use gpui
use std::process
use status
use ui

fn main() {
    let outcome = gpui::run("18 - shadow", 780.0, 640.0, || {
        status::missing(
            "18 - shadow",
            "upstream: examples/shadow.rs (585 lines)",
            #[
            "a custom BoxShadow — offset, blur_radius, spread_radius, colour",
            "(the style language has shadow=xs..2xl presets only)",
            ],
        )
        |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
