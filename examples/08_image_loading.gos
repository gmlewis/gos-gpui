// 08 - image_loading        upstream: tools/upstream/examples/image_loading.rs (213 lines)
//
// Upstream is about the *asset pipeline*, not about pictures. It defines its
// own asset type —
//
//     struct LoadImageWithParameters {}
//     impl Asset for LoadImageWithParameters {
//         type Source = LoadImageParameters { timeout: Duration, fail: bool };
//         ...
//     }
//
// — whose `load` starts a timer, hands the real work to
// `AssetLogger::<ImageAssetLoader>::load(Resource::Path(IMAGE))`, and then
// either awaits that (cells 1 and 2) or, after the timer, returns
// `Err(anyhow!("Failed to load image"))` without ever reading the file (cell 3).
// So cell 1 resolves at 175ms (`LOADING_DELAY - 25ms`), cells 2 and 3 at 5s, and
// cell 4 names a path that does not exist. Each `img` carries
// `.with_loading(|| loading_element())` (a black box pulsating between 4% and 24%
// opacity every 3s) and `.with_fallback(|| fallback_element())` (a grey "?" in a
// 1px box) — **including cell 4** — and each cell's `on_click` calls
// `cx.remove_asset::<..>(..)` to evict the cache entry and force a reload. The
// window is 300x300 with a white 300x300 box holding four 48px cells;
// `size_12()` is `rems(3.)` = 48px (gpui-macros-0.2.2/src/styles.rs) and
// `p_0p5()` is `rems(0.125)` = 2px.
//
// WHAT THE BINDING HAS, as of round 100. `ui::image_request(path, style,
// loading, fallback)` is GPUI's `with_loading` / `with_fallback`: the image
// element keeps the two subtrees as its own, and the binding picks between them
// by reading the *ordinary* image loader's state — the same state `Img` reads —
// on the same `Some(Ok)` / `Some(Err)` / `None` arms and the same
// `LOADING_DELAY` (200ms, gpui-0.2.2 src/elements/img.rs:31, 366-401). That was
// the whole of what the port could not reach before; the row it was blocked on
// is DW7. The bytes still arrive the way they always did: `PathBuf ->
// ImageSource` is `Resource::Path` (src/elements/img.rs:100-104) and
// `ImageAssetLoader` reads it with `fs::read` (src/elements/img.rs:601), so
// upstream's own `Assets` / `AssetSource` impl is not what loads any of its four
// cells either (`AssetSource` is consulted only for `Resource::Embedded`,
// src/elements/img.rs:618). `gpui::image_evict(path)` is `cx.remove_asset`, and
// all four cells click through it.
//
// THE TREE, and it is upstream's token for token: `flex col size=full
// justify=around` over `flex row w=full justify=around` over the white 300px box
// over four `size=48 border=1 bordercolor=red` cells, `justify=center
// items=center`, with nothing added. The window is 300x300, as upstream asks
// (`gpui::run` centres a window the same way). Upstream's `.id("image-1")` ..
// `.id("image-4")` are on the images themselves, so `gpui::image_state` reads
// back which subtree each cell chose. Earlier revisions of this port carried a
// heading, a "the four cells" legend and an "absent, not emulated" panel, because
// there was a list of unreachable capabilities to record; the list is empty now
// and so are the panels.
//
// Deviations — the list is the point of this file, and it has two entries where
// it had seven:
//
//   * **Cells 2 and 3 wait 5s for a source that cannot wait.** A custom `Asset`
//     with a `Duration` in its source is unreachable — `Asset<Source = ..>` and
//     `ImageCacheError` are not expressible, `window.use_asset::<LoadImageWithParameters>`
//     is not exposed, and a closure taking `&mut Window` is not a value the ABI
//     has a shape for (this is AX2, and it stays unreachable). GPUI's own loader
//     answers a filesystem path in about one frame, so an `image_request` on this
//     icon resolves long before `LOADING_DELAY` and its loading subtree is never
//     due — which is exactly right for cell 1 and exactly wrong for cells 2 and
//     3. Those two therefore draw **this port's** loading subtree for the first
//     5s, from a `gpui::task` timer the port starts, and hand the settled cell to
//     the real `ui::image_request` — cell 3's to a path that is not there, whose
//     `Some(Err)` is a real loader failure. The subtrees are the same elements
//     gpui would draw, at the same times, to the same 200ms grace; what differs is
//     who decided, and that is not on screen. **Invisible.**
//   * The pulse's phase. Upstream's `with_animation("loading-bg", ..)` hands its
//     closure a fresh 0..1 delta each 3s cycle; here the same delta comes from
//     `gpui::now()`, which is seconds since this program started, and
//     `pulsating_between(0.04, 0.24)` is reproduced term for term (gpui-0.2.2
//     src/elements/animation.rs:249-261). Both are at phase 0 when the cell first
//     draws, so they breathe together; the sampled alpha can still differ by a
//     frame. **Invisible.**

use gpui
use std::math
use std::process
use ui

/// Upstream's `IMAGE`: the crate's own `examples/image/app-icon.png`. The
/// binding takes a filesystem path, so this is the copy in `examples/assets/`.
///
/// Both paths are passed to the free `ui::image_request` as `*APP_ICON` /
/// `*MISSING`: under gos 0.66.0 a `&str` const is a reference and that call
/// wants the value it names, while the chained `.image(..)` of 04 and 11 takes
/// the const as it stands.
const APP_ICON: &str = "examples/assets/app-icon.png"

/// Upstream's fourth cell, verbatim — the normal loader on a path that is not
/// there. Its `Some(Err)` is what draws cell 4's fallback subtree.
const MISSING: &str = "this/file/really/shouldn't/exist/or/won't/be/an/image/I/hope"

/// `LOADING_DELAY - Duration::from_millis(25)`, with `LOADING_DELAY` = 200ms
/// (gpui-0.2.2 src/elements/img.rs:31): the cell that resolves before the
/// loading subtree is due.
const QUICK_MS: i64 = 175

/// The deliberate 5s of upstream's second and third cells.
const SLOW_MS: i64 = 5000

/// `LOADING_DELAY` in seconds. GPUI shows an `Img`'s loading subtree only once
/// this long has passed since the load started (src/elements/img.rs:373-395),
/// so the 5s cells are blank for their first 200ms. See `since_armed`.
const LOADING_DELAY_S: f64 = 0.2

/// Upstream's `Animation::new(Duration::from_secs(3)).repeat()`.
const PULSE_PERIOD: f64 = 3.0
const PULSE_MIN: f64 = 0.04
const PULSE_MAX: f64 = 0.24
const PI: f64 = 3.141592653589793

// ---- upstream's two subtrees, handed to the element --------------------

/// GPUI's `pulsating_between(0.04, 0.24)`, reproduced exactly
/// (gpui-0.2.2 src/elements/animation.rs:249-261):
///
///     t = sin(delta * 2pi); breath = (t*t*t + t) / 2; alpha = min + ((breath + 1) / 2) * range
///
/// Upstream hands it to `with_animation("loading-bg", ..)`, which feeds it a
/// fresh 0..1 delta every 3s cycle; here the same delta comes from
/// `gpui::now()` and a frame that asks for itself with `gpui::animate()`.
fn pulsating(delta: f64) -> f64 {
    let t = math::sin(delta * 2.0 * PI)
    let breath = (t * t * t + t) / 2.0
    PULSE_MIN + ((breath + 1.0) / 2.0) * (PULSE_MAX - PULSE_MIN)
}

/// Upstream's `loading_element()`: `size_full().flex_none().p_0p5().rounded_xs()`
/// around a `size_full` black box whose opacity is the pulse above.
fn loading(alpha: f64) -> ui::El {
    ui::panel("size=full flex=none p=2 rounded=xs")
        .child(ui::rect(f"size=full bg=black rounded=xs opacity={alpha}"))
}

/// Upstream's `fallback_element()`: `p_0p5()` around a centred, `text_sm`,
/// `rounded_xs` box with a 1px border and a "?", both the colour of
/// `black().opacity(0.5)` = `#00000080`.
fn fallback() -> ui::El {
    ui::panel("size=full flex=none p=2")
        .child(ui::panel("size=full flex items=center justify=center rounded=xs font=sm color=#00000080 border=1 bordercolor=#00000080")
            .text("?", ""))
}

/// Upstream's cell box: `img(..).size_12().border_1().border_color(red())`. It
/// is the **image element's** own style, which is why a settled cell wears it
/// through `image_request` and a staged one wears the same tokens on a plain
/// panel — during staging there is no image element to wear it. The 48px and the
/// border are the picture's box, not a wrapper around it: gpui draws a loading
/// or fallback subtree *inside* the image's bounds
/// (gpui-0.2.2 src/elements/img.rs:366-401), which is what `render_image` does
/// too.
const CELL: &str = "size=48 border=1 bordercolor=red"

/// Upstream's cell: `img(..).size_12().border_1().border_color(red())`.
fn cell(style: String, body: ui::El) -> ui::El {
    ui::panel(f"{CELL} {style}").child(body)
}

// ---- the port's staging, for the two cells that must wait ---------------

/// Start one staged cell's 5s: clear its flag, stamp the frame clock, and ask
/// `gpui::task` for the event that sets the flag again. The timer is the port's
/// own — see the first deviation — and it must only be called once per arrival,
/// since each `gpui::task` spawns a fresh worker.
fn arm(id: String, ms: i64) {
    gpui::set_bool(f"{id}.arrived", false)
    gpui::set_float(f"{id}.armed", gpui::now())
    gpui::task(id, ms)
}

/// How long ago this cell was armed, for the `LOADING_DELAY` grace.
fn since_armed(id: String, now: f64) -> f64 {
    now - gpui::state_float(f"{id}.armed", 0.0)
}

// ---- the four cells -----------------------------------------------------

/// Cell 1 — upstream's `timeout: LOADING_DELAY - 25ms, fail: false`. No staging
/// at all: the binding's own loader answers this file in about a frame, so the
/// real `image_request` is the whole cell, and its loading subtree is never due
/// — which is upstream's point for this cell. The click is upstream's
/// `remove_asset`, so the cell loads again from scratch.
fn quick_cell(alpha: f64) -> ui::El {
    ui::image_request(*APP_ICON, f"id=image-1 {CELL}", Some(loading(alpha)), Some(fallback()))
        .on_mouse("click", "reload.quick")
}

/// Cell 2 — upstream's `timeout: 5s, fail: false`: blank for `LOADING_DELAY`,
/// the loading subtree, then the image. Until the port's timer lands this is the
/// port's loading subtree; from then on it is the real thing.
fn slow_cell(arrived: bool, since: f64, alpha: f64) -> ui::El {
    if arrived {
        return ui::image_request(*APP_ICON, f"id=image-2 {CELL}", Some(loading(alpha)), Some(fallback()))
            .on_mouse("click", "reload.slow")
    }
    let body = if since < LOADING_DELAY_S {
        ui::rect("size=full")
    } else {
        loading(alpha)
    }
    cell("id=image-2", body).on_mouse("click", "reload.slow")
}

/// Cell 3 — upstream's `timeout: 5s, fail: true`: the same delay and loading
/// subtree, then the fallback. The settled half is a real load of a path that is
/// not there, so the fallback is the loader's own `Some(Err)` and not a flag the
/// port set.
fn failing_cell(arrived: bool, since: f64, alpha: f64) -> ui::El {
    if arrived {
        return ui::image_request(*MISSING, f"id=image-3 {CELL}", Some(loading(alpha)), Some(fallback()))
            .on_mouse("click", "reload.fail")
    }
    let body = if since < LOADING_DELAY_S {
        ui::rect("size=full")
    } else {
        loading(alpha)
    }
    cell("id=image-3", body).on_mouse("click", "reload.fail")
}

/// Cell 4 — upstream's path that does not exist. No staging: the loader fails at
/// once, and because upstream installs a fallback here too, the "?" is what it
/// draws. Its click evicts `ImgResourceLoader`'s entry, which is what
/// `gpui::image_evict` is.
fn missing_cell(alpha: f64) -> ui::El {
    ui::image_request(*MISSING, f"id=image-4 {CELL}", Some(loading(alpha)), Some(fallback()))
        .on_mouse("click", "reload.missing")
}

fn main() {
    let outcome = gpui::run("", 300.0, 300.0, || {
        // Upstream asks its asset system for all four images once, as the tree
        // is built. Two of the port's cells stage a 5s arrival instead — cell 1
        // and cell 4 are real loads that answer at once — so the timers start on
        // the first frame, and after that only a click re-arms one.
        if !gpui::state_bool("started", false) {
            gpui::set_bool("started", true)
            arm("slow", SLOW_MS)
            arm("fail", SLOW_MS)
        }

        for event in gpui::take_events() {
            let id, _result = gpui::event_parts(event)
            if id == "reload.quick" {
                gpui::image_evict(*APP_ICON)
            } else if id == "reload.slow" {
                // Only from a settled cell: two workers for one id would race to
                // set one flag.
                if gpui::state_bool("slow.arrived", false) {
                    gpui::image_evict(*APP_ICON)
                    arm("slow", SLOW_MS)
                }
            } else if id == "reload.fail" {
                if gpui::state_bool("fail.arrived", false) {
                    gpui::image_evict(*MISSING)
                    arm("fail", SLOW_MS)
                }
            } else if id == "reload.missing" {
                gpui::image_evict(*MISSING)
            } else if id == "slow" || id == "fail" {
                gpui::set_bool(f"{id}.arrived", true)
            }
        }

        let slow = gpui::state_bool("slow.arrived", false)
        let fail = gpui::state_bool("fail.arrived", false)
        let now = gpui::now()
        let alpha = pulsating((now % PULSE_PERIOD) / PULSE_PERIOD)

        // The pulse needs a frame per step, as upstream's animation driver would
        // ask for while `with_animation(..)` is live — and so does the loading
        // subtree the binding draws, which comes due at `LOADING_DELAY` and not
        // at the load's answer.
        gpui::animate()

        // Upstream's tree, token for token:
        //
        //     div().flex().flex_col().size_full().justify_around().child(
        //         div().flex().flex_row().w_full().justify_around().child(
        //             div().flex().bg(white).size(px(300.))
        //                  .justify_center().items_center()
        //                  .child(cell1)..child(cell4)))
        ui::column("size=full justify=around")
            .child(ui::row("w=full justify=around")
                .child(ui::row("size=300 bg=white justify=center items=center")
                    .child(quick_cell(alpha))
                    .child(slow_cell(slow, since_armed("slow", now), alpha))
                    .child(failing_cell(fail, since_armed("fail", now), alpha))
                    .child(missing_cell(alpha))))
            |> ui::root
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
