// W2 — the state store is scoped per window.
//
// Headless: `gos test tests`. No window is opened, so the current window is 0
// and the `_in` accessors are what address window 1 and window 2 directly.
//
// Pass means two windows can hold different values under the same key and
// neither can see the other's, and that forgetting a key forgets it in one
// window only.

use gpui

#[test]
fn state_is_scoped_to_a_window() {
    gpui::set_int_in(1, "count", 7)
    gpui::set_int_in(2, "count", 9)

    assert(gpui::state_int_in(1, "count", 0) == 7, "window 1 keeps its own count")
    assert(gpui::state_int_in(2, "count", 0) == 9, "window 2 keeps its own count")
    assert(
        gpui::state_int_in(3, "count", -1) == -1,
        "a window that never wrote the key answers the default",
    )
}

#[test]
fn every_type_is_scoped_to_a_window() {
    gpui::set_float_in(1, "ratio", 0.25)
    gpui::set_float_in(2, "ratio", 0.75)
    assert(gpui::state_float_in(1, "ratio", 0.0) == 0.25, "window 1 keeps its float")
    assert(gpui::state_float_in(2, "ratio", 0.0) == 0.75, "window 2 keeps its float")

    gpui::set_bool_in(1, "open", true)
    gpui::set_bool_in(2, "open", false)
    assert(gpui::state_bool_in(1, "open", false), "window 1 keeps its flag")
    assert(!gpui::state_bool_in(2, "open", true), "window 2 keeps its flag")

    gpui::set_text_in(1, "name", "one")
    gpui::set_text_in(2, "name", "two")
    assert(gpui::state_text_in(1, "name", "") == "one", "window 1 keeps its text")
    assert(gpui::state_text_in(2, "name", "") == "two", "window 2 keeps its text")
}

#[test]
fn forgetting_a_key_forgets_it_in_one_window_only() {
    gpui::set_int_in(1, "temp", 11)
    gpui::set_int_in(2, "temp", 22)
    gpui::forget_in(1, "temp")

    assert(gpui::state_int_in(1, "temp", -1) == -1, "window 1 forgot the key")
    assert(gpui::state_int_in(2, "temp", -1) == 22, "window 2 still has it")
}

#[test]
fn outside_a_frame_there_is_no_window() {
    // `gos test` runs no frame, so the current window is 0 — the namespace the
    // plain accessors read and write.
    assert(gpui::window_id() == 0, "a program outside a frame has no window")

    gpui::set_int("plain", 5)
    assert(gpui::state_int("plain", 0) == 5, "the plain accessors use window 0")
    assert(
        gpui::state_int_in(1, "plain", -1) == -1,
        "and window 1 does not see window 0's key",
    )
}
