// BG7 — file I/O and threads from Gossamer, as the escape hatch.
//
// Headless: `gos test tests`. This row is not about the binding at all: it is the
// question of what a program can reach *besides* it, which is what a program needs when
// a capability has no binding function and no Rust widget. `apps.md` recorded it as
// "undetermined" for one reason — the toolchain had never been run for it. It has been
// now, and the two halves came back differently.
//
// Pass means a program can write a file, see that it exists, read it back byte for byte,
// replace it, list what is in a directory it made, and delete it — all of it without a
// window and without the binding.
//
// Threads are the other half, and they are *not* here because they do not compile:
// `thread::spawn` is in `gossamer-std`'s Rust manifest and not in the language's scope.
// That is recorded in `tests/evidence/BG7.unreachable.txt` with the diagnostic, and the
// substitute is `gpui::task`, which is row BG1.

use std::fs
use std::thread

const PATH: &str = "/tmp/gos-bg7-round-trip.txt"
const BYTES: &str = "/tmp/gos-bg7-bytes.bin"
const DIR: &str = "/tmp/gos-bg7-dir"

#[test]
fn a_program_can_write_and_read_a_file() {
    let _ = fs::remove_file(*PATH) // a leftover from an earlier run is not an error

    let written = fs::write(*PATH, "bg7 round trip".as_bytes())
    assert(written.is_ok(), "writing a file under /tmp should succeed")
    assert(fs::exists(*PATH), "the file just written should exist")

    let back = fs::read_to_string(*PATH)
    match back {
        Ok(text) => assert(text == "bg7 round trip", f"read back \"{text}\""),
        Err(_) => assert(false, "reading back what was written should succeed"),
    }
}

#[test]
fn a_program_can_read_bytes_and_replace_a_file() {
    assert(fs::write(*BYTES, "first".as_bytes()).is_ok(), "the first write should succeed")
    let first = fs::read(*BYTES)
    match first {
        Ok(bytes) => assert(bytes.len() == 5, f"\"first\" is five bytes, got {bytes.len()}"),
        Err(_) => assert(false, "reading a file's bytes should succeed"),
    }

    // Opening for write truncates: the second write replaces rather than appends,
    // which is the behaviour a program saving a file depends on.
    assert(fs::write(*BYTES, "second".as_bytes()).is_ok(), "the second write should succeed")
    let second = fs::read_to_string(*BYTES)
    match second {
        Ok(text) => assert(text == "second", f"a second write replaces the first, got \"{text}\""),
        Err(_) => assert(false, "reading the replaced file should succeed"),
    }
}

#[test]
fn a_program_can_make_a_directory_and_delete_a_tree() {
    let _ = fs::remove_dir_all(*DIR)
    let made = fs::create_dir_all(*DIR)
    assert(made.is_ok(), "creating a directory under /tmp should succeed")

    let inner = f"{*DIR}/inner.txt"
    assert(fs::write(inner, "nested".as_bytes()).is_ok(), "writing inside the new directory should succeed")
    let listed = fs::read_dir(*DIR)
    match listed {
        Ok(entries) => assert(entries.len() == 1, f"the directory should hold one file, got {entries.len()}"),
        Err(_) => assert(false, "listing a directory that was just made should succeed"),
    }

    let gone = fs::remove_dir_all(*DIR)
    assert(gone.is_ok(), "deleting the tree should succeed")
    assert(fs::exists(*DIR) == false, "the directory should be gone")
}

#[test]
fn the_machine_reports_how_many_cpus_it_has() {
    let cpus = thread::num_cpus()
    assert(cpus >= 1, f"a machine has at least one cpu, this one says {cpus}")
}
