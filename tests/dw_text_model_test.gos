// DW1 / DW4 / DW5 — the text arithmetic three rows share: lines, carets and words.
//
// Headless: `gos test tests`. Three rows need this and none of them can be finished here:
//
//   * **DW1** ("multi-line, per-line layout, caret up/down/home/end, page moves") — the caret moves
//     are arithmetic over a string; the per-line layout is the text system, which lives on a window.
//   * **DW4** ("mouse selection, double-click word, triple-click line, drag autoscroll") — the word
//     and line a click selects are arithmetic; the click itself, and the measurement that turns a
//     point into an offset, need a window.
//   * **DW5** ("gutter and line numbers, wrap toggle, selection and caret colours") — a gutter is the
//     line count and the line an offset is on; the gutter is *drawn*, which needs a window.
//
// So this is the shared floor those three stand on, and it is worth having on its own: a Gossamer
// program keeps its text in the store — the store *is* the document — and the arithmetic here is
// what answers where a line begins, what word is under an offset, and where the caret lands one
// line down. What it cannot do either way is paint, and that half stays in the rows' doubt.
//
// **Offsets are UTF-8 byte offsets**, the same as `gpui::styled_text`'s highlight ranges — and every
// answer is snapped to a character boundary, so an offset in the middle of a multi-byte character
// gets a whole one rather than a broken one. Offsets past the end of the text are clamped, not
// refused: a caret that has run off the end belongs at the end.
//
// Pass means: a text with no break is one line, bounds exclude the break, the caret keeps its column
// across lines and stops at the ends, a word is a run of letters, digits and underscores, and
// nothing in it splits a character.

use gpui

#[test]
fn lines_are_counted_and_located() {
    let text = "ab\ncd\nef"
    assert(gpui::text_lines(text) == 3, f"three lines: {gpui::text_lines(text)}")
    assert(gpui::text_line(text, 0) == 0, "the first byte is on line 0")
    assert(gpui::text_line(text, 3) == 1, "after the first break is line 1")
    assert(gpui::text_line(text, 6) == 2, "and after the second, line 2")
    assert(gpui::text_line(text, 99) == 2, "past the end is the last line, not an error")
}

#[test]
fn a_text_with_no_break_is_one_line() {
    assert(gpui::text_lines("hello") == 1, "no break, one line")
    assert(gpui::text_lines("") == 1, "and an empty text is one empty line")
    assert(gpui::text_line_bounds("hello", 2) == "0,5", f"{gpui::text_line_bounds("hello", 2)}")
}

#[test]
fn line_bounds_exclude_the_break() {
    let text = "ab\ncd"
    assert(gpui::text_line_bounds(text, 0) == "0,2", "the first line stops before the break")
    assert(gpui::text_line_bounds(text, 4) == "3,5", "and the second starts after it")
    assert(
        gpui::text_line_bounds("ab\n", 3) == "3,3",
        "a text ending in a break has an empty last line",
    )
}

#[test]
fn the_caret_keeps_its_column_across_lines() {
    let text = "abc\ndefg\nhi"
    // Line 0 is bytes 0..3, line 1 is 4..8, line 2 is 9..11.
    assert(
        gpui::text_line_move(text, 1, 1, 1) == 5,
        f"one line down, one byte in: {gpui::text_line_move(text, 1, 1, 1)}",
    )
    assert(
        gpui::text_line_move(text, 1, 1, 20) == 8,
        f"a column past the end of the target line stops at its end, not in the line after it: {gpui::text_line_move(text, 1, 1, 20)}",
    )
    assert(
        gpui::text_line_move(text, 1, 2, 20) == 11,
        f"and down two, aiming past a line too short for that column, lands at its end: {gpui::text_line_move(text, 1, 2, 20)}",
    )
    assert(
        gpui::text_line_move(text, 11, -1, 1) == 5,
        "up one line aims at the same column again",
    )
    assert(gpui::text_line_move(text, 5, -1, 1) == 1, "and up again")
}

#[test]
fn caret_moves_stop_at_the_ends() {
    let text = "abc\ndef"
    assert(gpui::text_line_move(text, 0, -1, 0) == 0, "up from the first line stays on it")
    assert(
        gpui::text_line_move(text, 7, 1, 3) == 7,
        f"down from the last line, asking for the byte it is already at, stays there: {gpui::text_line_move(text, 7, 1, 3)}",
    )
    assert(
        gpui::text_line(text, gpui::text_line_move(text, 0, 9, 0)) == 1,
        "and a page move further than the text is the last line, wherever in it the column lands",
    )
}

#[test]
fn the_word_at_an_offset_is_a_run_of_letters_digits_and_underscores() {
    let text = "hello, world"
    assert(gpui::text_word(text, 1) == "0,5", f"inside a word: {gpui::text_word(text, 1)}")
    assert(gpui::text_word(text, 0) == "0,5", "at its first byte")
    assert(gpui::text_word(text, 4) == "0,5", "and at its last")
    assert(
        gpui::text_word(text, 5) == "5,6",
        f"the comma is a run of its own, which is what a double-click there should take: {gpui::text_word(text, 5)}",
    )
    assert(gpui::text_word(text, 7) == "7,12", "and the next word")
    assert(gpui::text_word(text, 99) == "12,12", "past the end is an empty word at the end")
    assert(gpui::text_word("", 0) == "0,0", "and so is an empty text")
}

#[test]
fn nothing_here_splits_a_character() {
    // "héllo" is six bytes: h, é (two), l, l, o.
    let text = "héllo wörld"
    assert(
        gpui::text_word(text, 1) == "0,6",
        f"a word with a multi-byte character in it: {gpui::text_word(text, 1)}",
    )
    assert(
        gpui::text_word(text, 2) == "0,6",
        f"an offset inside a character is snapped to a boundary, not split: {gpui::text_word(text, 2)}",
    )
    assert(
        gpui::text_line_bounds("é\nx", 0) == "0,2",
        f"and a line is measured in bytes without breaking one: {gpui::text_line_bounds("é\nx", 0)}",
    )
}
