// SCRATCH — the styles 02_data_table's rows use, checked headlessly.
//
// The example is silent when it runs, but an unknown style token is drawn as an **on-screen banner**, not
// printed — so silence would never catch one, and a cell whose `w=` or `truncate` went unparsed would render
// as an empty box. This asks the checker directly, with the exact strings the example builds.
use gpui

#[test]
fn the_data_tables_styles_are_all_known() {
    let styles = #[
        "borderb=1 bordercolor=#e0e0e0 bg=#0000001a py=2 px=8",
        "ws=nowrap truncate px=4 w=64 color=green",
        "ws=nowrap truncate px=4 w=180",
        "ws=nowrap shrink=0 truncate px=4 w=64",
        "bg=#ffffff font=sm size=full p=16 gap=8",
        "flex=1 overflow=hidden border=1 bordercolor=#e0e0e0 rounded=sm",
        "size=full",
        "w_full overflow=hidden borderb=1 bordercolor=#e0e0e0 color=#555555 bg=#f0f0f0 py=4 px=8 font=xs",
    ]
    for style in styles {
        let unknown = gpui::unknown_style_tokens(style)
        assert(
            unknown.len() == 0,
            f"this style the data table uses has tokens outside the vocabulary: {unknown} — in [{style}]",
        )
    }
}
