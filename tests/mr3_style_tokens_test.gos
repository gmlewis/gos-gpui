// MR3 — style-token completeness: per-corner radii, resize cursors, the focus-order
// tokens, and the `focus=` refinement.
//
// Headless: `gos test tests`. What a style token *means* is a parse, and the parse is the
// part a program can be wrong about; what it looks like when it is applied is a pixel
// question this machine cannot capture (see "Pixel verification is unavailable on this
// machine").
//
// The register lists MR3 as "partly", so the first two tests are the premise: they say
// which of its named tokens already exist. The third is the increment, and its first
// assertion calls nothing new — `unknown_style_tokens` already exists — so a red
// here is a wrong answer rather than an unresolved name.

use gpui

#[test]
fn the_focus_order_tokens_are_known() {
    let unknown = gpui::unknown_style_tokens("tabindex=0 tabstop focusable")
    assert(unknown.len() == 0, f"tabindex=, tabstop and focusable are style tokens: {unknown.len()} were refused")
}

#[test]
fn per_corner_radii_and_resize_cursors_are_known() {
    let corners = gpui::unknown_style_tokens("roundedtl=4 roundedtr=4 roundedbl=4 roundedbr=4")
    assert(corners.len() == 0, f"the four corner radii are style tokens: {corners.len()} were refused")
    let cursors = gpui::unknown_style_tokens("cursor=col-resize cursor=row-resize cursor=ew-resize cursor=ns-resize")
    assert(cursors.len() == 0, f"the four resize cursors are style tokens: {cursors.len()} were refused")
}

#[test]
fn focus_is_a_refinement_beside_hover_and_active() {
    let unknown = gpui::unknown_style_tokens("focus=bg:#ff0000")
    assert(unknown.len() == 0, "focus= is a refinement token, the third beside hover= and active=")

    let kinds = gpui::style_refinements("hover=bg:#111111 active=bg:#222222 focus=bg:#ff0000")
    assert(kinds == "hover,active,focus", f"the three refinements, in a fixed order: {kinds}")

    assert(gpui::style_refinements("bg=#111111") == "", "a style with no refinement says so")
    assert(gpui::unknown_style_tokens("focussed=bg:#ff0000").len() == 1, "and a misspelt one is refused")
}

#[test]
fn flex_reverse_and_decoration_tokens_are_known() {
    let unknown = gpui::unknown_style_tokens("col-reverse row-reverse wrap-reverse not-italic no-underline")
    assert(unknown.len() == 0, f"reverse and decoration tokens are known: {unknown.len()} were refused")
}
