// KM3 — menu accelerators bound to items.
//
// Tier: every tier.
//
// A menu item has always been able to *say* what it does, and never what key does
// it: the binding's `"events:<label>"` entry carried a name and nothing else, so
// every menu action in every program was keyboard-less.
//
// Upstream gets this from the keymap rather than from the item. `MenuItem::Action`
// has no accelerator field at all — the platform calls
// `Platform::set_menus(menus, keymap)` and the macOS menu looks the item's own
// action up in the keymap, then sets the `NSMenuItem`'s key equivalent and its
// modifier mask from whatever binding it finds
// (`gpui-0.2.2/src/platform/mac/platform.rs:355-392`). So an accelerator *is* a key
// binding; the item is what declares it.
//
// Pass means a menu entry can name a keystroke, that keystroke fires the entry's
// own slot, and the declaration reads back. The stroke is produced with
// `gpui::send_key`, so the whole path is exercised: key → keymap match → slot
// action → `"menu|<slot>"`.
//
// What is *not* checked here is the drawing of the accelerator beside the label:
// that is the native menu bar, and this machine cannot capture it (see "Pixel
// verification is unavailable on this machine"). The mechanism it rides on is the
// binding this probe proves exists.

use gpui
use std::process

/// Drain this frame's events and keep the menu's own.
fn handle() {
    for event in gpui::take_events() {
        let id, data = gpui::event_parts(event)
        if id == "menu" {
            gpui::list_push("km3.menu", data)
        }
    }
}

fn main() {
    let outcome = gpui::run("km3 - menu accelerators", 380.0, 220.0, || {
        let f = gpui::frame()
        gpui::on_keys(true)
        handle()

        // `Save` is the first `events` entry, so it is slot 0; the separator between
        // it and `Quit App` must not renumber it (that is MN3's rule, and this row
        // rides on it).
        let items = #["events:Save:cmd-s", "separator", "events:Quit App"]

        if f == 2 {
            gpui::set_menus("App", items)
        }
        // `gpui::send_key` delivers after the frame that asked.
        if f == 8 {
            gpui::send_key("cmd-s")
        }

        if f >= 16 {
            let declared = gpui::menu_accelerators(items)
            let fired = gpui::list_len("km3.menu")
            let slot = gpui::list_get("km3.menu", 0)

            // One exclusive chain ending in the verdict: `gpui::quit()` asks the
            // app to stop, it does not abort the callback that called it.
            if declared.len() != 1 || declared[0] != "0:cmd-s" {
                println(f"FAIL KM3 the menu's accelerators read back as {declared}, not the one `events:Save:cmd-s` declares")
                gpui::quit()
            } else if fired != 1 {
                println(f"FAIL KM3 the entry declared cmd-s and {fired} menu event(s) arrived: the accelerator is not bound to the item")
                gpui::quit()
            } else if slot != "0" {
                println(f"FAIL KM3 cmd-s fired menu slot {slot}, not the slot of the entry that declared it")
                gpui::quit()
            } else {
                println("OK KM3 the menu entry declared cmd-s, the declaration read back as 0:cmd-s, and pressing it fired menu slot 0")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("km3", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL KM3 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
