// KM7 — the pointer events a program had no way to hear.
//
// container: the pointer is driven from outside the process by `xdotool` through XTEST, against
// the X server the window really sits on. The Mac has no such server, and on this Mac a run *is*
// a window — `scripts/window-guard.sh` keeps one from opening there at all — so
// `scripts/probes.sh` and `scripts/tiers.sh` skip this one by name. It runs in the container:
//
//   ./scripts/gosbox.sh tiers tests/gui/km7_pointer_beyond.gos
//
// # What this exists for
//
// `gpui::on_mouse` names seven kinds, and the three this probe is about were the ones a program
// could not hear at all:
//
//   * the **wheel over an element**. gpui gates `on_scroll_wheel` on
//     `hitbox.should_handle_scroll(window)` (`gpui-0.2.2/src/elements/div.rs:318`) — the whole
//     hit-test list, not the hovered prefix the press handlers are gated on — and the binding
//     registered nothing for the event at either level.
//   * the pointer **leaving an element**. gpui has no element-level exit event: an element's
//     listeners are registered as concrete types on mouse-down and its neighbours
//     (`elements/div.rs:2042-2059`), and `MouseExitEvent` is not one of them. What an element
//     does have is the **transition** of its own hover, handed to the hover listener as a bool,
//     and that is only evaluated on a move.
//   * the pointer **leaving the window**. The same `MouseExitEvent`, which the platform
//     generates (`platform/linux/x11/client.rs:1217`) and which is dispatched to window
//     listeners directly — so it arrives whether or not the pointer moves again. That is the
//     difference between it and the element-level one, and the reason both are registered.
//
// # What is asserted, and against what
//
// Every number below is checked against what `xdotool` was told, not against what the binding
// says about itself:
//
//   * two wheel notches turn over the box — `click 4` then `click 5` — and the delta the element
//     is handed is `ScrollDelta::Lines` of **+3.0** and **−3.0**, with `dx` zero and
//     `<id>.scroll_lines` true. `3.0` is `SCROLL_LINES` (`platform/linux/platform.rs:33`), and
//     the number is asserted rather than the sign alone: a sign passes for any delta at all.
//   * the pointer is then moved **out of the box but not out of the window**, and the element's
//     own `exit` arrives — carrying the point the pointer was last seen at over it, which is
//     where the wheel was turned, since the element-level exit has no event of its own to read
//     a point from.
//   * the pointer is then moved **off the window altogether**, and the window-level `exit`
//     arrives, at a point of its own. The window-level `move` is heard at every one of those
//     moves — including the ones with the pointer off the box, which is the whole reason a
//     window-level listener exists — and its last point is the one the pointer was posted at.
//
// Every failure is counted as well as printed, and the verdict at the end reads the count, so no
// check below can fail and then fall through to a passing line.
//
// # Why the wheel may not arrive at all, and why that is recorded rather than worked around
//
// The X11 backend drops a scroll button press flagged `POINTER_EMULATED`
// (`platform/linux/x11/client.rs:1133-1135`) — the flag a smooth-scrolling device's events carry
// beside its `XinputMotion` valuators, and the same filter GTK applies. `xdotool` posts through
// XTEST, and whether XTEST's events carry that flag is the X server's business. If they do, the
// wheel line below goes red **for a reason that is not the binding's**, and its own message says
// so rather than leaving the reader to guess.

use gpui
use std::os::exec
use std::process
use std::strconv

/// The title the window is opened with, and what `xdotool` is told to look for. One word, so
/// that the search cannot match anything else on the display.
const TITLE: String = "km7beyond"

/// Where the listening box sits inside the window, from its own style string below.
const BOX_X: f64 = 100.0
const BOX_Y: f64 = 80.0
const BOX_W: f64 = 400.0
const BOX_H: f64 = 300.0

/// Where the wheel is turned: inside the box, and away from its own origin so that a report in
/// the element's space and one in the window's cannot be confused.
const AT_X: f64 = BOX_X + 150.0
const AT_Y: f64 = BOX_Y + 100.0

/// Where the pointer is put to leave the box **without** leaving the window: to the box's right
/// and above its bottom edge, well inside the 900 by 600 client area.
const OUT_X: f64 = BOX_X + BOX_W + 60.0
const OUT_Y: f64 = BOX_Y + 40.0

/// The window that is asked for, which is also what the far corner is measured against.
const WIN_W: f64 = 900.0
const WIN_H: f64 = 600.0

/// The delta the X11 backend hands a wheel notch: `platform/linux/platform.rs:33`. Asserted as a
/// number, not only as a sign.
const LINES: f64 = 3.0

/// Run a program and answer its stdout, trimmed, with anything that went wrong printed.
///
/// A missing tool or a refusal is printed rather than swallowed: its stdout is then empty and
/// every step below would fail for the wrong reason.
fn shell(program: String, args: Vec<String>) -> String {
    match exec::run(program.clone(), args) {
        Ok(out) => {
            if out.code != 0 {
                println(f"FAIL KM7 {program} exited {out.code}: {out.stderr.trim()}")
            }
            out.stdout.trim().clone()
        }
        Err(problem) => {
            println(f"FAIL KM7 could not run {program}: {problem}")
            String::new()
        }
    }
}

/// One `key=value` line out of `xdotool getwindowgeometry --shell`, as a number, or `-1.0`.
fn field(text: String, key: String) -> f64 {
    for line in text.split("\n") {
        if let Some((name, value)) = line.split_once("=") {
            if name.trim() == key {
                return number(value.trim().clone())
            }
        }
    }
    -1.0
}

/// A number, or `-1.0` if the text was not one.
fn number(text: String) -> f64 {
    match strconv::parse_f64(text) {
        Ok(value) => value,
        Err(_) => -1.0,
    }
}

/// The xdotool subcommand that posts one pointer move, as a list of words. `--sync` makes the
/// helper wait until the pointer really is there, so the next thing the probe posts cannot
/// overtake it.
fn move_to(x: f64, y: f64) -> Vec<String> {
    let sx = x.round() as i64
    let sy = y.round() as i64
    #["mousemove", "--sync", f"{sx}", f"{sy}"]
}

/// A point as it will be compared: `"12.5,30.25"`, to two decimals.
fn point(x: f64, y: f64) -> String {
    f"{x:.2},{y:.2}"
}

/// Whether two points are the same to within a hundredth of a pixel.
fn same(x: f64, y: f64, ex: f64, ey: f64) -> bool {
    let dx = x - ex
    let dy = y - ey
    (if dx < 0.0 { -dx } else { dx }) < 0.01 && (if dy < 0.0 { -dy } else { dy }) < 0.01
}

/// Write a failure down: print it, and count it. The verdict at the end reads the count, which
/// is what stops any check here from failing and then falling through to a passing line.
fn fail(message: String) {
    println(f"FAIL KM7 {message}")
    gpui::set_int("fails", gpui::state_int("fails", 0) + 1)
}

/// Where the *last* of the `"<id>|<kind>"` entries named by `want` is, or `-1`. The last is what
/// an assertion about "what the pointer did most recently" wants; the first is not.
fn last(ids: Vec<String>, want: String) -> i64 {
    let mut found = -1
    for i in 0..ids.len() {
        if ids[i].clone() == want.clone() {
            found = i as i64
        }
    }
    found
}

/// How many of them there are.
fn count(ids: Vec<String>, want: String) -> i64 {
    let mut n = 0
    for i in 0..ids.len() {
        if ids[i].clone() == want.clone() {
            n = n + 1
        }
    }
    n
}

/// The display's size, from `xdotool getdisplaygeometry`, which answers `"<w> <h>"`. `-1.0` for
/// either if it could not be read, which makes the far corner below absurd rather than wrong —
/// and the probe checks that corner before it uses it.
fn display_size() -> (f64, f64) {
    let text = shell("xdotool", #["getdisplaygeometry"])
    let mut w = -1.0
    let mut h = -1.0
    let mut seen = 0
    for word in text.split(" ") {
        let clean = word.trim().clone()
        if !clean.is_empty() && seen == 0 {
            w = number(clean.clone())
            seen = 1
        } else if !clean.is_empty() && seen == 1 {
            h = number(clean.clone())
            seen = 2
        }
    }
    (w, h)
}

/// A point on the display that is certainly not inside a window at `(ox, oy)` of `w` by `h`: the
/// display corner farthest from the window's centre. One window cannot cover all four corners,
/// so this is outside it — and the probe checks that rather than trusting it.
fn far_corner(ox: f64, oy: f64, w: f64, h: f64) -> (f64, f64) {
    let size = display_size()
    let dw = size.0
    let dh = size.1
    let cx = ox + w / 2.0
    let cy = oy + h / 2.0
    let mut qx = 2.0
    let mut qy = 2.0
    let mut best = -1.0
    for i in 0..4 {
        let tx = (if i == 0 || i == 2 { 2.0 } else { dw - 2.0 })
        let ty = (if i < 2 { 2.0 } else { dh - 2.0 })
        let d = (tx - cx) * (tx - cx) + (ty - cy) * (ty - cy)
        if d > best {
            best = d
            qx = tx
            qy = ty
        }
    }
    (qx, qy)
}

fn main() {
    let outcome = gpui::run(TITLE, WIN_W, WIN_H, || {
        let f = gpui::frame()

        // A frame is only painted when something asks for one: `gpui::run`'s tree on its own
        // gets the window's first two and then the program sits idle. Measured for MP1, whose
        // header records it — a variant with no `animate()` printed frames 1 and 2 and nothing
        // more.
        gpui::animate()

        // ---- every event, on the frame it arrives on ----------------------
        //
        // Drained every frame into a list rather than read where it is wanted, because the
        // store holds **one slot per key** and this probe is about more than one of each of
        // these arriving. A reading taken after a second wheel notch cannot say anything about
        // the first.
        for event in gpui::take_events() {
            let id, kind = gpui::event_parts(event.clone())
            let x, y = gpui::pointer_xy(event.clone())
            gpui::list_push("ids", f"{id}|{kind}")
            gpui::list_push_float("px", x)
            gpui::list_push_float("py", y)
        }

        // ---- frame 3: find the window, and put the pointer over the box ------------------
        //
        // The origin is taken from **the binding**, `gpui::window_field("inner_x")`, and not
        // from `xdotool`'s reading of the same window: the binding's is the number a pointer
        // event is measured against, so it is the one to post relative to. A window manager
        // that draws a frame of its own around the client would put the two apart and every
        // point below would be out by the difference — so they are compared rather than assumed
        // equal.
        if f == 3 && gpui::state_int("phase", 0) == 0 {
            gpui::set_int("phase", 1)
            let found = shell("xdotool", #["search", "--name", TITLE])
            let hits = found.lines()
            if hits.is_empty() {
                fail(f"no window named {TITLE} on this display (xdotool said `{found}`)")
                gpui::quit()
            } else {
                let geometry = shell(
                    "xdotool",
                    #["getwindowgeometry", "--shell", hits[0].trim().clone()],
                )
                let win_x = field(geometry.clone(), "X")
                let win_y = field(geometry.clone(), "Y")
                let ox = gpui::window_field("inner_x")
                let oy = gpui::window_field("inner_y")
                if !same(win_x, win_y, ox, oy) {
                    println(f"note KM7 xdotool puts the window at {point(win_x, win_y)} and the binding at {point(ox, oy)}; posting relative to the binding's")
                }
                gpui::set_float("origin_x", ox)
                gpui::set_float("origin_y", oy)
                let _ = shell("xdotool", move_to(ox + AT_X, oy + AT_Y))
            }
        }

        // ---- frame 6: one wheel notch up ---------------------------------------------------
        if f == 6 && gpui::state_int("phase", 0) == 1 {
            gpui::set_int("phase", 2)
            let _ = shell("xdotool", #["click", "4"])
        }

        // ---- frame 9: read what the notch up left, then one notch down --------------------
        //
        // Three frames between the post and the reading. The store is written by the handler
        // gpui dispatches, which is a round trip through the X server *and* a frame boundary
        // away from the `exec::run` that posted it — MP1 measured events landing one iteration
        // after they were posted. Reading the store in the frame the gesture goes out would
        // report the state before it, which is the shape of a check that has stopped checking.
        if f == 9 && gpui::state_int("phase", 0) == 2 {
            gpui::set_int("phase", 3)
            gpui::set_float("up_dx", gpui::state_float("box.dx", -99.0))
            gpui::set_float("up_dy", gpui::state_float("box.dy", -99.0))
            gpui::set_bool("up_lines", gpui::state_bool("box.scroll_lines", false))
            let _ = shell("xdotool", #["click", "5"])
        }

        // ---- frame 12: the wheel's whole claim, then leave the box ------------------------
        if f == 12 && gpui::state_int("phase", 0) == 3 {
            gpui::set_int("phase", 4)

            let up_dx = gpui::state_float("up_dx", -99.0)
            let up_dy = gpui::state_float("up_dy", -99.0)
            let down_dx = gpui::state_float("box.dx", -99.0)
            let down_dy = gpui::state_float("box.dy", -99.0)
            let lines = gpui::state_bool("box.scroll_lines", false) &&
                gpui::state_bool("up_lines", false)

            let ids = gpui::list_all("ids")
            let heard = count(ids.clone(), "box|scroll")

            // The wheel, whole. `click 4` is `ScrollDirection::Up` — `(0.0, SCROLL_LINES)` — and
            // `click 5` is `Down`, the same number negated
            // (`platform/linux/x11/client.rs:1138-1139`). Both are `ScrollDelta::Lines`, which is
            // what `<id>.scroll_lines` records: a pixel delta and a line delta are different
            // units landing in one slot, so the unit is reported rather than assumed.
            if heard < 2 {
                fail(f"the wheel was heard over the box {heard} times, not twice — the binding's `scroll` kind is registered at both levels (`gpui-binding/src/view.rs:3100`, `:2153`), so this is either xdotool's XTEST button events being dropped for `POINTER_EMULATED` (`platform/linux/x11/client.rs:1133-1135`) or the element not being under the pointer")
            }
            if !lines {
                fail("the wheel's delta did not arrive as a line delta, so `<id>.dx`/`<id>.dy` are not in the unit this assertion is about")
            }
            if !same(up_dx, up_dy, 0.0, LINES) {
                fail(f"the notch up arrived as {point(up_dx, up_dy)}, not the line delta {point(0.0, LINES)} that `SCROLL_LINES` gives")
            }
            if !same(down_dx, down_dy, 0.0, -LINES) {
                fail(f"the notch down arrived as {point(down_dx, down_dy)}, not the line delta {point(0.0, -LINES)}")
            }

            // Out of the box, and still inside the window. Two moves rather than one: the
            // element-level exit is gpui's hover **transition**, which is evaluated on a move
            // (`elements/div.rs:2270`), so a single move that both leaves and is the last thing
            // the pointer does is the case least likely to be caught.
            let ox = gpui::state_float("origin_x", 0.0)
            let oy = gpui::state_float("origin_y", 0.0)
            let _ = shell("xdotool", move_to(ox + OUT_X, oy + OUT_Y))
            let _ = shell("xdotool", move_to(ox + OUT_X + 20.0, oy + OUT_Y + 10.0))
            gpui::set_float("out_x", OUT_X + 20.0)
            gpui::set_float("out_y", OUT_Y + 10.0)
        }

        // ---- frame 15: the element's own exit, then leave the window -----------------------
        if f == 15 && gpui::state_int("phase", 0) == 4 {
            gpui::set_int("phase", 5)

            let ids = gpui::list_all("ids")
            let xs = gpui::list_all_float("px")
            let ys = gpui::list_all_float("py")
            let exit_at = last(ids.clone(), "box|exit")

            if exit_at < 0 {
                fail("the pointer left the box and the element-level `exit` was never heard — gpui gives an element the *transition* of its own hover (`gpui-binding/src/view.rs:3116`), and the move that crossed the edge was posted")
            } else {
                // What the element's exit carries is the point the pointer was last *seen* at
                // over that element, and the last thing seen there was the wheel. That is the
                // price of an exit with no event of its own to read a point from, and it is
                // asserted rather than left as prose.
                let x = xs[exit_at]
                let y = ys[exit_at]
                if !same(x, y, AT_X, AT_Y) {
                    fail(f"the element-level `exit` carried {point(x, y)}, not the {point(AT_X, AT_Y)} the pointer was last seen at over the box")
                }
            }

            // Now off the window altogether. The window's own exit needs no move after it, so a
            // single jump is enough — and the jump must leave the window, which is checked
            // before it is posted rather than hoped for.
            let ox = gpui::state_float("origin_x", 0.0)
            let oy = gpui::state_float("origin_y", 0.0)
            let corner = far_corner(ox, oy, WIN_W, WIN_H)
            let inside = corner.0 >= ox &&
                corner.0 <= ox + WIN_W &&
                corner.1 >= oy &&
                corner.1 <= oy + WIN_H
            if inside {
                fail(f"the far corner {point(corner.0, corner.1)} is inside the window at {point(ox, oy)}, so nothing below would leave it")
                gpui::quit()
            } else {
                let _ = shell("xdotool", move_to(corner.0, corner.1))
            }
        }

        // ---- frame 18: the window's own exit, and the window-level move --------------------
        if f == 18 && gpui::state_int("phase", 0) == 5 {
            gpui::set_int("phase", 6)

            let ids = gpui::list_all("ids")
            let xs = gpui::list_all_float("px")
            let ys = gpui::list_all_float("py")
            let out_x = gpui::state_float("out_x", 0.0)
            let out_y = gpui::state_float("out_y", 0.0)

            let exit_at = last(ids.clone(), "boxw|exit")
            let move_at = last(ids.clone(), "boxw|move")
            let moves = count(ids.clone(), "boxw|move")
            let box_exits = count(ids.clone(), "box|exit")

            // The window-level `move` is the listener an element cannot be: gpui gates the
            // element's own move handler on `event.dragging()` *and* on the element's hitbox
            // being hovered, so the moves with the pointer off the box are exactly the ones it
            // never sees. The last of them is where the pointer was posted.
            if moves < 3 {
                fail(f"the window-level listener heard {moves} moves; the pointer was moved at least three times after it was registered, and this listener is gated on nothing at all")
            }
            if move_at < 0 {
                fail("the window-level listener heard no move at all")
            } else if !same(xs[move_at], ys[move_at], out_x, out_y) {
                fail(f"the last window-level move was {point(xs[move_at], ys[move_at])}, not the {point(out_x, out_y)} the pointer was last posted at inside the window")
            }

            // The window's own exit: `MouseExitEvent` is dispatched to window listeners directly
            // (`gpui-0.2.2/src/window.rs:3677`), so nothing else can account for it arriving.
            if exit_at < 0 {
                fail("the pointer left the window and the window-level `exit` was never heard")
            } else {
                if move_at >= 0 && exit_at < move_at {
                    fail("the window-level exit arrived before the last move inside the window, so it is not the leave it claims to be")
                }
                // And it carries a point of its own, where the element-level one had to borrow
                // the last one seen. If the two are the same number the reader cannot tell which
                // of the two registrations answered.
                if move_at >= 0 &&
                    same(xs[exit_at], ys[exit_at], xs[move_at], ys[move_at])
                {
                    fail(f"the window-level exit and the last window-level move carry the same point {point(xs[exit_at], ys[exit_at])}, so at least one of them was not read from its own event")
                }
            }

            // One element-level exit, not a stream of them: the transition fires once, on the
            // move that crosses the edge. A `hovered` read that reported the state rather than
            // the change would fire again on every move after it.
            if box_exits != 1 {
                fail(f"the element-level `exit` fired {box_exits} times for one departure, so it is reporting the hovered state rather than the transition")
            }

            let fails = gpui::state_int("fails", 0)
            if fails == 0 {
                println(f"OK KM7 the wheel over an element arrived as the line delta `SCROLL_LINES` gives, +{LINES} and -{LINES} with dx zero, and only while the box was under the pointer; leaving the box was heard as the transition of its own hover, which needs a move, carrying the point last seen there; leaving the window was heard without one, at a point of its own; and the window-level move kept reporting with the pointer off the box, its last at the point it was posted at")
            }
            gpui::quit()
        }

        // ---- the tree ---------------------------------------------------------------------
        //
        // Two elements, and the *window-level* listener is not on the one the element-level
        // listener is on, which is deliberate. `gpui::on_mouse` and `gpui::on_mouse_window` both
        // wrap the element they are handed, and wrapping one element twice nests two wrappers
        // around one box; the binding folds and registers a wrapper per call, and no program has
        // ever chained them on one element — `tests/gui/dt2_thumb_drag.gos:336` and
        // `tests/gui/dd4_capture.gos:159` each pick one. So the full-size plain div carries
        // `move` and `exit` heard anywhere in the window, and the box carries `scroll` and its
        // own `exit`.
        //
        // A div with no listener inserts no hitbox, so the full-size one being *under* the box is
        // not load-bearing — but it is painted first anyway, which is also the order that would
        // keep it out of the way if it ever gained one.
        let wide = gpui::on_mouse_window(
            gpui::rect(f"absolute left=0 top=0 w={WIN_W} h={WIN_H} bg=#ffffff"),
            "move exit",
            "boxw",
        )
        let box = gpui::on_mouse(
            gpui::rect(f"absolute left={BOX_X} top={BOX_Y} w={BOX_W} h={BOX_H} bg=#3366ff"),
            "scroll exit",
            "box",
        )
        let stack = gpui::child(gpui::child(gpui::stack("size=full bg=#ffffff"), wide), box)
        gpui::root(stack)
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
