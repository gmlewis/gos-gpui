// SC7 — a custom scrollbar whose thumb drags the real offset.
//
// Tier: every tier.
//
// A scrollbar is arithmetic over three numbers: how far the thing has scrolled,
// how far it *can* scroll, and how much of it you can see. This probe draws one
// over a 200-row virtual list — the shape `examples/02_data_table.gos` draws an
// inert thumb over — and checks that all three numbers are real:
//
//   * the list reports a maximum offset, positive, so the track has a length
//   * it reports offset 0 before anything moves it, so the thumb starts at the
//     top rather than at a guess
//   * setting the offset — which is what a drag of the thumb does — moves the
//     list's rows, so the thumb is attached to the content and not to a picture
//     of it
//
// The drag *input* is the one part no probe can exercise: nothing in the binding
// synthesizes a pointer event. What is checked here is everything a drag would
// act on.

use gpui
use std::process

/// The list's row builder — handed to `gpui::run_with_rows`, not to
/// `gpui::list`; see `gpui::run_with_rows` for why. The list id comes first so
/// one builder can serve every list a program draws.
fn list_row(_list: String, i: i64) -> i64 {
    gpui::text(f"row {i}", "p=2 color=#ffffff")
}

fn main() {
    let outcome = gpui::run_with_rows("sc7 - a live scrollbar", 320.0, 280.0, "", list_row, || {
        let f = gpui::frame()

        if f == 2 {
            let max = gpui::scroll_max_offset("items", "y")
            let at = gpui::scroll_offset("items", "y")
            if max <= 0.0 {
                println(f"FAIL SC7 a list of 200 rows in a 200 pixel viewport reports a maximum offset of {max}")
                gpui::quit()
            }
            if at > 0.001 || at < -0.001 {
                println(f"FAIL SC7 a list nothing has scrolled reports offset {at}, not 0")
                gpui::quit()
            }
        }

        // A drag of the thumb to the middle of its track: the offset a thumb
        // asks for is a pixel offset, which is why this is `scroll_to` rather
        // than `list_scroll_to`.
        if f == 5 && !gpui::scroll_to("items", 0.0, -2000.0) {
            println("FAIL SC7 scroll_to did not recognise the list it was given")
            gpui::quit()
        }

        if f >= 8 {
            let at = gpui::scroll_offset("items", "y")
            let first, last = gpui::list_range("items")
            if at > -1999.0 || at < -2001.0 {
                println(f"FAIL SC7 the offset set to -2000 reads back as {at}")
                gpui::quit()
            } else if first != 100 {
                println(f"FAIL SC7 setting the offset to -2000 left the visible range at {first}..{last}, not from row 100")
                gpui::quit()
            } else {
                println("OK SC7 the list's offset and maximum are readable, and setting the offset the way a thumb would moves its rows")
                gpui::quit()
            }
        }

        gpui::animate()
        let list = gpui::list("items", 200, 20.0, "h=200 w=240")
        let root = gpui::column("p=8 bg=#111111 size=full")
        gpui::child(root, list)
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL SC7 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
