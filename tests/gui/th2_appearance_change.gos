// TH2 — observe appearance changes while running.
//
// needs: scripts/appearance-toggle.sh
//
// Tier: every tier, **run under `scripts/appearance-toggle.sh`**. This probe cannot be
// run plainly: it waits for the operating system to change the appearance, and
// nothing inside the process can cause that — gpui has no public appearance setter,
// and registering an observer does not replay the current value
// (`SubscriberSet::insert`'s `activate` is `active.set(true)` and nothing else,
// `gpui-0.2.2/src/subscription.rs:88`). A plain run therefore *fails* on purpose,
// and that failure is the evidence that the check is sensitive to a real change.
//
// TH1 reports the appearance the window has now. This is the other half: the window
// telling the program that it changed, which is what a program needs to re-colour
// itself while it is running rather than when it is rebuilt.
//
// Pass means the appearance changed *while the program ran* and the observer
// reported the new value — not the old one, and not nothing.

use gpui
use std::process

/// Drain this frame's events and keep the appearances the window reported.
fn handle() {
    for event in gpui::take_events() {
        let id, data = gpui::event_parts(event)
        if id == "changed" {
            gpui::list_push("th2.changed", data)
        }
    }
}

fn main() {
    let outcome = gpui::run("th2 - appearance change", 360.0, 220.0, || {
        let f = gpui::frame()
        handle()

        if f == 2 {
            gpui::observe_appearance("changed")
            // What the window says it is now, for the verdict to compare against.
            gpui::set_text("th2.first", gpui::appearance())
        }

        // About ten seconds: enough for `scripts/appearance-toggle.sh` to flip the
        // system appearance and for the platform to deliver the notification.
        if f >= 600 {
            let first = gpui::state_text("th2.first", "")
            let arrived = gpui::list_len("th2.changed")
            let reported = gpui::list_get("th2.changed", 0)

            // One exclusive chain ending in the verdict: `gpui::quit()` asks the
            // app to stop, it does not abort the callback that called it.
            if arrived == 0 {
                println(f"FAIL TH2 the appearance was not changed while the program ran, and nothing arrived — the window still reports {first}")
                gpui::quit()
            } else if reported == first {
                println(f"FAIL TH2 the observer fired but reported \"{reported}\", the same appearance the window had before the change (\"{first}\")")
                gpui::quit()
            } else {
                println(f"OK TH2 the appearance changed from \"{first}\" to \"{reported}\" while the program ran, and the observer reported it")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("th2", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL TH2 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
