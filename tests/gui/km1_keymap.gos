// KM1 — a program-facing keymap: `bind_keys` from Gossamer, and the event it fires.
//
// Tier: every tier.
//
// Upstream binds an action to a keystroke — `cx.bind_keys([KeyBinding::new("cmd-s",
// Save, None)])` — and that cannot cross this ABI: an `Action` is a trait
// implementation, and R3 leaves no value that *is* one. What a program actually
// needs is narrower than that: "when this stroke happens, tell me". So the binding
// owns one action type of its own, a bound stroke carries the program's own event
// name in it, and the program hears `"<name>"`.
//
// Before this, the only bound stroke in the whole binding was ⌘Q.
//
// Pass means a program can bind two strokes and hear exactly those two, in the
// window that asked, and that a stroke it did not bind fires nothing. The keys are
// produced with `gpui::send_key`, which goes through the window's ordinary dispatch
// — the same path a real key takes, including the keymap match.

use gpui
use std::process

/// Drain this frame's events and remember the bare ids, so the verdict can say
/// which of them arrived.
fn handle() {
    for event in gpui::take_events() {
        let id, _ = gpui::event_parts(event)
        if id == "save" || id == "redo" || id == "unbound" {
            gpui::list_push("km1.fired", id)
        }
    }
}

fn main() {
    let outcome = gpui::run("km1 - keymap", 380.0, 220.0, || {
        let f = gpui::frame()

        // The window needs the keyboard for a keystroke to be delivered at all.
        gpui::on_keys(true)
        handle()

        if f == 2 {
            gpui::bind_keys("cmd-s=save; cmd-shift-z=redo; cmd-j=unbound")
        }
        if f == 4 {
            // The request is applied during the frame that raised it, so the reader
            // has something to say on the frame after.
            let plan = gpui::keymap()
            gpui::set_int("km1.bound", plan.len() as i64)
        }
        // `gpui::send_key` delivers after the frame that asked.
        if f == 6 {
            gpui::send_key("cmd-s")
        }
        if f == 8 {
            gpui::send_key("cmd-shift-z")
        }
        if f == 10 {
            gpui::send_key("cmd-j")
        }

        if f >= 16 {
            let fired = gpui::list_len("km1.fired")
            let first = gpui::list_get("km1.fired", 0)
            let second = gpui::list_get("km1.fired", 1)
            let third = gpui::list_get("km1.fired", 2)
            let bound = gpui::state_int("km1.bound", 0)

            // One exclusive chain ending in the verdict: `gpui::quit()` asks the
            // app to stop, it does not abort the callback that called it.
            if bound != 3 {
                println(f"FAIL KM1 the reader says {bound} bindings, not the 3 the program asked for")
                gpui::quit()
            } else if fired != 3 {
                println(f"FAIL KM1 the program bound 3 strokes and {fired} of them fired: {first}, {second}, {third}")
                gpui::quit()
            } else if first != "save" || second != "redo" || third != "unbound" {
                println(f"FAIL KM1 the strokes fired the wrong events, in the wrong order: {first}, {second}, {third}")
                gpui::quit()
            } else {
                println(f"OK KM1 three bound strokes fired their own events in order ({first}, {second}, {third}), and the reader reports {bound} bindings")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("km1", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL KM1 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
