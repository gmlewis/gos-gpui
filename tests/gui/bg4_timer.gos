// BG4 — a repeat timer that can be rescheduled and cancelled.
//
// Tier: every tier.
//
// `gpui::tick(id, ms)` installed **one permanent timer per id**: a later `tick` with a
// different period was ignored, because the registry was a set and the id was simply
// already in it, and there was no way to stop one at all — the async loop was detached
// and ran until the process ended. A program could start a clock and never change it.
//
// Pass means all three, and each is measured rather than assumed:
//
//   * a 30ms timer raises events;
//   * the *same id* rescheduled to 300ms raises them far less often — the rate is what
//     changes, so the check is a comparison and not a count;
//   * `gpui::tick_stop` ends it, and nothing arrives afterwards.
//
// The reader is checked at each step too, so a binding that reported success while doing
// nothing would have to report the wrong period as well.
//
// Time is `gpui::now()`, not frames: the point is a millisecond period, and a frame count
// would make the check depend on how fast the machine happens to be painting. Each
// change is read back on a later frame than the one that asked for it, because a request
// is applied during the frame that raised it.
//
// The three windows are a few hundred milliseconds each, and deliberately so: this probe
// needs the window to go on being painted for as long as it runs, and that is the one
// thing it cannot control. The transition window is counted and then discarded, because a
// timer being retired can still be asleep when the stop lands.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("bg4 - repeat timer", 380.0, 220.0, || {
        let f = gpui::frame()
        let phase = gpui::state_int("bg4.phase", 0)

        // Count this frame's beats into the phase's own counter.
        let mut beats = 0
        for event in gpui::take_events() {
            let id, _ = gpui::event_parts(event)
            if id == "beat" {
                beats = beats + 1
            }
        }
        if phase == 0 {
            gpui::set_int("bg4.fast", gpui::state_int("bg4.fast", 0) + beats)
        } else if phase == 1 {
            gpui::set_int("bg4.slow", gpui::state_int("bg4.slow", 0) + beats)
        } else if phase == 3 {
            gpui::set_int("bg4.stopped", gpui::state_int("bg4.stopped", 0) + beats)
        }

        if f == 2 {
            gpui::tick("beat", 30)
        }
        if phase == 0 && gpui::now() >= 0.4 {
            gpui::set_text("bg4.period_fast", f"{gpui::tick_period("beat")}")
            // The same id, a period ten times longer: this is the reschedule.
            gpui::tick("beat", 300)
            gpui::set_int("bg4.phase", 1)
        }
        if phase == 1 && gpui::now() >= 0.8 {
            gpui::set_text("bg4.period_slow", f"{gpui::tick_period("beat")}")
            gpui::tick_stop("beat")
            gpui::set_int("bg4.phase", 2)
        }
        if phase == 2 && gpui::now() >= 0.95 {
            // A second after the stop, so what is read back is the state it left.
            gpui::set_text("bg4.period_stopped", f"{gpui::tick_period("beat")}")
            gpui::set_int("bg4.stopped", 0)
            gpui::set_int("bg4.phase", 3)
        }

        if phase == 3 && gpui::now() >= 1.2 {
            let fast = gpui::state_int("bg4.fast", 0)
            let slow = gpui::state_int("bg4.slow", 0)
            let stopped = gpui::state_int("bg4.stopped", 0)
            let period_fast = gpui::state_text("bg4.period_fast", "")
            let period_slow = gpui::state_text("bg4.period_slow", "")
            let period_stopped = gpui::state_text("bg4.period_stopped", "")

            // One exclusive chain ending in the verdict: `gpui::quit()` asks the
            // app to stop, it does not abort the callback that called it.
            if period_fast != "30" {
                println(f"FAIL BG4 a 30ms timer reads back as {period_fast}")
                gpui::quit()
            } else if period_slow != "300" {
                println(f"FAIL BG4 the same id rescheduled to 300ms still reads back as {period_slow}")
                gpui::quit()
            } else if period_stopped != "0" {
                println(f"FAIL BG4 tick_stop left the timer reading back as {period_stopped}, not 0")
                gpui::quit()
            } else if fast < 4 {
                println(f"FAIL BG4 a 30ms timer raised {fast} events in its window, so it was not running")
                gpui::quit()
            } else if slow * 2 >= fast {
                println(f"FAIL BG4 rescheduling the id from 30ms to 300ms did not slow it down: {fast} events in the first window, {slow} in the second")
                gpui::quit()
            } else if stopped != 0 {
                println(f"FAIL BG4 the timer was stopped and raised {stopped} more events afterwards")
                gpui::quit()
            } else {
                println(f"OK BG4 a 30ms timer raised {fast} events, the same id rescheduled to 300ms raised {slow}, and after tick_stop it raised none")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("bg4", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL BG4 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
