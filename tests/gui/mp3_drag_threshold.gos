// MP3 — a full-window listener hears every pointer move while the button is held, wherever the
// pointer is, and gpui's drag threshold can therefore be computed. Driven by a real pointer on a
// real window.
//
// container: the pointer is driven from outside the process by `xdotool` through XTEST, against
// the X server the window really sits on. The Mac has no such server — and `scripts/window-guard.sh`
// keeps a window from opening there at all — so `scripts/probes.sh` and `scripts/tiers.sh` skip
// this one by name. It runs in the container:
//
//   ./scripts/gosbox.sh tiers tests/gui/mp3_drag_threshold.gos
//
// # What this exists for
//
// `examples/03_drag_drop.gos` carried a deviation saying its ghost is armed by the press where
// upstream waits for gpui's drag threshold, and giving two reasons it could not be otherwise:
// that the binding's `move` events carry no threshold, and that "a move listener stops at the
// edge of the element that raised it, so a drag that leaves the square quickly could raise no
// `move` at all". The first is true and is *why* the port computes the threshold itself; the
// second is **false**, and this probe is what refutes it.
//
// gpui dispatches a mouse move to every listener registered on this window, and each listener
// decides for itself with `hitbox.is_hovered(window)` — which is true for **every** hitbox under
// the pointer, not only the front one, because the default `HitboxBehavior` is `Normal` and only
// `InteractiveElement::occlude` makes a box block the ones behind it
// (`gpui-0.2.2/src/window.rs:502`, `:570-578`, `:775-797`). So a listener on a full-window
// rectangle is hovered wherever the pointer is, and hears every move. The binding adds one gate
// of its own — `if event.dragging()`, which is `pressed_button == Some(MouseButton::Left)`
// (`src/interactive.rs:356`) — so what a full-window listener hears is every move **of a drag**,
// which is exactly the span over which gpui evaluates its threshold.
//
// # The threshold itself, from the crate
//
// ```text
// const DRAG_THRESHOLD: f64 = 2.;                                  // elements/div.rs:47
// ...
// if let Some(mouse_down) = pending_mouse_down.clone()
//     && !cx.has_active_drag()
//     && (event.position - mouse_down.position).magnitude() > DRAG_THRESHOLD
// ```
//
// (`elements/div.rs:2149-2174`.) Three things about it are worth pinning down and all three are
// checked below: it is **2.0** and not the "~4px" the example's bullet claimed; the comparison is
// strictly greater, so a move of exactly 2.0 px does not arm; and it is the **magnitude** of the
// offset, so a move of 2 px across and 2 px down arms even though neither axis passes 2 on its own.
//
// # What it is not
//
// It is not `examples/03_drag_drop.gos`. The tree below is the example's shape — a full-window
// listener at the bottom of a stack, a square over it that hears only `down`, a drop target over
// that — and the arming rule is upstream's, but the handlers are written here. What that means is
// that this checks the **binding** and the **arithmetic**, which are the two things the deviation
// bullet named; the example's own copy of the rule is the same rule and is not separately
// exercised.
//
// # Why the points are exact and the tolerance is a twentieth of a pixel
//
// The pointer is posted at a whole **screen** coordinate, so a single reading carries the
// difference between the binding's idea of where the window is and `xdotool`'s — measured at
// 0.05 px in `tests/gui/mp2_painting_drag.gos`. A **difference** of two postings does not: the
// origin cancels, and an offset of exactly two posted pixels is exactly 2.0 in window
// coordinates. That is what lets the 2.0-px edge be asserted at all, and why the tolerance below
// is only used to catch a reading that has drifted.

use gpui
use std::math
use std::os::exec
use std::process
use std::strconv

/// The title the window is opened with, and what `xdotool` is told to look for.
const TITLE: String = "mp3drag"

/// gpui's own number, quoted above: `const DRAG_THRESHOLD: f64 = 2.;`
/// (`gpui-0.2.2/src/elements/div.rs:47`).
const THRESHOLD: f64 = 2.0

/// Where the square sits and how big it is, from its own style string below.
const SQ_X: f64 = 100.0
const SQ_Y: f64 = 80.0

/// The point the first gesture presses at, and the two moves that straddle the threshold.
const PRESS_X: f64 = 200.0
const PRESS_Y: f64 = 200.0

/// Run a program and answer its stdout, trimmed, with anything that went wrong printed.
fn shell(program: String, args: Vec<String>) -> String {
    match exec::run(program.clone(), args) {
        Ok(out) => {
            if out.code != 0 {
                println(f"FAIL MP3 {program} exited {out.code}: {out.stderr.trim()}")
            }
            out.stdout.trim().clone()
        }
        Err(problem) => {
            println(f"FAIL MP3 could not run {program}: {problem}")
            String::new()
        }
    }
}

/// One `key=value` line out of `xdotool getwindowgeometry --shell`, as a number, or `-1.0`.
fn field(text: String, key: String) -> f64 {
    for line in text.split("\n") {
        if let Some((name, value)) = line.split_once("=") {
            if name.trim() == key {
                return match strconv::parse_f64(value.trim().clone()) {
                    Ok(number) => number,
                    Err(_) => -1.0,
                }
            }
        }
    }
    -1.0
}

/// The xdotool subcommand that posts one pointer move, as a list of words.
fn move_to(x: f64, y: f64) -> Vec<String> {
    let sx = x.round() as i64
    let sy = y.round() as i64
    #["mousemove", "--sync", f"{sx}", f"{sy}"]
}

/// A point as it will be compared: `"12.50,30.25"`, to two decimals.
fn point(x: f64, y: f64) -> String {
    f"{x:.2},{y:.2}"
}

/// Whether two readings are the same point, to within a twentieth of a pixel. See the header:
/// the differences this probe asserts do not depend on it, and it is here to catch a reading that
/// has drifted rather than to absorb one.
fn same(x: f64, y: f64, ex: f64, ey: f64) -> bool {
    let dx = x - ex
    let dy = y - ey
    (if dx < 0.0 { -dx } else { dx }) < 0.05 && (if dy < 0.0 { -dy } else { dy }) < 0.05
}

/// Press and release without moving.
fn tap(ox: f64, oy: f64, x: f64, y: f64) {
    let _ = shell("xdotool", move_to(ox + x, oy + y))
    let _ = shell("xdotool", #["mousedown", "1"])
    let _ = shell("xdotool", #["mouseup", "1"])
}

fn main() {
    let outcome = gpui::run(TITLE, 800.0, 600.0, || {
        let f = gpui::frame()
        gpui::animate()

        // ---- gesture A: the two edges of the threshold, from one press -----------------
        //
        // (200, 200) is inside the square. The first move is exactly 2.00 px away and must not
        // arm — gpui's comparison is `> 2.0` — and the second is 3.00 px away and must.
        if f == 3 && gpui::state_int("phase", 0) == 0 {
            gpui::set_int("phase", 1)
            let ox = origin_x()
            let oy = origin_y()
            if ox >= 0.0 && oy >= 0.0 {
                let _ = shell("xdotool", move_to(ox + PRESS_X, oy + PRESS_Y))
                let _ = shell("xdotool", #["mousedown", "1"])
                let _ = shell("xdotool", move_to(ox + PRESS_X + 2.0, oy + PRESS_Y))
                let _ = shell("xdotool", move_to(ox + PRESS_X + 3.0, oy + PRESS_Y))
                let _ = shell("xdotool", #["mouseup", "1"])
            }
        }

        // ---- gesture B: the magnitude, so a diagonal of 2,2 arms though neither axis does ---
        if f == 7 && gpui::state_int("phase", 0) == 1 {
            gpui::set_int("phase", 2)
            let ox = gpui::state_float("ox", -1.0)
            let oy = gpui::state_float("oy", -1.0)
            let _ = shell("xdotool", move_to(ox + SQ_X + 50.0, oy + SQ_Y + 40.0))
            let _ = shell("xdotool", #["mousedown", "1"])
            let _ = shell("xdotool", move_to(ox + SQ_X + 52.0, oy + SQ_Y + 42.0))
            let _ = shell("xdotool", #["mouseup", "1"])
        }

        // ---- gesture C: three moves, over three different things ---------------------------
        //
        // The square spans x 100..228 and y 80..208, the target starts at x 400, y 400. So the
        // first of these moves is still over the square — another element, with a listener of its
        // own, in front of the full-window one — the second is over empty space, and the third is
        // over the target. All three must reach the full-window listener.
        if f == 11 && gpui::state_int("phase", 0) == 2 {
            gpui::set_int("phase", 3)
            let ox = gpui::state_float("ox", -1.0)
            let oy = gpui::state_float("oy", -1.0)
            let _ = shell("xdotool", move_to(ox + SQ_X + 50.0, oy + SQ_Y + 40.0))
            let _ = shell("xdotool", #["mousedown", "1"])
            let _ = shell("xdotool", move_to(ox + SQ_X + 70.0, oy + SQ_Y + 60.0))
            let _ = shell("xdotool", move_to(ox + 280.0, oy + 300.0))
            let _ = shell("xdotool", move_to(ox + 450.0, oy + 450.0))
            let _ = shell("xdotool", #["mouseup", "1"])
        }

        // ---- draining ----------------------------------------------------------------------
        //
        // Over a window of frames rather than one: the gesture is posted with this callback
        // blocked, so its events are queued before it returns, but *when* gpui hands them over is
        // the platform's business and round 93 measured it can be the next iteration. The claim
        // is about the events' content and their order, not the frame they land in.
        //
        // The `pointer_xy` calls are **here**, in the frame's own closure, and not inside the
        // helpers they feed. That is round 93's finding, met a second time this round inside a
        // function called `drain`: a pair-returning binding called from a module-level function
        // faults under the JIT (`gossamer: fault inside JIT-compiled body 'drain'`, exit 127).
        // See "Notes and limits" in `README.md`.
        let which = if f >= 4 && f <= 6 { "a" } else if f >= 8 && f <= 10 { "b" } else if f >= 12 && f <= 14 { "c" } else { "" }
        if which != "" {
            for event in gpui::take_events() {
                let id, kind = gpui::event_parts(event.clone())
                let x, y = gpui::pointer_xy(event.clone())
                if id == "window" {
                    pointer_event(which.clone(), kind, x, y)
                } else if id == "item0" {
                    press_event(which.clone(), x, y)
                }
            }
        }

        if f == 15 {
            report()
            gpui::quit()
        }

        // The example's shape: a full-window listener at the bottom of the stack, a square over
        // it that hears only `down`, and a drop target over both.
        let overlay = gpui::on_mouse(gpui::rect("w=800 h=600"), "up move", "window")
        let square = gpui::on_mouse(
            gpui::rect(f"absolute left={SQ_X} top={SQ_Y} w=128 h=128 bg=#cccccc"),
            "down",
            "item0",
        )
        let target = gpui::on_mouse(
            gpui::rect("absolute left=400 top=400 w=200 h=100 bg=#dddddd"),
            "up",
            "target",
        )
        let root = gpui::child(gpui::child(gpui::child(gpui::stack("size=full bg=white"), overlay), square), target)
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}

/// Where the window's own origin sits on the screen, remembered the first time it is asked and
/// answered from the store after; `-1.0, -1.0` when there is no window to ask.
fn place_window() {
    let found = shell("xdotool", #["search", "--name", TITLE])
    let hits = found.lines()
    if hits.is_empty() {
        println(f"FAIL MP3 no window named {TITLE} on this display (xdotool said `{found}`)")
        gpui::set_float("ox", -1.0)
        gpui::set_float("oy", -1.0)
        return
    }
    let geometry = shell("xdotool", #["getwindowgeometry", "--shell", hits[0].trim().clone()])
    let ox = gpui::window_field("inner_x")
    let oy = gpui::window_field("inner_y")
    let wx = field(geometry, "X")
    let wy = field(geometry, "Y")
    gpui::set_float("ox", ox)
    gpui::set_float("oy", oy)
    let where_the_window_is = point(wx, wy)
    let where_the_binding_says = point(ox, oy)
    if where_the_window_is != where_the_binding_says {
        println(f"note MP3 xdotool puts the window at {where_the_window_is} and the binding at {where_the_binding_says}; posting relative to the binding's")
    }
}

fn origin_x() -> f64 {
    if gpui::state_int("placed", 0) == 0 {
        place_window()
        gpui::set_int("placed", 1)
    }
    gpui::state_float("ox", -1.0)
}

fn origin_y() -> f64 {
    gpui::state_float("oy", -1.0)
}

/// One pointer event of the gesture called `which`, as the full-window listener saw it: the
/// point it carried, and — for an arming gesture — whether the drag had been armed before it.
///
/// The point and the modifiers arrive as **arguments**, taken off the event by the frame's own
/// closure, and that is not a style choice: `gpui::pointer_xy` returns a pair of floats and round
/// 93 measured that calling it from a module-level function faults under the JIT inside the
/// callee. See "Notes and limits" in `README.md`.
fn pointer_event(which: String, kind: String, x: f64, y: f64) {
    if kind != "move" {
        return
    }
    // Which move of this gesture this is, counting from one.
    let n = gpui::state_int(f"{which}.moves.n", 0) + 1
    gpui::set_int(f"{which}.moves.n", n)
    // Every move the window raised, in order, whatever is under the pointer.
    gpui::list_push_float(f"{which}.moves", x)
    gpui::list_push_float(f"{which}.moves", y)
    // And the arming rule, which is upstream's: `> 2.0` of a **magnitude** from the press. The
    // first move to pass it is the one recorded, and `0` means none did.
    let press_x = gpui::state_float("press.x", 0.0)
    let press_y = gpui::state_float("press.y", 0.0)
    let dx = x - press_x
    let dy = y - press_y
    let away = math::sqrt(dx * dx + dy * dy)
    if away > THRESHOLD && gpui::state_int(f"{which}.armed.at", 0) == 0 {
        gpui::set_int(f"{which}.armed.at", n)
    }
}

/// The press and the release, which are the square's and the listener's respectively.
fn press_event(which: String, x: f64, y: f64) {
    gpui::set_float("press.x", x)
    gpui::set_float("press.y", y)
    gpui::set_int(f"{which}.moves.n", 0)
    gpui::set_int(f"{which}.armed.at", 0)
}

/// The verdict, and the whole of the check. Every branch prints its own line, because a check
/// that passes by falling through is a check that has stopped checking.
fn report() {
    let mut bad = 0

    // 1. The two edges of the threshold, from one press at a known point. The moves are posted
    //    2 px and 3 px away, and the origin cancels out of the difference, so these are exact.
    bad = bad + check_edge("a", "the first gesture")

    // 2. The magnitude: 2 across and 2 down is 2.83 px, over the threshold although neither axis
    //    is.
    let diagonal = gpui::state_int("b.armed.at", 0)
    if diagonal == 1 {
        println("ok     MP3 a move of 2 px across and 2 px down armed the drag, so what is measured is the distance and not either axis")
    } else {
        println(f"FAIL MP3 the diagonal move of 2.83 px did not arm the drag (armed at move {diagonal}, and 0 is none), so the distance is not being measured as a magnitude")
        bad = bad + 1
    }

    // 3. The three moves a drag raises as it crosses three different things: the square it
    //    started in, empty space, and the drop target — each of the first and last another
    //    element with a listener or a hitbox of its own. All three must reach the full-window
    //    listener, each carrying its own point, and in the order they were posted.
    bad = bad + check_points("c.moves", #[
        SQ_X + 70.0, SQ_Y + 60.0,
        280.0, 300.0,
        450.0, 450.0,
    ], "the moves of a drag that left the square")

    if bad == 0 {
        println("OK MP3 a full-window listener heard every move of a drag — over the square, over empty space and over the target — each with its own point, and gpui's 2.0 px threshold could be computed from them")
    }
}

/// Whether gesture `which` armed on its second move — the 3.00 px one — and not on the 2.00 px
/// one before it, which is the whole of the `>` in gpui's comparison.
fn check_edge(which: String, what: String) -> i64 {
    let armed_at = gpui::state_int(f"{which}.armed.at", 0)
    let heard = gpui::state_int(f"{which}.moves.n", 0)
    if armed_at == 2 {
        println("ok     MP3 a move of exactly 2.00 px did not arm the drag and the next one, at 3.00 px, did")
        return 0
    }
    if armed_at == 1 {
        println("FAIL MP3 the drag armed on the move 2.00 px from the press; gpui's comparison is `> 2.0` (elements/div.rs:2160), so only the 3.00 px move should have armed it")
        return 1
    }
    if armed_at == 0 {
        println(f"FAIL MP3 none of the {heard} move(s) that reached the window armed the drag, so the threshold is not being applied at all")
        return 1
    }
    println(f"FAIL MP3 {what} armed on move {armed_at}, not the second — the moves the window raised were not both heard, or not in the order they were posted")
    1
}

/// Whether `key`'s points are `want`, and a line for each one that is not. A short list is
/// reported as such, because a move that never arrived is the failure this probe exists for.
fn check_points(key: String, want: Vec<f64>, what: String) -> i64 {
    let points = gpui::list_all_float(key.clone())
    let want_n = want.len() as i64
    let got_n = points.len() as i64
    if got_n != want_n {
        let heard = got_n / 2
        let posted = want_n / 2
        println(f"FAIL MP3 {what}: the window raised {heard} of the {posted} moves that were posted, so a drag that leaves the element is not fully heard")
        return 1
    }
    let mut bad = 0
    for i in 0..want_n {
        let got = points[i]
        let should = want[i]
        if !same(got, 0.0, should, 0.0) {
            let n = i / 2
            let axis = if i % 2 == 0 { "x" } else { "y" }
            let got_at = point(got, 0.0)
            let want_at = point(should, 0.0)
            println(f"FAIL MP3 {what}: point {n}'s {axis} is {got_at}, not {want_at}")
            bad = bad + 1
        }
    }
    bad
}
