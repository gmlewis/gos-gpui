// TM1 — measure a text run.
//
// Tier: every tier.
//
// A measurement is one number, and the honest way to check one without baking a
// font's metrics into a test is to check the *relationships* between several —
// the same string twice as wide at twice the size, two copies of a word wider
// than one, a capital W wider than a lowercase i. None of those depend on which
// font this machine happens to resolve.
//
// Pass means:
//
//   * a width, an em width and a line height all come back positive
//   * doubling the size doubles the width
//   * two words are wider than one
//   * `W` advances further than `i`
//   * a size asked for explicitly beats the window's inherited one

use gpui
use std::process

fn main() {
    let outcome = gpui::run("tm1 - measure text", 320.0, 200.0, || {
        let f = gpui::frame()

        if f >= 2 {
            let base = gpui::text_width("hello", "fs=20")
            let doubled = gpui::text_width("hello", "fs=40")
            let two = gpui::text_width("hellohello", "fs=20")
            let em = gpui::text_em_width("fs=20")
            let wide = gpui::text_advance("W", "fs=20")
            let narrow = gpui::text_advance("i", "fs=20")
            let line = gpui::text_line_height("fs=20")
            let inherited = gpui::text_width("hello", "")
            let bigger = gpui::text_width("hello", "fs=32")

            if base <= 0.0 || em <= 0.0 || line <= 0.0 || inherited <= 0.0 {
                println(f"FAIL TM1 a measurement came back non-positive: width={base} em={em} line={line} inherited={inherited}")
                gpui::quit()
            } else if two <= base {
                println(f"FAIL TM1 two copies of a word measure {two}, no wider than one at {base}")
                gpui::quit()
            } else if doubled < base * 1.8 || doubled > base * 2.2 {
                println(f"FAIL TM1 doubling the size gave {doubled} rather than about twice {base}")
                gpui::quit()
            } else if wide <= narrow {
                println(f"FAIL TM1 \"W\" advances {wide}, no further than \"i\" at {narrow}")
                gpui::quit()
            } else if bigger <= inherited {
                println(f"FAIL TM1 the inherited size ({inherited}) is not smaller than an explicit fs=32 ({bigger})")
                gpui::quit()
            } else {
                // No numbers in the verdict: they are measured, and a verdict
                // that carries them can differ from one tier to the next. They
                // are recorded in the evidence instead.
                println("OK TM1 a text run is measurable, and the measurements scale and order the way text does")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 bg=#111111 size=full")
        gpui::child(root, gpui::text("measuring", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL TM1 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
