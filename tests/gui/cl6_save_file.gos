// CL6 — the save-file picker (`prompt_for_new_path`).
//
// **One window, one press.** The probe asks where to save, with a name already suggested; the platform shows
// its own panel; you press Save. Nothing in the window itself needs clicking.
//
// The chosen path comes back as **text** under `"cl6.path"`, and the event `"cl6"` carries `"saved"`,
// `"cancelled"` or `"failed"`.
//
// Run with `DSH_ALLOW_WINDOWS=1 ./scripts/run-once tests/gui/cl6_save_file.gos 120`.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("CL6 — save-file picker", 560.0, 220.0, || {
        let f = gpui::frame()

        if f == 2 {
            gpui::save_file("cl6", "/tmp", "gpui-cl6-saved.txt")
            println("CL6 asked where to save — the platform's panel should be up, in /tmp, with a name suggested")
        }

        for event in gpui::take_events() {
            let name, payload = gpui::event_parts(event)
            if name != "cl6" {
                continue
            }
            if payload == "saved" {
                let path = gpui::state_text("cl6.path", "")
                println(f"CL6 the panel answered \"{path}\"")
                if path == "" {
                    println("FAIL CL6 the event says saved but no path was left behind")
                } else {
                    println("OK CL6 the save panel's path reached the program, and the panel opened where it was asked to")
                }
            } else if payload == "cancelled" {
                println("OK CL6 (cancelled) the save panel answered, and said so rather than nothing")
            } else {
                println("FAIL CL6 the save panel reported a failure")
            }
            gpui::quit()
            return
        }

        if gpui::now() > 100.0 {
            println("FAIL CL6 no answer in 100 seconds — the panel was not answered")
            gpui::quit()
        }

        gpui::animate()
        let root = gpui::column("p=10 size=full bg=#111111")
        gpui::child(root, gpui::text("CL6 — press Save in the panel", "color=#ffffff"))
        gpui::child(root, gpui::text(f"{gpui::now()}s", "color=#888888"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL CL6 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
