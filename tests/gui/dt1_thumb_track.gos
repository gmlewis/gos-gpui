// DT1 — the data table's scrollbar thumb is placed by upstream's own rule.
//
// container: it opens a window, so it runs under the container's own X server rather than here.
//
//   ./scripts/gosbox.sh run tests/gui/dt1_thumb_track.gos
//
// # What this exists for
//
// `examples/02_data_table.gos` carried a deviation saying the thumb "is drawn at a fixed
// 100px, not from the list's visible height ... and only its *position* is computed. The track
// is `scroll_bounds("items", "h")` less the thumb, and the fraction is `-scroll_top /
// scroll_height` as upstream has it, so the thumb sits where upstream would put it."
//
// Two things in that are false, and they are the two things this probe was written against.
//
// **Upstream's thumb is not sized from the visible height.** It is
// `.h(SCROLLBAR_THUMB_HEIGHT)`, a fixed `px(100.)` (`tools/upstream/examples/data_table.rs:14`),
// and the port's `THUMB_HEIGHT` is the same 100 — so the *height* was never a difference and the
// first half of the bullet described one that does not exist.
//
// **The position formula was not upstream's.** Upstream (`:293-305`) is
//
// ```text
// let percentage = -self.scroll_top() / scroll_height;
// let offset_top = (table_height * percentage).clamp(
//     px(4.),
//     (table_height - SCROLLBAR_THUMB_HEIGHT - px(4.)).max(px(4.)),
// );
// ```
//
// where `table_height` is the list's viewport (`base_handle.bounds().size.height`, `:279-283`)
// and `scroll_height` is `last_item_size.contents.height` (`:285-291`) — the **whole content**,
// rows times row height. The port used `scroll_max_offset`, which is the content *less the
// viewport* (`gpui-0.2.2/src/elements/div.rs:1745-1747`), as the denominator, multiplied it by
// the viewport less the thumb rather than by the viewport, and applied no clamp at all.
//
// Round 95 deleted the bullet and gave the example upstream's own expression. The rule it
// carried before is kept in this probe, in `was_top`, so the failure can be reproduced from the
// probe alone; `tests/evidence/dt1.before.txt` is that run, and on a 10 000-row table in a
// 400-pixel viewport it is 20.8 px apart a quarter of the way down, 45.6 px at the middle, 67.0 px
// at three quarters, and a thumb that runs from 304 to 404 in a 400-pixel track at the end.
//
// # What it measures, and what it is not
//
// The numbers below — the viewport height, the maximum offset, and the scroll offset the list
// actually comes to rest at — are read off a **real list in a real window**, at five points
// across the range, with `gpui::scroll_offset`, `gpui::scroll_max_offset` and
// `gpui::scroll_bounds`. The two rules are then evaluated on those numbers. So what is checked is
// the binding's numbers and the arithmetic. That the arithmetic is the same arithmetic the
// example now carries is a matter of the transcription below, and the transcription is by eye.
//
// It is **not** `examples/02_data_table.gos`: a probe cannot import `ui` — `gos check` answers
// "error[GR0005]: module `ui` does not exist" for a file outside `examples/` — and the example is
// not a module, so neither `port_top` below nor upstream's is a call into it. That
// transcription is the one soft joint in this check, exactly as it is in
// `tests/gui/mp3_drag_threshold.gos`; the example's own copy is exercised by running it, which
// `./scripts/tiers.sh` and `./scripts/regress.sh 02` do.
//
// Two more things came out of writing this down. Neither is fixed here, and both are recorded in
// `CAPABILITIES.md`'s `DW8` row and in `PAIRS.md` §3 rather than in the example.
//
// The first is that `ui::scrollbar` exists and is the obvious thing to reach for. Its thumb,
// though, is the track's *share of the document* — `thumb_pixels` in `gpui-binding/src/scroll.rs`
// computes `track * track / (track + max)`, floored at a 24-pixel minimum. On ten thousand rows in
// a 400-pixel track that is 0.73 px, floored to 24, where upstream draws 100. Reaching for it would
// have traded this deviation for a much larger one, and that is why the example keeps its own
// thumb.
//
// The second is that upstream's *drag* mapping turns out to be reachable after all. It needs the
// pressed thumb's own rectangle in window pixels, and a program has every term of it: the pointer
// in the window from `gpui::pointer_xy`, the list's origin from `gpui::scroll_bounds("items", "y")`,
// and the thumb's top from the placement rule above. It is not written here because a drag needs a
// real pointer and this probe drives none — `KM7`, `DD2`, `DD4` and `MR4` are where that would be
// watched.
//
// The second assertion below is not about matching upstream at all: a thumb that is *placed* by a
// rule must not hang past the bottom of the track it slides on. Upstream's clamp guarantees that;
// the rule the port carried did not, and that is a picture anyone can see.

use gpui
use std::process

/// Upstream's `TOTAL_ITEMS` and the row height `ui::list` takes, from the example.
const ITEMS: i64 = 10_000
const ROW_H: f64 = 22.0

/// Upstream's `SCROLLBAR_THUMB_HEIGHT` (`data_table.rs:14`) — fixed, and the same on both sides.
const THUMB_H: f64 = 100.0

/// Upstream's `px(4.)`, the margin the clamp keeps at each end.
const MARGIN: f64 = 4.0

/// The points of the range the thumb is placed at: the top, three across the middle, and the end.
const FRACS: Vec<f64> = #[0.0, 0.25, 0.5, 0.75, 1.0]

fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        lo
    } else if v > hi {
        hi
    } else {
        v
    }
}

fn clamp01(v: f64) -> f64 {
    clamp(v, 0.0, 1.0)
}

/// The rule `examples/02_data_table.gos` carries now, transcribed from its `scrollbar()`.
///
/// It is upstream's expression (`data_table.rs:301-305`) with `max + h` standing in for the
/// content height the binding has no name for, and `THUMB_MARGIN` for `px(4.)`.
fn port_top(at: f64, max: f64, h: f64) -> f64 {
    let content = max + h
    let percentage = if content > 0.0 { clamp01(-at / content) } else { 0.0 }
    let ceiling = if h - THUMB_H - MARGIN > MARGIN {
        h - THUMB_H - MARGIN
    } else {
        MARGIN
    }
    clamp(h * percentage, MARGIN, ceiling)
}

/// Upstream's rule, transcribed from `tools/upstream/examples/data_table.rs:301-305` with the
/// two quantities it reads (`:279-291`) spelled in the binding's terms.
///
/// `scroll_height` is the whole content, and the binding has no name for it — but it does not
/// need one: `max_offset` is `content - viewport`, so `max + h` *is* the content.
///
/// Written out separately from `port_top` rather than shared with it, because it is the thing
/// being checked: the two agreeing is a finding, and a single function compared with itself
/// would not be one.
fn upstream_top(at: f64, max: f64, h: f64) -> f64 {
    let content = max + h
    let percentage = if content > 0.0 { -at / content } else { 0.0 }
    let floor = MARGIN
    let ceiling = if h - THUMB_H - MARGIN > MARGIN {
        h - THUMB_H - MARGIN
    } else {
        MARGIN
    }
    clamp(h * percentage, floor, ceiling)
}

/// The rule `examples/02_data_table.gos` carried *before* round 95, kept as this probe's
/// negative control.
///
/// Without it the check above would be two transcriptions of one expression, and a green would
/// say only that a function equals itself. With it, the probe shows on the same live numbers
/// that it can tell two rules apart — and that the one the example carried is one of the ones it
/// tells apart.
fn was_top(at: f64, max: f64, h: f64) -> f64 {
    if max <= 0.0 {
        return MARGIN
    }
    let track = h - THUMB_H
    let track = if track > 0.0 { track } else { 0.0 }
    MARGIN + clamp01(-at / max) * track
}

/// How far apart two placements are, in pixels.
fn gap(a: f64, b: f64) -> f64 {
    let d = a - b
    if d < 0.0 {
        -d
    } else {
        d
    }
}

/// Whether two placements differ by more than a hundredth of a pixel. A hundredth and not a
/// tenth: the difference this probe is about is tens of pixels, so anything under a hundredth is
/// a pair of expressions that agree.
fn differs(a: f64, b: f64) -> bool {
    gap(a, b) > 0.01
}

/// The list's row builder, handed to `gpui::run_with_rows` rather than to `gpui::list`: `run` is
/// the only binding call that does not return, and a callback handed to any other binding call is
/// released when that call returns. The list id comes first so one builder can serve every list.
fn list_row(_list: String, i: i64) -> i64 {
    gpui::text(f"row {i}", "p=2 color=#ffffff")
}

fn main() {
    let outcome = gpui::run_with_rows("dt1 - the thumb's track", 800.0, 600.0, "", list_row, || {
        let f = gpui::frame()
        gpui::animate()

        let i = gpui::state_int("i", 0)
        let reading = gpui::state_int("reading", 0)
        let bad = gpui::state_int("bad", 0)
        // The negative control's own two numbers: how many of the five points it disagrees with
        // upstream at, and by how much at worst.
        let control = gpui::state_int("control", 0)
        let worst = gpui::state_float("control.worst", 0.0)

        // The list is a 10 000-row table in a 400-pixel viewport, which is the example's shape
        // with the window's own chrome taken out of the arithmetic.
        let list = gpui::list("items", ITEMS, ROW_H, "h=400 w=300")
        let root = gpui::column("p=8 bg=#111111 size=full color=#ffffff")
        gpui::child(root, list)
        gpui::root(root)

        // A frame is spent letting the list lay out before anything is asked of it; then one
        // frame to ask for an offset and the next to read back the offset the list came to rest
        // at, because `scroll_to` is applied during the prepaint that follows it.
        if f < 3 {
            return
        }

        let max = gpui::scroll_max_offset("items", "y")
        if max <= 0.0 {
            println(f"FAIL DT1 the list reports no scrollable content (max offset {max:.1}), so the thumb has nothing to be placed on")
            gpui::quit()
            return
        }

        if i >= 5 {
            // The control's verdict, and the reason this probe is not two copies of one
            // expression: at the top of the range both rules put the thumb at 4, so four of the
            // five is the most a rule that differs can differ at.
            let mut fail = bad
            let h0 = gpui::state_float("h0", 0.0)
            if control == 4 {
                println(f"ok     DT1 the rule the example carried before round 95 disagrees with upstream's at {control} of the 5 points, by up to {worst:.1} px, so this check tells the two apart")
            } else {
                println(f"FAIL DT1 the rule the example carried before round 95 disagrees with upstream's at {control} of the 5 points and not 4, so this check is not reading the numbers it thinks it is")
                fail = fail + 1
            }
            if fail == 0 {
                println(f"OK DT1 on a real {ITEMS}-row list in a {h0}-pixel viewport the rule the example carries and upstream's put the thumb at the same pixel at all five points, and the thumb never runs past the end of its track")
            } else {
                println(f"FAIL DT1 {fail} finding(s) across the five points: a placement upstream's rule does not make, a thumb off the end of its track, or a control that would pass either way")
            }
            gpui::quit()
            return
        }

        if reading == 0 {
            gpui::scroll_to("items", 0.0, -FRACS[i] * max)
            gpui::set_int("reading", 1)
            return
        }

        let h = gpui::scroll_bounds("items", "h")
        let at = gpui::scroll_offset("items", "y")
        gpui::set_float("h0", h)
        let top = port_top(at, max, h)
        let up = upstream_top(at, max, h)

        if differs(top, up) {
            println(f"FAIL DT1 at {at:.1} of {max:.1} in a {h:.1}-pixel viewport the example's thumb sits at {top:.1} and upstream's at {up:.1} -- {gap(top, up):.1} px apart")
            gpui::set_int("bad", bad + 1)
        } else {
            println(f"ok     DT1 at {at:.1} of {max:.1} in a {h:.1}-pixel viewport both put the thumb at {up:.1}")
        }

        // The property, not the comparison: the thumb is the last thing on the track, so its own
        // height has to fit inside the track at the point the track is fullest.
        if top + THUMB_H > h + 0.01 {
            println(f"FAIL DT1 at {at:.1} the thumb runs from {top:.1} to {top + THUMB_H:.1}, past the bottom of a {h:.1}-pixel track")
            gpui::set_int("bad", bad + 1)
        }

        // And the control, counted rather than reported point by point — the point-by-point
        // account of the rule it replaces is `tests/evidence/dt1.before.txt`.
        let away = gap(was_top(at, max, h), up)
        if away > 0.01 {
            if away > worst {
                gpui::set_float("control.worst", away)
            }
            gpui::set_int("control", control + 1)
        }

        gpui::set_int("reading", 0)
        gpui::set_int("i", i + 1)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL DT1 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
