// MR2 — the `App` accessor batch: hiding the application, refreshing its windows, and the keyboard layout.
// linux: the witness is macOS's window server — this probe asks CoreGraphics which window its process owns — so the container has nothing to ask.
//
// **Two calls, and the window server as the witness.** `gpui::hide()` puts the whole application away —
// every window of it — and nothing comes back to the binding. What *can* be asked is the window server:
// this process asks CoreGraphics for the window **it** owns (`CGWindowListCopyWindowInfo`, filtered by
// this process's own pid, through `osascript`), and the answer is both the instrument and the check.
//
//   * Before the call the lookup answers a window number, and `screencapture -l <number>` writes
//     `tests/evidence/MR2.before.png` — **the window's own pixels only**, whatever else is stacked over it
//     at the time, and with no desktop around it. That is what `-l` is for, and it is why this probe's
//     picture does not change when the person running it switches workspace.
//   * After the call the lookup answers `0`: no window of this process is on the screen any more. **That
//     is the assertion**, and it is the program's own, not something a person has to read out of a PNG.
//     The picture is corroboration; the zero is the check.
//
// The lookup needs no permission — a window's owner pid, layer and number are not privileged; only its
// *name* is, and this probe does not ask for one. The capture does need Screen Recording, which
// `screencapture` from this shell has; where it is missing the probe says so on the FAIL line rather than
// passing quietly without its evidence.
//
// A hidden window's frame loop all but stops — the frame after the call arrives within a tick and then
// nothing for a minute or more — so the second look is taken on that one frame, and the program ends
// there rather than waiting for a frame that will not come. `gpui::quit()` posted from it is carried out.
//
// `gpui::refresh()` has **no observable at all**: it asks the platform to re-read its windows, and this
// binding neither waits for it nor hears from it. The probe calls it so the call itself is exercised, and
// says plainly that nothing can be concluded from it.
//
// `gpui::keyboard_layout()` is reported on the first frame — a real answer off the platform, and the
// "companions" half of the row, which already existed.
//
// This is the Hide that a program cannot get from its application menu: gpui 0.2.2 offers no `os_action`
// for it, which is why MN2's row found it inexpressible there.
//
// Run with `DSH_ALLOW_WINDOWS=1 ./scripts/run-once.sh tests/gui/mr2_hide.gos 60`.

use gpui
use std::fs
use std::process
use std::strings
use std::time

/// The CoreGraphics number of the window **this process** owns and has on screen, or `"0"` for none.
///
/// The window server's list is filtered by this process's own pid, so the answer is this program's
/// window and nobody else's — a title would have to be spelled the same way twice, and a title is the one
/// field of a window that needs Screen Recording to read. `kCGWindowLayer == 0` keeps the ordinary
/// windows and leaves out the menu-bar and status-item layers, which are not this program's to claim.
///
/// **`kCGWindowIsOnscreen` is the field that answers, and it was found by looking rather than assumed.**
/// The obvious query is `kCGWindowListOptionOnScreenOnly`, and it is wrong here: `NSApp.hide:` orders an
/// application's windows out *without* taking them out of the window server's list, so that query still
/// named this window after `hide()` had visibly put it away — measured, at `on=true` before the call and
/// still listed after it. What does change is this flag: `true` while the window is on the screen, and
/// **absent** once it is not. So the list is asked for *every* window of this process and the flag does
/// the choosing, which is the difference between a check that can fail and one that always passes.
///
/// It is a **question to be repeated, not read once**: one run in four had the hide land between the
/// call and the next frame and another had it not land at all yet — `NSRunningApplication.isHidden` said
/// `false` a millisecond after the call, which is the platform being asked before it had done anything.
/// The caller waits for this to answer `"0"` rather than reading the first answer.
fn window_number() -> String {
    let script = "ObjC.import('CoreGraphics');function run(argv){var p=argv[0];var a=ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo(0,0)));for(var i=0;i<a.length;i++){if(String(a[i].kCGWindowOwnerPID)===p&&a[i].kCGWindowIsOnscreen===true&&Number(a[i].kCGWindowLayer)===0){return a[i].kCGWindowNumber;}}return 0;}"
    let args: Vec<String> = #["-l", "JavaScript", "-e", script, f"{process::id()}"]

    match process::run("osascript", args) {
        Ok(out) => strings::trim(out.stdout),
        Err(problem) => {
            println(f"FAIL MR2 could not ask the window server which window this process owns: {problem}")
            "0"
        }
    }
}

/// Capture the window this process owns — its own pixels, and nothing stacked over it — and say what was
/// written. Answers the window number it captured, or `"0"` when there was no window to capture.
fn capture_window(path: String) -> String {
    let number = window_number()
    if number == "0" {
        println(f"FAIL MR2 no window of this process is on screen, so {path} was not written")
        return number
    }

    let args: Vec<String> = #["-x", "-o", "-l", number, path]
    match process::run_inherit("screencapture", args) {
        Ok(code) => {
            if code != 0 {
                println(f"FAIL MR2 screencapture exited {code} for window {number}")
                return "0"
            }
        }
        Err(problem) => {
            println(f"FAIL MR2 could not run screencapture: {problem}")
            return "0"
        }
    }

    match fs::metadata(path) {
        Ok(info) => {
            if info.size == 0 {
                println(f"FAIL MR2 the capture {path} is empty")
                return "0"
            }
            println(f"MR2 wrote {path} — {info.size} bytes: window {number} alone, with whatever was stacked over it left out")
            number
        }
        Err(problem) => {
            println(f"FAIL MR2 the capture {path} is not there: {problem}")
            "0"
        }
    }
}

fn main() {
    let outcome = gpui::run("MR2 — hide the application", 600.0, 240.0, || {
        let f = gpui::frame()

        if f == 1 {
            let layout = gpui::keyboard_layout()
            println(f"MR2 the keyboard layout this machine is using is \"{layout}\"")
            if layout.len() == 0 {
                println("FAIL MR2 the platform named no keyboard layout")
            }
            gpui::ask_active_window()
        }

        if f == 2 {
            let active = gpui::active_window()
            println(f"MR2 before hiding, the platform names window {active} as the active one")
            if active == 0 {
                println("MR2 0 means this application was not the frontmost one while the probe ran, which is the usual answer when a terminal started it — the hide below does not depend on that, and the window server is asked about this process's own window either way")
            }
        }

        // The frames a hidden application gets. The hide is carried out by the platform on its own
        // schedule — the request is drained inside a frame and AppKit then orders the windows out — so
        // the probe **waits for the platform to agree** rather than reading the answer the moment the
        // call returns, and then ends: the frame loop is stopping, and `quit()` posted from here is
        // carried out at the end of this frame.
        if gpui::state_bool("mr2.hidden", false) {
            let arrived = gpui::now()
            let mut waited = 0
            let mut number = window_number()
            while number != "0" && waited < 5000 {
                time::sleep(250)
                waited = waited + 250
                number = window_number()
            }
            if number == "0" {
                println(f"MR2 the frame after hide() arrived at now={arrived}s, and {waited}ms later the window server lists no window of this process on the screen — the program is still running, and the application is away")
                println("OK MR2 hide() was carried out by the platform while the program stayed alive: the frame after the call arrived, the window left the window server's list, and the program is still running. refresh() was exercised with nothing to show for it")
            } else {
                println(f"FAIL MR2 5s after hide() the window server still lists window {number} of this process on the screen — the platform did not carry the call out")
            }
            gpui::quit()
            return
        }

        // A window that is up and drawing, so the "before" capture has something to show: five seconds of it.
        if gpui::now() > 5.0 {
            gpui::set_bool("mr2.hidden", true)
            if capture_window("tests/evidence/MR2.before.png") != "0" {
                println("MR2 that is the window as it is now — the application is on the screen, and this process's window will be looked for again once it has been hidden")
            }
            gpui::refresh()
            println("MR2 called refresh() — no observable, and none claimed")
            gpui::hide()
            println(f"MR2 called hide() at now={gpui::now()}s — the whole application should now be off the screen")
        }

        gpui::animate()
        let root = gpui::column("p=10 gap=6 size=full bg=#111111")
        gpui::child(root, gpui::text("MR2 — this window is about to hide the whole application", "color=#ffffff"))
        gpui::child(root, gpui::text("a capture of it is taken first, and another once it is away", "color=#aaaaaa"))
        gpui::child(root, gpui::text(f"{gpui::now()}s", "color=#888888"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL MR2 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
