// EX27 — where `27_window` puts its sub-windows: `place=center`.
//
// Tier: every tier.
//
// # What this exists for
//
// `tools/upstream/examples/window.rs:68-70` asks for every sub-window the same way:
//
//     let window_bounds =
//         WindowBounds::Windowed(Bounds::centered(None, size(px(300.0), px(300.0)), cx));
//
// `None` is the primary display, and `Bounds::centered` puts the window's centre on
// that display's centre. `place=center` carries that through to the option, so the
// sub-window spec is upstream's own call — no function of the port's recomputes the
// centred origin from `gpui::display_field(0, ..)` and hands it in as x and y.
//
// # What it measures, and what it is not
//
// The probe mirrors the port's own `open_sub`: it opens a second window through
// `gpui::open_window` — the same entry point, with the same 300x300 size — and the
// child reads its own options back. The assertion is the **asked-for** half, the value
// that went into `WindowOptions`, which is the whole of this crate's job:
//
//   * the placement the child was opened with is `center`, not the empty string a spec
//     that said nothing would leave; and
//   * the size it was opened with is upstream's 300x300, so the window being asked
//     about is the one `open_sub` opens.
//
// It is deliberately **not** where the window landed. The container's window manager
// places windows itself — gpui's X11 backend sets no ICCCM position hints, so openbox
// overrides the rectangle — which is why `wh4_display_place.gos` declares `// linux:`
// and is skipped in the sweep. The asked-for half is checkable there and here, and on
// every tier.
//
// # Soft joint
//
// A probe cannot `use ui` (`error[GR0005]: module \`ui\` does not exist` for a file
// outside `examples/`), so it cannot call the example's own `open_sub`; the spec that
// function opens with is **transcribed** here, as DT1's, DT2's and MP3's rules are.
// What exercises the example's own copy is the five tiers over
// `examples/27_window.gos`.
//
// # The red
//
// With x and y computed from `display_field(0, ..)` and no `place=` at all, the readback
// is empty and the first check fails:
// `FAIL EX27 the child was opened with a placement of "", not the \`center\` upstream's
// Bounds::centered(None, ..) asks for`. `tests/evidence/EX27.before.txt` is that
// transcript.

use gpui
use std::process

/// The sub-window's view — the one `gpui::run` was given, running for a window that is
/// not the host.
fn child_view() {
    let f = gpui::frame()

    if f >= 2 {
        let place = gpui::window_option("place")
        let w = gpui::window_field("w")
        let h = gpui::window_field("h")

        if w != 300.0 || h != 300.0 {
            println(f"FAIL EX27 the child is {w}x{h}, not the 300x300 upstream opens every sub-window at")
            gpui::quit()
        } else if place != "center" {
            println(f"FAIL EX27 the child was opened with a placement of \"{place}\", not the `center` upstream's Bounds::centered(None, ..) asks for")
            gpui::quit()
        } else {
            println("OK EX27 the sub-window `27_window` opens asks for `place=center` — upstream's own `Bounds::centered(None, size(px(300.), px(300.)), cx)` — rather than a centred origin the port computed itself")
            gpui::quit()
        }
    }

    gpui::animate()
    let root = gpui::column("size=full bg=#ffffff")
    gpui::child(root, gpui::text("SubWindow", "color=#000000"))
    gpui::root(root)
}

fn main() {
    let outcome = gpui::run("ex27 - subwindow placement", 320.0, 200.0, || {
        // Every window runs this view; the host is 1 and the sub-window is the rest.
        if gpui::window_id() != 1 {
            return child_view()
        }

        // The spec `examples/27_window.gos`'s `open_sub` opens a normal sub-window
        // with: upstream's size, and `place=center` appended to that button's own
        // options — which for "Normal" are none.
        if gpui::frame() == 2 {
            gpui::open_window("", 0.0, 0.0, 300.0, 300.0, "place=center")
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#ffffff")
        gpui::child(root, gpui::text("27 - window", "color=#000000"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL EX27 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
