// W6 — editor instances are per (window, key).
//
// Tier: every tier.
//
// Two windows each draw `gpui::editor("note", ..)` — the same key — and each
// holds different text under it. The editor is the binding's, not the program's:
// it owns an entity, a caret, a selection and a focus handle, and that entity is
// registered under `(window, key)`. A registry keyed by `key` alone would hand
// the second window the first window's editor, and every write it makes would
// land in the first window's state.
//
// The observation is `gpui::editor_text`, and this probe is why that reader
// exists. Until the editor went multi-line its instrument was a side effect: a
// single-line editor normalised a newline into a space on the way in and stored
// the result back, so "was the child's text normalised" answered "did the
// child's own editor adopt it". A multi-line editor keeps its breaks and
// publishes nothing the program did not write, so that write-back is gone — and
// the store read cannot replace it, because each window has its own store and
// both hold exactly what the program put there whether or not any editor
// adopted it. What distinguishes a window's own editor from a shared one is what
// the *widget* is holding, which is what `gpui::editor_text` answers.
//
// The child's text has two lines and the first window's has one, so a line count
// is the discriminator, and a stray keystroke from whoever is at the keyboard
// (the editor takes focus when it is created) cannot forge it. Only the *wrong*
// outcomes are named exactly, for the same reason: a stray character must not
// read as a failure of the binding.
//
// Pass means each window's own editor is holding its own text after both have
// been alive for several frames.

use gpui
use std::process

/// The second window's view.
///
/// One view callback serves every window — the one `gpui::run` was given — and
/// `window::allocate` gives the window `run` opened the first id, 1, so anything
/// else is a window this program opened. The child is not given a callback of its
/// own passed to `gpui::open_window`; that call returns before the window is
/// drawn, and a callback handed to a binding function is valid only for that
/// call, so the child's view would answer an error on the compiled tiers.
fn child_view() {
    let cf = gpui::frame()
    if cf >= 3 {
        let theirs = gpui::editor_text("note")
        if theirs == "" {
            println("FAIL W6 the child window has no editor of its own on that key")
            gpui::quit()
        } else if theirs == "alpha" {
            println("FAIL W6 the child window's editor is the first window's editor")
            gpui::quit()
        } else if gpui::text_lines(theirs) < 2 {
            println("FAIL W6 the child window's editor holds one line, not the two it was given")
            gpui::quit()
        }
    }
    gpui::animate()
    let field = gpui::editor("note", "type here", "p=4 minh=28")
    let root = gpui::column("p=8 bg=#222222 size=full")
    gpui::child(root, field)
    gpui::root(root)
}

fn main() {
    let outcome = gpui::run("w6 - editor per window", 360.0, 220.0, || {
        if gpui::window_id() != 1 {
            return child_view()
        }

        let f = gpui::frame()

        if f == 1 {
            gpui::set_text("note", "alpha")
            // The child's editor is created in the child window, so it seeds from the child
            // window's store — one line here, two there.
            gpui::set_text_in(2, "note", "beta\nline")
            gpui::open_window("w6 - child", 420.0, 80.0, 260.0, 160.0, "")
        }

        if f >= 3 {
            // The first window's editor must hold the first window's text. Named exactly, and
            // checked by line count, so a stray keystroke appending a character is not a failure.
            let mine = gpui::editor_text("note")
            if mine == "beta\nline" || gpui::text_lines(mine) > 1 {
                println("FAIL W6 the first window's editor is holding the child's text")
                gpui::quit()
            }
        }

        if f >= 8 {
            println("OK W6 two windows each held an editor on the same key, and each holds its own text")
            gpui::quit()
        }
        gpui::animate()

        let field = gpui::editor("note", "type here", "p=4 minh=28")
        let root = gpui::column("p=8 bg=#111111 size=full")
        gpui::child(root, field)
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL W6 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
