// DW12, the calls a drawn titlebar is made of — a program is handed all four, and the X
// server is asked whether each one got there.
//
// container: every call this row is about is a call into a *window manager*, and the one
// this image carries is `openbox` on Xvfb, driven from outside the process by `xdotool`
// through XTEST. The Mac has no X server to receive a pointer, and
// `scripts/window-guard.sh` keeps a window from opening there at all, so `scripts/probes.sh`
// and `scripts/tiers.sh` skip this one by name:
//
//   ./scripts/gosbox.sh tiers tests/gui/dw12_window_calls.gos
//
// # What this exists for
//
// `DW12` is a titlebar a program draws for itself, and gpui hands a program four calls to
// make one out of: `Window::request_decorations` (`gpui-0.2.2 src/window.rs:1455`),
// `Window::start_window_resize` (`:1460`), `Window::start_window_move` (`:1753`) and
// `Window::set_client_inset` (`:1758`) — plus `Window::window_decorations` (`:1769`) and
// `Window::client_inset` (`:1764`) to read the first and the last back. This probe is about
// the two that leave a record on the X server a program can read for itself. The other two
// move the window, and are checked in `tests/gui/dw12_drag_and_resize.gos`.
//
// # Pass means all three
//
//   * **the binding's word is the platform's**, not the program's request. The window
//     manager advertises in `_NET_SUPPORTED` whether a client may draw its own frame
//     (`_GTK_FRAME_EXTENTS`); from that advertisement alone a word is forced, and
//     `gpui::window_decorations()` must give exactly it — before *and* after the program
//     asks for `client`. That second reading is the one with teeth: asking changes nothing
//     on this display, so a binding that echoed the request back would answer `client`
//     where the window manager answered `server`.
//   * **and the X server agrees**: `_MOTIF_WM_HINTS` on the window carries the decoration
//     hint the same way round — a non-zero decorations field means the window manager
//     draws them. Two independent records, one answer.
//   * **the inset reaches the server**: `gpui::set_client_inset(12)` is read back by
//     `gpui::client_inset()` *and* appears on the window as `_GTK_FRAME_EXTENTS`. The second
//     is the one that matters: it is the X server's copy, which gpui wrote (and only wrote,
//     `src/platform/linux/x11/window.rs:1585`, when the value changed), not the binding
//     remembering its own argument.
//
// # What is not checked here
//
// The `Decorations::Client` arm itself. Entering it needs `compositor_present &&
// gtk_frame_extents_supported` (`src/platform/linux/x11/client.rs:358`) and this display
// fails the second half — the image has no compositor at all (`xcompmgr`, `picom` and
// `compton` are all absent) and openbox advertises 85 atoms in `_NET_SUPPORTED`, none of
// them `_GTK_FRAME_EXTENTS`. The advertisement is read below rather than assumed, which is
// why the checks are written against the word it forces and not against the literal
// `"server"`: an image that gained a compositor would move this probe onto the other arm
// rather than fail it. See `CAPABILITIES.md`, "Unreachable", for the arm itself.
//
// # The frame is built on every pass, and no check returns early
//
// The tree is described *after* the checks and every branch falls through to it. A check
// that returned out of the callback would leave the frame with no tree, no prepaint and no
// window at all for `xdotool` to find — the shape this class of probe hangs on.

use gpui
use std::os::exec
use std::process
use std::strconv
use std::strings

/// The name the window is opened with, and what `xdotool` is told to look for. One word, so
/// that the search cannot match anything else on the display.
const TITLE: String = "dw12calls"

/// How wide a strip this program claims for its own titlebar. Not 0 and not 1: a value a
/// default could have produced would pass a check that never reached the platform.
const INSET: f64 = 12.0

/// How long the probe waits for the platform before calling it a failure, in seconds.
const PATIENCE: f64 = 15.0

/// Run a program and answer its stdout, trimmed, with anything that went wrong printed.
///
/// A missing tool or a refusal is printed rather than swallowed: its stdout is then empty
/// and the step that needed it would fail for the wrong reason.
fn shell(program: String, args: Vec<String>) -> String {
    match exec::run(program.clone(), args) {
        Ok(out) => {
            if out.code != 0 {
                println(f"FAIL DW12 {program} exited {out.code}: {out.stderr.trim()}")
            }
            out.stdout.trim().clone()
        }
        Err(problem) => {
            println(f"FAIL DW12 could not run {program}: {problem}")
            String::new()
        }
    }
}

/// The numbers `xprop` answered for one property, in order.
///
/// `xprop` answers a property as `NAME(TYPE) = v, v, v` on one line, and a property that is
/// not on the window as `NAME:  not found.` — which has no `=` and so answers no numbers at
/// all, which is the reading wanted for "nothing has been written".
fn numbers(text: String) -> Vec<f64> {
    let mut out: Vec<f64> = #[]
    for line in text.split("\n") {
        if let Some((_, rest)) = line.split_once("=") {
            for field in rest.split(",") {
                if let Ok(number) = strconv::parse_f64(field.trim().clone()) {
                    out.push(number)
                }
            }
        }
    }
    out
}

/// Whether two numbers are the same, to within a hundredth of a pixel.
///
/// Written as a distance rather than as `==`: the values here are floats, and a float
/// comparison that a reader has to reason about is a comparison that will one day surprise
/// somebody. The hundredth is far below anything a window manager could round to.
fn same(a: f64, b: f64) -> bool {
    let d = a - b
    (if d < 0.0 { -d } else { d }) < 0.01
}

/// One property of a window, printed in decimal whatever its type is.
///
/// `xprop` prints a property whose *type* it does not know as hex, and `_MOTIF_WM_HINTS` is
/// one: `0x2, 0x0, 0x1, 0x0, 0x0`, which is not a row of numbers anything here would parse.
/// Asking for 32-bit cardinals makes it and `_GTK_FRAME_EXTENTS` print the same way, so the
/// two are read by the same code and a change in one cannot hide behind the other's format.
fn property(wid: String, name: String) -> String {
    shell("xprop", #["-f", name.clone(), "32c", "-id", wid, name])
}

/// Which word the window manager's own advertisement forces: whether a client may draw its
/// own frame.
fn expected_decorations(atoms: String) -> String {
    if strings::contains(atoms.clone(), "_GTK_FRAME_EXTENTS") {
        "client"
    } else {
        "server"
    }
}

/// The decoration hint `_MOTIF_WM_HINTS` carries, as `window_decorations` spells it.
///
/// The property is `[flags, functions, decorations, input, status]`, and a non-zero
/// *decorations* field asks the window manager to draw them. Fewer than five fields means
/// the property is not on the window at all, which is a third state and is named as one.
fn motif_decorations(hints: String) -> String {
    let values = numbers(hints.clone())
    if values.len() < 5 {
        "absent"
    } else if values[2] > 0.0 {
        "server"
    } else {
        "client"
    }
}

fn main() {
    let outcome = gpui::run(TITLE, 420.0, 300.0, || {
        // A frame is only painted when something asks for one, and every step below waits on
        // the *next* frame: a request is drained between frames, and `begin_frame` samples
        // what the platform says at the start of each one.
        gpui::animate()
        let phase = gpui::state_int("phase", 0)
        let win = gpui::state_text("win", String::new())

        if phase == 0 {
            // A window that has not painted has no bounds, so this is also the guard that
            // there is a window for `xdotool` to find — a guard, not a wait, so the frame
            // below still gets its tree either way.
            if gpui::window_field("w") > 0.0 {
                let found = shell("xdotool", #["search", "--name", TITLE])
                let hits = found.lines()
                if hits.len() == 0 {
                    println(f"FAIL DW12 no window named {TITLE} on this display (xdotool answered `{found}`)")
                    gpui::quit()
                } else {
                    gpui::set_text("win", hits[0].trim().clone())
                    gpui::set_text("hits", f"{hits.len()}")
                    gpui::set_text("props", shell("xprop", #["-id", hits[0].trim().clone(), "WM_NAME", "_NET_WM_NAME", "_MOTIF_WM_HINTS"]))
                    gpui::set_text("atoms", shell("xprop", #["-root", "_NET_SUPPORTED"]))
                    // What the platform says about its own decorations before anything is
                    // asked of it. Kept because the check below is that asking does not
                    // change it.
                    gpui::set_text("before", gpui::window_decorations())
                    // Now make the request a program that draws its own titlebar makes.
                    gpui::request_window_decorations(true)
                    gpui::set_int("phase", 1)
                }
            } else if gpui::now() > PATIENCE {
                println("FAIL DW12 the window never painted, so there is nothing on this display to ask about")
                gpui::quit()
            }
        }

        if phase == 1 {
            // The frame after the request. `request_decorations` writes the window's hints
            // synchronously, so one frame on is enough to read back.
            let atoms = gpui::state_text("atoms", String::new())
            let expected = expected_decorations(atoms.clone())
            let before = gpui::state_text("before", String::new())
            let after = gpui::window_decorations()
            let motif = motif_decorations(property(win.clone(), "_MOTIF_WM_HINTS"))
            let verb = if expected == "client" {
                "is"
            } else {
                "is not"
            }

            if after != expected {
                println(f"FAIL DW12 the window manager advertises that a client {verb} allowed to draw its own frame — `{expected}` is the word that follows from {atoms.len()} bytes of _NET_SUPPORTED — and gpui::window_decorations answered `{after}`")
                gpui::quit()
            } else if motif != expected {
                println(f"FAIL DW12 gpui::window_decorations answered `{after}` and the window's own _MOTIF_WM_HINTS say `{motif}`: the binding and the X server disagree about who draws the window's decoration. Window {win} — one of {gpui::state_text("hits", String::new())} that xdotool matched — carries: {gpui::state_text("props", String::new())}")
                gpui::quit()
            } else if before != expected {
                println(f"FAIL DW12 gpui::window_decorations answered `{before}` before anything was asked of it and `{after}` after: the answer moved without the platform's grounds moving")
                gpui::quit()
            } else {
                // The inset, last, because its reading is a frame behind the call.
                gpui::set_client_inset(INSET)
                gpui::set_float("t1", gpui::now())
                gpui::set_int("phase", 2)
            }
        }

        if phase == 2 {
            let inset = gpui::client_inset()
            let waited = gpui::now() - gpui::state_float("t1", 0.0)
            if same(inset, INSET) {
                let extents = numbers(property(win.clone(), "_GTK_FRAME_EXTENTS"))
                if extents.len() != 4 {
                    println(f"FAIL DW12 set_client_inset({INSET}) reads back as {inset}, and the window carries {extents.len()} frame extents rather than the four of _GTK_FRAME_EXTENTS: the platform never heard the call")
                    gpui::quit()
                } else if !same(extents[0], INSET) || !same(extents[1], INSET) || !same(extents[2], INSET) || !same(extents[3], INSET) {
                    println(f"FAIL DW12 _GTK_FRAME_EXTENTS on the window reads `{extents[0]}, {extents[1]}, {extents[2]}, {extents[3]}` after set_client_inset({INSET})")
                    gpui::quit()
                } else {
                    let before = gpui::state_text("before", String::new())
                    let decided = expected_decorations(gpui::state_text("atoms", String::new()))
                    println(f"OK DW12 a program is handed the window calls a drawn titlebar is made of: gpui::window_decorations answered `{decided}` — the word the window manager's own _NET_SUPPORTED forces — both before the program asked for `client` and after, and the window's _MOTIF_WM_HINTS say the same; and set_client_inset({INSET}) both reads back as {inset} and is on the window as _GTK_FRAME_EXTENTS = {extents[0]}, {extents[1]}, {extents[2]}, {extents[3]}, where before the call gpui said `{before}`")
                    gpui::quit()
                }
            } else if waited > PATIENCE {
                println(f"FAIL DW12 set_client_inset({INSET}) was called and {waited} seconds later client_inset() answers {inset}")
                gpui::quit()
            }
        }

        // ---- the tree ------------------------------------------------------
        //
        // One box, and it is not what is being checked: what is being checked is on the X
        // server. It is here because a frame with no tree has no window, and a window is
        // what `xdotool` searches for and `xprop` is pointed at.
        let root = gpui::column("size=full items=start bg=#ffffff p=8")
        gpui::child(root, gpui::text(TITLE.clone(), "fs=16 color=#000000"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL DW12 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
