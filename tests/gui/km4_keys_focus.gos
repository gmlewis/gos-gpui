// KM4 — `on_keys(true)` must take focus at any frame, not only in the window's
// first two frames.
//
// Tier: every tier.
//
// A key event goes to the focused element and to the elements around it on the
// dispatch path. `gpui::on_keys(true)` makes the *window* that element, so a program
// can have shortcuts without building a widget — but only if the window actually has
// focus. Taking focus only while `gpui::frame() <= 2` leaves a program that
// turns the keyboard on at any later frame with a listener, no focus, and keystrokes
// that go nowhere: shortcuts dead, with no error to show for it.
//
// Pass means the window holds focus a few frames after the program asks for the
// keyboard at a frame well past the second one. `gpui::is_focused("~root")` is the
// binding's own reader for "is this handle the focused one", so the check is of the
// real focus state and not of a flag.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("km4 - keys take focus late", 320.0, 200.0, || {
        let f = gpui::frame()

        // Late on purpose: frame 20 is about a third of a second into the run.
        if f == 20 {
            gpui::on_keys(true)
        }

        if f == 24 {
            // One exclusive chain ending in the verdict: `gpui::quit()` asks the app
            // to stop, it does not abort the callback that called it.
            if gpui::is_focused("~root") {
                println(f"OK KM4 the window took focus on frame 20, when the program asked for the keyboard, and still holds it at frame {f}")
            } else {
                println(f"FAIL KM4 the program asked for the keyboard at frame 20 and the window does not have focus at frame {f}, so no keystroke would reach it")
            }
            gpui::quit()
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("keys", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL KM4 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
