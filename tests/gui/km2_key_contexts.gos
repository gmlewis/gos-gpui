// KM2 — key contexts, so bindings are focus-scoped.
//
// Tier: every tier.
//
// KM1 gave a program a keymap, but a *flat* one: every binding matched in every
// window and in every part of one. Upstream does not work that way — a binding
// carries a context predicate (`KeyBinding::new("cmd-s", Save, Some("Editor"))`)
// and gpui evaluates it against the context stack of the **focused** node, taken
// from that node's own branch of the dispatch tree. The element that names the
// context does it with `div().key_context("Editor")`.
//
// Neither half was reachable from a program: no token put a context on an element,
// and `gpui::bind_keys` had nowhere to write a predicate.
//
// Pass means the same keymap answers differently according to where focus is. A
// stroke bound with the context that is on the focused path fires; the same stroke
// with no context is also reachable; and a stroke bound with a context that is *not*
// on the path fires nothing at all. The last one is the half that matters: a
// binding whose context is ignored would fire it.
//
// The editor takes focus when it is created, and it sits inside the `ctx=Editor`
// panel, so the focused node's branch of the tree carries that context.

use gpui
use std::process

/// Drain this frame's events and keep the ones this probe bound.
fn handle() {
    for event in gpui::take_events() {
        let id, _ = gpui::event_parts(event)
        if id == "in_editor" || id == "in_widget" {
            gpui::list_push("km2.fired", id)
        }
    }
}

fn main() {
    let outcome = gpui::run("km2 - key contexts", 380.0, 240.0, || {
        let f = gpui::frame()
        handle()

        if f == 2 {
            // `cmd-s` inside the editor's context, and `cmd-j` inside a context
            // that no element in this tree names.
            gpui::bind_keys("cmd-s=in_editor@Editor; cmd-j=in_widget@Widget")
        }
        // `gpui::send_key` delivers after the frame that asked.
        if f == 8 {
            gpui::send_key("cmd-s")
        }
        if f == 10 {
            gpui::send_key("cmd-j")
        }

        if f >= 16 {
            let fired = gpui::list_len("km2.fired")
            let first = gpui::list_get("km2.fired", 0)
            let second = gpui::list_get("km2.fired", 1)

            // One exclusive chain ending in the verdict: `gpui::quit()` asks the
            // app to stop, it does not abort the callback that called it.
            if fired == 0 {
                println("FAIL KM2 the stroke bound inside the editor's context did not fire, so the context predicate was not matched")
                gpui::quit()
            } else if fired > 1 {
                println(f"FAIL KM2 a stroke bound inside a context no element names fired as well ({first}, {second}), so the context was ignored")
                gpui::quit()
            } else if first != "in_editor" {
                println(f"FAIL KM2 the wrong binding fired: {first}")
                gpui::quit()
            } else {
                println("OK KM2 the stroke bound inside the editor's context fired, and the stroke bound inside a context no element names fired nothing")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        // The context lives on an ancestor of the focused element, which is where
        // gpui reads it from: the focused node's own branch of the dispatch tree.
        let panel = gpui::panel("ctx=Editor size=full")
        gpui::child(panel, gpui::editor("notes", "type here", ""))
        gpui::child(root, panel)
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL KM2 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
