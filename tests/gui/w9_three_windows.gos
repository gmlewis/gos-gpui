// W9 — a second (and third) concurrent top-level window, without re-entering
// `run`.
//
// Tier: every tier.
//
// `gpui::run` refuses a second call in a process; `gpui::open_window` is the
// only way to get another window, and the whole point is that it is not a
// re-entry: the program is inside one `run` and stays there while a window's
// view callback opens another window's view callback, which opens a third.
//
// Pass means: window 2 opens window 3 from inside its own frame, all three have
// distinct ids, and window 3 can be heard from window 1 — which it does by
// writing into window 1's state namespace with `gpui::set_int_in`, so this also
// exercises the other direction of W2.

use gpui
use std::process

/// Window 2's view, and window 3's.
///
/// One view callback serves every window — the one `gpui::run` was given — and
/// `window::allocate` hands out 1 first, then 2, then 3, so the ids are the
/// windows' creation order. `run`'s own window is 1; anything else is a window
/// this program opened. Neither of these is a callback of its own passed to
/// `gpui::open_window`, which returns before the window is drawn — and a callback
/// handed to a binding function is valid only for that call — so both windows'
/// views would answer an error on the compiled tiers.
fn child_view() {
    let cf = gpui::frame()
    if cf == 1 {
        // Window 3, opened from window 2's frame. A nested `run`
        // would be refused; a nested `open_window` is the point.
        gpui::open_window("w9 - grandchild", 640.0, 130.0, 220.0, 140.0, "")
    }
    gpui::animate()
    let child = gpui::column("p=8 bg=#222222 size=full")
    gpui::child(child, gpui::text("child", "color=#ffffff"))
    gpui::root(child)
}

fn grandchild_view() {
    // Window 3 reports itself into window 1's namespace.
    gpui::set_int_in(1, "w9.reported", gpui::window_id())
    gpui::animate()
    let leaf = gpui::column("p=8 bg=#333333 size=full")
    gpui::child(leaf, gpui::text("grandchild", "color=#ffffff"))
    gpui::root(leaf)
}

fn main() {
    let outcome = gpui::run("w9 - two more windows", 320.0, 200.0, || {
        let f = gpui::frame()
        let me = gpui::window_id()

        if me == 2 {
            return child_view()
        }
        if me != 1 {
            return grandchild_view()
        }

        if f == 1 {
            // Window 2, opened from window 1's frame.
            gpui::open_window("w9 - child", 360.0, 70.0, 240.0, 150.0, "")
        }

        let reported = gpui::state_int("w9.reported", 0)
        if f >= 8 {
            if me != 1 {
                println(f"FAIL W9 the first window is {me}, not 1")
                gpui::quit()
            } else if reported != 3 {
                println(f"FAIL W9 the third window reported itself as {reported}, not 3")
                gpui::quit()
            } else {
                println(f"OK W9 three windows: 1, 2 and {reported}, one run call, no re-entry")
                gpui::quit()
            }
        } else {
            gpui::animate()
        }

        let root = gpui::column("p=8 bg=#111111 size=full")
        gpui::child(root, gpui::text(f"window {me}, frame {f}", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL W9 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
