// DW12, the half of a drawn titlebar that *moves*: `start_window_move` and
// `start_window_resize` hand the window to the window manager, and the window goes where
// the pointer goes.
//
// container: both calls end in an X client message to the window manager, and the only way
// to see that they did anything is to watch the window while an outside process drives the
// pointer — which here is `openbox` on Xvfb with `xdotool` posting XTEST events from
// `exec::run`. The Mac has no X server and `scripts/window-guard.sh` keeps a window from
// opening there at all, so `scripts/probes.sh` and `scripts/tiers.sh` skip this one by name:
//
//   ./scripts/gosbox.sh tiers tests/gui/dw12_drag_and_resize.gos
//
// # What this exists for
//
// A program that draws its own titlebar cannot drag its window by calling anything that
// moves a window: under a window manager the window's position belongs to the manager, and
// a program that moved itself would be fighting it. What it does instead is what a titlebar
// is *for* — it says "the button is down on me, take over" — and gpui's two calls for that
// are `Window::start_window_move` (`gpui-0.2.2 src/window.rs:1753`) and
// `Window::start_window_resize` (`:1460`). Both end at the same place on X11:
// `X11Window::send_moveresize` (`src/platform/linux/x11/window.rs:848`) ungrabs the pointer,
// reads where it is for itself, and sends `_NET_WM_MOVERESIZE` to the root window — flag 8 to
// move, and for a resize the flag `ResizeEdge::to_moveresize` gives (`:100`).
//
// So the claim under test is not "the binding sent a message" — that would be a claim about
// the binding's own source. It is the only claim that means anything here: **the window ends
// up where the pointer went.** `xdotool` reads the window's geometry before and after, from
// outside the process, and the difference is the pointer's own delta.
//
// # Pass means all three
//
//   * the button goes down inside the window, `start_window_move` is called while it is
//     held, the pointer moves and the button comes up: the window's position changes by
//     exactly the pointer's delta, to within a window manager's rounding.
//   * the same, from the bottom-right corner with `start_window_resize("bottom-right")`: the
//     window's *size* changes by the pointer's delta, and its top-left stays put — a resize
//     is not a move.
//   * both are read from the X server by `xdotool`, not from the binding: what the binding
//     believes about the window is not evidence that the window moved.
//
// # The tree is built on every pass, and no check returns early
//
// Every branch below falls through to the tree at the end of the callback. A branch that
// returned would leave a frame with no tree, and a window with no frame is a window
// `xdotool` cannot find and `openbox` has nothing to move.

use gpui
use std::os::exec
use std::process
use std::strconv

/// The name the window is opened with, and what `xdotool` is told to look for.
const TITLE: String = "dw12drag"

/// Where inside the window the pointer goes down for the drag, in the window's own
/// coordinates. Inside the client area and away from its edges, so that the press is the
/// program's and not the window manager's frame.
const PRESS_X: f64 = 120.0
const PRESS_Y: f64 = 40.0

/// How far the pointer travels with the button held, for the drag.
const MOVE_X: f64 = 60.0
const MOVE_Y: f64 = 40.0

/// How far the pointer travels with the button held, for the resize. Different from the
/// drag's numbers, so that a probe that measured one and reported the other would not pass.
const GROW_X: f64 = 70.0
const GROW_Y: f64 = 30.0

/// How far inside the bottom-right corner the resize press lands. Not on the corner itself:
/// the corner pixel belongs to the window manager's border, and the press is meant to be the
/// program's. The offset is held by the window manager for the whole resize, so it cancels.
const CORNER: f64 = 4.0

/// How many jumps the pointer travels in. More than one, and this is not a flourish: the
/// window manager begins following the pointer on the first motion it *sees*, and a grab it
/// established after a single jump would leave it with nothing to follow and the window
/// where it started. Measured, one jump is a race that fails perhaps one run in three.
const STEPS: i64 = 4

/// How long to leave between handing the window over and moving the pointer, in seconds —
/// long enough that the window manager has taken it and is watching the pointer. Measured
/// the same way as `STEPS`: without it the travel can be posted before the hand-over lands,
/// and then it is the program that receives the motion and the window does not move.
const SETTLE: f64 = 0.35

/// How much of a difference between the pointer's travel and the window's is the window
/// manager rounding to whole pixels rather than a window that did not follow.
const SLACK: f64 = 3.0

/// How long the probe waits for a step that should not need waiting for, in seconds.
const PATIENCE: f64 = 15.0

/// Run a program and answer its stdout, trimmed, with anything that went wrong printed.
fn shell(program: String, args: Vec<String>) -> String {
    match exec::run(program.clone(), args) {
        Ok(out) => {
            if out.code != 0 {
                println(f"FAIL DW12 {program} exited {out.code}: {out.stderr.trim()}")
            }
            out.stdout.trim().clone()
        }
        Err(problem) => {
            println(f"FAIL DW12 could not run {program}: {problem}")
            String::new()
        }
    }
}

/// One `key=value` line out of `xdotool getwindowgeometry --shell`, as a number, or `-1.0`.
fn field(text: String, key: String) -> f64 {
    for line in text.split("\n") {
        if let Some((name, value)) = line.split_once("=") {
            if name.trim() == key {
                return match strconv::parse_f64(value.trim().clone()) {
                    Ok(number) => number,
                    Err(_) => -1.0,
                }
            }
        }
    }
    -1.0
}

/// The xdotool subcommand that posts one pointer move, as a list of words.
fn move_to(x: f64, y: f64) -> Vec<String> {
    let sx = x.round() as i64
    let sy = y.round() as i64
    #["mousemove", "--sync", f"{sx}", f"{sy}"]
}

/// Where the window is and how big it is, as the X server answers — `X`, `Y`, `WIDTH` and
/// `HEIGHT` of `xdotool getwindowgeometry --shell`.
fn geometry(wid: String) -> String {
    shell("xdotool", #["getwindowgeometry", "--shell", wid])
}

/// Travel the pointer from one point to another in `STEPS` jumps, each one waited for, so
/// that a window manager following it has several motions to follow rather than one to miss.
fn travel(from_x: f64, from_y: f64, to_x: f64, to_y: f64) {
    for i in 1..(STEPS + 1) {
        let part = (i as f64) / (STEPS as f64)
        let _ = shell("xdotool", move_to(from_x + (to_x - from_x) * part, from_y + (to_y - from_y) * part))
    }
}

/// Whether two numbers are the same to within a rounding.
fn close(a: f64, b: f64) -> bool {
    let d = a - b
    (if d < 0.0 { -d } else { d }) <= SLACK
}

fn main() {
    let outcome = gpui::run(TITLE, 420.0, 300.0, || {
        // A frame is only painted when something asks for one, and this probe needs a run of
        // them: a request is drained between frames, so the pointer has to move on a frame
        // *after* the one that asked for the move.
        gpui::animate()
        let phase = gpui::state_int("phase", 0)
        let win = gpui::state_text("win", String::new())

        if phase == 0 {
            // A window that has not painted has no bounds, so this is also the guard that
            // there is a window for `xdotool` to find.
            if gpui::window_field("w") > 0.0 {
                let found = shell("xdotool", #["search", "--name", TITLE])
                let hits = found.lines()
                if hits.len() == 0 {
                    println(f"FAIL DW12 no window named {TITLE} on this display (xdotool answered `{found}`)")
                    gpui::quit()
                } else {
                    let id = hits[0].trim().clone()
                    let g = geometry(id.clone())
                    let x0 = field(g.clone(), "X")
                    let y0 = field(g.clone(), "Y")
                    let w0 = field(g.clone(), "WIDTH")
                    let h0 = field(g.clone(), "HEIGHT")
                    gpui::set_text("win", id)
                    // Spelled out rather than kept as `xdotool`'s own six-line answer: a
                    // verdict that breaks across lines is one a reader has to reassemble.
                    gpui::set_text("before", f"({x0}, {y0}) {w0} by {h0}")
                    gpui::set_float("x0", x0)
                    gpui::set_float("y0", y0)
                    gpui::set_float("t0", gpui::now())
                    gpui::set_int("phase", 1)
                }
            } else if gpui::now() > PATIENCE {
                println("FAIL DW12 the window never painted, so there is nothing on this display to drag")
                gpui::quit()
            }
        }

        // ---- the drag ------------------------------------------------------
        //
        // The press, then the request, on one frame: this is the order a program-drawn
        // titlebar does it in — the button goes down on the titlebar, and the titlebar's
        // press handler hands the window over. gpui reads the pointer's position itself, so
        // the press *is* the coordinates and none are passed.
        if phase == 1 {
            let x0 = gpui::state_float("x0", 0.0)
            let y0 = gpui::state_float("y0", 0.0)
            let _ = shell("xdotool", move_to(x0 + PRESS_X, y0 + PRESS_Y))
            let _ = shell("xdotool", #["mousedown", "1"])
            gpui::start_window_move()
            gpui::set_float("t1", gpui::now())
            gpui::set_int("phase", 2)
        }

        if phase == 2 && gpui::now() - gpui::state_float("t1", 0.0) >= SETTLE {
            let x0 = gpui::state_float("x0", 0.0)
            let y0 = gpui::state_float("y0", 0.0)
            let from_x = x0 + PRESS_X
            let from_y = y0 + PRESS_Y
            travel(from_x, from_y, from_x + MOVE_X, from_y + MOVE_Y)
            let _ = shell("xdotool", #["mouseup", "1"])
            gpui::set_float("t2", gpui::now())
            gpui::set_int("phase", 3)
        }

        if phase == 3 && gpui::now() - gpui::state_float("t2", 0.0) >= SETTLE {
            let x0 = gpui::state_float("x0", 0.0)
            let y0 = gpui::state_float("y0", 0.0)
            let g = geometry(win.clone())
            let x1 = field(g.clone(), "X")
            let y1 = field(g.clone(), "Y")
            let w1 = field(g.clone(), "WIDTH")
            let h1 = field(g.clone(), "HEIGHT")
            gpui::set_text("after_move", f"({x1}, {y1}) {w1} by {h1}")
            gpui::set_float("x1", x1)
            gpui::set_float("y1", y1)
            gpui::set_float("w1", w1)
            gpui::set_float("h1", h1)
            if !close(x1 - x0, MOVE_X) || !close(y1 - y0, MOVE_Y) {
                println(f"FAIL DW12 a press, start_window_move(), a pointer travel of ({MOVE_X}, {MOVE_Y}) and a release left the window at ({x0}, {y0}) and then ({x1}, {y1}): it moved by ({x1 - x0}, {y1 - y0})")
                gpui::quit()
            } else if w1 < 1.0 || h1 < 1.0 {
                println(f"FAIL DW12 the window has no size after the drag: xdotool reads it as {w1} by {h1}")
                gpui::quit()
            } else {
                gpui::set_int("phase", 4)
            }
        }

        // ---- the resize ----------------------------------------------------
        //
        // From inside the bottom-right corner, with the button held, asking for that same
        // edge by the name the binding spells it with.
        if phase == 4 {
            let x1 = gpui::state_float("x1", 0.0)
            let y1 = gpui::state_float("y1", 0.0)
            let w1 = gpui::state_float("w1", 0.0)
            let h1 = gpui::state_float("h1", 0.0)
            let _ = shell("xdotool", move_to(x1 + w1 - CORNER, y1 + h1 - CORNER))
            let _ = shell("xdotool", #["mousedown", "1"])
            gpui::start_window_resize("bottom-right")
            gpui::set_float("t3", gpui::now())
            gpui::set_int("phase", 5)
        }

        if phase == 5 && gpui::now() - gpui::state_float("t3", 0.0) >= SETTLE {
            let x1 = gpui::state_float("x1", 0.0)
            let y1 = gpui::state_float("y1", 0.0)
            let w1 = gpui::state_float("w1", 0.0)
            let h1 = gpui::state_float("h1", 0.0)
            let from_x = x1 + w1 - CORNER
            let from_y = y1 + h1 - CORNER
            travel(from_x, from_y, from_x + GROW_X, from_y + GROW_Y)
            let _ = shell("xdotool", #["mouseup", "1"])
            gpui::set_float("t4", gpui::now())
            gpui::set_int("phase", 6)
        }

        if phase == 6 && gpui::now() - gpui::state_float("t4", 0.0) >= SETTLE {
            let x0 = gpui::state_float("x0", 0.0)
            let y0 = gpui::state_float("y0", 0.0)
            let x1 = gpui::state_float("x1", 0.0)
            let y1 = gpui::state_float("y1", 0.0)
            let w1 = gpui::state_float("w1", 0.0)
            let h1 = gpui::state_float("h1", 0.0)
            let g = geometry(win.clone())
            let x2 = field(g.clone(), "X")
            let y2 = field(g.clone(), "Y")
            let w2 = field(g.clone(), "WIDTH")
            let h2 = field(g.clone(), "HEIGHT")
            if !close(w2 - w1, GROW_X) || !close(h2 - h1, GROW_Y) {
                println(f"FAIL DW12 a press inside the bottom-right corner, start_window_resize(\"bottom-right\"), a pointer travel of ({GROW_X}, {GROW_Y}) and a release left the window at {w1} by {h1} and then {w2} by {h2}: it grew by ({w2 - w1}, {h2 - h1})")
                gpui::quit()
            } else if !close(x2, x1) || !close(y2, y1) {
                println(f"FAIL DW12 a resize by the bottom-right corner moved the window's top-left from ({x1}, {y1}) to ({x2}, {y2}): the corner that was asked for was not the one that moved")
                gpui::quit()
            } else {
                let start = gpui::state_text("before", String::new())
                let moved = gpui::state_text("after_move", String::new())
                println(f"OK DW12 the two calls a program-drawn titlebar moves its window with really hand the window over: a pointer travelled ({MOVE_X}, {MOVE_Y}) with the button held and took the window from ({x0}, {y0}) to ({x1}, {y1}) — xdotool read {start} before and {moved} after — and the same gesture from the bottom-right corner took it from {w1} by {h1} to {w2} by {h2} without moving its top-left, which is now ({x2}, {y2})")
                gpui::quit()
            }
        }

        // ---- the tree ------------------------------------------------------
        //
        // The box is not what is being checked; the window is, and the window is what
        // `xdotool` searches for and `openbox` has to be able to take hold of. `size=full`
        // keeps it filling the window as the window is resized under it.
        let root = gpui::column("size=full items=start bg=#ffffff p=8")
        gpui::child(root, gpui::text(TITLE.clone(), "fs=16 color=#000000"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL DW12 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
