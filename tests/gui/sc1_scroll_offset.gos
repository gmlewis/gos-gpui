// SC1 / SC2 / SC3 — read, measure and set a scrolled container's offset.
//
// Tier: every tier.
//
// A window holds one scrolled container, named "panel" with an `id=` token, whose
// content is four times the container's height. Pass means all three:
//
//   SC2  the container reports a maximum offset, and it is positive — the reader
//        exists and the container really has content that does not fit
//   SC1  the offset reads back as what was set, having started at the top
//   SC3  setting an offset moves the container, and asking past the end parks at
//        the end rather than leaving a gap
//
// The three are one mechanism — a `ScrollHandle` kept per (window, element) — so
// they are one probe.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("sc1 - scroll offset", 320.0, 260.0, || {
        let f = gpui::frame()

        if f == 2 {
            // Nothing has been scrolled yet: at the top, with room to go.
            let start = gpui::scroll_offset("panel", "y")
            let max = gpui::scroll_max_offset("panel", "y")
            if max <= 0.0 {
                println(f"FAIL SC2 the scrolled container reports a maximum offset of {max}")
                gpui::quit()
            } else if start > 0.001 || start < -0.001 {
                println(f"FAIL SC1 a container nothing has scrolled reports offset {start}, not 0")
                gpui::quit()
            }
        }

        if f == 4 && !gpui::scroll_to("panel", 0.0, -40.0) {
            println("FAIL SC3 scroll_to did not recognise the container it was given")
            gpui::quit()
        }

        if f == 6 {
            let at = gpui::scroll_offset("panel", "y")
            if at > -39.0 || at < -41.0 {
                println(f"FAIL SC1 the offset set to -40 reads back as {at}")
                gpui::quit()
            }
        }

        if f == 8 {
            gpui::scroll_to("panel", 0.0, -100000.0)
        }

        if f == 10 {
            let max = gpui::scroll_max_offset("panel", "y")
            let at = gpui::scroll_offset("panel", "y")
            let gap = at + max
            if gap > 1.0 || gap < -1.0 {
                println(f"FAIL SC3 the offset {at} is not parked at the end of a {max} pixel range")
                gpui::quit()
            } else {
                println("OK SC1 SC2 SC3 offset read back after scroll_to, maximum positive, and clamped at the end")
                gpui::quit()
            }
        }

        gpui::animate()

        let content = gpui::panel("h=400 shrink=0 bg=#222222")
        let scroller = gpui::scroll("id=panel h=100 w=240")
        gpui::child(scroller, content)
        let root = gpui::column("p=8 bg=#111111 size=full")
        gpui::child(root, scroller)
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL SC1 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
