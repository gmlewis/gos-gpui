// ED1 — the editor's key set is the widget's, and it is wider than upstream's.
//
// Tier: every tier.
//
// # What this exists for
//
// `examples/09_input.gos` ports `tools/upstream/examples/input.rs`, and its header said
// for a long time that the two differ only in *plumbing*: upstream binds thirteen
// strokes through the application keymap (`cx.bind_keys` / `on_action`) and the binding
// matches keystrokes on the element instead, with "same keys". The plumbing half is
// right. "Same keys" is not: the binding's editor is a document editor and handles more
// strokes than upstream's one-line example binds anything for.
//
// Upstream (`tools/upstream/examples/input.rs:680-694`) binds exactly thirteen —
// backspace, delete, left, right, shift-left, shift-right, cmd-a, cmd-v, cmd-c, cmd-x,
// home and end, plus ctrl-cmd-space for the character palette — and its element carries
// an `on_action` for each and no key handler at all. So in upstream's window `enter`,
// `up`, `down`, `pageup`, `pagedown`, their shift-extended twins and `cmd-left` /
// `cmd-right` reach nothing, and its text cannot hold a break even if one arrived: the
// only path that could put one there is a paste, and that strips them
// (`input.rs:133`, `text.replace("\n", " ")`).
//
// This probe types into `gpui::editor` — the same widget `ui::editor` wraps, and the
// one `examples/09_input.gos` draws — and checks the text after each keystroke. The
// strokes upstream *does* bind are in the table too, so the probe cannot pass by the
// editor accepting anything at all; a stroke neither side handles (`f5`) is in it twice
// as the negative control, and it must change nothing.
//
// # Why a key is checked by the text and not by the caret
//
// The caret is not readable from a program, so every move is made to leave a mark: the
// letter typed *after* the move lands wherever the caret went, and the editor publishes
// its text, which the program reads back with `gpui::state_text`. `up` and `home` are
// therefore checked by the `Z` and `H` that follow them — `aZ\nb` is only reachable if
// `up` went to the start of the line above and `Z` was typed there, and `HaZ\nb` only if
// `home` went to the start of the line the caret was on.
//
// `gpui::send_key` is what types: it delivers a keystroke to the window as if it had
// been pressed, so the focused editor handles it exactly as it would a real key. It
// delivers *after* the frame that asked for it, which is why a key is sent on frame
// `j + 2` and its effect read on frame `j + 3`.
//
// Pass means all nine keystrokes left the document exactly where the widget's key set
// says they should, `f5` twice among them leaving it untouched.

use gpui
use std::process

fn main() {
    // The `f5`s are the control: a stroke upstream binds nothing for *and* the editor
    // handles nothing for, so a probe that passed by "any key changes the text" fails
    // here. `enter` and `up` are the claim — they are the widget's, not upstream's.
    let keys = ["f5", "a", "f5", "enter", "b", "up", "Z", "home", "H"]
    // wants[i] is the whole document after keys[i].
    let wants = ["", "a", "a", "a\n", "a\nb", "a\nb", "aZ\nb", "aZ\nb", "HaZ\nb"]

    let outcome = gpui::run("ed1 - editor keys", 420.0, 240.0, || {
        let f = gpui::frame()

        if f == 1 {
            gpui::set_text("doc", "")
        }

        // keys[j] is sent on frame j + 2, so the window has built the editor and
        // focused it first; the effect is read on frame i + 3.
        let i = f - 3
        if i >= 0 && i < 9 {
            let got = gpui::state_text("doc", "")
            if got != wants[i] {
                println(f"FAIL ED1 after key {i} ({keys[i]}) the document is \"{got}\", not \"{wants[i]}\"")
                gpui::quit()
            }
        }
        let j = f - 2
        if j >= 0 && j < 9 {
            gpui::send_key(keys[j])
        }

        if f >= 14 {
            println("OK ED1 nine keystrokes left the document where the editor's own key set says: enter split the line, up and home moved the caret, and f5 twice changed nothing")
            gpui::quit()
        }
        gpui::animate()

        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::editor("doc", "type here", ""))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL ED1 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
