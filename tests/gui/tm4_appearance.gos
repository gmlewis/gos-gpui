// TM4 — every platform default colour, correct for the appearance.
// TH1 — the live OS appearance, reported.
//
// Tier: every tier.
//
// The two are one check because they are one question. `gpui::default_color` is
// chosen from the window's appearance, so "the colours are right" cannot be
// answered without knowing which appearance the window is in — and "the
// appearance is reported" is only worth anything if something depends on it.
//
// Pass means:
//
//   * the window reports `light` or `dark` and nothing else
//   * the platform offers exactly the eight colours `gpui::colors::Colors` has,
//     no more and no fewer
//   * **every one of them is the value that appearance says it should be**
//
// The third is the one with teeth. It is an exact comparison against the set the
// reported appearance names, so a binding that installed the light defaults
// before the first window and never corrected them fails on a dark desktop with
// every colour wrong at once, and the failure names which.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("tm4 - appearance and default colours", 320.0, 200.0, || {
        let f = gpui::frame()

        if f >= 2 {
            let look = gpui::appearance()
            if look != "light" && look != "dark" {
                println(f"FAIL TH1 the window reports an appearance of \"{look}\", which is neither light nor dark")
                gpui::quit()
            }

            let names = gpui::colour_names()
            if names.len() != 8 {
                println(f"FAIL TM4 the platform offers {names.len()} default colours, not the eight it has")
                gpui::quit()
            }

            // `gpui::quit()` asks for the app to stop; it does not stop the
            // callback, so the failure is remembered and named once rather than
            // printing a verdict after every wrong colour.
            let mut checked = 0
            let mut ok = true
            for name in names {
                let installed = gpui::default_color(name)
                let expected = gpui::default_color_for(look, name)
                if installed != expected && ok {
                    println(f"FAIL TM4 {name} is {installed} while a {look} appearance says it should be {expected}")
                    ok = false
                }
                checked = checked + 1
            }

            if ok && checked == 8 {
                println("OK TH1 TM4 the window reports its appearance, and every one of the eight default colours is that appearance's own")
                gpui::quit()
            } else if ok {
                println(f"FAIL TM4 only {checked} of the eight colours were checked")
                gpui::quit()
            } else {
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("appearance", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL TM4 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
