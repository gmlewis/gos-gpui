// DT2 — the data table's scrollbar drag: upstream's mapping, alive past the thumb's edge.
//
// container: the pointer is driven from outside the process by `xdotool` through XTEST,
// against the X server the window really sits on. The Mac has no such server — and
// `scripts/window-guard.sh` keeps a window from opening there at all — so `scripts/probes.sh`
// and `scripts/tiers.sh` skip this one by name. It runs in the container:
//
//   ./scripts/gosbox.sh tiers tests/gui/dt2_thumb_drag.gos
//
// # What this exists for
//
// The scrollbar drag `examples/02_data_table.gos` ports has two halves an element-level
// reading gets wrong:
//
//     it keeps tracking when the pointer leaves the element, and holds the point that was
//     grabbed rather than putting the thumb's top under the pointer.
//
// Both halves are checked here, and the two things that check them are the two halves of the
// gesture. The tracking is checked by listening on the **window** rather than on the element:
// `gpui::on_mouse_window`, which is upstream's own instrument — `data_table.rs:323-366` hangs
// its three handlers on `window.on_mouse_event(..)`, not on the thumb — and which is the
// subject of `tests/gui/dd4_capture.gos`. The mapping is checked by transcribing upstream's
// expression, `data_table.rs:355-364`, term for term:
//
// ```text
// let inside_offset = drag_pos.y;                                    // = ev.position - thumb_bounds.origin - table_bounds.origin, stored on the press
// let percentage = ((ev.position.y - table_bounds.origin.y + inside_offset)
//     / (table_bounds.size.height)).clamp(0., 1.);
// let offset_y = ((scroll_height - table_bounds.size.height) * percentage)
//     .clamp(px(0.), scroll_height - SCROLLBAR_THUMB_HEIGHT);
// scroll_handle.set_offset(point(px(0.), -offset_y));
// ```
//
// `scroll_height` is `last_item_size.contents.height` (`:285-291`) — the whole content, which
// the binding has no name for and does not need: `gpui::scroll_max_offset` is the content less
// the viewport, so `max + h` is the content. `table_bounds` is `base_handle.bounds()`
// (`:279-283`), which is `gpui::scroll_bounds("items", ..)`. `thumb_bounds` is the canvas's own
// rectangle, which is the thumb's, and is `gpui::element_bounds("thumb", ..)`.
//
// **Upstream subtracts `table_bounds.origin.y` twice** — once inside `drag_position` on the
// press and once again in the percentage on the move. It is reproduced as written, on both
// sides, exactly as the example's `cell` reproduces upstream's `pb`/`pe`/`eps`; a port that
// corrected it would put the thumb somewhere upstream's would not be.
//
// # What it measures
//
// One press inside the thumb, one move to a point 250 pixels below the thumb's top — that is,
// 150 pixels *below the thumb's bottom edge* — and a release at the same point. The move is
// therefore an event the thumb's own hitbox could not hear, which is what makes this a check of
// the drag rather than of the press.
//
// The numbers are read off a **real 10 000-row list in a real window**: the thumb's rectangle
// (`gpui::element_bounds`), the viewport (`gpui::scroll_bounds`), the maximum offset
// (`gpui::scroll_max_offset`), the pointer's own point on each event (`gpui::pointer_xy`) and
// the offset the list comes to rest at (`gpui::scroll_offset`). The two rules are then evaluated
// on those numbers. So what is checked is the binding's numbers, the arithmetic, and whether the
// move arrived at all.
//
// It is **not** `examples/02_data_table.gos`: a probe cannot import `ui` — `gos check` answers
// "error[GR0005]: module `ui` does not exist" for a file outside `examples/` — and the example is
// not a module, so the rule below is not a call into it. That transcription is the one soft
// joint in this check, exactly as it is in `tests/gui/dt1_thumb_track.gos`; the example's own
// copy is exercised by running it, which `./scripts/tiers.sh examples/02_data_table.gos` does.
//
// # The two negative controls
//
// `WINDOW_LEVEL` picks how the listener is registered. Set it to `false` and the same tree, the
// same gesture and the same rule register with `gpui::on_mouse` instead — the element-level
// reading, kept here as the first negative control — and the probe goes red in one way: the
// press is heard and then nothing, because the moves happen where the thumb is not. It is the
// red recorded in `tests/evidence/dt2.before.txt`.
//
// `RULE` picks the mapping. Set it to `0` and the probe applies a deliberately wrong reading:
// the pointer's own place in the viewport, with no grabbed point held, which is the "puts the
// thumb's top under the pointer" half of the drag. The settle then lands where that reading
// asks rather than where upstream's does, and the probe goes red on the comparison — by 549
// pixels on the numbers below, which is not a rounding difference.
//
// Neither control is a second copy of the rule under test: one removes the window-level
// listener, the other replaces the mapping with that wrong reading.

use gpui
use std::os::exec
use std::process

/// The window's title, and what `xdotool` is told to look for.
const TITLE: String = "dt2thumbdrag"

/// Upstream's `TOTAL_ITEMS`, and the row height `ui::list` takes (the example's 22.0).
const ITEMS: i64 = 10_000
const ROW_H: f64 = 22.0

/// Upstream's `SCROLLBAR_THUMB_HEIGHT`, `SCROLLBAR_THUMB_WIDTH` and `px(4.)`
/// (`tools/upstream/examples/data_table.rs:13-14`), and the example's `THUMB_*`.
const THUMB_H: f64 = 100.0
const THUMB_W: f64 = 8.0
const MARGIN: f64 = 4.0

/// The viewport the list is given, which is the shape the example puts its list in.
const VIEW_W: f64 = 300.0
const VIEW_H: f64 = 400.0

/// How the listener is registered: `true` for the example's `gpui::on_mouse_window`, `false`
/// for `gpui::on_mouse`, the element-level reading. The first negative control.
const WINDOW_LEVEL: bool = true

/// Which drag rule the probe applies: `1` is the example's, transcribing upstream; `0` is a
/// deliberately wrong reading — the pointer's place in the viewport with no grabbed point
/// held. The second negative control.
const RULE: i64 = 1

/// Where the press lands: this far below the thumb's own top edge. Small, so that the point
/// grabbed sits near the thumb's top and the two rules part company at a distance anyone can
/// see.
const GRAB_INSIDE: f64 = 5.0

/// How far below the thumb's top the drag goes, in window pixels. Past the thumb's own hundred
/// by fifty, so the move that carries the drag happens *outside* the thumb — the thing the
/// window-level listener is for.
const DRAG_DOWN: f64 = 250.0

/// Run a program and answer its stdout, trimmed, with anything that went wrong printed.
fn shell(program: String, args: Vec<String>) -> String {
    match exec::run(program.clone(), args) {
        Ok(out) => {
            if out.code != 0 {
                println(f"FAIL DT2 {program} exited {out.code}: {out.stderr.trim()}")
            }
            out.stdout.trim().clone()
        }
        Err(problem) => {
            println(f"FAIL DT2 could not run {program}: {problem}")
            String::new()
        }
    }
}

/// The `xdotool` subcommand that posts one pointer move, as a list of words.
fn move_to(x: f64, y: f64) -> Vec<String> {
    let sx = x.round() as i64
    let sy = y.round() as i64
    #["mousemove", "--sync", f"{sx}", f"{sy}"]
}

/// Keeps `v` inside `lo..=hi`, which is what upstream's `.clamp(..)` does.
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        lo
    } else if v > hi {
        hi
    } else {
        v
    }
}

/// Keeps a fraction inside `0..=1`.
fn clamp01(v: f64) -> f64 {
    clamp(v, 0.0, 1.0)
}

/// The rule `examples/02_data_table.gos` uses, transcribed from its `main()`.
///
/// It is upstream's expression (`data_table.rs:355-364`) with `max + h` standing in for
/// `scroll_height` and `THUMB_H` for `SCROLLBAR_THUMB_HEIGHT`. `grab` is `drag_position`, which
/// the press stored as `ev.position - thumb_bounds.origin - table_bounds.origin` — the
/// double-subtraction of `table_bounds.origin` is upstream's, and is kept.
fn now_offset(py: f64, grab: f64, table_y: f64, table_h: f64, max: f64) -> f64 {
    let percentage = clamp01((py - table_y + grab) / table_h)
    clamp(max * percentage, 0.0, (max + table_h) - THUMB_H)
}

/// A deliberately wrong reading of the drag, kept as this probe's negative control.
///
/// The `scrollbar()` this reading comes from hung its listener on a 16-pixel strip that wrapped
/// the thumb and read the pointer's place *inside that strip* — which is the viewport — so the
/// fraction was the pointer's own place in the viewport and nothing was held. Without it the
/// check above would be a rule compared with itself, and a green would say only that arithmetic
/// is arithmetic. With it, the probe shows on the same live numbers that it tells two rules
/// apart, and that this reading is one of the ones it tells apart.
fn was_offset(py: f64, thumb_y: f64, table_h: f64, max: f64) -> f64 {
    let percentage = clamp01((py - thumb_y) / table_h)
    max * percentage
}

/// Whether two offsets are the same to within a pixel. One and not a hundredth: the offset is
/// `max`-scaled — 219 600 on ten thousand rows — so a pointer that lands on a whole screen pixel
/// and a list that carries an `f32` offset are worth a pixel between them, and the difference
/// this probe is about is hundreds.
fn same(a: f64, b: f64) -> bool {
    let d = a - b
    (if d < 0.0 { -d } else { d }) < 1.0
}

/// Whether two offsets differ by more than a pixel.
fn differs(a: f64, b: f64) -> bool {
    let d = a - b
    (if d < 0.0 { -d } else { d }) >= 1.0
}

/// The list's row builder, handed to `gpui::run_with_rows` rather than to `gpui::list`: `run`
/// is the only binding call that does not return, and a callback handed to any other binding
/// call is released when that call returns. The list id comes first so one builder can serve
/// every list.
fn list_row(_list: String, i: i64) -> i64 {
    gpui::text(f"row {i}", "p=2 color=#ffffff")
}

fn main() {
    let outcome = gpui::run_with_rows(TITLE, 900.0, 600.0, "", list_row, || {
        let f = gpui::frame()
        gpui::animate()

        // ---- the gesture, posted from inside the frame that blocks it ------------------
        //
        // `--sync` is what makes the posts arrive in order: each waits for the X server to have
        // processed the one before it. The frame callback is blocked while they are posted, so
        // they are queued before it returns, but *when* gpui hands them over is the platform's
        // business — which is why the drain below runs over a range of frames.
        //
        // The points are worked out from the thumb's *own* rectangle, read back from the binding
        // (`gpui::element_bounds`) rather than assumed from the placement, because the placement
        // is the thing this probe is not allowed to trust.
        if f == 3 && gpui::state_int("phase", 0) == 0 {
            gpui::set_int("phase", 1)
            let found = shell("xdotool", #["search", "--name", TITLE])
            let hits = found.lines()
            if hits.is_empty() {
                println(f"FAIL DT2 no window named {TITLE} on this display (xdotool said `{found}`)")
            } else {
                let tx = gpui::element_bounds("thumb", "x")
                let ty = gpui::element_bounds("thumb", "y")
                let tw = gpui::element_bounds("thumb", "w")
                let th = gpui::element_bounds("thumb", "h")
                if th < 1.0 || tw < 1.0 {
                    println(f"FAIL DT2 the thumb has no rectangle to aim at: {tw:.1}x{th:.1} at {tx:.1},{ty:.1}")
                }
                let ox = gpui::window_field("inner_x")
                let oy = gpui::window_field("inner_y")
                let press_x = tx + tw / 2.0
                let press_y = ty + GRAB_INSIDE
                let drag_y = ty + DRAG_DOWN
                let _ = shell("xdotool", move_to(ox + press_x, oy + press_y))
                let _ = shell("xdotool", #["mousedown", "1"])
                let _ = shell("xdotool", move_to(ox + press_x, oy + drag_y))
                let _ = shell("xdotool", #["mouseup", "1"])
            }
        }

        // ---- the drag, and the rule, exactly as the example's frame does it -------------
        //
        // The pointer's own point comes off each event (`gpui::pointer_xy`) and not out of the
        // one `<id>.y` slot the last of them would have overwritten; the press is gated on the
        // thumb's rectangle, which is upstream's `thumb_bounds.contains(&ev.position)`; and the
        // moves are held open by a flag the press sets and the release clears, which is
        // upstream's `ev.dragging()`.
        if f >= 4 {
            for event in gpui::take_events() {
                let id, kind = gpui::event_parts(event.clone())
                let px, py = gpui::pointer_xy(event.clone())
                if id == "thumb" {
                    let thumb_x = gpui::element_bounds("thumb", "x")
                    let thumb_y = gpui::element_bounds("thumb", "y")
                    let thumb_w = gpui::element_bounds("thumb", "w")
                    let thumb_h = gpui::element_bounds("thumb", "h")
                    let table_y = gpui::scroll_bounds("items", "y")
                    let table_h = gpui::scroll_bounds("items", "h")
                    let max = gpui::scroll_max_offset("items", "y")
                    if kind == "down" {
                        let inside = px >= thumb_x && px <= thumb_x + thumb_w &&
                            py >= thumb_y && py <= thumb_y + thumb_h
                        if inside {
                            // Upstream's `drag_position = ev.position - thumb_bounds.origin
                            // - table_bounds.origin`.
                            gpui::set_float("grab", py - thumb_y - table_y)
                            gpui::set_float("press.ty", thumb_y)
                            gpui::set_float("press.tx", thumb_x)
                            gpui::set_float("press.tw", thumb_w)
                            gpui::set_float("press.th", thumb_h)
                            gpui::set_float("table.y", table_y)
                            gpui::set_float("table.h", table_h)
                            gpui::set_float("max", max)
                            gpui::set_bool("held", true)
                            gpui::set_int("downs", gpui::state_int("downs", 0) + 1)
                        }
                    } else if kind == "up" {
                        gpui::set_bool("held", false)
                        gpui::set_int("ups", gpui::state_int("ups", 0) + 1)
                    } else if kind == "move" {
                        if gpui::state_bool("held", false) && table_h > 0.0 {
                            let grab = gpui::state_float("grab", 0.0)
                            let offset = if RULE == 1 {
                                now_offset(py, grab, table_y, table_h, max)
                            } else {
                                was_offset(py, thumb_y, table_h, max)
                            }
                            gpui::scroll_to("items", 0.0, -offset)
                            // The numbers this move drove the list with, for the verdict: the
                            // point the pointer was actually at, its height above the thumb's
                            // bottom edge, and the offset asked for.
                            gpui::set_float("move.py", py)
                            gpui::set_float("move.above", thumb_y + thumb_h - py)
                            gpui::set_float("move.offset", offset)
                            gpui::set_int("moves", gpui::state_int("moves", 0) + 1)
                        }
                    }
                }
            }
        }

        if f == 26 && gpui::state_int("phase", 0) == 1 {
            gpui::set_int("phase", 2)
            report()
            gpui::quit()
        }

        // The tree, as the example's own: a viewport-sized stack holding the list and, over it,
        // the thumb — `absolute`, `right=4`, `h=100`, `w=8`, which is upstream's placement, at
        // the top the example's own rule gives it. The listener under test is the thumb's own.
        let h = gpui::scroll_bounds("items", "h")
        let max = gpui::scroll_max_offset("items", "y")
        let at = gpui::scroll_offset("items", "y")
        let content = max + h
        let percentage = if content > 0.0 { clamp01(-at / content) } else { 0.0 }
        let ceiling = if h - THUMB_H - MARGIN > MARGIN { h - THUMB_H - MARGIN } else { MARGIN }
        let top = clamp(h * percentage, MARGIN, ceiling)

        let list = gpui::list("items", ITEMS, ROW_H, "size=full")
        let stack = gpui::stack(f"w={VIEW_W} h={VIEW_H}")
        gpui::child(stack, list)
        let thumb_style = f"absolute top={top} right=4 h={THUMB_H} w={THUMB_W} bg=#c0c0c0 rounded=lg"
        let thumb = if WINDOW_LEVEL {
            gpui::on_mouse_window(gpui::rect(thumb_style), "down move up", "thumb")
        } else {
            gpui::on_mouse(gpui::rect(thumb_style), "down move up", "thumb")
        }
        gpui::child(stack, thumb)
        let root = gpui::child(gpui::column("p=8 bg=#111111 size=full color=#ffffff"), stack)
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL DT2 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}

/// The verdict, and the whole of the check. Every branch prints its own line, because a check
/// that passes by falling through is a check that has stopped checking.
fn report() {
    let at = gpui::scroll_offset("items", "y")
    let settled = 0.0 - at
    let downs = gpui::state_int("downs", 0)
    let ups = gpui::state_int("ups", 0)
    let moves = gpui::state_int("moves", 0)
    let move_py = gpui::state_float("move.py", 0.0)
    let above = gpui::state_float("move.above", 0.0)
    let grab = gpui::state_float("grab", 0.0)
    let press_ty = gpui::state_float("press.ty", 0.0)
    let table_y = gpui::state_float("table.y", 0.0)
    let table_h = gpui::state_float("table.h", 0.0)
    let max = gpui::state_float("max", 0.0)

    let mut bad = 0

    // 1. The press was heard, and heard where the thumb is — the gate that stands in for
    //    upstream's `thumb_bounds.contains`.
    if downs != 1 {
        println(f"FAIL DT2 the thumb heard {downs} press(es), not 1: the window-level listener did not register, or the gate rejected a press inside the thumb")
        bad = bad + 1
    }

    // 2. The move was heard at all, and it was a move the thumb's own hitbox could not have
    //    heard: it happened below the thumb's bottom edge. This is the half of the deviation
    //    about tracking, and it is the one thing here that no arithmetic can fake.
    if moves < 1 {
        println(f"FAIL DT2 no move carried the drag: the pointer went {DRAG_DOWN:.0} px below the thumb's top and the list never moved (offset {at:.1})")
        bad = bad + 1
    } else if above > 0.0 {
        println(f"FAIL DT2 the move the drag was carried by was {above:.1} px inside the thumb's bottom edge, so it does not show tracking past the thumb")
        bad = bad + 1
    }

    // 3. The release was heard, wherever it happened — the other thing an element-level
    //    listener cannot do.
    if ups != 1 {
        println(f"FAIL DT2 the thumb heard {ups} release(s), not 1: a release outside the thumb reached nobody")
        bad = bad + 1
    }

    if table_h <= 0.0 || max <= 0.0 {
        println(f"FAIL DT2 the list reports a viewport of {table_h:.1} and a maximum offset of {max:.1}, so there is nothing for a drag to move")
        return
    }

    // 4. Where the drag left the list. Both rules are evaluated on the numbers a real list in a
    //    real window gave: the point the pointer was actually at on the move, the point the press
    //    grabbed, the list's own origin and viewport, and the maximum offset.
    let want = now_offset(move_py, grab, table_y, table_h, max)
    let wrong = was_offset(move_py, press_ty, table_h, max)

    if !same(settled, want) {
        println(f"FAIL DT2 the drag asked the list for {want:.1} and it settled at {settled:.1}: {settled - want:.1} px out")
        bad = bad + 1
    } else {
        println(f"ok     DT2 the drag held the point it grabbed: press {GRAB_INSIDE:.0} px into the thumb, dragged {DRAG_DOWN - GRAB_INSIDE:.0} px lower, and the list settled at {settled:.1} of {max:.1} -- exactly what upstream's mapping asks for")
    }

    // 5. And a deliberately wrong reading, on the same numbers, lands somewhere else — which is
    //    what makes the line above a finding rather than arithmetic agreeing with itself.
    if differs(want, wrong) {
        println(f"ok     DT2 the deliberately wrong reading would have asked for {wrong:.1} instead, {want - wrong:.1} px away, so this check tells the two rules apart")
    } else {
        println(f"FAIL DT2 the deliberately wrong reading asks for {wrong:.1} too, so this check cannot tell the two rules apart")
        bad = bad + 1
    }

    if bad == 0 {
        println(f"OK DT2 a window-level listener on the thumb heard a press inside it, a move {0.0 - above:.0} px below its bottom edge and the release, and the list settled where upstream's mapping puts it")
    }

    // Left for the operator's eye, not as a check: the geometry every number above came from.
    let tx = gpui::state_float("press.tx", 0.0)
    let tw = gpui::state_float("press.tw", 0.0)
    let th = gpui::state_float("press.th", 0.0)
    println(f"note DT2 thumb at {tx:.1},{press_ty:.1} {tw:.1}x{th:.1}; list at y={table_y:.1} h={table_h:.1} max={max:.1}; grab={grab:.2}; move at y={move_py:.1}; {moves} move(s) drove it")
}
