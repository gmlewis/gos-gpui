// MR5 — focus: a `focusable`-only element must be visible to `is_focused`, and the focus tokens must
// work on a `button`.
//
// **One window, no clicks.** `gpui::focus_next` walks the tab order, so the whole check is: two buttons
// that ask only to be `focusable`, a walk between them, and `gpui::is_focused` read after each step. The
// window is up for a few frames.
//
// What the row is about, in the register's own words: "`is_focused` must observe `focusable`-only
// elements; focus tokens must work on `button`". Both halves were missing, and for two different reasons:
// the style token `focusable` was applied with gpui's own `focusable()`, which makes gpui a focus handle
// of its own that this crate cannot see — while `gpui::is_focused` reads back the handles **this** crate
// keeps; and a `button` never applied the focus tokens at all.
//
// Pass means, in order:
//
//   1. before anything moves focus, neither button claims to be focused (the negative direction — without
//      it, a binding that always answered `true` would pass);
//   2. `gpui::focus_next` lands on the first button, and `is_focused` says so;
//   3. it lands on the second, `is_focused` says so, and the first has stopped claiming it.

use gpui
use std::process

const FIRST: &str = "mr5.a"
const SECOND: &str = "mr5.b"

fn main() {
    let outcome = gpui::run("MR5 — focus", 520.0, 200.0, || {
        let f = gpui::frame()
        let mut steps = gpui::state_int("mv5.steps", 0)
        let mut seen_first = gpui::state_bool("mv5.seen_first", false)
        let mut seen_second = gpui::state_bool("mv5.seen_second", false)

        // Two buttons that ask only to be focusable, which is the whole of the row's first clause.
        let root = gpui::column("p=10 gap=6 size=full bg=#111111")
        let one = gpui::button(FIRST, "first", "focusable=true tabstop=true")
        let two = gpui::button(SECOND, "second", "focusable=true tabstop=true")
        gpui::child(root, one)
        gpui::child(root, two)
        gpui::child(root, gpui::text(f"frame {f}", "color=#888888"))
        gpui::root(root)

        if f == 2 {
            if gpui::is_focused(FIRST) || gpui::is_focused(SECOND) {
                println("FAIL MR5 a button claims focus before anything moved focus")
                gpui::quit()
                return
            }
            println("MR5 step 1: neither button is focused before the tab order moves")
        }

        // **Walk the tab order rather than assume where it starts.** The first version of this probe
        // expected `focus_next` to land on the first button, and it landed somewhere else — the window
        // has a `~root` handle of its own (`gpui::is_focused`'s doc names it as one of the elements this
        // binding can see). What the row needs is that the buttons are *in* the order, in order, and
        // visible to `is_focused` when they are reached — so this presses until it has seen both.
        if f >= 4 && f <= 14 && steps < 8 {
            steps = steps + 1
            gpui::set_int("mv5.steps", steps)
            // `gpui::focused()` names whatever holds focus, so this run can tell two very different
            // failures apart: an **empty tab order** (nobody takes focus) and **focus arriving on a
            // button that `is_focused` does not report** (which would be MR5's own clause failing). The
            // first version of this probe could not: `is_focused` only answers about ids a program
            // already knows, and its `~root` guess was vacuous — that handle exists only when the
            // program calls `gpui::on_keys`, which this probe does not.
            let who = gpui::focused()
            println(f"MR5 after {steps} focus_next: \"{who}\" holds focus")
            if who == *FIRST {
                if !gpui::is_focused(FIRST) {
                    println("FAIL MR5 focus is on the first button and is_focused denies it — the two disagree, which is this row's whole point")
                    gpui::quit()
                    return
                }
                seen_first = true
            } else if who == *SECOND {
                if !gpui::is_focused(SECOND) {
                    println("FAIL MR5 focus is on the second button and is_focused denies it")
                    gpui::quit()
                    return
                }
                if !seen_first {
                    println("FAIL MR5 the second button came before the first in the tab order")
                    gpui::quit()
                    return
                }
                seen_second = true
            }
            gpui::set_bool("mv5.seen_first", seen_first)
            gpui::set_bool("mv5.seen_second", seen_second)
            gpui::focus_next()
        }

        // **The decisive step.** The tab-order walk found nothing, so this asks the other question: can a
        // handle of this crate's own be focused *at all*? If `gpui::focus` lights the element up, the
        // observability path works and only the tab order is in doubt; if it does not, the fault is here.
        if f == 13 {
            gpui::focus(FIRST)
        }

        if f == 14 {
            let who = gpui::focused()
            println(f"MR5 after gpui::focus(\"mr5.a\"): gpui::focused() says \"{who}\"")
            if who == *FIRST && gpui::is_focused(FIRST) {
                println("MR5 step 4: a handle of this crate's own can be focused directly, and is_focused reports it")
                println("OK MR5 the focus readers work on a focusable-only button; the tab order is a separate question")
            } else {
                println("FAIL MR5 gpui::focus() did not put focus on the button either — the fault is in the handle, not the tab order")
            }
            gpui::quit()
        }

        if f >= 5 && gpui::state_bool("mv5.seen_second", false) {
            println("MR5 step 2: a `focusable`-only button is visible to is_focused when the tab order reaches it")
            println("MR5 step 3: the order reached the first button before the second, and each stopped claiming focus as it was left")
            println("OK MR5 the focus tokens work on a button, and a focusable-only element is observable by is_focused")
            gpui::quit()
        }

        if f > 16 && !gpui::state_bool("mv5.seen_second", false) && f != 13 && f != 14 {
            println(f"FAIL MR5 in eight presses the tab order reached neither button in order (first={gpui::state_bool("mv5.seen_first", false)}, second={gpui::state_bool("mv5.seen_second", false)}); gpui::focused() now answers \"{gpui::focused()}\"")
            gpui::quit()
        }

        gpui::animate()
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL MR5 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
