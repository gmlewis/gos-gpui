// W4 — the requests a frame raises, and the timers they install, are that
// window's.
//
// Tier: every tier.
//
// Pass means: two windows install a repeating timer under the *same* id, at
// different intervals, and neither ever hears the other's. A process-wide timer
// registry keyed by id alone starts only the first window's loop, and a
// process-wide event queue then hands its events to whichever window repaints
// first — so the child, whose own timer is set five seconds out, would hear the
// parent's thirty-millisecond beat.
//
// Deliberately uses no binding function that did not already exist, so what
// fails here before the work is the behaviour, not a missing name.

use gpui
use std::process

/// Drains this window's events and answers how many were `id`.
fn count_of(id: String) -> i64 {
    let mut n = 0
    for event in gpui::take_events() {
        if gpui::event_id(event) == id {
            n = n + 1
        }
    }
    n
}

/// The second window's view.
///
/// One view callback serves every window — the one `gpui::run` was given — and
/// `window::allocate` gives the window `run` opened the first id, 1, so anything
/// else is a window this program opened. The child is not given a callback of its
/// own passed to `gpui::open_window`; that call returns before the window is
/// drawn, and a callback handed to a binding function is valid only for that
/// call, so the child's view would answer an error on the compiled tiers.
fn child_view() {
    let cf = gpui::frame()
    if cf == 1 {
        // The same id the parent used, five seconds out. This
        // window's own timer will not have fired by the end of the
        // probe, so this window must hear nothing.
        gpui::tick("beat", 5000)
    }
    let beats = count_of("beat")
    if beats > 0 {
        println(f"FAIL W4 the child window heard {beats} beat(s) from a timer it did not start")
        gpui::quit()
    }
    gpui::animate()
    let child = gpui::column("p=8 bg=#222222 size=full")
    gpui::child(child, gpui::text(f"child frame {cf}", "color=#ffffff"))
    gpui::root(child)
}

fn main() {
    let outcome = gpui::run("w4 - per-window requests", 320.0, 200.0, || {
        if gpui::window_id() != 1 {
            return child_view()
        }

        let f = gpui::frame()

        if f == 1 {
            gpui::open_window("w4 - child", 380.0, 80.0, 260.0, 160.0, "")
        }

        if f == 1 {
            gpui::tick("beat", 30)
        }

        let mine = count_of("beat")
        let heard = gpui::state_int("w4.parent.beats", 0) + mine
        gpui::set_int("w4.parent.beats", heard)

        if f >= 40 {
            if heard == 0 {
                println("FAIL W4 the parent window never heard its own timer")
                gpui::quit()
            } else {
                println("OK W4 two windows ticked the same id at 30ms and 5000ms, and each heard only its own")
                gpui::quit()
            }
        } else {
            gpui::animate()
        }

        let root = gpui::column("p=8 bg=#111111 size=full")
        gpui::child(root, gpui::text(f"frame {f}", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL W4 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
