// WH2 — maximized and fullscreen: opening in that state, and `zoom_window`.
//
// Tier: every tier.
//
// The window opens with `start=maximized`, so this exercises both halves of the
// row in one run: the state a window *asks for at open*, which is a platform
// call rather than a size — gpui reads the bounds out of
// `WindowBounds::Maximized` and ignores the state, so a window can only zoom
// once it is on screen — and `gpui::zoom_window()` at runtime.
//
// Pass means the platform reports the window maximized after it opened asking
// to be, and reports it back to its own size after `zoom_window()` again.
// Both are read through `gpui::window_option("maximized")`, which is
// `Window::is_maximized` on this platform: the window's bounds being the
// display's work area.
//
// `toggle_fullscreen` is deliberately *not* exercised here, and the row says so:
// a fullscreen window takes over the display for the length of the transition,
// and this probe runs four times per tier and once per `scripts/probes.sh` — a
// check that switches the desktop's space every time it runs is a nuisance with
// a pass condition. The capability is implemented and the row names the half it
// does not check.

use gpui
use std::process

fn main() {
    let outcome = gpui::run_with("wh2 - window state", 320.0, 200.0, "start=maximized", || {
        let f = gpui::frame()
        let phase = gpui::state_int("wh2.phase", 0)
        let maximized = gpui::window_option("maximized")

        // `start=maximized` is a platform call made on the window's first frame,
        // and the platform takes its time about it: measured on this machine, the
        // zoom animation reaches the display's work area at frame 23 — about four
        // tenths of a second. The deadline is therefore a *time*, not a frame
        // count, because the frame rate is not a property of the program: a window
        // that is occluded stops being painted at all, so a frame-counted
        // deadline would turn a regression into a silent hang instead of a
        // failure. See the row's residual doubt.
        if f >= 2 && phase == 0 {
            if maximized == "1" {
                println("OK WH2 a window opened with start=maximized reports itself maximized")
                gpui::set_int("wh2.phase", 1)
                gpui::zoom_window()
            } else if gpui::now() > 4.0 {
                gpui::set_int("wh2.phase", 2)
                println(f"FAIL WH2 a window opened with start=maximized never reported itself maximized; it says \"{maximized}\"")
                gpui::quit()
            }
        } else if phase == 1 {
            // This half can wait: the window is maximized while it does, so it is
            // on top and keeps painting. The verdict is spoken once —
            // `gpui::quit()` asks the app to stop, it does not stop the callback,
            // so a branch that stays true would print its line every frame.
            if maximized == "0" {
                gpui::set_int("wh2.phase", 2)
                println("OK WH2 zoom_window put the window back, and the platform reports it")
                gpui::quit()
            } else if gpui::now() > 20.0 {
                gpui::set_int("wh2.phase", 2)
                println(f"FAIL WH2 zoom_window never put the window back; it still says \"{maximized}\"")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("window state", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL WH2 gpui::run_with stopped with an error: {problem}")
        process::exit(1)
    }
}
