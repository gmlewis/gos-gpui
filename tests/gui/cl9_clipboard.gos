// CL9 — a program-facing clipboard, text and image.
//
// Tier: every tier.
//
// The clipboard is a shared, stateful resource, so the check does three things a
// program would: it puts its own text on, reads it back, and **puts back whatever
// was there before** — otherwise running this five times leaves five probes' worth
// of text on the user's clipboard.
//
// The text half is the half that round-trips. The image half is a *reader*: a
// program can ask whether the clipboard holds an image, but the binding does not
// decode one, because writing an image needs gpui's own `Image` type and nothing in
// this crate constructs it. The probe therefore requires the kind to be one of three
// words and to agree with the text it just read, rather than pretending to test an
// image.

use gpui
use std::process

const MARKER: &str = "cl9 the clipboard round-trips"

fn main() {
    let outcome = gpui::run("cl9 - the clipboard", 320.0, 200.0, || {
        let f = gpui::frame()

        if f == 2 {
            // Keep whatever is there, so it can go back. If a *previous* run of
            // this probe was killed before its own restore — a stale build lock,
            // a timeout — then what is there is this probe's own marker, and
            // putting it back would leave the marker on the clipboard and fail the
            // check at frame 7 for a reason that has nothing to do with the
            // binding. The marker is therefore never the value that goes back.
            let mut old = gpui::clipboard_text()
            if old == *MARKER {
                old = "cl9 - restored after an interrupted run"
            }
            gpui::set_text("cl9.old", old)
            gpui::set_clipboard_text(*MARKER)
        }

        if f >= 4 && !gpui::state_bool("cl9.checked", false) {
            gpui::set_bool("cl9.checked", true)
            let got = gpui::clipboard_text()
            let kind = gpui::clipboard_kind()
            if kind != "text" {
                println(f"FAIL CL9 the clipboard holds text but reports its kind as \"{kind}\"")
                gpui::quit()
            } else if got != *MARKER {
                println(f"FAIL CL9 the clipboard reads back as \"{got}\", not the text written to it")
                gpui::quit()
            }
            // Back the way it was, before anything else can fail.
            gpui::set_clipboard_text(gpui::state_text("cl9.old", ""))
        }

        if f >= 7 {
            // What went back is what was there — and because the marker is never
            // what goes back, a restore that silently did nothing still shows.
            let back = gpui::clipboard_text()
            let old = gpui::state_text("cl9.old", "")
            if back != old {
                println(f"FAIL CL9 the clipboard reads back as \"{back}\", not the \"{old}\" that was there before the write")
                gpui::quit()
            } else {
                println("OK CL9 text written to the clipboard reads back with the right kind, and what was there is restored")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 bg=#111111 size=full")
        gpui::child(root, gpui::text("clipboard", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL CL9 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
