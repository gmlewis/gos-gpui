// EX22 — the menu bar `22_text` asks for: one empty menu named "GPUI Typography".
//
// container: it opens a window, so it runs under the container's own X server rather than here.
//
//   ./scripts/gosbox.sh run tests/gui/ex22_text_menu.gos
//
// # What this exists for
//
// `tools/upstream/examples/text.rs:302-305` installs exactly one menu, from `Application::run`'s
// closure and before the window is opened:
//
//     cx.set_menus(vec![Menu { name: "GPUI Typography".into(), items: vec![] }]);
//
// An empty menu is a name in the menu bar with nothing under it. Until round 101
// `examples/22_text.gos` called nothing here and said so in a deviation bullet — "the binding owns
// the macOS menu bar and exposes no API for it" — which had been false since `gpui::set_menus` was
// built (MN1's round), and which made that name the one *visible* difference the pair had.
//
// # What it measures, and what it is not
//
// The probe mirrors the port's own frame — the window, and the menu installed on it — and then asks
// the platform what it was given, through `gpui::installed_menu()`, which is `App::get_menus()`
// read back after the install. Both halves of "empty menu" are checked, because only the pair of
// them means it:
//
//   * the bar carries **one line** — a menu with items in it would read back as more lines, at
//     depth 1, and a bar with a second menu would read back as a second line at depth 0;
//   * that line is **`"0:menu:GPUI Typography:"`** — depth 0, kind `menu`, that name, no action.
//
// So a `set_menus` that dropped the name, invented an item, or installed anything else fails here.
// It is not a photograph: the container cannot carry a client window's pixels into its framebuffer
// (`tests/evidence/DW3.capture.txt`), and on Linux there is no menu *bar* to photograph anyway —
// `LinuxPlatform::set_menus` stores the menu and shows nothing (`platform/linux/platform.rs:474`),
// which is upstream's behaviour on Linux too. What is checked is what the platform was handed.
//
// # What is not here
//
// The tree. `22_text`'s window is the specimen sheet plus a 240px sidebar, it is upstream's element
// for element, and its six remaining deviations are mechanism, none of them on the menu bar. This
// probe is about the part of that pair's `main` that is *not* the tree.
//
// # The red
//
// Without the `set_menus` call below — which is what the port did until round 101 — the readback is
// empty and the first check fails: `FAIL EX22 the platform was handed 0 line(s) of menu bar, not the
// one empty menu upstream installs: #[]`. `tests/evidence/EX22.before.txt` is that transcript.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("ex22 - text menu", 320.0, 200.0, || {
        let f = gpui::frame()

        // Upstream installs its menu before the window opens; `gpui::set_menus` is a request the
        // binding applies after the frame that asked for it, so frame 2 is the port's own place
        // for it — the same line, in the same shape, that `examples/22_text.gos` now starts with.
        if f == 2 {
            gpui::set_menus("GPUI Typography", #[])
        }

        if f >= 8 {
            let installed = gpui::installed_menu()

            // One exclusive chain ending in the verdict; every branch is a positive condition,
            // because `if !flag` and `if flag == false` are both lint noise here.
            if installed.len() != 1 {
                println(f"FAIL EX22 the platform was handed {installed.len()} line(s) of menu bar, not the one empty menu upstream installs: {installed}")
                gpui::quit()
            } else if installed[0] != "0:menu:GPUI Typography:" {
                println(f"FAIL EX22 the one menu reads back as \"{installed[0]}\", not the empty menu named \"GPUI Typography\" upstream installs")
                gpui::quit()
            } else {
                println("OK EX22 the menu bar is upstream's exactly: one menu named \"GPUI Typography\" with nothing under it — the platform was handed 1 line, at depth 0, with no action")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#ffffff")
        gpui::child(root, gpui::text("GPUI Typography", "color=#000000 fs=16"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL EX22 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
