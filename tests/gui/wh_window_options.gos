// WH1 minimum window size; WH3 application id; WH5 scale factor; WH8 window
// kind and tabbing identifier; WH7 the option vocabulary and its refusals.
//
// Tier: every tier.
//
// One probe for five rows because they are one mechanism: the `"key=value …"`
// string `run`, `run_with` and `open_window` all take. Each of them used to be
// parsed by whichever entry point happened to read it, so the first window and
// every window after it disagreed about what the vocabulary meant, and a token
// nobody knew was dropped in silence.
//
// Pass means:
//
//   * the window answers for every open-time option it was asked for — the
//     minimum size it will shrink to, the id a Linux desktop groups it by, the
//     kind of window it is, its tab group
//   * the scale factor the platform reports is a real one
//   * the vocabulary knows every key it has, and `unknown_window_tokens` names
//     a misspelt key and a key whose value means nothing here
//
// The asked-for half is what a binding can answer for: it is the value that
// went into `WindowOptions`, which is the whole of this crate's job. Whether
// the window manager then honours a minimum size is the platform's, and is
// named in the row's residual doubt rather than claimed here.

use gpui
use std::process

fn main() {
    let outcome = gpui::run_with("wh - window options", 300.0, 200.0, "minsize=420,240 appid=com.example.wh tabbing=wh-group kind=floating", || {
        let f = gpui::frame()

        if f >= 2 {
            let mut ok = true

            // WH1 — the minimum size the window was opened with.
            let min = gpui::window_option("min")
            if min != "420,240" {
                println(f"FAIL WH1 the window reports a minimum size of \"{min}\", not the 420,240 it asked for")
                ok = false
            }
            let min_w = gpui::window_option("min_w")
            let min_h = gpui::window_option("min_h")
            if ok && (min_w != "420" || min_h != "240") {
                println(f"FAIL WH1 the minimum size reads back as {min_w}x{min_h}, not 420x240")
                ok = false
            }

            // WH3 — the application id a desktop groups the window by.
            let app_id = gpui::window_option("app_id")
            if ok && app_id != "com.example.wh" {
                println(f"FAIL WH3 the window reports an application id of \"{app_id}\", not com.example.wh")
                ok = false
            }

            // WH5 — the platform's scale factor, which is what a program picks
            // a raster size from. Zero is not a scale factor.
            let scale = gpui::window_option("scale")
            if ok && (scale == "" || scale == "0") {
                println("FAIL WH5 the window reports no scale factor at all")
                ok = false
            }

            // WH8 — the kind of window, and its tab group.
            let kind = gpui::window_option("kind")
            if ok && kind != "floating" {
                println(f"FAIL WH8 the window reports a kind of \"{kind}\", not the floating it asked for")
                ok = false
            }
            let tabbing = gpui::window_option("tabbing")
            if ok && tabbing != "wh-group" {
                println(f"FAIL WH8 the window reports a tab group of \"{tabbing}\", not wh-group")
                ok = false
            }

            // WH7 — the vocabulary. Every key it has, in one string, must be
            // understood; a misspelt key and a key whose value means nothing
            // here must be named rather than dropped.
            let whole = gpui::unknown_window_tokens("minsize=420,240 appid=com.example tabbing=t start=maximized display=0 place=center background=blur titlebar=none show=false movable=false minimizable=false focus=false resizable=false float=true maximized=true fullscreen=true kind=popup")
            if ok && whole.len() != 0 {
                let mut first = ""
                for token in whole {
                    if first == "" {
                        first = token
                    }
                }
                println(f"FAIL WH7 the vocabulary does not know \"{first}\", which it has")
                ok = false
            }
            let bad = gpui::unknown_window_tokens("minsize=420 kind=dialog nosuch=1")
            if ok && bad.len() != 3 {
                println(f"FAIL WH7 three tokens of \"minsize=420 kind=dialog nosuch=1\" are not this vocabulary's, but {bad.len()} were reported")
                ok = false
            }
            if ok {
                let mut seen = ""
                for token in bad {
                    seen = f"{seen} {token}"
                }
                if seen != " minsize=420 kind=dialog nosuch=1" {
                    println(f"FAIL WH7 the refusals read back as{seen}, not minsize=420 kind=dialog nosuch=1")
                    ok = false
                }
            }

            if ok {
                println(f"OK WH1 WH3 WH5 WH7 WH8 the window answers for its minimum size, app id, kind and tab group; the scale factor is {scale}; the vocabulary knows its own keys and refuses minsize=420, kind=dialog and nosuch=1")
            }
            gpui::quit()
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("window options", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL WH1 gpui::run_with stopped with an error: {problem}")
        process::exit(1)
    }
}
