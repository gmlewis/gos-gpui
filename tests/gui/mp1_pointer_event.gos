// MP1 — a pointer event carries its own point, and its own modifiers, measured against a
// real pointer on a real window.
//
// container: the pointer is driven from outside the process by `xdotool` through XTEST,
// against the X server the window really sits on. The Mac has no such server — and
// `scripts/window-guard.sh` keeps a window from opening there at all — so `scripts/probes.sh`
// and `scripts/tiers.sh` skip this one by name. It runs in the container:
//
//   ./scripts/gosbox.sh tiers tests/gui/mp1_pointer_event.gos
//
// # What this exists for
//
// `gpui::on_mouse` writes the point it saw into `<id>.x` / `<id>.y`, one slot per element, and
// raises `"<id>|<kind>"`. The slot holds the **last** event's point, so when several moves
// coalesce into one frame every one of those events reads back the same number and the points
// in between are gone. `13_painting`'s header has said so in prose since it was written and
// nothing had ever measured it. This measures it: the moves below are posted from *inside* a
// frame, with the frame's own callback blocked while they go out, so they cannot fail to
// arrive together.
//
// Pass means all four of these, and each is checked against what `xdotool` was told:
//
//   * a down, four moves and an up arrive, in order, with `gpui::event_parts` still answering
//     just the kind (`"down"` / `"move"` / `"up"`) — the payload grew a tail and nothing that
//     reads a kind noticed;
//   * the four moves carry four **different** points, spaced exactly as they were posted —
//     which is the whole point, and which the store cannot do;
//   * `gpui::state_float("canvas.x")` still reports the **last** point, in the element's own
//     space, while `gpui::pointer_xy` reports each event's own point in the **window's** —
//     the two spaces differ by the element's origin, and this asserts both numbers exactly;
//   * shift held over a move arrives on that move and on the next, and is gone from the move
//     after it is released.
//
// # Why the window has to be found and the box has to be known
//
// The pointer is moved to absolute **screen** coordinates, and the binding reports a point in
// the window. The two are related by where the window sits, so the probe reads the window's
// own position (`gpui::window_field("inner_x")`) rather than assuming it, and posts the
// gesture relative to that. The listener's box is `absolute left=100 top=80 w=400 h=300`, so
// the element's own space is the window's, less exactly that origin.
//
// # Why a click has to come from outside the process
//
// gpui has no public way to inject a pointer event — `DW4`'s header records the experiment in
// full (`Window::dispatch_event` returns a `pub(crate)` type, so it is not callable from
// another crate however it is wrapped). The operating system's own input device is the way in.

use gpui
use std::os::exec
use std::process
use std::strconv

/// The title the window is opened with, and what `xdotool` is told to look for. One word, so
/// that the search cannot match anything else on the display.
const TITLE: String = "mp1ptr"

/// Where the listening box sits inside the window, from its own style string below. Written
/// once and used both to place the mouse and to say what the element's own space is.
const BOX_X: f64 = 100.0
const BOX_Y: f64 = 80.0
const BOX_W: f64 = 400.0
const BOX_H: f64 = 300.0

/// How far apart the four moves are posted. Not 1px: a spacing that survives the round trip
/// through `xdotool`'s own integer coordinates is a spacing whose loss is visible.
const STEP: f64 = 20.0

/// Run a program and answer its stdout, trimmed, with anything that went wrong printed.
///
/// A missing tool or a refusal is printed rather than swallowed: its stdout is then empty and
/// every step below would fail for the wrong reason.
fn shell(program: String, args: Vec<String>) -> String {
    match exec::run(program.clone(), args) {
        Ok(out) => {
            if out.code != 0 {
                println(f"FAIL MP1 {program} exited {out.code}: {out.stderr.trim()}")
            }
            out.stdout.trim().clone()
        }
        Err(problem) => {
            println(f"FAIL MP1 could not run {program}: {problem}")
            String::new()
        }
    }
}

/// One `key=value` line out of `xdotool getwindowgeometry --shell`, as a number, or `-1.0`.
fn field(text: String, key: String) -> f64 {
    for line in text.split("\n") {
        if let Some((name, value)) = line.split_once("=") {
            if name.trim() == key {
                return match strconv::parse_f64(value.trim().clone()) {
                    Ok(number) => number,
                    Err(_) => -1.0,
                }
            }
        }
    }
    -1.0
}

/// The xdotool subcommand that posts one pointer move, as a list of words.
fn move_to(x: f64, y: f64) -> Vec<String> {
    let sx = x.round() as i64
    let sy = y.round() as i64
    #["mousemove", "--sync", f"{sx}", f"{sy}"]
}

/// A point as it will be compared: `"12.5,30.25"`, to two decimals.
fn point(x: f64, y: f64) -> String {
    f"{x:.2},{y:.2}"
}

/// Whether two points are the same to within a hundredth of a pixel.
fn same(x: f64, y: f64, ex: f64, ey: f64) -> bool {
    let dx = x - ex
    let dy = y - ey
    (if dx < 0.0 { -dx } else { dx }) < 0.01 && (if dy < 0.0 { -dy } else { dy }) < 0.01
}

/// Find the window, work out where its content origin is, post the first gesture, and remember
/// the origin for the second one and for the assertions.
///
/// The origin is taken from **the binding**, `gpui::window_field("inner_x")`, and not from
/// `xdotool`'s own reading of the same window. The binding's is the number a pointer event is
/// measured against — so it is the one to post relative to, and the one to assert against — and
/// the two are compared rather than assumed equal, because a window manager that draws a frame
/// of its own around the client would put them apart and every point below would be out by the
/// difference.
fn post_gestures(wid: String, _f: i64) {
    let geometry = shell("xdotool", #["getwindowgeometry", "--shell", wid])
    let win_x = field(geometry.clone(), "X")
    let win_y = field(geometry.clone(), "Y")
    let ox = gpui::window_field("inner_x")
    let oy = gpui::window_field("inner_y")
    if !same(win_x, win_y, ox, oy) {
        println(f"note MP1 xdotool puts the window at {point(win_x, win_y)} and the binding at {point(ox, oy)}; posting relative to the binding's")
    }
    gpui::set_float("origin_x", ox)
    gpui::set_float("origin_y", oy)

    // The gesture, in the window's own coordinates. `sx`/`sy` are the element's, which is where
    // the listener's box is measured from.
    let sx = BOX_X + 150.0
    let sy = BOX_Y + 100.0
    let _ = shell("xdotool", move_to(ox + sx, oy + sy))
    let _ = shell("xdotool", #["mousedown", "1"])
    for i in 0..4 {
        let _ = shell("xdotool", move_to(ox + sx + STEP * ((i + 1) as f64), oy + sy))
    }
    let _ = shell("xdotool", #["mouseup", "1"])
}

fn main() {
    let outcome = gpui::run(TITLE, 900.0, 600.0, || {
        let f = gpui::frame()

        // A frame is only painted when something asks for one: `gpui::run`'s tree on its own
        // gets the window's first two and then the program sits idle. Every probe that needs a
        // run of frames says so, and this is it — measured here, a variant with no `animate()`
        // printed frames 1 and 2 and nothing more.
        gpui::animate()

        // The gesture is posted while this frame's callback is blocked inside `exec::run`, so
        // every one of its events is queued before the next frame can drain them. That is what
        // makes the coalescing below a certainty rather than a hope — and the store's one-slot
        // reading is what makes it a defect.
        if f == 3 && gpui::state_int("phase", 0) == 0 {
            gpui::set_int("phase", 1)
            let found = shell("xdotool", #["search", "--name", TITLE])
            let hits = found.lines()
            if hits.is_empty() {
                println(f"FAIL MP1 no window named {TITLE} on this display (xdotool said `{found}`)")
            } else {
                post_gestures(hits[0].trim().clone(), f)
            }
        }

        // The second gesture: shift held over two moves, then let go before a third.
        if f == 6 && gpui::state_int("phase", 0) == 1 {
            gpui::set_int("phase", 2)
            let win_x = gpui::state_float("origin_x", 0.0)
            let win_y = gpui::state_float("origin_y", 0.0)
            let sx = BOX_X + 150.0
            let sy = BOX_Y + 100.0
            let _ = shell("xdotool", #["mousedown", "1"])
            let _ = shell("xdotool", #["keydown", "shift"])
            let _ = shell("xdotool", move_to(win_x + sx + 100.0, win_y + sy + 40.0))
            let _ = shell("xdotool", move_to(win_x + sx + 114.0, win_y + sy + 40.0))
            let _ = shell("xdotool", #["keyup", "shift"])
            let _ = shell("xdotool", move_to(win_x + sx + 128.0, win_y + sy + 40.0))
            let _ = shell("xdotool", #["mouseup", "1"])
        }

        // ---- the first gesture's events ----------------------------------
        //
        // One pass, collecting the kinds and the points. The kinds are asserted as the whole
        // run rather than one at a time: `event_parts` answering the kind alone is the thing
        // the payload's new tail could have broken, and a run of the six is what says it did
        // not.
        if f == 4 {
            let mut kinds: Vec<String> = #[]
            let mut moves: Vec<(f64, f64)> = #[]
            for event in gpui::take_events() {
                let id, kind = gpui::event_parts(event.clone())
                if id == "canvas" {
                    kinds.push(kind.clone())
                    if kind == "move" {
                        let x, y = gpui::pointer_xy(event.clone())
                        moves.push((x, y))
                    }
                }
            }
            let expected_kinds = "down,move,move,move,move,up"
            let saw_kinds = kinds.join(",")
            if saw_kinds != expected_kinds {
                println(f"FAIL MP1 the events were {saw_kinds}, not {expected_kinds}")
            }
            if moves.len() != 4 {
                println(f"FAIL MP1 {moves.len()} moves arrived, not 4")
            } else {
                // Four different points, in the order and at the spacing they were posted, each
                // in the *window's* own space — which is what upstream's `MouseDownEvent::position`
                // holds and what a port paints with. Nothing that reads one slot per frame can
                // do this, which is the whole of the defect.
                for i in 0..4 {
                    let x = moves[i].0
                    let y = moves[i].1
                    let want_x = BOX_X + 150.0 + STEP * ((i + 1) as f64)
                    let want_y = BOX_Y + 100.0
                    if !same(x, y, want_x, want_y) {
                        println(f"FAIL MP1 move {i} is {point(x, y)} in the window, not the {point(want_x, want_y)} it was posted at")
                    }
                }
                // The store, by contrast, holds one point — the last — and holds it in the
                // *element's* own space, which is where the box is measured from. The two
                // spaces differ by exactly that origin, and asserting both says so.
                let lx = gpui::state_float("canvas.x", -999.0)
                let ly = gpui::state_float("canvas.y", -999.0)
                if !same(lx, ly, 150.0 + 4.0 * STEP, 100.0) {
                    println(f"FAIL MP1 the store says {point(lx, ly)}, not the last point in the element's own space")
                }
                if same(moves[0].0, moves[0].1, moves[3].0, moves[3].1) {
                    println("FAIL MP1 the first and last moves are the same point, so nothing was coalesced and this proves nothing")
                }
            }
        }

        // ---- the second gesture's events ---------------------------------
        //
        // Shift is held over the first two moves and released before the third. The modifiers
        // ride on the event, so the third move says they are gone — a latch kept in the
        // program's own state could not tell the difference, and `gpui::on_keys` raises
        // key-down only, so it could never have been released.
        //
        // Drained over several frames rather than one. The gesture is posted with the frame's
        // own callback blocked, so its events are queued before it returns — but *when* gpui
        // hands them to the program is the platform's business, and the second gesture's
        // `keydown`/`keyup` put enough round trips in front of the moves that the first
        // iteration after posting delivers only the `down`, and the moves arrive one
        // iteration later. What this check is about is the content of the events, not
        // which frame they land in, so it collects over a window and asserts at the end.
        if f >= 7 && f <= 9 {
            for event in gpui::take_events() {
                let id, kind = gpui::event_parts(event.clone())
                // Gesture 2's events only; gesture 1's were drained and asserted above.
                if id == "canvas" {
                    let kinds_so_far = gpui::state_text("kinds2", String::new())
                    gpui::set_text("kinds2", f"{kinds_so_far}{kind},")
                    if kind == "move" {
                        let mods_so_far = gpui::state_text("mods", String::new())
                        let m = gpui::pointer_mods(event.clone())
                        gpui::set_text("mods", f"{mods_so_far}{m},")
                    }
                }
            }
        }

        if f == 10 {
            let saw_mods = gpui::state_text("mods", String::new())
            let expected_mods = "shift,shift,,"
            if saw_mods != expected_mods {
                println(f"FAIL MP1 the moves' modifiers were `{saw_mods}`, not `{expected_mods}`")
            }
            let saw_kinds = gpui::state_text("kinds2", String::new())
            let expected_kinds = "down,move,move,move,up,"
            if saw_kinds != expected_kinds {
                println(f"FAIL MP1 the second gesture's events were `{saw_kinds}`, not `{expected_kinds}`")
            }
            if saw_mods == expected_mods && saw_kinds == expected_kinds {
                println("OK MP1 four moves in one frame kept their own points, the store kept the last of them, `event_parts` still answered only the kind, and shift arrived and left with the key")
            }
            gpui::quit()
        }

        let listener = gpui::on_mouse(
            gpui::rect(f"absolute left={BOX_X} top={BOX_Y} w={BOX_W} h={BOX_H} bg=#eeeeee"),
            "down up move",
            "canvas",
        )
        let root = gpui::child(gpui::stack("size=full bg=white"), listener)
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
