// WH6 — window bounds: outer and inner, the state they are in, and observing a
// change.
//
// Tier: every tier.
//
// The row has three parts. The *outer* bounds are already readable — `window_field`
// has answered x, y, w and h since the beginning. The *inner* ones, the state the
// window is in, and the size it would go back to are not, and the `observe` half is a
// callback the platform invokes rather than a reader, which is what makes this the
// only WH row that needs a retained callback.
//
// Pass means:
//
//   * the window reports an inner size, and it is not larger than the outer one
//   * a window opened windowed says so, and reports no restore size
//   * resizing it raises a bounds event, and the window reports the new size
//
// The first assertion is the one with teeth at HEAD, and it is a *behaviour* rather
// than an unresolved name: `window_field` answers 0.0 for a field it does not know,
// so a program asking for the inner size got a window with no interior.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("wh6 - window bounds", 320.0, 200.0, || {
        let f = gpui::frame()

        if f == 2 {
            let w = gpui::window_field("w")
            let h = gpui::window_field("h")
            let inner_w = gpui::window_field("inner_w")
            let inner_h = gpui::window_field("inner_h")

            // The chain is ordered so that nothing round 19 added is *called* before
            // the assertion that can fail without it. Everything below the first
            // `else` is inside that branch for exactly that reason: a probe that
            // touches a new name in its first statement is abandoned at that name at
            // HEAD, and a timeout is a much weaker transcript than a wrong answer.
            //
            // It is also one exclusive chain, ending in the verdict: `gpui::quit()`
            // asks the app to stop, it does not abort the callback that called it, so
            // a failure branch written as a separate `if` falls through and prints the
            // success line in the same frame.
            if inner_w <= 0.0 || inner_h <= 0.0 {
                println(f"FAIL WH6 the window reports an inner size of {inner_w}x{inner_h}, which is not a size")
                gpui::quit()
            } else if inner_w > w + 4.0 || inner_h > h + 4.0 {
                println(f"FAIL WH6 the inner size {inner_w}x{inner_h} is larger than the outer {w}x{h}")
                gpui::quit()
            } else {
                let state = gpui::window_bounds_state()
                let restore_w = gpui::window_field("restore_w")
                if state != "windowed" {
                    println(f"FAIL WH6 a window opened windowed reports its bounds as \"{state}\"")
                    gpui::quit()
                } else if restore_w > 0.5 {
                    println(f"FAIL WH6 a windowed window reports a restore width of {restore_w}, which is a size nothing will go back to")
                    gpui::quit()
                } else {
                    gpui::set_float("wh6.w", w)
                    gpui::set_float("wh6.h", h)
                    gpui::set_float("wh6.iw", inner_w)
                    gpui::set_float("wh6.ih", inner_h)
                    gpui::observe_window_bounds("bounds")
                }
            }
        }

        if f == 3 {
            // `Context::observe_window_bounds` runs its callback once as it installs
            // it, so the first event is the geometry the window already had. Draining
            // it here — before the resize — is what makes the event the verdict waits
            // for unambiguous.
            for event in gpui::take_events() {
                let id, _payload = gpui::event_parts(event)
                if id == "bounds" {
                    gpui::set_int("wh6.seen", gpui::state_int("wh6.seen", 0) + 1)
                }
            }
            gpui::resize_window(430.0, 310.0)
        }

        if f >= 4 && gpui::state_int("wh6.done", 0) == 0 {
            let mut heard = false
            for event in gpui::take_events() {
                let id, _payload = gpui::event_parts(event)
                if id == "bounds" {
                    heard = true
                }
            }
            let w = gpui::window_field("w")
            let h = gpui::window_field("h")
            if heard {
                gpui::set_int("wh6.done", 1)
                if w < 400.0 || h < 280.0 {
                    println(f"FAIL WH6 the resize to 430x310 raised a bounds event, but the window reports {w}x{h}")
                    gpui::quit()
                } else {
                    let was_w = gpui::state_float("wh6.w", 0.0)
                    let was_h = gpui::state_float("wh6.h", 0.0)
                    let was_iw = gpui::state_float("wh6.iw", 0.0)
                    let was_ih = gpui::state_float("wh6.ih", 0.0)
                    println(f"OK WH6 outer {was_w}x{was_h} and inner {was_iw}x{was_ih} while windowed; a resize to 430x310 raised a bounds event and the window now reports {w}x{h}")
                    gpui::quit()
                }
            } else if w >= 400.0 && h >= 280.0 {
                // The resize took effect and no event came with it. This is the
                // break's shape, and it is caught by *counting frames since the
                // geometry changed* rather than by waiting on a clock: an occluded
                // window stops being painted altogether, so a `gpui::now()` deadline
                // can outlive the last frame the probe will ever see and the run ends
                // as a silent `exit 124` instead of a verdict. Twenty frames is about
                // a third of a second here, several times what the platform takes.
                let waited = gpui::state_int("wh6.grace", 0) + 1
                gpui::set_int("wh6.grace", waited)
                if waited > 20 {
                    gpui::set_int("wh6.done", 1)
                    println(f"FAIL WH6 the resize to 430x310 took effect — the window reports {w}x{h} — but raised no bounds event")
                    gpui::quit()
                }
            } else if f > 60 {
                gpui::set_int("wh6.done", 1)
                println(f"FAIL WH6 the resize to 430x310 never took effect; the window still reports {w}x{h}")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("window bounds", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL WH6 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
