// WH4 — choose the display (`display=`), and `place=center`.
//
// Tier: every tier.
//
// The check has to go through `open_window`, and that is the point of the row:
// `place=center` was read, stored, and then compared in an `if` whose two arms
// were the same expression, so a window opened with it landed exactly where its
// x and y said instead of in the middle of the display. The first window could
// never have shown that — `run` centres it by habit, whatever the spec says — so
// this probe opens a *second* window at x=7, y=9 with `place=center` and asks the
// child itself where it landed.
//
// Pass means:
//
//   * the child's x is where the display's centre puts a 300-wide window, not 7
//   * its y is not the 9 it was given either
//   * the options it was opened with say `place=center`, and name a display
//
// The first assertion is deliberately the one that uses nothing this binding
// added in round 17: at HEAD the probe fails on it with an address in a message,
// rather than being abandoned at an unresolved name and timing out.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("wh4 - display and place", 320.0, 200.0, || {
        let f = gpui::frame()

        if f == 2 {
            gpui::open_window("wh4 child", 7.0, 9.0, 300.0, 200.0, "display=0 place=center", || {
                let cf = gpui::frame()

                if cf == 2 {
                    let dx = gpui::display_field(0, "x")
                    let dy = gpui::display_field(0, "y")
                    let dw = gpui::display_field(0, "w")
                    let dh = gpui::display_field(0, "h")
                    let x = gpui::window_field("x")
                    let y = gpui::window_field("y")
                    let place = gpui::window_option("place")
                    let display = gpui::window_option("display")

                    // Where a centred 300x200 window belongs on display 0.
                    let want_x = dx + (dw - 300.0) / 2.0
                    let want_y = dy + (dh - 200.0) / 2.0

                    // One exclusive chain, ending in the verdict, and that is not
                    // tidiness: `gpui::quit()` asks the app to stop, it does **not**
                    // abort the callback that called it, so a failure branch that is
                    // not the last thing in its chain falls through and prints the
                    // success line after the failure. Written as separate `if`s this
                    // probe said both things at once, which is how it was caught.
                    //
                    // A few pixels of slack: the platform rounds, and the two
                    // numbers arrive through different conversions.
                    if x - want_x > 4.0 || want_x - x > 4.0 {
                        println(f"FAIL WH4 the child opened with place=center at x={x}, where the display's centre puts a 300 wide window at {want_x}; it was given x=7")
                        gpui::quit()
                    } else if y == 9.0 {
                        println(f"FAIL WH4 the child opened with place=center at the y it was given, {y}, not near the display's centre at {want_y}")
                        gpui::quit()
                    } else if place != "center" {
                        println(f"FAIL WH4 the child reports its placement as \"{place}\", not the center it asked for")
                        gpui::quit()
                    } else if display == "" || display == "0" {
                        println(f"FAIL WH4 the child cannot say which display it is on; it answers \"{display}\"")
                        gpui::quit()
                    } else {
                        println(f"OK WH4 a child opened at x=7,y=9 with display=0 place=center landed at x={x},y={y} (centre {want_x},{want_y}), and reports place={place} display={display}")
                        gpui::quit()
                    }
                }

                gpui::animate()
                let root = gpui::column("p=4 size=full bg=#111111")
                gpui::root(root)
            })
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("display and place", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL WH4 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
