// W2 — the state store is scoped per window, on a real window.
//
// Tier: every tier. The headless half of this capability is
// `tests/w2_store_scope.gos` (`gos test tests`); this half proves the *current*
// window is resolved correctly while frames are running, which a headless test
// cannot reach.
//
// Pass means: two windows open at once, both writing the same key on every
// frame, and neither ever reading the other's value — checked both through the
// window they are in and from one window addressing the other by id.

use gpui
use std::process

/// One window's half of the experiment.
///
/// Writes this window's own value under the shared key every frame, reads it
/// back through the window it is running in, and — once both windows have
/// certainly written — checks the other window's namespace from here. Answers
/// false when this window's value did not survive.
fn window_body(value: i64, other: i64, other_value: i64, frame: i64) -> bool {
    let me = gpui::window_id()
    gpui::set_int("w2.value", value)

    let mine = gpui::state_int("w2.value", -1)
    if mine != value {
        println(f"FAIL W2 window {me} wrote {value} and read back {mine}")
        return false
    }

    if frame >= 5 {
        let here = gpui::state_int_in(me, "w2.value", -1)
        let there = gpui::state_int_in(other, "w2.value", -1)
        if here != value || there != other_value {
            println(
                f"FAIL W2 window {me} reads {here} for itself (want {value}) and {there} for window {other} (want {other_value})"
            )
            return false
        }
    }
    true
}

/// The second window's view.
///
/// There is one view callback for the program — the one `gpui::run` was given —
/// and every window is drawn by it. `window::allocate` gives the window `run`
/// opened the first id, 1, so that one is the parent and every other id is a
/// window this program opened. It is not a callback of its own passed to
/// `gpui::open_window`; `open_window` returns before the window is ever drawn, and
/// a callback handed to a binding function is valid only for that call, so a view
/// callback passed that way would answer an error on the compiled tiers.
///
/// The child is window 2 and holds 22, while window 1 holds 11 — the values
/// `main`'s own body uses, the other way round.
fn child_view() {
    let cf = gpui::frame()
    if !window_body(22, 1, 11, cf) {
        gpui::quit()
    }
    gpui::animate()
    let child = gpui::column("p=8 bg=#222222 size=full")
    gpui::child(child, gpui::text("child", "color=#ffffff"))
    gpui::root(child)
}

fn main() {
    let outcome = gpui::run("w2 - per-window state", 320.0, 200.0, || {
        if gpui::window_id() != 1 {
            return child_view()
        }

        let f = gpui::frame()
        let me = gpui::window_id()

        if f == 1 {
            // Window 2: the same experiment, the other value.
            gpui::open_window("w2 - child", 380.0, 80.0, 260.0, 160.0, "")
        }

        if !window_body(11, 2, 22, f) {
            gpui::quit()
        }

        if f >= 6 {
            println(f"OK W2 window {me} held 11 while window 2 held 22, over {f} frames")
            gpui::quit()
        } else {
            gpui::animate()
        }

        let root = gpui::column("p=8 bg=#111111 size=full")
        gpui::child(root, gpui::text(f"window {me}, frame {f}", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL W2 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
