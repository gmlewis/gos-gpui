// W8 — menus wired to the window that renders, not the first.
//
// **Two windows, no clicks.** The row's claim is about *wiring*: when a window renders, the menu it asks for is
// installed on **that** window rather than on whichever window happened to come first. That is readable
// without a click, because `gpui::installed_menu()` answers for the window whose callback is running — so
// window 2 can be asked what menu it was given, and a witness in window 1 can compare.
//
// Before the fix the second window's `set_menus` landed on the first window: window 2's own record stayed empty
// and window 1's named the second menu. So the check is exactly that each window reports its **own** menu, and
// that the two differ.
//
// The *action* half of the row — that clicking an item delivers it to the window whose menu it was — is not
// exercised here: a menu click cannot be synthesized. What this does show is the half a program can see.
//
// Run with `DSH_ALLOW_WINDOWS=1 ./scripts/run-once.sh tests/gui/w8_menu_owner.gos 45`.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("w8 - first", 460.0, 200.0, || {
        let f = gpui::frame()

        if f == 1 {
            gpui::set_menus("w8.first", #["events:first"])
            gpui::open_window("w8 - second", 480.0, 0.0, 380.0, 180.0, "", || {
                if gpui::frame() == 1 {
                    gpui::set_menus("w8.second", #["events:second"])
                }
                if gpui::frame() == 5 {
                    // This window asks what menu *it* was given. If the wiring is right, that is its own.
                    let mine = gpui::installed_menu()
                    if mine.len() > 0 {
                        gpui::set_text_in(1, "w8.menu.second", mine[0])
                    }
                }
                gpui::animate()
                let child = gpui::column("p=8 gap=4 size=full bg=#222222")
                gpui::child(child, gpui::text("the second window", "color=#ffffff"))
                gpui::child(child, gpui::text(f"{gpui::frame()}", "color=#888888"))
                gpui::root(child)
            })
        }

        if f == 7 {
            let mine = gpui::installed_menu()
            if mine.len() > 0 {
                gpui::set_text("w8.menu.first", mine[0])
            }
        }

        if f >= 12 {
            let first = gpui::state_text("w8.menu.first", "")
            let second = gpui::state_text("w8.menu.second", "")
            println(f"W8 the first window reports \"{first}\" and the second reports \"{second}\"")
            if first == "" {
                println("FAIL W8 the first window was given no menu at all")
            } else if second == "" {
                println("FAIL W8 the second window was given no menu — its set_menus went somewhere else")
            } else if first == second {
                println("FAIL W8 both windows report the same menu: the second window's menu landed on the first, which is the defect this row is about")
            } else {
                println("OK W8 each window was given its own menu, so the menu follows the window that renders")
            }
            gpui::quit()
            return
        }

        gpui::animate()
        let root = gpui::column("p=8 gap=4 size=full bg=#111111")
        gpui::child(root, gpui::text("the first window — a second one opens beside it", "color=#ffffff"))
        gpui::child(root, gpui::text(f"{f}", "color=#888888"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL W8 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
