// KM6 — Shift-Tab and modifier fidelity.
//
// Tier: every tier.
//
// One hole, in three sizes. gpui's `Keystroke` carries the whole stroke and the
// modifier state — `modifiers`, `key` and `key_char` — but `gpui::on_keys(true)`
// used to report only `key`, the name printed on the key. gpui maps **both** Tab
// and Shift-Tab to the key `"tab"`, so the one place a program could read them
// said they were the same keystroke. A shortcut that had to tell them apart
// could not, and neither could one that cared whether shift or ⌘ was held: `a`
// and `A` arrived identically.
//
// Pass means a program watching `gpui::on_keys(true)` sees `shift-tab` and `tab`
// as different keystrokes, reads shift held for the first and not the second, and
// reads ⌘ held for `cmd-c`. The keys are produced with `gpui::send_key`, which
// goes through the window's ordinary dispatch, because nothing in a probe can type.
//
// `tests/evidence/KM6.before.txt` records the red: the first keystroke reached the
// program as `"tab"`.
//
// The row also names **key-up**, and the release is implemented — the window root
// listens with `.capture_key_up` and `gpui::on_keys` raises `"keyup|<stroke>"`.
// It is deliberately not asserted here, because it cannot be: gpui 0.2.2 has no
// externally callable way to dispatch a release. `Window::dispatch_keystroke` is
// the key *down* path only (`gpui-0.2.2/src/window.rs:3540`), and
// `Window::dispatch_event` — the one public entry that takes a `PlatformInput` —
// returns `DispatchEventResult`, which is `pub(crate)`
// (`gpui-0.2.2/src/window.rs:1273`), so the call does not compile outside gpui:
//
//     error: type `gpui::window::DispatchEventResult` is private
//
// A real release from the platform reaches the listener; a synthetic one cannot be
// produced from here, so the release half of this row is recorded as unverified
// rather than claimed. See `## Unreachable`.

use gpui
use std::process

/// Drain the frame's events into one list: every key-down payload, in the order
/// the window received them.
fn handle() {
    for event in gpui::take_events() {
        let id, data = gpui::event_parts(event)
        if id == "key" {
            gpui::list_push("km6.keys", data)
        }
    }
}

fn main() {
    let outcome = gpui::run("km6 - modifiers", 380.0, 220.0, || {
        let f = gpui::frame()

        // The window takes the keyboard, so the program is the element that hears
        // the keys. Safe every frame; it only arms once.
        gpui::on_keys(true)
        handle()

        // `gpui::send_key` delivers after the frame that asked, so every send is
        // followed by a frame that samples the result.
        if f == 4 {
            gpui::send_key("shift-tab")
        }
        if f == 6 {
            gpui::set_bool("km6.shift_on_shifttab", gpui::state_bool("~key.shift", false))
            gpui::set_text("km6.unparse_shifttab", gpui::state_text("~key.unparse", ""))
            gpui::send_key("tab")
        }
        if f == 8 {
            gpui::set_bool("km6.shift_on_tab", gpui::state_bool("~key.shift", false))
            gpui::set_text("km6.unparse_tab", gpui::state_text("~key.unparse", ""))
            gpui::send_key("cmd-c")
        }
        if f == 10 {
            gpui::set_bool("km6.platform_on_cmdc", gpui::state_bool("~key.platform", false))
            gpui::set_text("km6.unparse_cmdc", gpui::state_text("~key.unparse", ""))
            gpui::set_text("km6.mods_cmdc", gpui::state_text("~key.mods", ""))
        }

        if f >= 16 {
            let down_first = gpui::list_get("km6.keys", 0)
            let down_second = gpui::list_get("km6.keys", 1)
            let down_third = gpui::list_get("km6.keys", 2)
            let shift_on_shifttab = gpui::state_bool("km6.shift_on_shifttab", false)
            let shift_on_tab = gpui::state_bool("km6.shift_on_tab", false)
            let platform_on_cmdc = gpui::state_bool("km6.platform_on_cmdc", false)
            let unparse_shifttab = gpui::state_text("km6.unparse_shifttab", "")
            let unparse_tab = gpui::state_text("km6.unparse_tab", "")
            let unparse_cmdc = gpui::state_text("km6.unparse_cmdc", "")
            let mods_cmdc = gpui::state_text("km6.mods_cmdc", "")

            // One exclusive chain ending in the verdict: `gpui::quit()` asks the
            // app to stop, it does not abort the callback that called it.
            if down_first != "shift-tab" {
                println(f"FAIL KM6 the first keystroke reached the program as \"{down_first}\", not \"shift-tab\": Shift-Tab is indistinguishable from Tab")
                gpui::quit()
            } else if down_second != "tab" {
                println(f"FAIL KM6 the second keystroke reached the program as \"{down_second}\", not \"tab\"")
                gpui::quit()
            } else if down_third != "cmd-c" {
                println(f"FAIL KM6 the third keystroke reached the program as \"{down_third}\", not \"cmd-c\"")
                gpui::quit()
            } else if unparse_shifttab != "shift-tab" || unparse_tab != "tab" || unparse_cmdc != "cmd-c" {
                println(f"FAIL KM6 the store says \"{unparse_shifttab}\" then \"{unparse_tab}\" then \"{unparse_cmdc}\", so the unparsed stroke is not reported")
                gpui::quit()
            } else if !shift_on_shifttab || shift_on_tab {
                println(f"FAIL KM6 the shift modifier reads {shift_on_shifttab} for Shift-Tab and {shift_on_tab} for Tab, so a program cannot tell them apart by modifier")
                gpui::quit()
            } else if !platform_on_cmdc || mods_cmdc != "platform" {
                println(f"FAIL KM6 cmd-c reports platform={platform_on_cmdc} and mods=\"{mods_cmdc}\", so the modifier state is not reported")
                gpui::quit()
            } else {
                println(f"OK KM6 the three keystrokes arrived as \"{down_first}\", \"{down_second}\" and \"{down_third}\"; shift read {shift_on_shifttab} then {shift_on_tab}, and cmd-c reported mods=\"{mods_cmdc}\"")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("km6", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL KM6 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
