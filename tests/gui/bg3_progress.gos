// BG3 — reporting progress from background work.
//
// Tier: every tier.
//
// `gpui::task` reports twice: nothing at all while the work runs, and once when it is done.
// A program with a progress bar therefore had nothing to put in it — the bar could jump from
// empty to full and never move in between, which for a job that takes ten seconds is the
// difference between "working" and "hung".
//
// Pass means the work reports while it runs, that the report never goes **backwards**, that it
// ends at exactly 1 with the result beside it, and that **cancelling** the work stops the
// reporting — a cancelled job that went on reporting progress would be telling a program to
// draw a bar for something that is never going to happen.
//
// The reports arrive as `"<id>.progress"` events, and the value is read with
// `gpui::task_progress(id)`: the event is the signal that there is something to draw, the
// reader is the number. That split is deliberate — a program that is animating can poll the
// reader without the events, and a program that is idle needs the event to know to repaint.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("bg3 - progress", 380.0, 220.0, || {
        let f = gpui::frame()
        let phase = gpui::state_int("bg3.phase", 0)

        // This frame's progress reports, and whether the work finished during it.
        let mut reports = 0
        let mut finished = false
        for event in gpui::take_events() {
            let id, _ = gpui::event_parts(event)
            if id == "work.progress" {
                reports = reports + 1
            } else if id == "work" {
                finished = true
            }
        }

        if f == 2 {
            gpui::set_text("bg3.monotonic", "yes")
            gpui::task("work", 300)
            gpui::task("gone", 300)
        }
        if phase == 0 && gpui::now() >= 0.2 {
            // Late enough that the cancelled work has reported several times: a freeze
            // measured from a progress of 0 would prove nothing.
            gpui::task_cancel("gone")
            gpui::set_int("bg3.phase", 1)
        }
        if phase == 1 && gpui::now() >= 0.25 {
            gpui::set_float("bg3.gone_a", gpui::task_progress("gone"))
            gpui::set_int("bg3.phase", 2)
        }
        if phase <= 2 {
            gpui::set_int("bg3.reports", gpui::state_int("bg3.reports", 0) + reports)
            let now = gpui::task_progress("work")
            if now < gpui::state_float("bg3.last", 0.0) {
                gpui::set_text("bg3.monotonic", "no")
            }
            gpui::set_float("bg3.last", now)
        }
        if phase == 2 && finished {
            gpui::set_float("bg3.work_last", gpui::task_progress("work"))
            gpui::set_text("bg3.work_result", gpui::task_result("work"))
            gpui::set_int("bg3.phase", 3)
        }
        if phase == 3 && gpui::now() >= 0.7 {
            // Half a second after the cancel: a task that was still reporting would be far
            // past where it was.
            gpui::set_float("bg3.gone_b", gpui::task_progress("gone"))
            gpui::set_int("bg3.phase", 4)
        }

        if phase == 4 {
            let reports = gpui::state_int("bg3.reports", 0)
            let monotonic = gpui::state_text("bg3.monotonic", "")
            let work_last = gpui::state_float("bg3.work_last", -1.0)
            let work_result = gpui::state_text("bg3.work_result", "")
            let gone_a = gpui::state_float("bg3.gone_a", -1.0)
            let gone_b = gpui::state_float("bg3.gone_b", -2.0)

            // One exclusive chain ending in the verdict: `gpui::quit()` asks the
            // app to stop, it does not abort the callback that called it. Every branch is
            // a positive condition, because the linter is right that `if !flag` and
            // `if flag == false` are both noise.
            if monotonic != "yes" {
                println("FAIL BG3 the progress of running work went backwards")
                gpui::quit()
            } else if reports < 2 {
                println(f"FAIL BG3 the work reported its progress {reports} time(s) while it ran, so there was nothing to watch")
                gpui::quit()
            } else if work_last < 0.999 {
                println(f"FAIL BG3 the work finished with its progress at {work_last}, not 1")
                gpui::quit()
            } else if work_result == "" {
                println("FAIL BG3 the work finished and left no result to read")
                gpui::quit()
            } else if gone_a <= 0.0 {
                println("FAIL BG3 the cancelled work had reported no progress at all before it was cancelled, so the freeze below would prove nothing")
                gpui::quit()
            } else if gone_a != gone_b {
                println(f"FAIL BG3 cancelled work went on reporting progress: {gone_a} then {gone_b}")
                gpui::quit()
            } else {
                println(f"OK BG3 the work reported its progress {reports} times without ever going backwards, ended at 1 with its result beside it, and the cancelled work stopped reporting at {gone_b}")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        // The reader is what a painter takes, so a progress bar is a token away.
        gpui::child(root, gpui::draw("bars", gpui::task_progress("work"), "h=40"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL BG3 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
