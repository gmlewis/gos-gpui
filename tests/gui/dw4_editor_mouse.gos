// DW4 — what a mouse does to the editor: a click's caret, a double-click's word, a
// triple-click's line, a drag's range, and the autoscroll a drag does not do.
//
// needs: scripts/pointer.sh
//
// Tier: every tier, but only on a machine whose pointer may be moved. `scripts/probes.sh`
// skips this one by name, exactly as it skips TH2; run it by hand:
//
//   DSH_ALLOW_WINDOWS=1 ./scripts/run-once.sh tests/gui/dw4_editor_mouse.gos 60
//
// # Why a click has to come from outside the process
//
// gpui has no public way to inject a pointer event. `Window::dispatch_event` takes a
// `PlatformInput` and is public (`gpui-0.2.2/src/window.rs:3581`), but its return type
// `DispatchEventResult` is `pub(crate)` (`window.rs:1273`), and a public function whose
// return type is private is not callable from another crate however it is wrapped — a
// two-crate experiment confirms it for a direct call,
// for a discarded result, and for a generic-erasure wrapper. Nothing else on `Window`
// injects input either. The operating system's event tap is the way in, and
// `scripts/pointer.sh` is the smallest thing that posts through it.
//
// # What is driven, and what is asserted
//
// The text is `"alphabetical beta\nsecond line\ntail"`. The probe clicks at the middle
// of the editor's own box and then asks the editor what it selected, through
// `gpui::editor_selection`. Text alone could not tell any of these apart — a caret, a
// word and a line all leave the same characters behind — which is why that reader had to
// exist before this row could be checked at all.
//
//   step 1  one click    -> `<c>,<c>`: a caret, and not the one the editor already had
//   step 2  two clicks   -> exactly `gpui::text_word(content, c)`, with `c` *inside* it
//   step 3  three clicks -> exactly `gpui::text_line_bounds(content, c)`, and not the word
//   step 4  a drag       -> `<line start>,<c>`: the range from the line's own left edge
//
// The expected value of steps 2 and 3 is **not written down as numbers**. It is
// `gpui::text_word` and `gpui::text_line_bounds` asked at the caret the platform's own
// click produced: the click picks a byte, and the crate's arithmetic — the same
// arithmetic DW1 checks — says what that byte means. Hard-coding `"6,10"` would make this
// a test of the font metrics, and it would break the first time the window's font
// changed. The one thing the probe does insist on is that the caret landed *inside* the
// word rather than on its edge or in a space, so that a badly-aimed click is reported as
// a badly-aimed click instead of passing.
//
// Every click is checked before it is posted: `scripts/pointer.sh owner` answers the pid of
// the frontmost window under the point, and the probe requires it to be its own process.
// A click posted at someone else's window is a click that did not happen, and it would
// otherwise look exactly like a widget that ignores the mouse.
//
// # The autoscroll clause of this row
//
// There is no drag autoscroll to check, and this is the row that says so rather than
// leaving it implied. gpui does have `Window::request_autoscroll` (`window.rs:2484`), but
// the only thing that ever takes it up is gpui's own `List` (`elements/list.rs:808`,
// `:819`) — a leaf element's request is dropped on the floor. Upstream's `TextInput`,
// which this editor is a port of, has no autoscroll at all
// (`tools/upstream/examples/input.rs`), and this editor has no viewport of its own: it
// draws its whole document inside its box and maps a point to a row by dividing by the
// line height, so there is nothing for a drag to scroll. What *is* measurable is the
// consequence, and step 5 measures it: a second editor of twelve lines inside a scroll
// panel forty pixels tall, dragged from inside the panel to past its bottom edge, leaves
// the panel's offset exactly where it was.
//
// Pass means every step above held, on a machine where the pointer could be moved.

use gpui
use std::os::exec
use std::process
use std::strconv

fn content() -> String {
    "alphabetical beta\nsecond line\ntail"
}

fn long_content() -> String {
    "one\ntwo\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\neleven\ntwelve"
}

/// Runs `./scripts/pointer.sh` and answers its trimmed stdout.
///
/// The probe is run from the repository root, which is where every harness here runs
/// programs from; a refusal or a missing tool is printed rather than swallowed, because
/// its stdout is then empty and every step below would fail for the wrong reason.
fn pointer(args: Vec<String>) -> String {
    match exec::run("./scripts/pointer.sh", args) {
        Ok(out) => {
            if out.code != 0 {
                println("FAIL DW4 scripts/pointer.sh exited {}: {}", out.code, out.stderr.trim())
            }
            out.stdout.trim().clone()
        }
        Err(problem) => {
            println("FAIL DW4 could not run ./scripts/pointer.sh: {}", problem)
            String::new()
        }
    }
}

/// A decimal `i64`, or -1 for anything else.
fn int_of(text: String) -> i64 {
    match strconv::parse_i64(text.clone()) {
        Ok(number) => number,
        Err(_) => -1,
    }
}

/// The two numbers in a `"<start>,<end>"` range, as -1,-1 when it is not one.
fn range_of(range: String) -> (i64, i64) {
    match range.split_once(",") {
        Some((start, end)) => (int_of(start.clone()), int_of(end.clone())),
        None => (-1, -1),
    }
}

fn main() {
    let outcome = gpui::run("dw4 - editor mouse", 440.0, 300.0, || {
        let f = gpui::frame()
        let now = gpui::now()

        if f == 1 {
            gpui::set_text("ed", content())
            gpui::set_text("ed2", long_content())
            gpui::set_float("since", now)
        }

        // Both editors are built on frame 1 and their boxes are recorded as they are
        // built, so the first frame that can read one is the second.
        let ready = f >= 2 && gpui::editor_bounds("ed", "h") > 0.0

        if ready && !gpui::state_bool("done", false) {
            let phase = gpui::state_int("phase", 0)
            let waited = now - gpui::state_float("since", now)
            let failed = gpui::state_int("failed", 0)

            // Where the row is about: a third of the way across the editor's own box, so
            // the click lands inside the first word whatever the font is, and half way
            // down it, so it lands on whichever row the box's own arithmetic picks.
            let ex = gpui::editor_bounds("ed", "x")
            let ey = gpui::editor_bounds("ed", "y")
            let eh = gpui::editor_bounds("ed", "h")
            let content_x = gpui::state_float("content_x", gpui::window_field("inner_x"))
            let content_y = gpui::state_float("content_y", gpui::window_field("inner_y"))
            let at_x = content_x + ex + 30.0
            let at_y = content_y + ey + eh / 2.0
            // The same row, at the first pixel of the editor's own box: where a drag to
            // the left ends up.
            let home_x = content_x + ex + 1.0

            if phase == 0 && waited >= 0.4 {
                let mine = process::id()

                // The window's rectangle as the window server has it, and then where its
                // content starts. `gpui::window_field` answers the frame for `x`, `y`, `w`
                // and `h`; a window whose titlebar the platform draws starts that
                // decoration's height below its frame, and this probe asks for 300 pixels
                // of height and is given a 332-pixel frame, so 32 of them are the titlebar.
                // Getting this wrong is not a crash — it aims a row higher than intended,
                // which is exactly the kind of wrong answer a click test must not have.
                // The height asked for below is the same 300 the `gpui::run` above asks
                // for; the two have to be kept in step.
                let frame = pointer(Vec::from(["frame", f"{mine}"]))
                let parts = frame.split_whitespace()
                let mut measured_x = gpui::window_field("inner_x")
                let mut measured_y = gpui::window_field("inner_y")
                if frame != "" && parts.len() == 4 {
                    measured_x = int_of(parts[0].clone()) as f64
                    measured_y = int_of(parts[1].clone()) as f64 + (int_of(parts[3].clone()) as f64 - 300.0)
                }
                gpui::set_float("content_x", measured_x)
                gpui::set_float("content_y", measured_y)

                println(
                    "DW4 window says {},{},{}x{}, the window server says {}, and the content starts at {:.0},{:.0}",
                    gpui::window_field("x"), gpui::window_field("y"),
                    gpui::window_field("w"), gpui::window_field("h"), frame, measured_x, measured_y,
                )

                // Before anything is posted: is our own window the one under the point?
                let aim_x = measured_x + ex + 30.0
                let aim_y = measured_y + ey + eh / 2.0
                let owner = int_of(pointer(Vec::from(["owner", f"{aim_x}", f"{aim_y}"])))
                println("DW4 aiming at {:.0},{:.0} (the editor's box is {:.0},{:.0},{}x{} inside it); this process {}; window owner {}", aim_x, aim_y, ex, ey, gpui::editor_bounds("ed", "w"), eh, mine, owner)
                if owner != mine {
                    println("FAIL DW4 the frontmost window at {:.0},{:.0} belongs to process {}, not to this one ({}): a click there would land in someone else's window, so none was posted", aim_x, aim_y, owner, mine)
                    gpui::set_int("failed", failed + 1)
                    gpui::set_int("phase", 10)
                } else {
                    gpui::set_int("phase", 1)
                }
                gpui::set_float("since", now)
            }

            // The point the four steps below click at: the window's own content origin plus
            // the editor's box, so a frame later it is the same point the transcript above
            // named.
            let at_x = content_x + ex + 30.0
            let at_y = content_y + ey + eh / 2.0
            let home_x = content_x + ex + 1.0

            if phase == 1 && waited >= 0.3 {
                // Where the caret was before the click. A click that never arrived leaves
                // it where a freshly-set document puts it, which would otherwise read as
                // a caret in the right place.
                gpui::set_text("before", gpui::editor_selection("ed"))
                pointer(Vec::from(["click", f"{at_x}", f"{at_y}", "1"]))
                gpui::set_int("phase", 2)
                gpui::set_float("since", now)
            }

            if phase == 2 && waited >= 1.0 {
                let selection = gpui::editor_selection("ed")
                let before = gpui::state_text("before", "")
                let start, end = range_of(selection.clone())
                println("DW4 one click: selection {} (was {})", selection, before)
                let mut bad = 0
                if start != end || start < 0 {
                    println("FAIL DW4 one click selected {} — a single click leaves a caret, not a range", selection)
                    bad = bad + 1
                }
                if selection == before || start <= 0 {
                    println("FAIL DW4 the click did not move the caret: it reads {} and read {} before the click", selection, before)
                    bad = bad + 1
                }
                gpui::set_int("caret", start)
                gpui::set_int("failed", failed + bad)
                // Away from the editor, so the platform's click counter starts over: three
                // presses at one point in quick succession are a triple click, and the
                // steps below are meant to be one, two and three.
                pointer(Vec::from(["move", "4", "4"]))
                gpui::set_int("phase", 3)
                gpui::set_float("since", now)
            }

            if phase == 3 && waited >= 0.6 {
                pointer(Vec::from(["click", f"{at_x}", f"{at_y}", "2"]))
                gpui::set_int("phase", 4)
                gpui::set_float("since", now)
            }

            if phase == 4 && waited >= 1.0 {
                let caret = gpui::state_int("caret", -1)
                let selection = gpui::editor_selection("ed")
                let word = gpui::text_word(content(), caret)
                let word_start, word_end = range_of(word.clone())
                println("DW4 two clicks: selection {}, the word at {} is {}", selection, caret, word)
                let mut bad = 0
                if selection != word {
                    println("FAIL DW4 two clicks selected {}, and the word the caret {} is in is {}", selection, caret, word)
                    bad = bad + 1
                }
                // The word has to be a word *around* the caret. A caret that landed on a
                // word's first byte, or in a space, would make the two agree for the wrong
                // reason — the probe aimed badly, and that is worth saying.
                if !(word_start < caret && caret < word_end) {
                    println("FAIL DW4 the click aimed at byte {} of \"{}\", which is not strictly inside the word {} — the probe's aim, not the widget, is at fault", caret, content(), word)
                    bad = bad + 1
                }
                gpui::set_text("word", word.clone())
                gpui::set_int("failed", failed + bad)
                pointer(Vec::from(["move", "4", "4"]))
                gpui::set_int("phase", 5)
                gpui::set_float("since", now)
            }

            if phase == 5 && waited >= 0.6 {
                pointer(Vec::from(["click", f"{at_x}", f"{at_y}", "3"]))
                gpui::set_int("phase", 6)
                gpui::set_float("since", now)
            }

            if phase == 6 && waited >= 1.0 {
                let caret = gpui::state_int("caret", -1)
                let selection = gpui::editor_selection("ed")
                let line = gpui::text_line_bounds(content(), caret)
                let word = gpui::state_text("word", "")
                println("DW4 three clicks: selection {}, the line at {} is {}", selection, caret, line)
                let mut bad = 0
                if selection != line {
                    println("FAIL DW4 three clicks selected {}, and the line the caret {} is on is {}", selection, caret, line)
                    bad = bad + 1
                }
                if line == word {
                    println("FAIL DW4 three clicks and two clicks both selected {} — three clicks take the line, which is longer", line)
                    bad = bad + 1
                }
                gpui::set_text("line", line.clone())
                gpui::set_int("failed", failed + bad)
                pointer(Vec::from(["move", "4", "4"]))
                gpui::set_int("phase", 7)
                gpui::set_float("since", now)
            }

            if phase == 7 && waited >= 0.6 {
                // From the caret back to the left edge of its own row: the range the drag
                // covers is the whole run of text the row's start and the caret bound.
                pointer(Vec::from(["drag", f"{at_x}", f"{at_y}", f"{home_x}", f"{at_y}", "8"]))
                gpui::set_int("phase", 8)
                gpui::set_float("since", now)
            }

            if phase == 8 && waited >= 1.5 {
                let caret = gpui::state_int("caret", -1)
                let selection = gpui::editor_selection("ed")
                let line_start, _ = range_of(gpui::state_text("line", ""))
                println("DW4 drag: selection {}, from the caret {} back to the row's left edge {}", selection, caret, line_start)
                let start, end = range_of(selection.clone())
                let mut bad = 0
                if start != line_start || end != caret {
                    println("FAIL DW4 the drag selected {}, and dragging from the caret {} to the row's first byte covers {},{}", selection, caret, line_start, caret)
                    bad = bad + 1
                }
                gpui::set_int("failed", failed + bad)
                gpui::set_int("phase", 9)
                gpui::set_float("since", now)
            }

            if phase == 9 && waited >= 0.6 {
                // The autoscroll clause. The panel is forty pixels tall and its editor is
                // twelve lines; the drag starts inside the panel and ends past its bottom
                // edge, which is where an autoscroll would have to happen.
                let panel_x = gpui::scroll_bounds("panel", "x")
                let panel_y = gpui::scroll_bounds("panel", "y")
                let panel_h = gpui::scroll_bounds("panel", "h")
                let before = gpui::scroll_offset("panel", "y")
                println("DW4 autoscroll: the panel is {},{},{} tall, its offset is {} before a drag from inside it to {} below its bottom edge", panel_x, panel_y, panel_h, before, panel_y + panel_h + 20.0)
                gpui::set_float("scroll_before", before)
                pointer(Vec::from([
                    "drag",
                    f"{content_x + panel_x + 30.0}",
                    f"{content_y + panel_y + 10.0}",
                    f"{content_x + panel_x + 30.0}",
                    f"{content_y + panel_y + panel_h + 20.0}",
                    "10",
                ]))
                gpui::set_int("phase", 10)
                gpui::set_float("since", now)
            }

            if phase == 10 && waited >= 1.5 {
                let before = gpui::state_float("scroll_before", -1.0)
                let after = gpui::scroll_offset("panel", "y")
                println("DW4 autoscroll: the panel's offset is {} after the drag, and was {}", after, before)
                if after != before {
                    println("FAIL DW4 the panel scrolled from {} to {} during a drag that left it — this row says a leaf editor has no autoscroll, and gpui's own List is the only thing that honours it", before, after)
                    gpui::set_int("failed", failed + 1)
                }
                // The last thing to check is the clause the three-click step above left
                // half-said: it took the line under the pointer, but every step so far
                // aimed at the middle row, so "the line under the pointer" and "the second
                // line" are still the same answer. This one aims at the top of the box
                // instead, and it is also what the capture beside this transcript shows:
                // the whole first line highlighted, held on screen for six seconds.
                pointer(Vec::from(["move", "4", "4"]))
                gpui::set_int("phase", 11)
                gpui::set_float("since", now)
            }

            if phase == 11 && waited >= 0.6 {
                // A tenth of the way down the box: the first of its three rows.
                let top_y = content_y + ey + eh * 0.1
                pointer(Vec::from(["click", f"{at_x}", f"{top_y}", "3"]))
                gpui::set_int("phase", 12)
                gpui::set_float("since", now)
            }

            if phase == 12 {
                if !gpui::state_bool("evidenced", false) && waited >= 1.5 {
                    let selection = gpui::editor_selection("ed")
                    let first_line = gpui::text_line_bounds(content(), 0)
                    let second_line = gpui::state_text("line", "")
                    println("DW4 three clicks at the top of the box: selection {}, the first line is {}, the line the middle row gave was {}", selection, first_line, second_line)
                    let mut bad = 0
                    if selection != first_line {
                        println("FAIL DW4 three clicks at the top of the box selected {}, and the first line is {}", selection, first_line)
                        bad = bad + 1
                    }
                    if selection == second_line {
                        println("FAIL DW4 three clicks at the top of the box selected {}, the same line the middle of the box gave — the row under the pointer is not what is being taken", selection)
                        bad = bad + 1
                    }
                    gpui::set_int("failed", failed + bad)
                    gpui::set_bool("evidenced", true)
                }
                // Held, so the window can be photographed with the line still highlighted.
                if waited >= 6.0 {
                    gpui::set_bool("done", true)
                    if gpui::state_int("failed", 0) == 0 {
                        println("OK DW4 a click left a caret, two clicks took the word it was in, three took the line under the pointer, a drag took the range back to its row's edge, and a drag past a scrolled editor's own edge scrolled nothing — all driven through the operating system's event tap, because gpui's is not callable")
                    }
                    gpui::quit()
                }
            }
        }

        gpui::animate()
        let root = gpui::column("p=10 gap=8 size=full bg=#111111")
        gpui::child(root, gpui::editor("ed", "type here", ""))
        gpui::child(root, gpui::text("dw4 - the editor under the mouse", "color=#888888"))
        let panel = gpui::scroll("id=panel h=40 w=380")
        gpui::child(panel, gpui::editor("ed2", "type here", ""))
        gpui::child(root, panel)
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL DW4 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
