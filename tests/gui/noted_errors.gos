// The noted-error channel: what the binding tells the person, told to the program.
//
// The binding reports problems by drawing a banner inside the window and printing nothing. That is how
// `examples/02_data_table.gos` drew no rows and passed every silence check for days. This proves the
// channel that closes the hole:
//
//   * a deliberately unknown style token makes the binding note an error;
//   * `gpui::noted_errors()` shows the program the same message the banner shows the person;
//   * with `GOSSAMER_NOTED_ERRORS=1` in the environment, the same message goes to stderr, so a headless
//     check can see it too — which is what the regression suite is being taught to treat as failure.
//
// This is not a register row. It is the instrument the register's checks need.
//
// Run with `DSH_ALLOW_WINDOWS=1 ./scripts/run-once tests/gui/noted_errors.gos 20`.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("noted errors", 420.0, 200.0, || {
        let f = gpui::frame()

        if f == 1 {
            let before = gpui::noted_errors()
            println(f"NOTED before anything went wrong: {before.len()} message(s)")
        }

        // A token the style language does not know. The binding notes it — and draws a banner.
        let root = gpui::column("size=full p=8")
        gpui::child(root, gpui::text("deliberately misspelled style below", ""))
        gpui::child(root, gpui::text("x", "notatoken=7"))
        gpui::root(root)

        if f >= 3 {
            let noted = gpui::noted_errors()
            println(f"NOTED the program can read what the person would see: {noted}")
            if noted.len() == 0 {
                println("FAIL noted_errors the binding noted nothing for a token it does not know — either the token is known, or the channel is broken")
            } else {
                println("OK noted_errors the banner's messages reach the program, so a silent empty window is no longer invisible")
            }
            gpui::quit()
        }
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL noted_errors gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
