// MN1 — submenus, installed.
//
// Tier: every tier.
//
// The headless cases in `tests/mn1_submenu_test.gos` pin the grammar; this pins the thing the
// grammar is for. A submenu that is only *described* correctly and never built would leave a
// nested entry with a label and no action, and a menu click cannot be synthesized to find out
// (W8's doubt) — but a **keystroke** can. So the check is that an entry two levels deep, inside
// a submenu inside a submenu, has its own slot and fires its own event when its declared
// accelerator is pressed.
//
// Pass means the nesting installs without the build failing, and that the two entries inside it
// fire slots 0 and 1 in that order.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("mn1 - submenu", 380.0, 240.0, || {
        let f = gpui::frame()
        gpui::on_keys(true)

        for event in gpui::take_events() {
            let id, data = gpui::event_parts(event)
            if id == "menu" {
                gpui::list_push("mn1.fired", data)
            }
        }

        if f == 2 {
            gpui::set_menus("App", #[
                "submenu:File",
                ">events:Save:cmd-s",
                ">separator",
                ">submenu:Recent",
                ">>events:Recent One:cmd-r",
                "events:Quit App",
            ])
        }
        // `gpui::send_key` delivers after the frame that asked.
        if f == 8 {
            gpui::send_key("cmd-s")
        }
        if f == 10 {
            gpui::send_key("cmd-r")
        }

        if f >= 16 {
            let fired = gpui::list_len("mn1.fired")
            // What the platform was actually given, which is the check that the nesting
            // survived the build rather than only the declaration.
            let installed = gpui::installed_menu()
            let first = gpui::list_get("mn1.fired", 0)
            let second = gpui::list_get("mn1.fired", 1)
            let tree = gpui::menu_tree(#[
                "submenu:File",
                ">events:Save:cmd-s",
                ">separator",
                ">submenu:Recent",
                ">>events:Recent One:cmd-r",
                "events:Quit App",
            ])

            // One exclusive chain ending in the verdict: `gpui::quit()` asks the
            // app to stop, it does not abort the callback that called it. Every branch is
            // a positive condition, because the linter is right that `if !flag` and
            // `if flag == false` are both noise.
            if tree.len() != 6 {
                println(f"FAIL MN1 the six entries read back as {tree.len()}: {tree}")
                gpui::quit()
            } else if tree[4] != "2:events:Recent One" {
                println(f"FAIL MN1 the entry two levels in reads back as \"{tree[4]}\"")
                gpui::quit()
            } else if installed.len() != 7 {
                println(f"FAIL MN1 the installed menu bar has {installed.len()} items, not the 7 that were declared: {installed}")
                gpui::quit()
            } else if installed[4] != "2:submenu:Recent:" {
                println(f"FAIL MN1 the inner submenu was installed as \"{installed[4]}\", so the nesting did not survive the build")
                gpui::quit()
            } else if installed[5] != "3:events:Recent One:gpui_binding::Slot1" {
                // The item's own action, which no keybinding can stand in for: the accelerator
                // fires the slot directly, so a menu whose items all carried the same action
                // would still answer to the keyboard.
                println(f"FAIL MN1 the nested entry's own action is \"{installed[5]}\", not the slot its position implies")
                gpui::quit()
            } else if fired != 2 {
                println(f"FAIL MN1 the two accelerators declared inside submenus fired {fired} menu event(s), not 2 — a nested entry without its own action")
                gpui::quit()
            } else if first != "0" {
                println(f"FAIL MN1 the first nested entry fired slot {first}, not 0")
                gpui::quit()
            } else if second != "1" {
                println(f"FAIL MN1 the second nested entry, two levels deep, fired slot {second}, not 1")
                gpui::quit()
            } else {
                println(f"OK MN1 a submenu holding a separator and a submenu of its own was built as declared — the platform has it {installed.len()} items deep and nested — and both entries inside it fired their own slots (0 and 1)")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::text("mn1", "color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL MN1 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
