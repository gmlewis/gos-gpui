// DW3 — the input widget is a real text field: a caret, a selection, and a marked
// (composing) range.
//
// Tier: every tier.
//
// `ui::input` was a hand-rolled key loop: it appended `event.keystroke.key_char` to the
// stored string, handled backspace, and knew nothing else. A field like that cannot hold a
// composing word, cannot be typed into anywhere but at the end, and never registers the
// input handler every platform sends text through — so an input method had nowhere to put
// what it was composing, and the row's second half did not exist. It is built on the
// editor's engine now, which is upstream's `TextInput` with the same `EntityInputHandler`,
// the same `ElementInputHandler` and the same `window.handle_input` registration; this
// probe is what says so.
//
// Pass means:
//
//   * typing with the caret in the middle inserts there, rather than appending
//   * `cmd-a` selects the field, and backspace takes the selection away — all of it
//   * a composing (marked) word is readable while it is being composed
//   * the next insertion **replaces** the composing text, which is what every input
//     method's commit relies on
//   * Enter raises `<key>|submit` and puts no break in a single-line field, and Escape
//     raises `<key>|cancel`
//
// The field is driven with `gpui::send_key`, which goes through the window's ordinary
// dispatch, and composing with `gpui::compose`, which reaches the widget through the same
// method the platform's input methods call.
//
// **Two things are not claimed, and both are recorded rather than guessed.** An input
// method has never delivered this widget a composition — there is none in the container
// and no way to install one, and the machine this is developed on may not open a window —
// so what is checked is the *entry point* the platform's delivery ends in, not the
// platform. And what is **drawn** for a composing run — the underline — is not captured:
// the container's X server does not carry a client window's pixels into its framebuffer at
// all (`tests/evidence/DW3.capture.txt`, measured), and macOS would need a window on this
// machine. The underlined run is the same `UnderlineStyle` the editor has painted since
// `DW1`; no tier has photographed it.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("dw3 - the input field", 480.0, 240.0, || {
        let f = gpui::frame()

        // The field takes focus the moment it is created, as the editor does, and
        // `send_key` delivers after the frame that asked — so every reading below is on the
        // frame after the keys it follows.
        if f == 3 {
            gpui::send_key("a")
            gpui::send_key("c")
        }
        if f == 5 {
            gpui::set_text("dw3.typed", gpui::state_text("field", ""))
            gpui::send_key("left")
            gpui::send_key("b")
        }
        if f == 7 {
            gpui::set_text("dw3.inserted", gpui::state_text("field", ""))
            gpui::send_key("cmd-a")
            gpui::send_key("backspace")
        }
        if f == 9 {
            gpui::set_text("dw3.cleared", gpui::state_text("field", ""))
            gpui::compose("field", "nihao")
        }
        if f == 11 {
            gpui::set_text("dw3.marked", gpui::composing("field"))
            gpui::set_text("dw3.while_composing", gpui::state_text("field", ""))
            gpui::send_key("x")
        }
        if f == 13 {
            gpui::set_text("dw3.after_replace", gpui::state_text("field", ""))
            gpui::set_text("dw3.after_unmark", gpui::composing("field"))
            gpui::send_key("enter")
        }
        if f == 15 {
            gpui::set_text("dw3.after_enter", gpui::state_text("field", ""))
            gpui::send_key("escape")
        }

        // The events are drained once, at the end, because they queue until something
        // takes them: what this asks is which of the two the field raised, not when.
        if f >= 17 {
            let typed = gpui::state_text("dw3.typed", "")
            let inserted = gpui::state_text("dw3.inserted", "")
            let cleared = gpui::state_text("dw3.cleared", "")
            let marked = gpui::state_text("dw3.marked", "")
            let while_composing = gpui::state_text("dw3.while_composing", "")
            let after_replace = gpui::state_text("dw3.after_replace", "")
            let after_unmark = gpui::state_text("dw3.after_unmark", "")
            let after_enter = gpui::state_text("dw3.after_enter", "")

            let mut submitted = 0
            let mut cancelled = 0
            for event in gpui::take_events() {
                let id, what = gpui::event_parts(event)
                if id == "field" && what == "submit" {
                    submitted = submitted + 1
                }
                if id == "field" && what == "cancel" {
                    cancelled = cancelled + 1
                }
            }

            // One exclusive chain ending in the verdict: `gpui::quit()` asks the app to stop,
            // it does not abort the callback that called it.
            if typed != "ac" {
                println(f"FAIL DW3 the field did not take the two keys it was sent; it holds \"{typed}\"")
                gpui::quit()
            } else if inserted != "abc" {
                println(f"FAIL DW3 typing after `left` gave \"{inserted}\", not \"abc\": the field appends rather than inserting at the caret")
                gpui::quit()
            } else if cleared != "" {
                println(f"FAIL DW3 cmd-a then backspace left \"{cleared}\", not an empty field")
                gpui::quit()
            } else if marked != "nihao" {
                println(f"FAIL DW3 composing text reads \"{marked}\", not the \"nihao\" being composed")
                gpui::quit()
            } else if while_composing != "nihao" {
                println(f"FAIL DW3 the field holds \"{while_composing}\" while composing \"nihao\"")
                gpui::quit()
            } else if after_replace != "x" {
                println(f"FAIL DW3 a key pressed while composing gave \"{after_replace}\", not \"x\": the marked text should have been replaced by it")
                gpui::quit()
            } else if after_unmark != "" {
                println(f"FAIL DW3 the field is still composing \"{after_unmark}\" after that replacement")
                gpui::quit()
            } else if after_enter != "x" {
                println(f"FAIL DW3 enter changed the field to \"{after_enter}\": a single-line field takes no break")
                gpui::quit()
            } else if submitted != 1 {
                println(f"FAIL DW3 enter raised {submitted} submit events, not one")
                gpui::quit()
            } else if cancelled != 1 {
                println(f"FAIL DW3 escape raised {cancelled} cancel events, not one")
                gpui::quit()
            } else {
                println(f"OK DW3 the field inserted at the caret (\"{typed}\" then \"{inserted}\"), cmd-a and backspace cleared it, a composing \"{marked}\" was readable and replaced by the next key (\"{after_replace}\", no longer composing), and enter and escape raised their own events")
                gpui::quit()
            }
        }

        gpui::animate()
        let root = gpui::column("p=12 gap=10 size=full bg=#111111")
        gpui::child(root, gpui::text("input field", "color=#ffffff"))
        gpui::child(root, gpui::input("field", "type here", "p=6 w=320 bg=#1e1e2e color=#ffffff"))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL DW3 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
