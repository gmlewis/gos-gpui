// KM5 — `observe_keystrokes` must see keys an element handled.
//
// Tier: every tier.
//
// gpui walks a key event down the tree from the root to the focused element and
// then back up, and `cx.stop_propagation()` in an element's handler ends that walk.
// The observer upstream offers — `cx.observe_keystrokes` — is dispatched at the very
// end, after the walk, and is skipped outright when propagation was stopped
// (`gpui-0.2.2/src/window.rs:3861-3869`). The text editor stops propagation for
// every key it handles, so the keys a program most wants to watch were the ones it
// could never see.
//
// Pass means a focused editor handles two keys — one that types and one that it
// stops propagation for — and the observer sees both, while the editor's own text
// shows it really did handle them.
//
// The keystrokes are produced with `gpui::send_key`, which is new and is what makes
// this row checkable at all: nothing in a probe can type.

use gpui
use std::process

fn main() {
    let outcome = gpui::run("km5 - observed keys", 360.0, 220.0, || {
        let f = gpui::frame()

        if f == 2 {
            gpui::observe_keystrokes("seen")
        }

        // The editor is focused the moment it is created, so it is the element
        // that handles these. `"a"` is typed into it; `backspace` is one of the
        // keys it consumes and stops propagation for.
        if f == 4 {
            gpui::send_key("a")
        }
        if f == 8 {
            gpui::send_key("backspace")
        }

        if f >= 6 && gpui::state_int("km5.done", 0) == 0 {
            let mut seen = gpui::state_text("km5.seen", "")
            let mut count = gpui::state_int("km5.count", 0)
            for event in gpui::take_events() {
                let id, payload = gpui::event_parts(event)
                if id == "seen" {
                    count = count + 1
                    seen = f"{seen} {payload}"
                }
            }
            gpui::set_int("km5.count", count)
            gpui::set_text("km5.seen", seen)

            if f >= 14 {
                gpui::set_int("km5.done", 1)
                let text = gpui::state_text("notes", "")
                // One exclusive chain ending in the verdict: `gpui::quit()` asks the
                // app to stop, it does not abort the callback that called it.
                if count < 2 {
                    println(f"FAIL KM5 the editor handled \"a\" and backspace, and the observer saw {count} of them:{seen}")
                    gpui::quit()
                } else if text != "" {
                    println(f"FAIL KM5 the observer saw the keys ({seen}) but the editor's text is \"{text}\", so it never handled them")
                    gpui::quit()
                } else {
                    println(f"OK KM5 the editor handled \"a\" and backspace, the observer saw {count} keystrokes:{seen}, and the editor's text is back to empty")
                    gpui::quit()
                }
            }
        }

        gpui::animate()
        let root = gpui::column("p=8 size=full bg=#111111")
        gpui::child(root, gpui::editor("notes", "type here", ""))
        gpui::root(root)
    })

    if let Err(problem) = outcome {
        eprintln(f"FAIL KM5 gpui::run stopped with an error: {problem}")
        process::exit(1)
    }
}
