// TH4 — theme overrides at token level.
//
// Headless: `gos test tests`. A theme override is a *parse* — eight names the platform
// has and a colour for each — and the parse is what the binding acts on; whether the
// result is drawn with is the usual pixel question (see "Pixel verification is
// unavailable on this machine").
//
// The register names five colours to override: accent, selection, border, caret and tick.
// Checked against the source, only two of those are colours gpui has — `selection` is
// `Colors::selected` and `border` is `Colors::border` — because `accent` and `caret` do
// not exist in gpui 0.2.2 at all, and `tick` is this binding's own checkbox colour. So the
// vocabulary here is the eight fields `gpui::colors::Colors` actually has, and the third
// test is what that costs.

use gpui

#[test]
fn theme_tokens_are_known() {
    let unknown = gpui::unknown_style_tokens("theme.background=#111111 theme.text=#eeeeee")
    assert(unknown.len() == 0, f"theme.<field>= is a style token: {unknown.len()} were refused")
}

#[test]
fn the_eight_platform_colours_can_be_overridden() {
    let all = gpui::theme_override("theme.text=#111111 theme.selected_text=#222222 theme.background=#333333 theme.disabled=#444444 theme.selected=#555555 theme.border=#666666 theme.separator=#777777 theme.container=#888888")
    assert(all == "text,selected_text,background,disabled,selected,border,separator,container", f"the eight fields of Colors, in order: {all}")
}

#[test]
fn a_name_that_is_not_a_platform_colour_is_refused() {
    assert(gpui::theme_override("theme.accent=#ff0000") == "", "accent is not a colour gpui has")
    assert(gpui::unknown_style_tokens("theme.accent=#ff0000").len() == 1, "so it is reported rather than ignored")
    assert(gpui::theme_override("theme.nosuch=#ff0000") == "", "neither is a misspelling")
    assert(gpui::theme_override("bg=#111111") == "", "an ordinary colour token overrides nothing")
}
