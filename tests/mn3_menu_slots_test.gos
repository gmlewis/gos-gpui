// MN3 — checkmarks, disabled items, separators that do not shift the action mapping.
//
// Headless: `gos test tests`. A menu entry is mapped onto one of the binding's eight
// action slots, and that mapping is arithmetic on a list of strings — so it can be read
// without a window, which is what makes this row's third clause checkable on a machine
// whose screen is locked. The first two clauses are not checkable anywhere: see below.
//
// Pass means the slot an `"events:"` entry answers with counts **events entries**, so a
// separator between two actions does not renumber the second one.

use gpui

#[test]
fn a_separator_does_not_shift_the_slots() {
    let slots = gpui::menu_slots(#["events:Open", "separator", "events:Save", "separator", "quits:Quit", "events:Quit App"])
    assert(slots.len() == 3, f"three events entries, got {slots.len()}")
    assert(slots[0] == "0:Open", f"the first events entry is slot 0: {slots[0]}")
    assert(slots[1] == "1:Save", f"a separator in front of it does not renumber it: {slots[1]}")
    assert(slots[2] == "2:Quit App", f"nor does a separator and a quits entry: {slots[2]}")
}

#[test]
fn the_other_entry_kinds_take_no_slot() {
    let slots = gpui::menu_slots(#["separator", "quits:Quit"])
    assert(slots.len() == 0, "neither a separator nor a quits entry is an event")

    let only_events = gpui::menu_slots(#["events:A", "events:B", "events:C"])
    assert(only_events == #["0:A", "1:B", "2:C"], "and without them the slots are the positions")
}

#[test]
fn a_menu_entry_that_is_not_one_is_dropped() {
    let slots = gpui::menu_slots(#["events:A", "nosuch:B", "events:C"])
    assert(slots == #["0:A", "1:C"], "an entry kind the binding does not know is not built, and takes no slot")
}
