// MR3 — style-token completeness: the same assertions as `tests/mr3_style_tokens_test.gos`,
// as a program rather than a test, so they can be run on the interpreter and on both LLVM
// builds. It opens no window: a style token's *meaning* is a parse, and the parse is
// reachable without a frame — which is what makes this row checkable on a machine whose
// screen is locked.

use gpui

fn main() {
    let mut bad = 0

    let unknown = gpui::unknown_style_tokens("tabindex=0 tabstop focusable roundedtl=4 roundedtr=4 roundedbl=4 roundedbr=4 cursor=col-resize")
    if unknown.len() != 0 {
        eprintln(f"FAIL MR3 {unknown.len()} style tokens the register names are refused")
        bad = bad + 1
    }

    let kinds = gpui::style_refinements("hover=bg:#111111 active=bg:#222222 focus=bg:#ff0000")
    if kinds != "hover,active,focus" {
        eprintln(f"FAIL MR3 the three refinements read back as \"{kinds}\"")
        bad = bad + 1
    }
    if gpui::style_refinements("bg=#111111") != "" {
        eprintln("FAIL MR3 a style with no refinement claims one")
        bad = bad + 1
    }
    if gpui::unknown_style_tokens("focussed=bg:#ff0000").len() != 1 {
        eprintln("FAIL MR3 a misspelt refinement is not refused")
        bad = bad + 1
    }

    if bad == 0 {
        println("OK MR3 per-corner radii, resize cursors, the focus-order tokens and focus= are all known, and the three refinements read back in order")
    }
}
