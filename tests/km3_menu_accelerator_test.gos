// KM3 — menu accelerators: the entry grammar that declares one.
//
// Headless: `gos test tests`. An accelerator is the third part of an `events`
// entry — `"events:Save:cmd-s"` — and reading it back is arithmetic on a list of
// strings, so it can be checked without a window.
//
// What is checked here is that the declaration is read *without disturbing anything
// else*: the slot numbering MN3 established counts `events` entries, and a third
// part must not change it, nor may it turn a `separator` into an event.
//
// The binding itself is a window question and lives in
// `tests/gui/km3_menu_accelerator.gos`.

use gpui

#[test]
fn an_entry_may_declare_an_accelerator() {
    let declared = gpui::menu_accelerators(#["events:Save:cmd-s", "separator", "events:Quit App"])
    assert(declared.len() == 1, f"one of the two entries declares one, got {declared.len()}")
    assert(declared[0] == "0:cmd-s", f"on the slot that entry takes: {declared[0]}")
}

#[test]
fn the_slot_numbering_ignores_the_accelerator() {
    // Slot 1, not 0: `A` is the first events entry, so `B` is the second — and the
    // third part is not an entry of its own.
    let declared = gpui::menu_accelerators(#["events:A", "events:B:f5"])
    assert(declared == #["1:f5"], f"the accelerator rides on its entry's slot: {declared}")

    let slots = gpui::menu_slots(#["events:A", "events:B:f5"])
    assert(slots == #["0:A", "1:B"], f"and the labels are unchanged by it: {slots}")
}

#[test]
fn an_entry_that_declares_nothing_is_not_reported() {
    let declared = gpui::menu_accelerators(#["events:Save", "quits:Quit", "separator"])
    assert(declared.len() == 0, "no third part, no accelerator")
}

#[test]
fn an_empty_menu_declares_nothing() {
    let declared = gpui::menu_accelerators(#[])
    assert(declared.len() == 0, "an empty menu is not an error, it is an empty menu")
}
