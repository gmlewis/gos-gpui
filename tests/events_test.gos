// Unit tests for the event queue ring buffer, pointer events, and event dispatch engine.

use gpui
use ui

#[test]
fn event_queue_fifo_and_payload_integrity() {
    let _ = ui::poll_events()

    ui::push_event(101, ui::EVENT_CLICK, 42, 3.1415, "hello_world")
    ui::push_event(102, ui::EVENT_DOUBLE_CLICK, 100, 2.7182, "second_event")
    ui::push_event(103, ui::EVENT_KEY_DOWN, -7, 0.0, "key_a")

    let events = ui::poll_events()
    assert(events.len() == 3, f"expected 3 events, got {events.len()}")

    assert(events[0].target_id == 101, f"event 0 target_id mismatch: {events[0].target_id}")
    assert(events[0].kind == ui::EVENT_CLICK, f"event 0 kind mismatch: {events[0].kind}")
    assert(events[0].payload_i64 == 42, f"event 0 payload_i64 mismatch: {events[0].payload_i64}")
    assert(events[0].payload_str == "hello_world", f"event 0 payload_str mismatch: {events[0].payload_str}")

    assert(events[1].target_id == 102, f"event 1 target_id mismatch: {events[1].target_id}")
    assert(events[1].kind == ui::EVENT_DOUBLE_CLICK, f"event 1 kind mismatch: {events[1].kind}")
    assert(events[1].payload_i64 == 100, f"event 1 payload_i64 mismatch: {events[1].payload_i64}")
    assert(events[1].payload_str == "second_event", f"event 1 payload_str mismatch: {events[1].payload_str}")

    assert(events[2].target_id == 103, f"event 2 target_id mismatch: {events[2].target_id}")
    assert(events[2].kind == ui::EVENT_KEY_DOWN, f"event 2 kind mismatch: {events[2].kind}")
    assert(events[2].payload_i64 == -7, f"event 2 payload_i64 mismatch: {events[2].payload_i64}")
    assert(events[2].payload_str == "key_a", f"event 2 payload_str mismatch: {events[2].payload_str}")

    let drained = ui::poll_events()
    assert(drained.len() == 0, f"expected empty drained queue, got {drained.len()}")
}

#[test]
fn event_dispatch_to_registered_listener() {
    let mut click_count = 0
    let mut received_payload = ""

    let btn = ui::button("btn_test", "Click Me", "")
    let handle = ui::handle_of(btn)

    ui::on(handle, ui::EVENT_CLICK, |ev: ui::Event| {
        click_count += 1
        received_payload = ev.payload_str
    })

    let ev = ui::new_event(handle, ui::EVENT_CLICK, 0, 0.0, "payload_clicked")
    ui::dispatch_event(ev)

    assert(click_count == 1, f"expected 1 click, got {click_count}")
    assert(received_payload == "payload_clicked", f"payload mismatch: {received_payload}")

    ui::clear_listeners()
}

#[test]
fn pointer_event_carries_position_and_modifiers() {
    let event = "canvas|down\u{1}12.5\u{1}30.25\u{1}"
    let id, kind = gpui::event_parts(event)
    assert(id == "canvas", "id extracted before `|`")
    assert(kind == "down", f"kind extracted correctly: {kind}")

    let x, y = gpui::pointer_xy(event)
    assert((x - 12.5).abs() < 1e-9, f"expected x=12.5, got {x}")
    assert((y - 30.25).abs() < 1e-9, f"expected y=30.25, got {y}")
    assert(gpui::pointer_mods(event) == "", "no modifiers held")

    let event_with_mods = "canvas|move\u{1}1.0\u{1}2.0\u{1}ctrl-platform-shift"
    let mx, my = gpui::pointer_xy(event_with_mods)
    assert((mx - 1.0).abs() < 1e-9 && (my - 2.0).abs() < 1e-9, "position parsed correctly")
    assert(gpui::pointer_mods(event_with_mods) == "ctrl-platform-shift", "modifiers parsed correctly")
}

#[test]
fn queue_scoped_to_window() {
    let _ = gpui::take_events_in(1)
    let _ = gpui::take_events_in(2)

    gpui::subscribe_in(1, "topic1", "sub1")
    gpui::publish_in(1, "topic1", "val1")
    let evts1 = gpui::take_events_in(1)
    let evts2 = gpui::take_events_in(2)

    assert(evts1.len() == 1, "window 1 received its event")
    assert(evts2.len() == 0, "window 2 did not receive window 1's event")
    let _ = gpui::unsubscribe_in(1, "topic1", "sub1")
}
