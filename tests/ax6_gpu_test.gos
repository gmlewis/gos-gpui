// AX6 — GPU and device information to the program.
//
// Headless: `gos test tests`. `Window::gpu_specs()` is `pub`
// (`gpui-0.2.2/src/window.rs:4377`) and answers `Option<GpuSpecs>`, a public struct with public
// fields (`gpui.rs:302-311`: `is_software_emulated`, `device_name`, `driver_name`, `driver_info`).
// Only a live window can answer — the call goes straight through to the platform window
// (`window.rs:4378`) — so the binding samples it once during a frame and keeps it.
//
// **Pass means the record is empty until a frame has asked**, and that the names are exact. That
// second half matters more than it looks: a program printing its environment reads these fields and
// writes them into a diagnostics panel, and a near miss (`"DEVICE"`, `"vendor"`) must come back
// empty rather than as a device name that was never there.
//
// The populated path cannot be reached from here — it needs a window — and `AX6`'s residual doubt
// says so. What is checked is the contract a program reads *before* the first frame.

use gpui

#[test]
fn before_a_frame_has_asked_there_is_no_gpu_to_report() {
    assert(
        gpui::gpu_field("device") == "",
        f"nothing is reported rather than guessed: {gpui::gpu_field("device")}",
    )
    assert(gpui::gpu_field("driver") == "", "nor a driver")
    assert(gpui::gpu_field("info") == "", "nor any further information about one")
    assert(
        !gpui::gpu_is_software(),
        "and nothing claims a GPU is emulated on the CPU when none has been looked at",
    )
}

#[test]
fn the_vocabulary_is_the_three_the_reader_answers_to() {
    // The claim "the names are exact" needs something behind it, and this is it: the names there
    // are. That `gpu_field` *matches* on them cannot be exercised from here — an unasked window is
    // empty at the guard before a name is ever compared — which is recorded in the row's doubt.
    assert(
        gpui::gpu_fields() == #["device", "driver", "info"],
        f"the three names, in the order a programme would print them: {gpui::gpu_fields()}",
    )
}

#[test]
fn a_field_that_is_not_one_of_those_is_empty() {
    assert(
        gpui::gpu_field("vendor") == "",
        "there is no vendor field; asking for one is not a device name",
    )
    assert(gpui::gpu_field("") == "", "and an empty name names nothing")
    assert(
        gpui::gpu_field("DEVICE") == "",
        "the names are exact, as every other field reader here is — a near miss is empty, not a guess",
    )
}

#[test]
fn a_gpu_belongs_to_one_window() {
    assert(
        gpui::gpu_field_in(1, "device") == "",
        "a window that has never been asked has nothing either",
    )
    assert(
        gpui::gpu_field_in(0, "device") == "",
        "and neither has the one `gos test` runs in",
    )
}
