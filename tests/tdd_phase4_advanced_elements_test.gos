// TDD Phase 4: Advanced Elements (Anchored, Deferred, Modal)
//
// Verifies:
// 1. Anchored element construction with corner and offset constraints.
// 2. Deferred element construction with priority.
// 3. Modal helper and element hierarchy nesting.

use gpui
use ui

#[test]
fn anchored_element_corners_and_offsets() {
    let tooltip = ui::label("Tooltip content").bg("#313244").p(8.0)

    // Test Anchored Top-Left
    let a_tl = ui::anchored(ui::ANCHOR_TOP_LEFT, 100.0, 50.0, tooltip)
    assert(a_tl.handle > 0, f"expected valid anchored handle, got {a_tl.handle}")

    // Test Anchored Top-Right with offset
    let a_tr = ui::anchored_with_offset(ui::ANCHOR_TOP_RIGHT, 200.0, 100.0, 10.0, 5.0, tooltip)
    assert(a_tr.handle > 0, f"expected valid anchored with offset handle, got {a_tr.handle}")

    // Test Anchored Bottom-Left
    let a_bl = ui::anchored(ui::ANCHOR_BOTTOM_LEFT, 50.0, 300.0, tooltip)
    assert(a_bl.handle > 0, f"expected valid anchored handle, got {a_bl.handle}")

    // Test Anchored Bottom-Right
    let a_br = ui::anchored(ui::ANCHOR_BOTTOM_RIGHT, 400.0, 300.0, tooltip)
    assert(a_br.handle > 0, f"expected valid anchored handle, got {a_br.handle}")
}

#[test]
fn deferred_element_and_modal() {
    let dialog_content = ui::div()
        .flex_col()
        .w(300.0)
        .h(200.0)
        .bg("#181825")
        .p(16.0)
        .child(ui::label("Modal Title"))

    // Deferred element with high priority (e.g. 100 for overlay)
    let def_el = ui::deferred(100, dialog_content)
    assert(def_el.handle > 0, f"expected valid deferred handle, got {def_el.handle}")

    // Modal helper
    let modal_el = ui::modal(dialog_content)
    assert(modal_el.handle > 0, f"expected valid modal handle, got {modal_el.handle}")

    // Can nest into parent element
    let root = ui::div()
        .w(800.0)
        .h(600.0)
        .child(ui::label("Main page"))
        .child(modal_el)

    assert(root.handle > 0, f"expected valid root handle, got {root.handle}")
}
