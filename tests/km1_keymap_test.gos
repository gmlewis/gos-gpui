// KM1 — a program-facing keymap.
//
// Headless: `gos test tests`. The spec a program hands `gpui::bind_keys` is a
// string in, a list of pairs out, and that parse is arithmetic on text — so it can
// be read without a window.
//
// Pass means `"<stroke>=<name>; <stroke>=<name>"` reads back as one
// `"<stroke>:<name>"` per pair, in order, with the malformed pairs dropped rather
// than silently bound to something.
//
// The other half of the row — that a bound stroke actually *fires* the event — is a
// window question and lives in `tests/gui/km1_keymap.gos`.

use gpui

#[test]
fn a_spec_parses_into_stroke_and_event_pairs() {
    let plan = gpui::keymap_plan("cmd-s=save; cmd-shift-z=redo")
    assert(plan.len() == 2, f"two pairs, got {plan.len()}")
    assert(plan[0] == "cmd-s:save", f"the first pair, in order: {plan[0]}")
    assert(plan[1] == "cmd-shift-z:redo", f"the second pair: {plan[1]}")
}

#[test]
fn a_name_may_carry_the_rest_of_the_line() {
    // The split is at the *first* `=`, so an event name may contain one.
    let plan = gpui::keymap_plan("ctrl-alt-p=toggle=panel")
    assert(plan == #["ctrl-alt-p:toggle=panel"], "the name is everything after the first =")
}

#[test]
fn a_pair_that_is_not_a_pair_is_dropped() {
    let plan = gpui::keymap_plan("cmd-s=save; nonsense; =noname; cmd-j=")
    assert(plan.len() == 1, f"only the one well-formed pair survives, got {plan.len()}")
    assert(plan[0] == "cmd-s:save", f"and it is that one: {plan[0]}")
}

#[test]
fn an_empty_spec_binds_nothing() {
    let plan = gpui::keymap_plan("")
    assert(plan.len() == 0, "an empty spec is not an error, it is an empty keymap")
}
