// TDD Phase 1: Reactive State Engine & Window Notification
//
// Verifies:
// 1. Model<T> / Store<T> reactive updates: mutate model state, verify subscriber closure fires with new state.
// 2. Window repaint trigger: model notification queues a frame invalidation request.

use gpui
use ui

struct CounterState {
    count: i64,
}

#[test]
fn model_reactive_updates_and_subscription() {
    let mut model = ui::create_model(CounterState { count: 10 })
    assert(model.read().count == 10, "initial count should be 10")

    let mut subscriber_calls = 0
    let mut observed_count = 0

    model.subscribe(|state: CounterState| {
        subscriber_calls += 1
        observed_count = state.count
    })

    // Update using a mutation closure
    model.update(|s: CounterState| CounterState { count: s.count + 5 })

    assert(subscriber_calls == 1, f"expected 1 subscriber call, got {subscriber_calls}")
    assert(observed_count == 15, f"expected observed_count == 15, got {observed_count}")
    assert(model.read().count == 15, f"model state mismatch: {model.read().count}")

    // Set directly with a new value
    model.set(CounterState { count: 100 })
    assert(subscriber_calls == 2, f"expected 2 subscriber calls, got {subscriber_calls}")
    assert(observed_count == 100, f"expected observed_count == 100, got {observed_count}")
    assert(model.read().count == 100, f"model state mismatch: {model.read().count}")
}

#[test]
fn window_repaint_trigger_on_model_notification() {
    let window_id = 99
    // Clear any pending invalidations for window 99
    let _ = gpui::clear_window_invalidation(window_id)
    assert(!gpui::is_window_invalidated(window_id), "window should initially not be invalidated")

    // Create a model attached to window 99
    let mut model = ui::create_model_for_window(CounterState { count: 0 }, window_id)

    // Trigger update
    model.set(CounterState { count: 1 })

    // Verify window invalidation is queued
    assert(gpui::is_window_invalidated(window_id), "model notification should invalidate window")

    // Clear invalidation and verify state resets
    let cleared = gpui::clear_window_invalidation(window_id)
    assert(cleared, "clear_window_invalidation should return true")
    assert(!gpui::is_window_invalidated(window_id), "window should no longer be invalidated")
}
