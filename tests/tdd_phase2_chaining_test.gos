// TDD Phase 2: Fluent Method Chaining & Style Categories
//
// Verifies:
// 1. Fluent chaining across style categories: layout, flex, grid, spacing, colors, borders, shadows, corners, typography, opacity, z-index, visibility.
// 2. Chaining returns self and correctly mutates element style attributes.
// 3. Pipe syntax compatibility (|>) as clean alternative.

use gpui
use ui

#[test]
fn fluent_chaining_all_categories() {
    let card = ui::div()
        .flex_col()
        .items_center()
        .justify_between()
        .w(400.0)
        .h(300.0)
        .p(24.0)
        .gap(16.0)
        .bg("#1e1e2e")
        .border(1.0, "#313244")
        .rounded(12.0)
        .shadow_lg()
        .opacity(0.95)
        .z(5)

    let style = ui::style_of(card)
    assert(ui::handle_of(card) != 0, "card handle is valid")
    assert(style != "", "style string is populated")

    // Verify tokens were appended
    assert(gpui::unknown_style_tokens(style).len() == 0, f"all chained tokens should be valid style tokens: {style}")

    // Verify hierarchy chaining
    let parent = ui::div()
        .flex_row()
        .gap(8.0)
        .child(
            ui::div()
                .w(100.0)
                .h(50.0)
                .bg("#ff0000")
        )
        .child(
            ui::div()
                .w(100.0)
                .h(50.0)
                .bg("#00ff00")
        )

    assert(ui::handle_of(parent) != 0, "parent handle is valid")
}

#[test]
fn pipe_syntax_alternative() {
    let el = ui::div()
        .w(200.0)
        .h(100.0)
        |> |e| ui::with_padding(e, 16.0)
        |> |e| ui::with_opacity(e, 0.8)
        |> |e| ui::with_bg(e, "#333333")

    let style = ui::style_of(el)
    assert(style != "", "piped style is not empty")
    assert(gpui::unknown_style_tokens(style).len() == 0, f"all piped tokens should be valid: {style}")
}
