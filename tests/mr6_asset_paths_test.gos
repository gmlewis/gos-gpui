// MR6 — where an asset path resolves.
//
// Headless: `gos test tests`. The row is "`ui::` module completeness and doc parity", and of its
// three clauses two turn out not to be gaps at all: `ui::scroll` takes a style, so `id=panel` in
// that style is what `gpui::scroll_offset("panel")` already reads (rounds 5–8 built that), and
// `ui::editor` multi-line is **DW1's row**, not this one — the editor widget's own text model.
//
// What is left is the clause the register names as the defect: **an `image` or `icon` path
// resolves against the process's working directory** (`view.rs:861`), which for a program started
// from a desktop icon is somewhere its assets are not. So a program can declare a root its assets
// live under, and the path it hands `image`/`icon` is resolved against it first.
//
// Pass means: nothing changes for a program that declares no root, a root is searched before the
// working directory, an asset the root does not have falls back rather than breaking, an absolute
// path is never touched, and the root is spelled however the program likes.
//
// `asset_root` is per window and the tests share window 0, so every case here sets the root it
// wants rather than relying on the last one to have cleared it.

use gpui
use std::fs

#[test]
fn without_a_root_a_path_is_left_alone() {
    gpui::asset_root("")
    assert(
        gpui::asset_path("logo.png") == "logo.png",
        f"a program that declares no root keeps the old behaviour: {gpui::asset_path("logo.png")}",
    )
}

#[test]
fn a_root_is_searched_before_the_working_directory() {
    let _ = fs::remove_dir_all("/tmp/gpui-mr6-a")
    assert(fs::create_dir_all("/tmp/gpui-mr6-a/assets").is_ok(), "the assets directory")
    assert(
        fs::write("/tmp/gpui-mr6-a/assets/logo.png", "not really a png".as_bytes()).is_ok(),
        "an asset in it",
    )
    gpui::asset_root("/tmp/gpui-mr6-a/assets")
    assert(
        gpui::asset_path("logo.png") == "/tmp/gpui-mr6-a/assets/logo.png",
        f"the root comes first: {gpui::asset_path("logo.png")}",
    )
    gpui::asset_root("")
    let _ = fs::remove_dir_all("/tmp/gpui-mr6-a")
}

#[test]
fn an_asset_the_root_does_not_have_falls_back() {
    let _ = fs::remove_dir_all("/tmp/gpui-mr6-b")
    assert(fs::create_dir_all("/tmp/gpui-mr6-b/assets").is_ok(), "an empty assets directory")
    gpui::asset_root("/tmp/gpui-mr6-b/assets")
    assert(
        gpui::asset_path("somewhere-else.png") == "somewhere-else.png",
        f"a miss is not a failure: {gpui::asset_path("somewhere-else.png")}",
    )
    gpui::asset_root("")
    let _ = fs::remove_dir_all("/tmp/gpui-mr6-b")
}

#[test]
fn an_absolute_path_is_never_touched() {
    gpui::asset_root("/tmp/gpui-mr6-c")
    assert(
        gpui::asset_path("/tmp/absolute.png") == "/tmp/absolute.png",
        f"a program that knows where its asset is says so, and is believed: {gpui::asset_path("/tmp/absolute.png")}",
    )
    gpui::asset_root("")
}

#[test]
fn the_root_is_spelled_however_the_program_likes() {
    let _ = fs::remove_dir_all("/tmp/gpui-mr6-d")
    assert(fs::create_dir_all("/tmp/gpui-mr6-d/assets").is_ok(), "the assets directory")
    assert(
        fs::write("/tmp/gpui-mr6-d/assets/logo.png", "not really a png".as_bytes()).is_ok(),
        "an asset",
    )
    gpui::asset_root("/tmp/gpui-mr6-d/assets/")
    assert(
        gpui::asset_path("logo.png") == "/tmp/gpui-mr6-d/assets/logo.png",
        f"a trailing slash does not double one: {gpui::asset_path("logo.png")}",
    )
    gpui::asset_root("")
    let _ = fs::remove_dir_all("/tmp/gpui-mr6-d")
}
