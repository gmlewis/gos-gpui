// TH5 — colour-scheme-aware style tokens: `theme:<name>` as a style value.
//
// Headless: `gos test tests`. A style value that names the colour table is a *parse*
// plus a vocabulary, and both can be read without a window — which is what makes this
// half checkable on a machine with no display to spare.
//
// TH3 wired `set_theme` so the table can be told which palette to answer from; this is
// the other end of the same idea. Before it, a program that wanted the desktop's own
// background had to read `gpui::default_color("background")` and paste the hex into its
// style string — the table existed and the language could not name it.
//
// Pass means `theme:<name>` is a style value, that the names it accepts are exactly the
// ones `gpui::colour_names` publishes, and that a name the table does not have is
// **reported** rather than drawn as black.
//
// The resolution itself — that `theme:background` answers what the table answers, and
// follows `set_theme` — needs a window and lives in `tests/gui/th5_theme_tokens.gos`.

use gpui

#[test]
fn a_value_may_name_the_colour_table() {
    let unknown = gpui::unknown_style_tokens("bg=theme:background color=theme:text")
    assert(unknown.len() == 0, f"both are names the table has: {unknown}")
}

#[test]
fn a_name_the_table_does_not_have_is_reported() {
    let unknown = gpui::unknown_style_tokens("bg=theme:nosuch")
    assert(unknown == #["bg=theme:nosuch"], f"reported rather than silently drawn as black: {unknown}")
}

#[test]
fn the_names_it_accepts_are_the_ones_the_table_publishes() {
    let names = gpui::colour_names()
    assert(names.len() == 8, f"the platform table publishes eight, got {names.len()}")
    for name in names {
        let unknown = gpui::unknown_style_tokens(f"bg=theme:{name}")
        assert(unknown.len() == 0, f"{name} is a name colour_names publishes: {unknown}")
    }
}

#[test]
fn a_literal_is_still_a_literal() {
    let unknown = gpui::unknown_style_tokens("bg=#89b4fa color=white grad=#111111,#222222")
    assert(unknown.len() == 0, f"nothing about the table changes an ordinary colour: {unknown}")
}

#[test]
fn the_prefix_is_checked_not_the_whole_value() {
    // `theme` alone is a colour the language has never had either way, but the point
    // here is narrower: the check is on the *name* after the colon, not on the token.
    let unknown = gpui::unknown_style_tokens("bg=theme:")
    assert(unknown == #["bg=theme:"], f"an empty name is not a name: {unknown}")
}
