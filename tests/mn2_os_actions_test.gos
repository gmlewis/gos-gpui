// MN2 — OS actions and the application/dock menu: the grammar.
//
// Headless: `gos test tests`. Two new kinds of menu entry, and the vocabulary each of them
// draws from:
//
//   * `"os:<label>:<selector>"` — an item wired to a **system selector**, so the OS performs the
//     action itself: `Cut`, `Copy`, `Paste`, `SelectAll`, `Undo`, `Redo`. It is still an action of
//     the menu's, so it takes a slot like any other.
//   * `"services:<label>"` — the **Services** menu, which the system fills in. It is a menu, not
//     an action, so it takes no slot.
//
// Pass means both read back from the declaration, that the slot numbering still counts the
// entries that are actions and only those, and that a selector the binding does not know is
// reported rather than made into something else.
//
// The install path is the probe: `tests/gui/mn2_os_actions.gos`.

use gpui

#[test]
fn an_os_action_reads_back_as_its_own_kind() {
    let tree = gpui::menu_tree(#["os:Copy:copy", "services:Services", "events:Quit"])
    assert(tree.len() == 3, f"three entries, got {tree.len()}")
    assert(tree[0] == "0:os:Copy", f"a system action is its own kind: {tree[0]}")
    assert(tree[1] == "0:services:Services", f"and so is the Services menu: {tree[1]}")
    assert(tree[2] == "0:events:Quit", f"beside the ordinary entries: {tree[2]}")
}

#[test]
fn only_the_actions_take_slots() {
    // An OS action is an action; the Services menu is a menu, like a submenu.
    let slots = gpui::menu_slots(#["os:Copy:copy", "services:Services", "events:Quit", "os:Paste:paste"])
    assert(slots == #["0:Copy", "1:Quit", "2:Paste"], f"actions counted, menus not: {slots}")
}

#[test]
fn the_six_selectors_are_the_ones_it_knows() {
    let tree = gpui::menu_tree(#[
        "os:Cut:cut",
        "os:Copy:copy",
        "os:Paste:paste",
        "os:Select All:selectAll",
        "os:Undo:undo",
        "os:Redo:redo",
    ])
    assert(tree.len() == 6, f"all six are known: {tree.len()}")
}

#[test]
fn a_selector_it_does_not_know_is_reported() {
    let bad = gpui::menu_bad(#["events:a", "os:Copy:nosuch"])
    assert(bad == #["os:Copy:nosuch"], f"reported rather than made into something else: {bad}")

    // And the other direction, which is what stops the assertion above passing for the wrong
    // reason: a selector it *does* know is not reported.
    let known = gpui::menu_bad(#["os:Copy:copy", "os:Select All:selectAll"])
    assert(known.len() == 0, f"both are selectors it knows: {known}")
}

#[test]
fn the_nesting_still_applies_to_both() {
    let tree = gpui::menu_tree(#["submenu:Edit", ">os:Copy:copy", ">services:Services"])
    assert(tree[1] == "1:os:Copy", f"an OS action inside a submenu: {tree[1]}")
    assert(tree[2] == "1:services:Services", f"and the Services menu inside one: {tree[2]}")

    let slots = gpui::menu_slots(#["submenu:Edit", ">os:Copy:copy", ">services:Services", "events:Quit"])
    assert(slots == #["0:Copy", "1:Quit"], f"only the action took a slot: {slots}")
}
