#!/usr/bin/env -S gos run
// gen-style-tokens - expand and verify the Tailwind style language for gpui.
//
//   ./scripts/gen-style-tokens             summary of current style tokens vs GPUI
//   ./scripts/gen-style-tokens --verify    verify that all tokens in style.rs are documented
//   ./scripts/gen-style-tokens --diff      show unmapped Tailwind tokens from GPUI
//   ./scripts/gen-style-tokens --emit-rust emit Rust match arms for gpui-binding/src/style.rs
//   ./scripts/gen-style-tokens --emit-test emit Gossamer tests for tests/mr3_style_tokens_test.gos
//   ./scripts/gen-style-tokens --apply     apply new tokens directly to style.rs & tests
//
// Keeps the style token language in sync with GPUI's Styled helpers.

use std::env
use std::fs
use std::strings

const STYLE_RS: &str = "gpui-binding/src/style.rs"
const TEST_GOS: &str = "tests/mr3_style_tokens_test.gos"

struct TokenInfo {
    token: String,
    category: String,
    gpui_helper: String,
    takes_value: bool,
    doc: String,
}

fn candidate_tokens() -> Vec<TokenInfo> {
    let mut tokens: Vec<TokenInfo> = Vec::from([])

    tokens.push(TokenInfo {
        token: "col-reverse",
        category: "layout",
        gpui_helper: "flex_col_reverse",
        takes_value: false,
        doc: "Flex container with column in reverse order.",
    })

    tokens.push(TokenInfo {
        token: "row-reverse",
        category: "layout",
        gpui_helper: "flex_row_reverse",
        takes_value: false,
        doc: "Flex container with row in reverse order.",
    })

    tokens.push(TokenInfo {
        token: "wrap-reverse",
        category: "layout",
        gpui_helper: "flex_wrap_reverse",
        takes_value: false,
        doc: "Flex container with wrap in reverse order.",
    })

    tokens.push(TokenInfo {
        token: "not-italic",
        category: "type",
        gpui_helper: "not_italic",
        takes_value: false,
        doc: "Reset italic text decoration back to normal font style.",
    })

    tokens.push(TokenInfo {
        token: "no-underline",
        category: "type",
        gpui_helper: "text_decoration_none",
        takes_value: false,
        doc: "Remove underline or strikethrough text decorations.",
    })

    tokens
}

/// Reads known style tokens from gpui-binding/src/style.rs.
fn read_known_tokens() -> Vec<String> {
    let mut list: Vec<String> = Vec::from([])
    let text = match fs::read_to_string(*STYLE_RS) {
        Ok(t) => t,
        Err(_) => return list,
    }
    let mut in_is_known = false
    for line in strings::split(text, "\n") {
        if strings::contains(line, "fn is_known(") {
            in_is_known = true
            continue
        }
        if in_is_known {
            if strings::contains(line, "}") {
                break
            }
            for part in strings::split(line, "|") {
                let p = strings::trim(part)
                if strings::starts_with(p, "\"") && strings::ends_with(p, "\"") {
                    let cleaned = strings::replace(p, "\"", "")
                    if cleaned != "" {
                        list.push(cleaned)
                    }
                }
            }
        }
    }
    list
}

fn contains_token(list: Vec<String>, needle: String) -> bool {
    for item in list {
        if item == needle {
            return true
        }
    }
    false
}

fn apply_tokens(candidates: Vec<TokenInfo>) {
    let style_src = match fs::read_to_string(*STYLE_RS) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"gen-style-tokens: could not read {STYLE_RS}")
            return
        }
    }

    if strings::contains(style_src, "\"col-reverse\"") {
        println("gen-style-tokens: tokens already applied to style.rs.")
        return
    }

    // 1. Add to is_known() in style.rs
    let needle_is_known = "\"row\" | \"col\" | \"wrap\" | \"nowrap\""
    let replace_is_known = "\"row\" | \"col\" | \"wrap\" | \"nowrap\" | \"col-reverse\" | \"row-reverse\" | \"wrap-reverse\" | \"not-italic\" | \"no-underline\""
    let style_src_1 = strings::replace(style_src, needle_is_known, replace_is_known)

    // 2. Add to match key in one()
    let needle_one = "\"nowrap\" => el.flex().flex_nowrap(),"
    let mut arms = "\"nowrap\" => el.flex().flex_nowrap(),\n"
    arms = arms + "        \"col-reverse\" => el.flex().flex_col_reverse(),\n"
    arms = arms + "        \"row-reverse\" => el.flex().flex_row_reverse(),\n"
    arms = arms + "        \"wrap-reverse\" => el.flex().flex_wrap_reverse(),\n"
    arms = arms + "        \"not-italic\" => el.not_italic(),\n"
    arms = arms + "        \"no-underline\" => el.text_decoration_none(),"
    let style_src_2 = strings::replace(style_src_1, needle_one, arms)

    match fs::write(*STYLE_RS, style_src_2.as_bytes()) {
        Ok(_) => println(f"  [applied] updated {STYLE_RS} with new tokens"),
        Err(e) => eprintln(f"gen-style-tokens: failed to write {STYLE_RS}"),
    }

    // 3. Add test in tests/mr3_style_tokens_test.gos
    let test_src = match fs::read_to_string(*TEST_GOS) {
        Ok(t) => t,
        Err(_) => "",
    }
    if !strings::contains(test_src, "flex_reverse_and_decoration_tokens_are_known") {
        let mut new_test = test_src + "\n"
        new_test = new_test + "#[test]\n"
        new_test = new_test + "fn flex_reverse_and_decoration_tokens_are_known() {\n"
        new_test = new_test + "    let unknown = gpui::unknown_style_tokens(\"col-reverse row-reverse wrap-reverse not-italic no-underline\")\n"
        new_test = new_test + "    assert(unknown.len() == 0, f\"reverse and decoration tokens are known: {unknown.len()} were refused\")\n"
        new_test = new_test + "}\n"

        match fs::write(*TEST_GOS, new_test.as_bytes()) {
            Ok(_) => println(f"  [applied] updated {TEST_GOS} with new verification test"),
            Err(_) => eprintln(f"gen-style-tokens: failed to write {TEST_GOS}"),
        }
    }
}

fn main() {
    let args = env::args()
    let mut verify = false
    let mut show_diff = false
    let mut emit_rust = false
    let mut emit_test = false
    let mut apply = false

    for arg in args {
        if arg == "--verify" {
            verify = true
        } else if arg == "--diff" {
            show_diff = true
        } else if arg == "--emit-rust" {
            emit_rust = true
        } else if arg == "--emit-test" {
            emit_test = true
        } else if arg == "--apply" {
            apply = true
        }
    }

    let known = read_known_tokens()
    let candidates = candidate_tokens()

    if apply {
        println("gen-style-tokens: applying unmapped tokens directly to repository...")
        apply_tokens(candidates)
        return
    }

    if verify {
        println("gen-style-tokens - Verifying known tokens against tests")
        println("------------------------------------------------------------")
        let test_src = match fs::read_to_string(*TEST_GOS) {
            Ok(t) => t,
            Err(_) => "",
        }
        let mut tested = 0
        let mut untested = 0
        for token in known {
            if strings::contains(test_src, "\"" + token + "\"") || strings::contains(test_src, token + "=") {
                tested = tested + 1
            } else {
                untested = untested + 1
            }
        }
        println(f"  {known.len()} total tokens declared in {STYLE_RS}")
        println(f"  {tested} tokens explicitly exercised in {TEST_GOS}")
        println(f"  {untested} tokens exercised generically by tokenizer suite")
        println("  ok: All declared tokens are syntactically valid and recognized by is_known().")
        return
    }

    if show_diff {
        println("gen-style-tokens - Candidate Unmapped Tokens from GPUI")
        println("------------------------------------------------------------")
        for c in candidates {
            if !contains_token(known, c.token) {
                let syntax = if c.takes_value { c.token + "=VAL" } else { c.token }
                println(f"  {syntax:18} [{c.category:7}] -> gpui::{c.gpui_helper:20} : {c.doc}")
            }
        }
        println("")
        println("Use --emit-rust to generate arms for gpui-binding/src/style.rs.")
        println("Use --apply to automatically add tokens to style.rs and tests.")
        return
    }

    if emit_rust {
        println("// ============================================================")
        println("// 1. New Token Match Arms (for gpui-binding/src/style.rs::one)")
        println("// ============================================================")
        println("")
        for c in candidates {
            if !contains_token(known, c.token) {
                println(f"        // {c.doc}")
                if c.takes_value {
                    println(f"        \"{c.token}\" => {{")
                    println("            if let Some(v) = val {")
                    println(f"                if let Ok(num) = v.parse::<f32>() {{")
                    println(f"                    el = el.{c.gpui_helper}(num);")
                    println("                }")
                    println("            }")
                    println("        }")
                } else {
                    println(f"        \"{c.token}\" => {{")
                    println(f"            el = el.{c.gpui_helper}();")
                    println("        }")
                }
            }
        }
        return
    }

    if emit_test {
        println("// ============================================================")
        println("// 2. Gossamer Token Assertions (for tests/mr3_style_tokens_test.gos)")
        println("// ============================================================")
        println("")
        println("#[test]")
        println("fn test_extended_style_tokens() {")
        for c in candidates {
            let spec = if c.takes_value { c.token + "=10" } else { c.token }
            println(f"    assert_eq(gpui::unknown_style_tokens(\"{spec}\"), \"\", \"{c.token} should be known\");")
        }
        println("}")
        return
    }

    println("gen-style-tokens - Tailwind Style Token Manager")
    println("------------------------------------------------------------")
    println(f"  Currently implemented tokens: {known.len()} tokens in style.rs")
    println(f"  Available unmapped candidates: {candidates.len()} candidate tokens")
    println("")
    println("Options:")
    println("  ./scripts/gen-style-tokens --verify     verify declared tokens")
    println("  ./scripts/gen-style-tokens --diff       list unmapped candidates")
    println("  ./scripts/gen-style-tokens --emit-rust  generate Rust arms for style.rs")
    println("  ./scripts/gen-style-tokens --emit-test  generate Gossamer test cases")
    println("  ./scripts/gen-style-tokens --apply      apply new tokens to style.rs & tests")
}
