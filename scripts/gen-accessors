#!/usr/bin/env -S gos run
// gen-accessors - generate Rust binding, Gossamer wrapper, and test scaffolding
// for pure scalar GPUI accessors.
//
//   ./scripts/gen-accessors                 all generated code to stdout
//   ./scripts/gen-accessors --summary       list available accessors
//   ./scripts/gen-accessors --emit-rust     output only Rust binding code
//   ./scripts/gen-accessors --emit-gos      output only Gossamer lib code
//   ./scripts/gen-accessors --emit-test     output only test code
//   ./scripts/gen-accessors --target=NAME   filter by target struct (Window, Display, Bounds)
//
// Bridges the mechanical gap between GPUI and Gossamer without manual boilerplate.

use std::env
use std::fs
use std::strings

struct AccessorDef {
    target: String,
    method: String,
    is_setter: bool,
    param_name: String,
    param_type: String,
    gos_param_type: String,
    return_type: String,
    gos_return_type: String,
    doc: String,
}

fn catalog() -> Vec<AccessorDef> {
    let mut defs: Vec<AccessorDef> = Vec::from([])

    defs.push(AccessorDef {
        target: "Window",
        method: "is_maximized",
        is_setter: false,
        param_name: "",
        param_type: "",
        gos_param_type: "",
        return_type: "bool",
        gos_return_type: "bool",
        doc: "Whether the window is currently maximized by the window manager.",
    })

    defs.push(AccessorDef {
        target: "Window",
        method: "set_maximized",
        is_setter: true,
        param_name: "maximized",
        param_type: "bool",
        gos_param_type: "bool",
        return_type: "()",
        gos_return_type: "()",
        doc: "Sets whether the window is maximized.",
    })

    defs.push(AccessorDef {
        target: "Window",
        method: "set_mouse_position",
        is_setter: true,
        param_name: "x: f64, y: f64",
        param_type: "x: f64, y: f64",
        gos_param_type: "x: f64, y: f64",
        return_type: "()",
        gos_return_type: "()",
        doc: "Warp the pointer to the specified window coordinates.",
    })

    defs.push(AccessorDef {
        target: "Display",
        method: "color_space",
        is_setter: false,
        param_name: "display_id: i64",
        param_type: "display_id: i64",
        gos_param_type: "display_id: i64",
        return_type: "String",
        gos_return_type: "String",
        doc: "The name of the color space associated with the display (e.g. sRGB, Display P3).",
    })

    defs.push(AccessorDef {
        target: "Bounds",
        method: "contains",
        is_setter: false,
        param_name: "bx: f64, by: f64, bw: f64, bh: f64, px: f64, py: f64",
        param_type: "bx: f64, by: f64, bw: f64, bh: f64, px: f64, py: f64",
        gos_param_type: "bx: f64, by: f64, bw: f64, bh: f64, px: f64, py: f64",
        return_type: "bool",
        gos_return_type: "bool",
        doc: "Answers whether the point (px, py) is contained within the bounds (bx, by, bw, bh).",
    })

    defs.push(AccessorDef {
        target: "Bounds",
        method: "center",
        is_setter: false,
        param_name: "x: f64, y: f64, w: f64, h: f64",
        param_type: "x: f64, y: f64, w: f64, h: f64",
        gos_param_type: "x: f64, y: f64, w: f64, h: f64",
        return_type: "(f64, f64)",
        gos_return_type: "(f64, f64)",
        doc: "Calculates the center coordinate (cx, cy) of the rectangular bounds.",
    })

    defs
}

fn render_rust_fn(d: AccessorDef) -> String {
    let fn_name = if d.target == "Window" {
        "window_" + d.method
    } else if d.target == "Display" {
        "display_" + d.method
    } else {
        strings::to_lowercase(d.target) + "_" + d.method
    }

    let mut out = "    /// " + d.doc + "\n"
    if d.is_setter {
        out = out + f"    fn {fn_name}(_d: &mut dyn NativeDispatch, {d.param_type}) -> Result<(), String> {{\n"
        out = out + f"        // Invokes {d.target}::{d.method}\n"
        out = out + "        Ok(())\n"
        out = out + "    }\n"
    } else if d.param_name != "" {
        out = out + f"    fn {fn_name}(_d: &mut dyn NativeDispatch, {d.param_type}) -> Result<{d.return_type}, String> {{\n"
        out = out + f"        // Invokes {d.target}::{d.method}\n"
        if d.return_type == "bool" {
            out = out + "        Ok(true)\n"
        } else if d.return_type == "String" {
            out = out + "        Ok(String::new())\n"
        } else {
            out = out + "        Ok((0.0, 0.0))\n"
        }
        out = out + "    }\n"
    } else {
        out = out + f"    fn {fn_name}(_d: &mut dyn NativeDispatch) -> Result<{d.return_type}, String> {{\n"
        out = out + f"        // Invokes {d.target}::{d.method}\n"
        if d.return_type == "bool" {
            out = out + "        Ok(false)\n"
        } else {
            out = out + "        Ok(String::new())\n"
        }
        out = out + "    }\n"
    }
    out
}

fn render_gos_fn(d: AccessorDef) -> String {
    let fn_name = if d.target == "Window" {
        "window_" + d.method
    } else if d.target == "Display" {
        "display_" + d.method
    } else {
        strings::to_lowercase(d.target) + "_" + d.method
    }

    let mut out = "/// " + d.doc + "\n"
    if d.is_setter {
        out = out + f"pub fn {fn_name}({d.gos_param_type}) -> Result<(), String> {{\n"
        out = out + f"    gpui::{fn_name}({clean_args(d.gos_param_type)})\n"
        out = out + "}\n"
    } else if d.param_name != "" {
        out = out + f"pub fn {fn_name}({d.gos_param_type}) -> {d.gos_return_type} {{\n"
        out = out + f"    match gpui::{fn_name}({clean_args(d.gos_param_type)}) {{\n"
        out = out + "        Ok(v) => v,\n"
        if d.gos_return_type == "bool" {
            out = out + "        Err(_) => false,\n"
        } else if d.gos_return_type == "String" {
            out = out + "        Err(_) => \"\",\n"
        } else {
            out = out + "        Err(_) => (0.0, 0.0),\n"
        }
        out = out + "    }\n"
        out = out + "}\n"
    } else {
        out = out + f"pub fn {fn_name}() -> {d.gos_return_type} {{\n"
        out = out + f"    match gpui::{fn_name}() {{\n"
        out = out + "        Ok(v) => v,\n"
        if d.gos_return_type == "bool" {
            out = out + "        Err(_) => false,\n"
        } else {
            out = out + "        Err(_) => \"\",\n"
        }
        out = out + "    }\n"
        out = out + "}\n"
    }
    out
}

fn clean_args(params: String) -> String {
    let mut args: Vec<String> = Vec::from([])
    for part in strings::split(params, ",") {
        let p = strings::trim(part)
        let subparts = strings::split(p, ":")
        if subparts.len() > 0 {
            args.push(strings::trim(subparts[0]))
        }
    }
    strings::join(args, ", ")
}

fn render_test(d: AccessorDef) -> String {
    let fn_name = if d.target == "Window" {
        "window_" + d.method
    } else if d.target == "Display" {
        "display_" + d.method
    } else {
        strings::to_lowercase(d.target) + "_" + d.method
    }

    let mut out = f"#[test]\nfn test_{fn_name}_exists() {{\n"
    if d.is_setter {
        out = out + f"    // Verification that {fn_name} can be invoked without panic\n"
        out = out + f"    let _ = ui::{fn_name};\n"
    } else {
        out = out + f"    // Verification that {fn_name} returns valid value\n"
        out = out + f"    let _ = ui::{fn_name};\n"
    }
    out = out + "    assert(true, \"accessor exists\")\n"
    out = out + "}\n"
    out
}

fn main() {
    let args = env::args()
    let mut summary = false
    let mut emit_rust = false
    let mut emit_gos = false
    let mut emit_test = false
    let mut filter_target = ""

    for arg in args {
        if arg == "--summary" {
            summary = true
        } else if arg == "--emit-rust" {
            emit_rust = true
        } else if arg == "--emit-gos" {
            emit_gos = true
        } else if arg == "--emit-test" {
            emit_test = true
        } else if strings::starts_with(arg, "--target=") {
            filter_target = strings::replace(arg, "--target=", "")
        }
    }

    let defs = catalog()

    if summary {
        println("gen-accessors - Candidate Scalar Accessors")
        println("------------------------------------------------------------")
        for d in defs {
            if filter_target != "" && strings::to_lowercase(d.target) != strings::to_lowercase(filter_target) {
                continue
            }
            let sig = if d.param_name != "" {
                f"{d.target}::{d.method}({d.param_name}) -> {d.return_type}"
            } else {
                f"{d.target}::{d.method}() -> {d.return_type}"
            }
            println(f"  {sig:48} : {d.doc}")
        }
        println("")
        println("Use --emit-rust, --emit-gos, or --emit-test to generate code.")
        return
    }

    let show_all = !emit_rust && !emit_gos && !emit_test

    if show_all || emit_rust {
        println("// ============================================================")
        println("// 1. Rust Binding Skeleton (for gpui-binding/src/lib.rs)")
        println("// ============================================================")
        println("")
        for d in defs {
            if filter_target != "" && strings::to_lowercase(d.target) != strings::to_lowercase(filter_target) {
                continue
            }
            println(render_rust_fn(d))
        }
    }

    if show_all || emit_gos {
        println("// ============================================================")
        println("// 2. Gossamer Library Wrapper (for src/lib.gos)")
        println("// ============================================================")
        println("")
        for d in defs {
            if filter_target != "" && strings::to_lowercase(d.target) != strings::to_lowercase(filter_target) {
                continue
            }
            println(render_gos_fn(d))
        }
    }

    if show_all || emit_test {
        println("// ============================================================")
        println("// 3. Test Scaffolding (for tests/accessors_test.gos)")
        println("// ============================================================")
        println("")
        for d in defs {
            if filter_target != "" && strings::to_lowercase(d.target) != strings::to_lowercase(filter_target) {
                continue
            }
            println(render_test(d))
        }
    }
}
