#!/usr/bin/env -S gos run
// audit-capabilities - audit capability coverage between GPUI and gpui-binding.
//
//   ./scripts/audit-capabilities            summary & category breakdown
//   ./scripts/audit-capabilities --detail   full inventory with item status
//   ./scripts/audit-capabilities --filter=NAME filter by subsystem (e.g. window, style, text)
//   ./scripts/audit-capabilities --json     machine-readable output
//
// Evaluates the repo's progress toward 100% capability status against the
// published `gpui` crate, classifying items into:
//   - COVERED:      bound and callable in Gossamer
//   - MECHANICAL:   pure scalar getter/setter; automatable via `gen-accessors`
//   - STYLE_TOKEN:  styling method; automatable via `gen-style-tokens`
//   - MECHANISM:    requires immediate-mode / event queue architectural redesign
//   - UNREACHABLE:  structurally blocked (private symbols, ABI callback barrier)

use std::env
use std::fs
use std::process
use std::strings

const MANIFEST: &str = "gpui-binding/Cargo.toml"
const BINDING_LIB: &str = "gpui-binding/src/lib.rs"
const BINDING_STYLE: &str = "gpui-binding/src/style.rs"

struct Subsystem {
    name: String,
    total: i64,
    covered: i64,
    mechanical: i64,
    style_token: i64,
    mechanism: i64,
    unreachable: i64,
}

fn new_subsystem(name: String) -> Subsystem {
    Subsystem {
        name: name,
        total: 0,
        covered: 0,
        mechanical: 0,
        style_token: 0,
        mechanism: 0,
        unreachable: 0,
    }
}

/// Locates the cached gpui crate source directory or "" if not found.
fn find_gpui_source() -> String {
    let home = match env::var("HOME") {
        Some(h) => h,
        None => return "",
    }
    let base = home + "/.cargo/registry/src"
    if !fs::exists(base) {
        return ""
    }
    let entries = match fs::read_dir(base) {
        Ok(e) => e,
        Err(_) => return "",
    }
    for entry in entries {
        if entry.is_dir {
            let candidate = entry.path + "/gpui-0.2.2"
            if fs::exists(candidate + "/src") {
                return candidate
            }
        }
    }
    ""
}

/// Reads registered binding functions from gpui-binding/src/lib.rs.
fn read_bound_functions() -> Vec<String> {
    let mut names: Vec<String> = Vec::from([])
    let text = match fs::read_to_string(*BINDING_LIB) {
        Ok(t) => t,
        Err(_) => return names,
    }
    for line in strings::split(text, "\n") {
        let trimmed = strings::trim(line)
        if strings::starts_with(trimmed, "fn ") || strings::starts_with(trimmed, "cb_fn ") {
            let without_prefix = strings::replace(strings::replace(trimmed, "cb_fn ", ""), "fn ", "")
            let parts = strings::split(without_prefix, "(")
            if parts.len() > 0 {
                let name = strings::trim(parts[0])
                if name != "" && !strings::starts_with(name, "//") {
                    names.push(name)
                }
            }
        }
    }
    names
}

/// Reads known style tokens from gpui-binding/src/style.rs.
fn read_known_style_tokens() -> Vec<String> {
    let mut tokens: Vec<String> = Vec::from([])
    let text = match fs::read_to_string(*BINDING_STYLE) {
        Ok(t) => t,
        Err(_) => return tokens,
    }
    let mut in_is_known = false
    for line in strings::split(text, "\n") {
        if strings::contains(line, "fn is_known(") {
            in_is_known = true
            continue
        }
        if in_is_known {
            if strings::contains(line, "}") {
                break
            }
            for part in strings::split(line, "|") {
                let p = strings::trim(part)
                if strings::starts_with(p, "\"") && strings::ends_with(p, "\"") {
                    let cleaned = strings::replace(p, "\"", "")
                    if cleaned != "" {
                        tokens.push(cleaned)
                    }
                }
            }
        }
    }
    tokens
}

fn contains_str(list: Vec<String>, needle: String) -> bool {
    for item in list {
        if item == needle {
            return true
        }
    }
    false
}

fn print_bar(pct: f64, width: i64) -> String {
    let filled = (pct / 100.0 * (width as f64)) as i64
    let mut s = "["
    let mut i = 0
    while i < width {
        if i < filled {
            s = s + "="
        } else {
            s = s + " "
        }
        i = i + 1
    }
    s + "]"
}

fn main() {
    let args = env::args()
    let mut detail = false
    let mut json_out = false
    let mut filter_name = ""

    for arg in args {
        if arg == "--detail" {
            detail = true
        } else if arg == "--json" {
            json_out = true
        } else if strings::starts_with(arg, "--filter=") {
            filter_name = strings::replace(arg, "--filter=", "")
        }
    }

    let bound_fns = read_bound_functions()
    let style_tokens = read_known_style_tokens()
    let gpui_src = find_gpui_source()

    if !json_out {
        println("audit-capabilities - GPUI to Gossamer Capability Assessment")
        println("------------------------------------------------------------")
        if gpui_src != "" {
            println(f"  upstream GPUI: {gpui_src}")
        } else {
            println("  upstream GPUI: using built-in capability register (crate cache not found)")
        }
        println(f"  gpui-binding:  {bound_fns.len()} registered functions, {style_tokens.len()} style tokens")
        println("")
    }

    // Capability families catalog
    let mut items: Vec<String> = Vec::from([])
    // Format: "subsystem|name|status|reason"
    items.push("window|open_window|COVERED|gpui::open_window")
    items.push("window|close_window|COVERED|gpui::close_window")
    items.push("window|window_bounds|COVERED|gpui::window_bounds")
    items.push("window|resize_window|COVERED|gpui::resize_window")
    items.push("window|active_window|COVERED|gpui::active_window")
    items.push("window|scale_factor|COVERED|gpui::window_scale_factor")
    items.push("window|is_maximized|MECHANICAL|Window::is_maximized scalar accessor")
    items.push("window|set_maximized|MECHANICAL|Window::set_maximized setter")
    items.push("window|is_fullscreen|COVERED|gpui::window_option(\"fullscreen\")")
    items.push("window|set_fullscreen|COVERED|gpui::toggle_fullscreen")
    items.push("window|start_window_move|COVERED|gpui::start_window_move")
    items.push("window|start_window_resize|COVERED|gpui::start_window_resize")
    items.push("window|mouse_position|COVERED|gpui::pointer_xy")
    items.push("window|set_mouse_position|MECHANICAL|Window::set_mouse_position")
    items.push("window|prompt|COVERED|gpui::prompt queue")
    items.push("window|native_prompt|UNREACHABLE|Window::prompt closure unexposed")

    items.push("display|display_count|COVERED|gpui::display_count")
    items.push("display|display_field|COVERED|gpui::display_field")
    items.push("display|display_bounds|COVERED|gpui::display_bounds")
    items.push("display|refresh|COVERED|gpui::refresh")
    items.push("display|color_space|MECHANICAL|Display::color_space scalar")

    items.push("style|flex|COVERED|row, col, flex tokens")
    items.push("style|spacing|COVERED|gap, p, m tokens")
    items.push("style|size|COVERED|w, h, size tokens")
    items.push("style|alignment|COVERED|justify, items, align")
    items.push("style|colors|COVERED|bg, color, grad")
    items.push("style|border|COVERED|border, bordercolor, rounded")
    items.push("style|shadow|COVERED|shadow xs..2xl")
    items.push("style|z_index|STYLE_TOKEN|z-index / z_index token")
    items.push("style|aspect_ratio|STYLE_TOKEN|aspect-ratio token")
    items.push("style|box_sizing|STYLE_TOKEN|box-sizing token")
    items.push("style|opacity|COVERED|opacity token")

    items.push("text|text_measure|COVERED|gpui::text_width")
    items.push("text|font_families|COVERED|gpui::font_families")
    items.push("text|line_height|COVERED|gpui::line_height")
    items.push("text|text_layout|COVERED|gpui::text_layout")
    items.push("text|typography_highlights|COVERED|gpui::set_highlights")
    items.push("text|custom_font_loader|MECHANISM|AssetSource custom loader trait")

    items.push("input|keymap|COVERED|gpui::bind_keys")
    items.push("input|editor|COVERED|ui::editor & gpui::editor_*")
    items.push("input|ime_compose|COVERED|gpui::compose")
    items.push("input|pointer_events|COVERED|gpui::on_mouse")
    items.push("input|tab_order|COVERED|gpui::focus & tab_order")
    items.push("input|custom_input_handler|UNREACHABLE|EntityInputHandler trait")
    items.push("input|drag_payload_static|MECHANISM|on_drag 'static payload")

    items.push("canvas|path_builder|COVERED|gpui::path_*")
    items.push("canvas|paint_paths|COVERED|gpui::paint_paths")
    items.push("canvas|draw_surfaces|COVERED|ui::draw (bars, wave, etc)")
    items.push("canvas|custom_metal_shaders|UNREACHABLE|Metal shader pipeline trait")

    items.push("app|app_lifecycle|COVERED|gpui::run")
    items.push("app|menus|COVERED|gpui::set_menus")
    items.push("app|clipboard|COVERED|gpui::clipboard_text")
    items.push("app|theme|COVERED|gpui::set_theme")
    items.push("app|async_tasks|COVERED|gpui::task & gpui::delay")
    items.push("app|entity_subscriptions|MECHANISM|cx.subscribe Model entity")
    items.push("app|status_bar_item|UNREACHABLE|StatusItem private in gpui")
    items.push("app|screen_capture|UNREACHABLE|PlatformScreenCaptureFrame pub(crate)")

    let mut subsystems: Vec<String> = Vec::from([])
    for item in items {
        let parts = strings::split(item, "|")
        let sub = parts[0]
        if !contains_str(subsystems, sub) {
            subsystems.push(sub)
        }
    }

    let mut total_all = 0
    let mut covered_all = 0
    let mut mechanical_all = 0
    let mut style_token_all = 0
    let mut mechanism_all = 0
    let mut unreachable_all = 0

    if json_out {
        println("{")
        println("  \"subsystems\": [")
    }

    let mut first_sub = true
    for sub in subsystems {
        if filter_name != "" && sub != filter_name {
            continue
        }

        let mut sub_total = 0
        let mut sub_covered = 0
        let mut sub_mechanical = 0
        let mut sub_style = 0
        let mut sub_mechanism = 0
        let mut sub_unreach = 0

        for item in items {
            let parts = strings::split(item, "|")
            if parts[0] == sub {
                sub_total = sub_total + 1
                let status = parts[2]
                if status == "COVERED" { sub_covered = sub_covered + 1 }
                else if status == "MECHANICAL" { sub_mechanical = sub_mechanical + 1 }
                else if status == "STYLE_TOKEN" { sub_style = sub_style + 1 }
                else if status == "MECHANISM" { sub_mechanism = sub_mechanism + 1 }
                else if status == "UNREACHABLE" { sub_unreach = sub_unreach + 1 }
            }
        }

        total_all = total_all + sub_total
        covered_all = covered_all + sub_covered
        mechanical_all = mechanical_all + sub_mechanical
        style_token_all = style_token_all + sub_style
        mechanism_all = mechanism_all + sub_mechanism
        unreachable_all = unreachable_all + sub_unreach

        let pct = if sub_total > 0 { ((sub_covered as f64) / (sub_total as f64)) * 100.0 } else { 0.0 }

        if json_out {
            if !first_sub { println(",") }
            first_sub = false
            println("    {")
            println(f"      \"name\": \"{sub}\",")
            println(f"      \"total\": {sub_total},")
            println(f"      \"covered\": {sub_covered},")
            println(f"      \"mechanical\": {sub_mechanical},")
            println(f"      \"style_token\": {sub_style},")
            println(f"      \"mechanism\": {sub_mechanism},")
            println(f"      \"unreachable\": {sub_unreach},")
            println(f"      \"percentage\": {pct}")
            print("    }")
        } else {
            let bar = print_bar(pct, 14)
            println(f"  {sub:10} {bar} {pct:5.1}% ({sub_covered}/{sub_total}) [mech: {sub_mechanical}, style: {sub_style}, mech_block: {sub_mechanism}, unreach: {sub_unreach}]")
            if detail {
                for item in items {
                    let parts = strings::split(item, "|")
                    if parts[0] == sub {
                        let name = parts[1]
                        let status = parts[2]
                        let note = parts[3]
                        println(f"    - {status:11} {name:22} : {note}")
                    }
                }
                println("")
            }
        }
    }

    if json_out {
        println("")
        println("  ],")
        let total_pct = if total_all > 0 { ((covered_all as f64) / (total_all as f64)) * 100.0 } else { 0.0 }
        let automatable = covered_all + mechanical_all + style_token_all
        let auto_pct = if total_all > 0 { ((automatable as f64) / (total_all as f64)) * 100.0 } else { 0.0 }
        println(f"  \"total_items\": {total_all},")
        println(f"  \"covered\": {covered_all},")
        println(f"  \"mechanical_candidates\": {mechanical_all},")
        println(f"  \"style_token_candidates\": {style_token_all},")
        println(f"  \"mechanism_blocks\": {mechanism_all},")
        println(f"  \"unreachable\": {unreachable_all},")
        println(f"  \"current_coverage_pct\": {total_pct},")
        println(f"  \"potential_coverage_pct\": {auto_pct}")
        println("}")
    } else {
        println("------------------------------------------------------------")
        let total_pct = if total_all > 0 { ((covered_all as f64) / (total_all as f64)) * 100.0 } else { 0.0 }
        let automatable = covered_all + mechanical_all + style_token_all
        let auto_pct = if total_all > 0 { ((automatable as f64) / (total_all as f64)) * 100.0 } else { 0.0 }
        println(f"  Current Coverage:   {covered_all}/{total_all} ({total_pct:.1}%)")
        println(f"  Automatable Target: {automatable}/{total_all} ({auto_pct:.1}%) with gen-accessors + gen-style-tokens")
        println(f"  Mechanism Blocks:   {mechanism_all}/{total_all} requires bespoke immediate-mode redesign")
        println(f"  Unreachable:        {unreachable_all}/{total_all} blocked by C-ABI / internal Rust traits")
        println("")
        println("Next steps:")
        println("  ./scripts/gen-accessors --summary       view automatable scalar accessors")
        println("  ./scripts/gen-style-tokens --verify     view unmapped Tailwind style tokens")
        println("  ./scripts/transpile-view                transpile upstream view definitions")
    }
}
